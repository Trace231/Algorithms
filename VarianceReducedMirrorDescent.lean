        hEavg_def hcanonical_pos_edge hcanonical_neg_edge
  let baseStep : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪L • x k, (1 / (n : ℝ)) • d⟫_ℝ) +
