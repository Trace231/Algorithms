/-- Voucher step: replace the actual freezing error by the larger Lipschitz
budget under a nonnegative perturbation scale. -/
private theorem _voucher_step_3e_lipschitz_error_absorption
    {τ errorSum R S : ℝ} (hτ_nonneg : 0 ≤ τ)
    (herror_le_R : errorSum ≤ R)
    (hfirst : -(τ * errorSum) ≤ τ * S) :
    -(τ * R) ≤ τ * S :=
  scaled_error_budget_to_R hτ_nonneg herror_le_R hfirst

/-- Voucher step: cancel the positive perturbation scale after the strict
epsilon budget has absorbed the Lipschitz error. -/
private theorem _voucher_step_3f_positive_scale_cancellation
    {τ ε R S : ℝ} (hτ_pos : 0 < τ) (hR_lt : R < ε)
    (hscaled : -(τ * R) ≤ τ * S) :
    -ε ≤ S :=
  positive_perturb_scale_cancel_with_epsilon_loss hτ_pos hR_lt hscaled

/-- Legacy refutability certificate for the retired cycle-only first-order
