private theorem reflected_scaled_bracket_sum_rewrite
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (L : ℝ) (g r : ℕ → H) :
    (Finset.sum (Finset.range n)
        (fun k =>
          if hlast : k + 1 = n then
            -⟪g k, (1 / L) • r k⟫_ℝ
          else
            ⟪g k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) +
      ⟪g n, (1 / L) • r 0⟫_ℝ) =
    (1 / L) *
      (⟪g n - g 0, r 0⟫_ℝ +
        Finset.sum (Finset.range (n - 1))
          (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)) := by
  classical
  have hbase :=
    reflected_if_last_inner_sum_eq_boundary_pred
      (H := H) hn_pos g (fun k => (1 / L) • r k)
  calc
    (Finset.sum (Finset.range n)
        (fun k =>
          if hlast : k + 1 = n then
            -⟪g k, (1 / L) • r k⟫_ℝ
          else
            ⟪g k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) +
      ⟪g n, (1 / L) • r 0⟫_ℝ)
        =
      ⟪g n - g 0, (1 / L) • r 0⟫_ℝ +
        Finset.sum (Finset.range (n - 1))
          (fun k => ⟪g k - g (k + 1), (1 / L) • r (k + 1)⟫_ℝ) := hbase
    _ =
      (1 / L) *
        (⟪g n - g 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)) := by
        simp only [inner_smul_right]
        rw [← Finset.mul_sum, ← mul_add]

/-- Frozen-field split for the reflected perturbation cycle.

This packages the algebra common to the `B` and quadratic-tilt fields in Lan
