                        τ • ((1 / L) • r (n - 1))⟫_ℝ := by
                    congr 1
                    · apply Finset.sum_congr rfl
                      intro k hk
                      rw [hpos_edges k hk]
                    · rw [hpos_last]
          have herrorWork_neg_edge :
              errorWork_neg =
                Finset.sum (Finset.range (n - 1))
                    (fun k =>
                      ⟪B (yNeg k) - g k,
                        (1 / (n : ℝ)) • d -
                          τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
                  ⟪B (yNeg (n - 1)) - g (n - 1),
                    (1 / (n : ℝ)) • d +
                      τ • ((1 / L) • r (n - 1))⟫_ℝ := by
            have hn_sub_succ : n - 1 + 1 = n := Nat.sub_add_cancel hn_pos
            calc
              errorWork_neg =
                  Finset.sum (Finset.range (n - 1))
                      (fun k =>
                        ⟪B (yNeg k) - g k, yNeg (k + 1) - yNeg k⟫_ℝ) +
                    ⟪B (yNeg (n - 1)) - g (n - 1),
                      yNeg n - yNeg (n - 1)⟫_ℝ := by
                    dsimp [errorWork_neg]
                    conv_lhs => rw [← hn_sub_succ, Finset.sum_range_succ]
                    simp [hn_sub_succ]
              _ =
                  Finset.sum (Finset.range (n - 1))
                      (fun k =>
                        ⟪B (yNeg k) - g k,
                          (1 / (n : ℝ)) • d -
                            τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
                    ⟪B (yNeg (n - 1)) - g (n - 1),
                      (1 / (n : ℝ)) • d +
                        τ • ((1 / L) • r (n - 1))⟫_ℝ := by
                    congr 1
                    · apply Finset.sum_congr rfl
                      intro k hk
                      rw [hneg_edges k hk]
                    · rw [hneg_last]
          have heDiff_edge_split :
              eDiff =
                (Finset.sum (Finset.range (n - 1))
                    (fun k =>
                      ⟪B (yPos k) - g k,
                        (1 / (n : ℝ)) • d +
                          τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
                  ⟪B (yPos (n - 1)) - g (n - 1),
                    (1 / (n : ℝ)) • d -
                      τ • ((1 / L) • r (n - 1))⟫_ℝ) -
                (Finset.sum (Finset.range (n - 1))
                    (fun k =>
                      ⟪B (yNeg k) - g k,
                        (1 / (n : ℝ)) • d -
                          τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
                  ⟪B (yNeg (n - 1)) - g (n - 1),
                    (1 / (n : ℝ)) • d +
                      τ • ((1 / L) • r (n - 1))⟫_ℝ) := by
            dsimp [eDiff]
            rw [herrorWork_pos_edge, herrorWork_neg_edge]
          let driftSum : ℝ :=
            Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪B (yPos k) - g k, (1 / (n : ℝ)) • d⟫_ℝ -
                    ⟪B (yNeg k) - g k, (1 / (n : ℝ)) • d⟫_ℝ)
          let driftLast : ℝ :=
            ⟪B (yPos (n - 1)) - g (n - 1), (1 / (n : ℝ)) • d⟫_ℝ -
              ⟪B (yNeg (n - 1)) - g (n - 1), (1 / (n : ℝ)) • d⟫_ℝ
          let oscillationSum : ℝ :=
            Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪B (yPos k) - g k, (1 / L) • (r (k + 1) - r k)⟫_ℝ +
                    ⟪B (yNeg k) - g k, (1 / L) • (r (k + 1) - r k)⟫_ℝ)
          let oscillationLast : ℝ :=
            ⟪B (yPos (n - 1)) - g (n - 1),
                (1 / L) • r (n - 1)⟫_ℝ +
              ⟪B (yNeg (n - 1)) - g (n - 1),
                (1 / L) • r (n - 1)⟫_ℝ
          let driftError : ℝ := driftSum + driftLast
          let oscillationError : ℝ := oscillationSum - oscillationLast
          have hcore_split_and_budget :
              eDiff = driftError + τ * oscillationError ∧
                Eavg ≤
                  τ * Finset.sum (Finset.range n)
                    (fun k => ‖(1 / L) • r k‖) := by
            constructor
            · have hsum_pair :
                  Finset.sum (Finset.range (n - 1))
                      (fun k =>
                        ⟪B (yPos k) - g k,
                          (1 / (n : ℝ)) • d +
                            τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ -
                          ⟪B (yNeg k) - g k,
                            (1 / (n : ℝ)) • d -
                              τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) =
                    Finset.sum (Finset.range (n - 1))
                      (fun k =>
                        (⟪B (yPos k) - g k, (1 / (n : ℝ)) • d⟫_ℝ -
                          ⟪B (yNeg k) - g k, (1 / (n : ℝ)) • d⟫_ℝ) +
                        τ *
                          (⟪B (yPos k) - g k,
                            (1 / L) • (r (k + 1) - r k)⟫_ℝ +
                            ⟪B (yNeg k) - g k,
                              (1 / L) • (r (k + 1) - r k)⟫_ℝ)) := by
                apply Finset.sum_congr rfl
                intro k hk
                exact
                  reflected_error_edge_pair_split_pos
                    (B (yPos k) - g k) (B (yNeg k) - g k)
                    ((1 / (n : ℝ)) • d)
                    ((1 / L) • (r (k + 1) - r k)) τ
              have hlast_pair :
                  ⟪B (yPos (n - 1)) - g (n - 1),
                    (1 / (n : ℝ)) • d -
                      τ • ((1 / L) • r (n - 1))⟫_ℝ -
                    ⟪B (yNeg (n - 1)) - g (n - 1),
                      (1 / (n : ℝ)) • d +
                        τ • ((1 / L) • r (n - 1))⟫_ℝ =
                  (⟪B (yPos (n - 1)) - g (n - 1),
                      (1 / (n : ℝ)) • d⟫_ℝ -
                    ⟪B (yNeg (n - 1)) - g (n - 1),
                      (1 / (n : ℝ)) • d⟫_ℝ) -
                    τ *
                      (⟪B (yPos (n - 1)) - g (n - 1),
                          (1 / L) • r (n - 1)⟫_ℝ +
                        ⟪B (yNeg (n - 1)) - g (n - 1),
                          (1 / L) • r (n - 1)⟫_ℝ) :=
                reflected_error_edge_pair_split_last
                  (B (yPos (n - 1)) - g (n - 1))
                  (B (yNeg (n - 1)) - g (n - 1))
                  ((1 / (n : ℝ)) • d) ((1 / L) • r (n - 1)) τ
              calc
                eDiff =
                    Finset.sum (Finset.range (n - 1))
                        (fun k =>
                          ⟪B (yPos k) - g k,
                            (1 / (n : ℝ)) • d +
                              τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ -
                            ⟪B (yNeg k) - g k,
                              (1 / (n : ℝ)) • d -
                                τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
                      (⟪B (yPos (n - 1)) - g (n - 1),
                        (1 / (n : ℝ)) • d -
                          τ • ((1 / L) • r (n - 1))⟫_ℝ -
                        ⟪B (yNeg (n - 1)) - g (n - 1),
                          (1 / (n : ℝ)) • d +
                            τ • ((1 / L) • r (n - 1))⟫_ℝ) := by
                  rw [heDiff_edge_split]
                  rw [Finset.sum_sub_distrib]
                  abel
                _ = driftError + τ * oscillationError := by
                  rw [hsum_pair, hlast_pair]
                  rw [Finset.sum_add_distrib, ← Finset.mul_sum]
                  change
                    (driftSum + τ * oscillationSum) +
                        (driftLast - τ * oscillationLast) =
                      driftError + τ * oscillationError
                  dsimp [driftError, oscillationError]
                  ring
            · have hpos_direct :
                  Finset.sum (Finset.range n)
                      (fun k =>
                        ‖(1 / L) •
                          (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) ≤
                    τ * Finset.sum (Finset.range n)
                      (fun k => ‖(1 / L) • r k‖) := by
                exact
                  scaled_lipschitz_error_sum_bound_for_reflected_cycle
                    B U L τ hL_pos hτ_nonneg x g r yPos hg
                    hy_eq_range_pos hx_mem_range hy_mem_range_pos hBLip
              have hneg_direct :
                  Finset.sum (Finset.range n)
                      (fun k =>
                        ‖(1 / L) •
                          (B (reflectedPerturbedCycle L τ n x
                            (fun j => -r j) k) - g k)‖) ≤
                    τ * Finset.sum (Finset.range n)
                      (fun k => ‖(1 / L) • r k‖) := by
                exact
                  scaled_lipschitz_error_sum_bound_for_neg_reflected_cycle
                    B U L τ hL_pos hτ_nonneg x g r yNeg hg
                    hy_eq_range_neg hx_mem_range hy_mem_range_neg hBLip
              simpa [Eavg] using
                _voucher_step_3d_two_sided_error_average_bound
                  hpos_direct hneg_direct
          have heDiff_drift_oscillation_sum_split :
              eDiff = driftError + τ * oscillationError :=
            hcore_split_and_budget.1
          have hEavg_budget_from_source :
              Eavg ≤
                τ * Finset.sum (Finset.range n)
                  (fun k => ‖(1 / L) • r k‖) :=
            hcore_split_and_budget.2
          have hcross_neg_split :
              baseStep + predSkewNF + residualNegNF +
                  (driftError + τ * oscillationError) ≤ 0 := by
            simpa [heDiff_drift_oscillation_sum_split] using hcross_neg_core
          have hcross_pos_split :
              baseStep - predSkewNF + residualPosNF -
                  (driftError + τ * oscillationError) ≤ 0 := by
            simpa [heDiff_drift_oscillation_sum_split] using hcross_pos_core
          have hsplit_cancel :
              2 * baseStep + residualPosNF + residualNegNF ≤ 0 := by
            linarith [hcross_neg_split, hcross_pos_split]
          let Rsum : ℝ :=
            Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ)
          let meshEnergy : ℝ := L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)
          have hactual_scaled_residual_lower :
              -(τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ))) ≤
                τ * Eavg := by
            -- Remaining exact two-sign absorption leaf: combine the
            -- uncancelled split inequalities with the drift/oscillation
            -- decomposition and the actual averaged freezing error. This is
            -- the theorem-critical bridge; the endpoint-energy wrapper below
            -- is intentionally bypassed.
            have hfirst_Q : 0 ≤ 2 * Rsum + Q + Eavg := by
              -- Core T1 frontier: the two crossed signs and the explicit
              -- positive/negative freezing-error edge decompositions should
              -- absorb the actual averaged error before the mesh budget is
              -- used.  This is deliberately the unscaled Q-form so the
              -- remaining proof obligation is exactly the source-derived
              -- first-variation bridge, not scalar bookkeeping.
              have hsource_budget_visible := hEavg_budget_from_source
              have hneg_split_visible := hcross_neg_split
              have hpos_split_visible := hcross_pos_split
              have hresidual_visible := hresidual_sum_nonpos
              have hdrift_visible := heDiff_drift_oscillation_sum_split
              have herror_pos_visible := herrorWork_pos_edge
              have herror_neg_visible := herrorWork_neg_edge
              have hsplit_visible := hsplit_cancel
              have hcross_cancel_from_visible :
                  2 * baseStep + residualPosNF + residualNegNF ≤ 0 := by
                linarith only [hneg_split_visible, hpos_split_visible]
              have hdefect_lower_from_cross :
                  baseStep - predSkewNF + residualPosNF ≤
                    driftError + τ * oscillationError := by
                linarith only [hpos_split_visible]
              have hdefect_upper_from_cross :
                  driftError + τ * oscillationError ≤
                    -(baseStep + predSkewNF + residualNegNF) := by
                linarith only [hneg_split_visible]
              have hdefect_interval_from_cross :
                  baseStep - predSkewNF + residualPosNF ≤
                      driftError + τ * oscillationError ∧
                    driftError + τ * oscillationError ≤
                      -(baseStep + predSkewNF + residualNegNF) := by
                exact ⟨hdefect_lower_from_cross, hdefect_upper_from_cross⟩
              have heDiff_from_visible_edges :
                  eDiff =
                    (Finset.sum (Finset.range (n - 1))
                        (fun k =>
                          ⟪B (yPos k) - g k,
                            (1 / (n : ℝ)) • d +
                              τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
                      ⟪B (yPos (n - 1)) - g (n - 1),
                        (1 / (n : ℝ)) • d -
                          τ • ((1 / L) • r (n - 1))⟫_ℝ) -
                    (Finset.sum (Finset.range (n - 1))
                        (fun k =>
                          ⟪B (yNeg k) - g k,
                            (1 / (n : ℝ)) • d -
                              τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
                      ⟪B (yNeg (n - 1)) - g (n - 1),
                        (1 / (n : ℝ)) • d +
                          τ • ((1 / L) • r (n - 1))⟫_ℝ) := by
                dsimp [eDiff]
                rw [herror_pos_visible, herror_neg_visible]
              have hdefect_eq_eDiff :
                  driftError + τ * oscillationError = eDiff := by
                exact hdrift_visible.symm
              -- T1 core frontier: prove the actual unscaled absorption from
              -- the crossed reflected splits plus exact freezing-error edge
              -- decompositions. The endpoint/slack algebra is now downstream
              -- of this fact, so the remaining proof debt is no longer an
              -- endpoint wrapper.
              have hfirst_lower : -(2 * Rsum + Q) ≤ Eavg := by
                -- Core absorption form.  The crossed-split interval
                -- `hdefect_interval_from_cross` and the actual edge identity
                -- `heDiff_from_visible_edges` are now exposed together with
                -- `hdefect_eq_eDiff`; the remaining work is the Hilbert/Finset
                -- source algebra identifying this signed defect with the
                -- first-variation scalar and bounding it by the actual
                -- averaged freezing error.
                exact
                  source_preserving_reflected_first_variation_bridge
                    Φ B U L hL_pos hsupport hupper hBLip hn_pos hτ_nonneg
                    hτ_pos d x g r yPos yNeg hx_mem_range hyPert_mem_pos
                    hyPert_mem_neg hg hr hstep hclose hg0
                    (hbaseStep_def := rfl) (hpredSkewNF_def := rfl)
                    (hresidualPosNF_def := rfl) (hresidualNegNF_def := rfl)
                    (hdriftError_def := rfl) (hoscillationError_def := rfl)
                    (hRsum_def := rfl) (hQ_def := rfl) (hEavg_def := rfl)
                    hcross_neg_split hcross_pos_split hresidual_sum_nonpos
                    heDiff_drift_oscillation_sum_split
                    herrorWork_pos_edge herrorWork_neg_edge
                    hEavg_budget_from_source
              linarith only [hfirst_lower]
            have hfirst_variation_with_slack :
                Q ≤ 2 * Rsum + meshEnergy +
                  (2 * Q + Eavg - meshEnergy) :=
              endpoint_slack_from_first_variation_absorption hfirst_Q
            have _ :
                ‖g n‖ ^ 2 ≤
                  2 * L *
                      ((1 / (n : ℝ)) *
                        Finset.sum (Finset.range n)
                          (fun k => ⟪g k, d⟫_ℝ)) +
                    meshEnergy + (2 * Q + Eavg - meshEnergy) := by
              simpa [Q, Rsum, meshEnergy] using
                endpoint_energy_bound_of_residual_first_variation_with_slack
                  (H := H) d L hn_pos g r hg0 hr
                  (2 * Q + Eavg - meshEnergy)
                  (by simpa [Q, Rsum, meshEnergy] using
                    hfirst_variation_with_slack)
            have hmesh_Q :
                Q ≤ L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
              simpa [Q] using hgrad_increment_budget
            have hnonneg_mesh :
                0 ≤ 2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) + Eavg := by
              have hdiff_nonneg :
                  0 ≤ L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) - Q :=
                sub_nonneg.mpr hmesh_Q
              have hrewrite :
                  2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) + Eavg =
                    (2 * Rsum + Q + Eavg) +
                      (L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) - Q) := by
                ring
              rw [hrewrite]
              exact add_nonneg hfirst_Q hdiff_nonneg
            have hscaled_nonneg :
                0 ≤
                  τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) + Eavg) :=
              mul_nonneg hτ_nonneg hnonneg_mesh
            have hscaled_sum :
                0 ≤
                  τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) +
                    τ * Eavg := by
              have hrewrite :
                  τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) + Eavg) =
                    τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) +
                      τ * Eavg := by
                ring
              rwa [hrewrite] at hscaled_nonneg
            calc
              -(τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ))) =
                  0 - τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) := by
                    ring
              _ ≤
                  (τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) +
                    τ * Eavg) -
                    τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) := by
                    exact sub_le_sub_right hscaled_sum
                      (τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)))
              _ = τ * Eavg := by
                    ring
          have hwork_error_nonneg :
              0 ≤ τ * (2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) +
                τ * Eavg := by
            linarith only [hactual_scaled_residual_lower]
          simpa [S, Rsum] using hwork_error_nonneg
        exact hdirect_scaled_absorption
      exact hscaled_absorption
    exact _voucher_step_3d_final_ordered_ring_from_nonnegative_sum hnonneg
  simpa [Eavg, S] using hfinite_cancellation

/-- Typed finite-algebra leaf: normalized two-sign source splits imply the
exact scaled first-variation lower bound.

This is the exact cancellation step that remains after the source support and
smooth-upper cycle applications have been normalized into named positive and
negative components.  It deliberately keeps the averaged error term in the
conclusion; earlier attempts to replace this by `0 ≤ S` were overstrong in this
local context. -/

private theorem _voucher_step_3d_mesh_rewrite_from_combined_terms
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) {τ : ℝ}
    (hτ_nonneg : 0 ≤ τ)
    (d : H) (x g r : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hyPert_mem_pos :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hyPert_cycle_pos :
      reflectedPerturbedCycle L τ n x r (n + 1) =
        reflectedPerturbedCycle L τ n x r 0)
    (hyPert_mem_neg :
      ∀ k, k ≤ n + 1 →
        reflectedPerturbedCycle L τ n x (fun j => -r j) k ∈ U)
    (hyPert_cycle_neg :
      reflectedPerturbedCycle L τ n x (fun j => -r j) (n + 1) =
        reflectedPerturbedCycle L τ n x (fun j => -r j) 0)
    (hg : ∀ k, g k = B (x k))
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    (hclose : x 0 - x n = -d)
    (hg0 : g 0 = 0)
    (hpos_named :
      let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        τ *
          ((1 / L) *
            (⟪g n - g 0, r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
      let errorWork_pos : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yPos k) - g k, yPos (k + 1) - yPos k⟫_ℝ)
      let baseTilt : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n - g n, x 0 - x n⟫_ℝ
      let predTilt : ℝ :=
        τ *
          ((1 / L) *
            (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork_pos : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ)
      (baseB + predB) + errorWork_pos ≤ 0 ∧
        (baseTilt + predTilt) + residualWork_pos - errorWork_pos ≤ 0)
    (hneg_named :
      let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        τ *
          ((1 / L) *
            (⟪g n - g 0, r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
      let errorWork_neg : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yNeg k) - g k, yNeg (k + 1) - yNeg k⟫_ℝ)
      let baseTilt : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n - g n, x 0 - x n⟫_ℝ
      let predTilt : ℝ :=
        τ *
          ((1 / L) *
            (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork_neg : ℝ :=
