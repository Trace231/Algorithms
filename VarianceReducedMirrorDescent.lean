          linarith

/-- Early open-chart pairwise Baillon-Haddad inequality from support, upper
model, and Lipschitz selected gradients.

This aligns with Lan Lemma 5.8 proof step 2 in the open chart. Search audit:
checked downstream `open_chart_pairwise_baillon_haddad_from_support_upper_lipschitz`
and `open_pairwise_bh_from_support_upper_gradient_semantics_direct`; the
declaration-order usable dependency here is the zero-base helper
`early_open_zero_base_self_bound_non_circular`, so this theorem packages the
standard shift by the supporting plane at `v`. -/
private theorem early_open_chart_pairwise_bh_from_support_upper_lipschitz
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [CompleteSpace V] [FiniteDimensional ℝ V]
    (Φ : V → ℝ) (B : V → V) (U : Set V) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ U, ∀ v ∈ U,
      Φ v ≤ Φ u + ⟪B u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2)
    (hBLip : ∀ u ∈ U, ∀ v ∈ U, ‖B u - B v‖ ≤ L * ‖u - v‖) :
    ∀ u ∈ U, ∀ v ∈ U,
      ‖B u - B v‖ ^ 2 ≤
        2 * L * (Φ u - Φ v - ⟪B v, u - v⟫_ℝ) := by
  classical
  have hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x := by
    intro x hx
    exact
      support_upper_hasFDerivAt_of_mem_interior
        Φ B U L hsupport hupper x (by
          simpa [hUopen.interior_eq] using hx)
  intro u hu v hv
  let Ψ : V → ℝ := fun y => Φ y - Φ v - ⟪B v, y - v⟫_ℝ
  let C : V → V := fun y => B y - B v
  have hΨv : Ψ v = 0 := by simp [Ψ]
  have hCv : C v = 0 := by simp [C]
  have hnonnegΨ : ∀ x ∈ U, 0 ≤ Ψ x := by
    intro x hx
    simpa [Ψ] using hsupport v hv x hx
  have hsupportΨ :
      ∀ x ∈ U, ∀ y ∈ U,
        0 ≤ Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ := by
    intro x hx y hy
    have h := hsupport x hx y hy
    have hres :
        Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ =
          Φ y - Φ x - ⟪B x, y - x⟫_ℝ := by
      simp [Ψ, C, inner_sub_left, inner_sub_right]
      ring
    simpa [hres] using h
  have hupperΨ :
      ∀ x ∈ U, ∀ y ∈ U,
        Ψ y ≤ Ψ x + ⟪C x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2 := by
    intro x hx y hy
    have h := hupper x hx y hy
    have hres :
        Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ =
          Φ y - Φ x - ⟪B x, y - x⟫_ℝ := by
      simp [Ψ, C, inner_sub_left, inner_sub_right]
      ring
    have hgap :
        Φ y - Φ x - ⟪B x, y - x⟫_ℝ ≤
          (L / 2) * ‖y - x‖ ^ 2 := by
      linarith
    have hgapΨ :
        Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ ≤
          (L / 2) * ‖y - x‖ ^ 2 := by
      simpa [hres] using hgap
    linarith
  have hgradΨ : ∀ x ∈ U, HasFDerivAt Ψ (innerSL ℝ (C x)) x := by
    intro x hx
    have hΦ := hgrad x hx
    have hlin :
        HasFDerivAt (fun y : V => ⟪B v, y - v⟫_ℝ)
          (innerSL ℝ (B v)) x := by
      simpa using
        ((innerSL ℝ (B v)).hasFDerivAt.comp x
          ((hasFDerivAt_id x).sub_const v))
    have hshift :
        HasFDerivAt (fun y : V => Φ y - Φ v - ⟪B v, y - v⟫_ℝ)
          (innerSL ℝ (B x) - innerSL ℝ (B v)) x := by
      exact (hΦ.sub_const (Φ v)).sub hlin
    have hderiv : innerSL ℝ (B x) - innerSL ℝ (B v) = innerSL ℝ (C x) := by
      ext d
      simp [C]
    rw [hderiv] at hshift
    simpa [Ψ] using hshift
  have hCLip : ∀ x ∈ U, ∀ y ∈ U, ‖C x - C y‖ ≤ L * ‖x - y‖ := by
    intro x hx y hy
    have hdiff : C x - C y = B x - B y := by
      dsimp [C]
      abel
    simpa [hdiff] using hBLip x hx y hy
  have hself : ‖C u‖ ^ 2 ≤ 2 * L * Ψ u :=
    early_open_zero_base_self_bound_non_circular
      Ψ C U L hL_pos hUopen hUconv hnonnegΨ hsupportΨ hupperΨ hgradΨ hCLip
      v hv hΨv hCv u hu
  simpa [Ψ, C] using hself

/-- Early intrinsic-interior pairwise Baillon-Haddad chart transport.

This is the remaining relative-open analytic core for Lan Lemma 5.8 after
the source support, smooth-upper, affine-direction, and Lipschitz data have
already been assembled. Search audit: checked the downstream
`intrinsic_pairwise_baillon_haddad_chart_transport`,
`open_chart_pairwise_baillon_haddad_from_support_upper_lipschitz`,
`carrier_chart_to_ambient_vsub`, SOptLib chart lemmas
`SOptLib.carrierChartPoint_mem_interior_chartSet_of_intrinsicInterior`,
`SOptLib.carrierChartToAmbient_mem_intrinsicInterior_of_mem_interior_chartSet`,
