/-- Exact normal form for the direct-endpoint double-`Q` gap. -/
private theorem double_q_gap_as_residual_cross_terms
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) {L : ℝ} (hL_pos : 0 < L)
