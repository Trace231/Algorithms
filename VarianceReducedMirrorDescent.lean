  have hscaled : -(τ * R) ≤ τ * S :=
    _voucher_step_3e_lipschitz_error_absorption
      hτ_nonneg (by simpa [errorSum, R] using herror_le_R) hfirst
  have hcancel : -ε ≤ S :=
    _voucher_step_3f_positive_scale_cancellation
      hτ_pos (by simpa [R] using hlinear_error_small) hscaled
  simpa [S] using hcancel

