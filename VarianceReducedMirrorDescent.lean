        rw [hres] at h
        simpa [sub_eq_add_neg, add_assoc] using h
      let errorSum : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ‖(1 / L) • (B (yPert k) - g k)‖)
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        perturbScale *
          (1 / L *
            (⟪g n - g 0, r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
      let errorWork : ℝ :=
        Finset.sum (Finset.range n)
          (fun k =>
            ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ)
      let baseTilt : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n - g n, x 0 - x n⟫_ℝ
      let predTilt : ℝ :=
        perturbScale *
          (1 / L *
            (⟪L • x n - g n - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪L • x k - g k - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork : ℝ :=
        Finset.sum (Finset.range n)
          (fun k =>
            ⟪perturbScale • r k, yPert (k + 1) - yPert k⟫_ℝ)
      have hB_pred_error_nonpos_abbrev :
          (baseB + predB) + errorWork ≤ 0 := by
        simpa [baseB, predB, errorWork] using hB_pred_error_nonpos
      have htilt_pred_error_nonpos_abbrev :
          (baseTilt + predTilt) + residualWork - errorWork ≤ 0 := by
        simpa [baseTilt, predTilt, residualWork, errorWork] using
          htilt_pred_error_nonpos'
      have hcombined_pred_error_nonpos :
          baseB + predB + baseTilt + predTilt + residualWork ≤ 0 := by
        linarith [hB_pred_error_nonpos_abbrev, htilt_pred_error_nonpos_abbrev]
      have herror_le_R : errorSum ≤ R := by
        simpa [errorSum] using hB_yPert_close_scaled_sum_le_R
      have hfirst :
          -(perturbScale * errorSum) ≤ perturbScale * S := by
        have hendpoint_energy :
            ‖g n‖ ^ 2 ≤
              2 * L *
                  ((1 / (n : ℝ)) *
                    Finset.sum (Finset.range n)
                      (fun k => ⟪g k, d⟫_ℝ)) +
                L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
          have hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x := by
            intro y hy
            exact
              support_upper_hasFDerivAt_of_mem_interior
                Φ B U L hsupport hupper y (by
                  simpa [hUopen.interior_eq] using hy)
