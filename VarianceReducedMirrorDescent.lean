private theorem scaled_error_budget_to_R
    {τ E R S : ℝ} (hτ_nonneg : 0 ≤ τ) (hE_le_R : E ≤ R)
    (hfirst : -(τ * E) ≤ τ * S) :
    -(τ * R) ≤ τ * S := by
  have hscaled_error : τ * E ≤ τ * R :=
    mul_le_mul_of_nonneg_left hE_le_R hτ_nonneg
  have hleft : -(τ * R) ≤ -(τ * E) := neg_le_neg hscaled_error
  exact le_trans hleft hfirst

/-- Lipschitz control of the scaled freezing error on reflected perturbation vertices.

This is the analytic error-budget piece in Lan Lemma 5.8's reflected-cycle
