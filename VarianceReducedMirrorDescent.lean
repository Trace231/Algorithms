actual reflected `Eavg` definition. -/
private theorem canonical_two_sign_pair_norm_sum_eq_two_Eavg
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    {n : ℕ} {L τ : ℝ} (B : H → H) (x g r : ℕ → H) {Eavg : ℝ}
    (hEavg_def :
      Eavg =
        (Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                  g k)‖)) /
          2) :
    Finset.sum (Finset.range n)
        (fun k =>
          ‖(1 / L) • (B (reflectedPerturbedCycle L τ n x r k) - g k)‖ +
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                g k)‖) =
      2 * Eavg := by
  rw [hEavg_def]
  rw [Finset.sum_add_distrib]
  ring

/-- Summed two-sign Cauchy--Schwarz lower bound for the canonical reflected
freezing-error work.

This is the finite T1 bridge for Lan Lemma 5.8's reflected mesh route.  It
uses the actual canonical positive/negative edge displays together with the
actual `Eavg` definition: the first component records that the summed
positive/negative scaled freezing-error norms are exactly `2 * Eavg`, while
the second component lower-bounds the oscillatory signed part of
`errorWork_pos - errorWork_neg`. Search audit: checked the target-file
`two_sign_scaled_error_inner_lower_bound`,
`reflected_two_sign_point_error_norm_le_two_Eavg`, and
`signed_defect_edge_reconstruction_from_edges`; the pointwise helper supplies
the Cauchy--Schwarz atom, the point-extraction helper is too weak for a finite
sum, and the edge reconstruction supplies the canonical work connection but
not the summed norm lower bound. -/
private theorem canonical_two_sign_error_work_lower_bound
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) {L τ : ℝ} (hL_pos : 0 < L)
    (hτ_nonneg : 0 ≤ τ) (d : H) (B : H → H) (x g r : ℕ → H)
    {Eavg errorWork_pos errorWork_neg : ℝ}
    (hEavg_def :
      Eavg =
        (Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                  g k)‖)) /
          2)
    (herrorWork_pos_edge :
      errorWork_pos =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
                (1 / (n : ℝ)) • d +
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d -
              τ • ((1 / L) • r (n - 1))⟫_ℝ)
    (herrorWork_neg_edge :
      errorWork_neg =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
                (1 / (n : ℝ)) • d -
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
              g (n - 1),
            (1 / (n : ℝ)) • d +
              τ • ((1 / L) • r (n - 1))⟫_ℝ) :
    let pairNorm : ℕ → ℝ := fun k =>
      ‖(1 / L) • (B (reflectedPerturbedCycle L τ n x r k) - g k)‖ +
        ‖(1 / L) •
          (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖
    let driftPart : ℝ :=
      Finset.sum (Finset.range (n - 1))
          (fun k =>
            ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
                (1 / (n : ℝ)) • d⟫_ℝ -
              ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
                (1 / (n : ℝ)) • d⟫_ℝ) +
        (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d⟫_ℝ -
          ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
              g (n - 1),
            (1 / (n : ℝ)) • d⟫_ℝ)
    let oscillationWeight : ℝ :=
      Finset.sum (Finset.range (n - 1))
          (fun k => pairNorm k * ‖r (k + 1) - r k‖) +
        pairNorm (n - 1) * ‖r (n - 1)‖
    Finset.sum (Finset.range n) pairNorm = 2 * Eavg ∧
      -(τ * oscillationWeight) ≤
        (errorWork_pos - errorWork_neg) - driftPart := by
  classical
  refine ⟨?_, ?_⟩
  · exact
      canonical_two_sign_pair_norm_sum_eq_two_Eavg
        (B := B) (x := x) (g := g) (r := r) (n := n) (L := L) (τ := τ)
        hEavg_def
  · let epP : ℕ → H := fun k =>
      B (reflectedPerturbedCycle L τ n x r k) - g k
    let epN : ℕ → H := fun k =>
      B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k
    let v : ℕ → H := fun k => r (k + 1) - r k
    let pairNorm : ℕ → ℝ := fun k =>
      ‖(1 / L) • epP k‖ + ‖(1 / L) • epN k‖
    let rangeWeight : ℝ :=
      Finset.sum (Finset.range (n - 1)) (fun k => pairNorm k * ‖v k‖)
    let lastWeight : ℝ := pairNorm (n - 1) * ‖r (n - 1)‖
    let rangeOscInner : ℝ :=
      Finset.sum (Finset.range (n - 1))
        (fun k =>
          ⟪epP k, (1 / L) • v k⟫_ℝ + ⟪epN k, (1 / L) • v k⟫_ℝ)
    let lastOscInner : ℝ :=
      ⟪epP (n - 1), (1 / L) • r (n - 1)⟫_ℝ +
        ⟪epN (n - 1), (1 / L) • r (n - 1)⟫_ℝ
    have hosc :
        -(rangeWeight + lastWeight) ≤ rangeOscInner - lastOscInner := by
      simpa [rangeWeight, lastWeight, rangeOscInner, lastOscInner, pairNorm,
        epP, epN, v] using
        (two_sign_scaled_error_oscillation_lower_bound
          (H := H) (L := L) hL_pos (n - 1) epP epN v (r (n - 1)))
    have hscaled :
        -(τ * (rangeWeight + lastWeight)) ≤
          τ * (rangeOscInner - lastOscInner) := by
      have hmul := mul_le_mul_of_nonneg_left hosc hτ_nonneg
      nlinarith [hmul]
    let driftPart : ℝ :=
      Finset.sum (Finset.range (n - 1))
          (fun k =>
            ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
                (1 / (n : ℝ)) • d⟫_ℝ -
              ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
                (1 / (n : ℝ)) • d⟫_ℝ) +
        (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d⟫_ℝ -
          ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
              g (n - 1),
            (1 / (n : ℝ)) • d⟫_ℝ)
    have hdrift_def :
        driftPart =
          Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
                    (1 / (n : ℝ)) • d⟫_ℝ -
                  ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
                    (1 / (n : ℝ)) • d⟫_ℝ) +
            (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
                (1 / (n : ℝ)) • d⟫_ℝ -
              ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
                  g (n - 1),
                (1 / (n : ℝ)) • d⟫_ℝ) := rfl
    have hosc_def :
        rangeOscInner - lastOscInner =
          Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
                    (1 / L) • (r (k + 1) - r k)⟫_ℝ +
                  ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
                    (1 / L) • (r (k + 1) - r k)⟫_ℝ) -
            (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
                (1 / L) • r (n - 1)⟫_ℝ +
              ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
                  g (n - 1),
                (1 / L) • r (n - 1)⟫_ℝ) := by
      rfl
    have hsigned :
        driftPart + τ * (rangeOscInner - lastOscInner) =
          errorWork_pos - errorWork_neg := by
      exact
        signed_defect_edge_reconstruction_from_edges
          (n := n) L τ d B g r
          (reflectedPerturbedCycle L τ n x r)
          (reflectedPerturbedCycle L τ n x (fun j => -r j))
          (driftError := driftPart)
          (oscillationError := rangeOscInner - lastOscInner)
          (errorWork_pos := errorWork_pos)
          (errorWork_neg := errorWork_neg)
          hdrift_def hosc_def herrorWork_pos_edge herrorWork_neg_edge
    have hdisplay :
        errorWork_pos - errorWork_neg - driftPart =
          τ * (rangeOscInner - lastOscInner) := by
      calc
        errorWork_pos - errorWork_neg - driftPart =
            (driftPart + τ * (rangeOscInner - lastOscInner)) - driftPart := by
          rw [← hsigned]
        _ = τ * (rangeOscInner - lastOscInner) := by
          ring
    change
      -(τ * (rangeWeight + lastWeight)) ≤
        errorWork_pos - errorWork_neg - driftPart
    rw [hdisplay]
    exact hscaled

/-- Final scalar conversion from the exact Q-form first-variation absorption
