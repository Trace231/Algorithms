/-- Source endpoint energy plus a `2 * Q + Eavg` mesh cover gives the Q/R slack. -/
private theorem endpoint_mesh_energy_and_double_q_gap_to_q_slack
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
