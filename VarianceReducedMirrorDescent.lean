              ‖B u‖ ^ 2 ≤ 2 * L * (Φ u - Φ z) :=
            open_zero_base_endpoint_energy_from_support_upper_lipschitz
              Φ B U L hL_pos hUopen hUconv hsupport hupper hgrad hBLip
              z hz hBz u hu
