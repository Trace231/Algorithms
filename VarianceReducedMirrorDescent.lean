private theorem before_mesh_normalized_zero_base_endpoint_energy_from_source_direct
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hnonneg : ∀ x ∈ U, 0 ≤ Φ x)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hΦz : Φ z = 0) (hBz : B z = 0)
    (u : H) (hu : u ∈ U) :
    ‖B u‖ ^ 2 ≤ 2 * L * Φ u := by
  classical
  refine le_of_forall_pos_le_add ?_
  intro ε hε_pos
  let line : ℝ → H := fun t => AffineMap.lineMap z u t
  let φ : ℝ → ℝ := fun t => Φ (line t)
  let g : ℝ → H := fun t => B (line t)
  let d : H := u - z
  have hline0 : line 0 = z := by
    simp [line]
  have hline1 : line 1 = u := by
    simp [line]
  have hφ0 : φ 0 = 0 := by
    simp [φ, hline0, hΦz]
  have hφ1 : φ 1 = Φ u := by
    simp [φ, hline1]
  obtain ⟨ρ, hρ_pos, htube⟩ :=
    compact_segment_tube_inside_open_convex_domain U hUopen hUconv z hz u hu
  have hseg_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1, line t ∈ U := by
    intro t ht
    exact hUconv.lineMap_mem hz hu ht
  have hlocal_pair :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖(t - s) • d‖ < ρ →
          ‖g t - g s‖ ^ 2 ≤
            2 * L * (φ t - φ s - ⟪g s, (t - s) • d⟫_ℝ) := by
    intro s hs t ht hmesh
    have hsub :
        line t - line s = (t - s) • d := by
      simpa [line, d] using lineMap_sub_eq_smul_endpoint_diff z u s t
    have hpair :=
      local_pair_gap_of_mesh_ball_subset Φ B U L hL_pos hsupport hupper hBLip
        (line s) (hseg_mem s hs) (line t) (hseg_mem t ht)
        (htube t ht) (by simpa [hsub] using hmesh)
    simpa [φ, g, hsub] using hpair
  obtain ⟨n, hn_pos, hmesh, henergyBudget, _hworkBudget⟩ :=
    choose_uniform_partition_for_mesh_and_error d hL_pos hρ_pos hε_pos
  have hfwd :=
    forward_local_pair_gap_sum_controls_mesh_energy_budget
      φ g d L ρ hL_pos hlocal_pair hn_pos hmesh
  let gn : ℕ → H := fun k => B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))
  have hg0 : gn 0 = 0 := by
    simp [gn, hBz]
  have hreflected :
      0 ≤
        2 *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪gn k, (L / (n : ℝ)) • d - (gn (k + 1) - gn k)⟫_ℝ) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    simpa [gn, d] using
      before_endpoint_reflected_work_nonnegative_from_source_cycles
        Φ B U L hL_pos hUopen hUconv hsupport hupper hBLip
        z hz hBz u hu hn_pos
  have hendpoint_raw :=
    mesh_endpoint_algebra_from_reflected_work_before_endpoint
      d L hn_pos gn hg0 hreflected
  have hnR_pos : 0 < (n : ℝ) := by
    exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have hendpoint :
      ‖B u‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖g ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
                  g ((k : ℝ) / (n : ℝ))‖ ^ 2) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    simpa [gn, g, line, d, div_self hnR_ne] using hendpoint_raw
  calc
    ‖B u‖ ^ 2
        ≤ 2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖g ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
                  g ((k : ℝ) / (n : ℝ))‖ ^ 2) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := hendpoint
    _ ≤ 2 * L * (φ 1 - φ 0) + ε / 2 := by
          linarith
    _ = 2 * L * Φ u + ε / 2 := by
          rw [hφ1, hφ0]
          ring
    _ ≤ 2 * L * Φ u + ε := by
          linarith

/-- Direct zero-base endpoint energy from source support and smooth upper data.

This is the analytic Lan Lemma 5.8 leaf needed before the before-mesh direct
split: after shifting the supporting plane at `z`, support plus the quadratic
upper model and Lipschitz selected gradient should give
`‖B u‖^2 ≤ 2L(Φ u - Φ z)`. Search audit: checked the pre-searched candidates
`Convex.carrier_smooth_quadratic_upper_bound`,
`lipschitzWith_of_norm_sub_le_mul`, `LipschitzWith.measurable`, and target-file
hits `open_pairwise_baillon_haddad_from_convex_hasFDerivAt_lipschitz`,
`open_zero_base_baillon_haddad_endpoint_from_support_upper_gradient`, and
`_voucher_step_2_zero_base_endpoint_energy`; the exact proved wrappers are
declared downstream of this before-mesh direct slot or use carrier/global
formulations, while the SOptLib hits provide only smooth-upper or Lipschitz
infrastructure rather than this open-chart endpoint. -/

private theorem before_mesh_zero_base_endpoint_energy_from_source_direct
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hBz : B z = 0)
    (u : H) (hu : u ∈ U) :
    ‖B u‖ ^ 2 ≤ 2 * L * (Φ u - Φ z) := by
  classical
  let Ψ : H → ℝ := fun y => Φ y - Φ z
  have hΨz : Ψ z = 0 := by
    simp [Ψ]
  have hnonnegΨ : ∀ x ∈ U, 0 ≤ Ψ x := by
    intro x hx
    have h := hsupport z hz x hx
    simpa [Ψ, hBz] using h
  have hsupportΨ : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Ψ y - Ψ x - ⟪B x, y - x⟫_ℝ := by
    intro x hx y hy
    simpa [Ψ] using hsupport x hx y hy
  have hupperΨ : ∀ x ∈ U, ∀ y ∈ U,
      Ψ y ≤ Ψ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2 := by
    intro x hx y hy
    have h := hupper x hx y hy
    change Φ y - Φ z ≤
      Φ x - Φ z + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2
    linarith
  have hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x := by
    intro x hx
    exact
      support_upper_hasFDerivAt_of_mem_interior
        Φ B U L hsupport hupper x (by
          simpa [hUopen.interior_eq] using hx)
  have hgradΨ : ∀ x ∈ U, HasFDerivAt Ψ (innerSL ℝ (B x)) x := by
    intro x hx
    simpa [Ψ] using (hgrad x hx).sub_const (Φ z)
  have hmain :
      ‖B u‖ ^ 2 ≤ 2 * L * Ψ u :=
    before_mesh_normalized_zero_base_endpoint_energy_from_source_direct
      Ψ B U L hL_pos hUopen hUconv hnonnegΨ hsupportΨ hupperΨ
      hgradΨ hBLip z hz hΨz hBz u hu
  simpa [Ψ] using hmain

/-- Direct endpoint-energy inequality on a source uniform mesh.

This aligns Lan Lemma 5.8's smoothness gap with the fixed uniform mesh used by
the before-mesh reflected perturbation proof. It uses the route-local zero-base
endpoint above and the already-proved forward mesh upper estimate
`uniform_forward_mesh_gap_upper_from_hasFDeriv_lipschitz`. -/
private theorem before_mesh_endpoint_energy_from_source_uniform_mesh_direct
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) (d : H) (x g : ℕ → H)
    (hx0_mem : x 0 ∈ U) (hxn_mem : x n ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hg0 : g 0 = 0)
    (hmesh :
      ∀ k, k ≤ n →
        x k = AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ)))
    (hclose : x 0 - x n = -d) :
    ‖g n‖ ^ 2 ≤
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
        L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
  classical
  have hdx : x n - x 0 = d := by
    have h := congrArg Neg.neg hclose
    simpa [neg_sub] using h
  have hBz : B (x 0) = 0 := by
    have h := hg0
    rw [hg 0] at h
    exact h
  have hsum :
      Finset.sum (Finset.range n)
          (fun k =>
            ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
              d⟫_ℝ) =
        Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ) := by
    apply Finset.sum_congr rfl
    intro k hk
    have hk_le : k ≤ n := Nat.le_of_lt (Finset.mem_range.mp hk)
    have hxk := hmesh k hk_le
    calc
      ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
          d⟫_ℝ
          = ⟪B (x k), d⟫_ℝ := by rw [← hxk]
      _ = ⟪g k, d⟫_ℝ := by rw [← hg k]
  have hgrad : ∀ y ∈ U, HasFDerivAt Φ (innerSL ℝ (B y)) y := by
    intro y hy
    exact
      support_upper_hasFDerivAt_of_mem_interior
        Φ B U L hsupport hupper y (by
          simpa [hUopen.interior_eq] using hy)
  have hBH : ‖B (x n)‖ ^ 2 ≤ 2 * L * (Φ (x n) - Φ (x 0)) :=
    before_mesh_zero_base_endpoint_energy_from_source_direct
      Φ B U L hL_pos hUopen hUconv hsupport hupper hBLip
      (x 0) hx0_mem hBz (x n) hxn_mem
  have hforward :
      Φ (x n) - Φ (x 0) ≤
        (1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                  x n - x 0⟫_ℝ) +
          L * ‖x n - x 0‖ ^ 2 / (2 * (n : ℝ)) :=
    uniform_forward_mesh_gap_upper_from_hasFDeriv_lipschitz
      Φ B U L hL_pos hUconv hgrad hBLip (x 0) hx0_mem (x n) hxn_mem hn_pos
  have htwoL_nonneg : 0 ≤ 2 * L := by nlinarith
  have hscaled :
      2 * L * (Φ (x n) - Φ (x 0)) ≤
        2 * L *
          ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                    x n - x 0⟫_ℝ) +
            L * ‖x n - x 0‖ ^ 2 / (2 * (n : ℝ))) :=
    mul_le_mul_of_nonneg_left hforward htwoL_nonneg
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have hendpoint :
      ‖B (x n)‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                    x n - x 0⟫_ℝ)) +
          L ^ 2 * ‖x n - x 0‖ ^ 2 / (n : ℝ) := by
    calc
      ‖B (x n)‖ ^ 2 ≤ 2 * L * (Φ (x n) - Φ (x 0)) := hBH
      _ ≤
          2 * L *
            ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n)
                  (fun k =>
                    ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                      x n - x 0⟫_ℝ) +
              L * ‖x n - x 0‖ ^ 2 / (2 * (n : ℝ))) := hscaled
      _ =
          2 * L *
              ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n)
                  (fun k =>
                    ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                      x n - x 0⟫_ℝ)) +
            L ^ 2 * ‖x n - x 0‖ ^ 2 / (n : ℝ) := by
        field_simp [hnR_ne]
  have hgn : g n = B (x n) := hg n
  rw [← hgn] at hendpoint
  simpa [hsum, hdx] using hendpoint

/-- Direct finite algebra from endpoint energy to reflected-work budget.

This is the declaration-order-safe endpoint-to-work step for Lan Lemma 5.8.
It specializes the proved Hilbert telescope
`reflected_work_nonneg_of_endpoint_energy_bound` and rewrites the residual
definition `r k`. -/
private theorem before_mesh_reflected_work_budget_from_endpoint_direct
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (L : ℝ) (d : H) (g r : ℕ → H)
    (hg0 : g 0 = 0)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hendpoint :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) :
    0 ≤
      2 * Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) +
        L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
  classical
  have hwork :=
    reflected_work_nonneg_of_endpoint_energy_bound d L hn_pos g hg0 hendpoint
  have hsum :
      Finset.sum (Finset.range n)
          (fun k => ⟪g k, r k⟫_ℝ) =
        Finset.sum (Finset.range n)
          (fun k => ⟪g k, (L / (n : ℝ)) • d - (g (k + 1) - g k)⟫_ℝ) := by
    apply Finset.sum_congr rfl
    intro k hk
    rw [hr k hk]
  simpa [hsum] using hwork

