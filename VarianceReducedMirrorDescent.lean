private theorem early_reflected_frozen_field_split_pred
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (L τ : ℝ) (F x r : ℕ → H) :
    let yPert : ℕ → H := fun k =>
      if hk : k < n then
        x k + τ • ((1 / L) • r k)
      else if hk' : k = n then
        x n
      else
        x 0 + τ • ((1 / L) • r 0)
    Finset.sum (Finset.range n)
        (fun k => ⟪F k, yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪F n, yPert (n + 1) - yPert n⟫_ℝ =
    (Finset.sum (Finset.range n)
        (fun k => ⟪F k, x (k + 1) - x k⟫_ℝ) +
      ⟪F n, x 0 - x n⟫_ℝ) +
    τ *
      ((1 / L) *
        (⟪F n - F 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪F k - F (k + 1), r (k + 1)⟫_ℝ))) := by
  classical
  let yPert : ℕ → H := fun k =>
    if hk : k < n then
      x k + τ • ((1 / L) • r k)
    else if hk' : k = n then
      x n
    else
      x 0 + τ • ((1 / L) • r 0)
  change
    Finset.sum (Finset.range n)
        (fun k => ⟪F k, yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪F n, yPert (n + 1) - yPert n⟫_ℝ =
    (Finset.sum (Finset.range n)
        (fun k => ⟪F k, x (k + 1) - x k⟫_ℝ) +
      ⟪F n, x 0 - x n⟫_ℝ) +
    τ *
      ((1 / L) *
        (⟪F n - F 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪F k - F (k + 1), r (k + 1)⟫_ℝ)))
  obtain ⟨hyPert_edge_lt, hyPert_edge_last, hyPert_closing_edge⟩ :=
    reflected_perturbed_cycle_edge_identities x r τ L hn_pos
  have hfrozen_split :
      Finset.sum (Finset.range n)
          (fun k => ⟪F k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪F n, yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k => ⟪F k, x (k + 1) - x k⟫_ℝ) +
        ⟪F n, x 0 - x n⟫_ℝ) +
      (Finset.sum (Finset.range n)
          (fun k =>
            if hlast : k + 1 = n then
              ⟪F k, -τ • ((1 / L) • r k)⟫_ℝ
            else
              ⟪F k,
                τ •
                  ((1 / L) • r (k + 1) - (1 / L) • r k)⟫_ℝ) +
        ⟪F n, τ • ((1 / L) • r 0)⟫_ℝ) := by
    have hsum :
        Finset.sum (Finset.range n)
            (fun k => ⟪F k, yPert (k + 1) - yPert k⟫_ℝ) =
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪F k, x (k + 1) - x k⟫_ℝ +
                (if hlast : k + 1 = n then
                  ⟪F k, -τ • ((1 / L) • r k)⟫_ℝ
                else
                  ⟪F k,
                    τ •
                      ((1 / L) • r (k + 1) - (1 / L) • r k)⟫_ℝ)) := by
      apply Finset.sum_congr rfl
      intro k hk
      by_cases hlast : k + 1 = n
      · rw [hyPert_edge_last k hk hlast]
        simp [inner_sub_right, hlast]
        ring
      · have hlt : k + 1 < n := by
          have hklt : k < n := Finset.mem_range.mp hk
          omega
        rw [hyPert_edge_lt k hlt]
        simp [inner_add_right, hlast]
    have hclose :
        ⟪F n, yPert (n + 1) - yPert n⟫_ℝ =
          ⟪F n, x 0 - x n⟫_ℝ +
            ⟪F n, τ • ((1 / L) • r 0)⟫_ℝ := by
      rw [hyPert_closing_edge]
      simp [inner_add_right]
    rw [hsum, hclose, Finset.sum_add_distrib]
    ring
  have hscaled :
      Finset.sum (Finset.range n)
          (fun k =>
            if hlast : k + 1 = n then
              ⟪F k, -τ • ((1 / L) • r k)⟫_ℝ
            else
              ⟪F k,
                τ •
                  ((1 / L) • r (k + 1) - (1 / L) • r k)⟫_ℝ) +
        ⟪F n, τ • ((1 / L) • r 0)⟫_ℝ =
      τ *
        (Finset.sum (Finset.range n)
            (fun k =>
              if hlast : k + 1 = n then
                -⟪F k, (1 / L) • r k⟫_ℝ
              else
                ⟪F k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) +
          ⟪F n, (1 / L) • r 0⟫_ℝ) := by
    have hsum_scale :
        Finset.sum (Finset.range n)
            (fun k =>
              if hlast : k + 1 = n then
                ⟪F k, -τ • ((1 / L) • r k)⟫_ℝ
              else
                ⟪F k,
                  τ •
                    ((1 / L) • r (k + 1) - (1 / L) • r k)⟫_ℝ) =
          τ *
            Finset.sum (Finset.range n)
              (fun k =>
                if hlast : k + 1 = n then
                  -⟪F k, (1 / L) • r k⟫_ℝ
                else
                  ⟪F k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      by_cases hlast : k + 1 = n
      · simp [hlast, inner_smul_right]
      · simp [hlast, inner_smul_right]
    rw [hsum_scale, inner_smul_right]
    ring
  rw [hfrozen_split, hscaled,
    early_reflected_scaled_bracket_sum_rewrite (H := H) hn_pos L F r]

/-- Early moving-to-frozen split for the perturbed quadratic-tilt cycle.

This aligns with Lan Lemma 5.8's stated smoothness-derived cycle form: before
the endpoint, `L • y_k - B y_k` is the frozen field plus the injected residual
and the freezing-error correction. Search audit: verified downstream
`tilt_moving_frozen_residual_split`; neither SOptLib nor Mathlib has this
paper-route moving/frozen decomposition. -/
private theorem early_tilt_moving_frozen_residual_split
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) {L τ : ℝ} (hL_pos : 0 < L)
    (B : H → H) (x g r : ℕ → H)
    (hg : ∀ k, g k = B (x k)) :
    let yPert : ℕ → H := fun k =>
      if hk : k < n then
        x k + τ • ((1 / L) • r k)
      else if hk' : k = n then
        x n
      else
        x 0 + τ • ((1 / L) • r 0)
    Finset.sum (Finset.range n)
        (fun k => ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
    (Finset.sum (Finset.range n)
        (fun k => ⟪L • x k - g k, yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪L • x n - g n, yPert (n + 1) - yPert n⟫_ℝ) +
    Finset.sum (Finset.range n)
      (fun k =>
        ⟪τ • r k - (B (yPert k) - g k), yPert (k + 1) - yPert k⟫_ℝ) := by
  classical
  let yPert : ℕ → H := fun k =>
    if hk : k < n then
      x k + τ • ((1 / L) • r k)
    else if hk' : k = n then
      x n
    else
      x 0 + τ • ((1 / L) • r 0)
  change
    Finset.sum (Finset.range n)
        (fun k => ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
    (Finset.sum (Finset.range n)
        (fun k => ⟪L • x k - g k, yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪L • x n - g n, yPert (n + 1) - yPert n⟫_ℝ) +
    Finset.sum (Finset.range n)
      (fun k =>
        ⟪τ • r k - (B (yPert k) - g k), yPert (k + 1) - yPert k⟫_ℝ)
  have hsum :
      Finset.sum (Finset.range n)
          (fun k => ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) =
        Finset.sum (Finset.range n)
          (fun k =>
            ⟪L • x k - g k, yPert (k + 1) - yPert k⟫_ℝ +
              ⟪τ • r k - (B (yPert k) - g k), yPert (k + 1) - yPert k⟫_ℝ) := by
    apply Finset.sum_congr rfl
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    have hyk : yPert k = x k + τ • ((1 / L) • r k) := by
      simp [yPert, hklt]
    have hscale : L • (τ • ((1 / L) • r k)) = τ • r k := by
      rw [smul_smul, smul_smul]
      congr 1
      field_simp [ne_of_gt hL_pos]
    have hfield :
        L • yPert k - B (yPert k) =
          (L • x k - g k) + (τ • r k - (B (yPert k) - g k)) := by
      rw [hyk, smul_add, hscale, hg k]
      abel
    rw [hfield, inner_add_left]
  have hclose :
      L • yPert n - B (yPert n) = L • x n - g n := by
    have hn_not_lt : ¬ n < n := by omega
    have hyn : yPert n = x n := by
      simp [yPert, hn_not_lt]
    rw [hyn, hg n]
  rw [hsum, hclose, Finset.sum_add_distrib]
  ring

/-- Early moving-to-frozen split for the perturbed `B` cycle.

This is the declaration-order-safe companion to
`early_tilt_moving_frozen_residual_split`, matching Lan Lemma 5.8's reflected
cycle with the moving selected-gradient field frozen at the mesh. Search audit:
verified downstream `reflected_moving_B_frozen_error_split`; available SOptLib
and Mathlib candidates do not state this endpoint-aware correction split. -/
private theorem early_reflected_moving_B_frozen_error_split
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) {L τ : ℝ}
    (B : H → H) (x g r : ℕ → H)
    (hg : ∀ k, g k = B (x k)) :
    let yPert : ℕ → H := fun k =>
      if hk : k < n then
        x k + τ • ((1 / L) • r k)
      else if hk' : k = n then
        x n
      else
        x 0 + τ • ((1 / L) • r 0)
    Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
    (Finset.sum (Finset.range n)
        (fun k => ⟪g k, yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪g n, yPert (n + 1) - yPert n⟫_ℝ) +
    Finset.sum (Finset.range n)
      (fun k =>
        ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) := by
  classical
  let yPert : ℕ → H := fun k =>
    if hk : k < n then
      x k + τ • ((1 / L) • r k)
    else if hk' : k = n then
      x n
    else
      x 0 + τ • ((1 / L) • r 0)
  change
    Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
    (Finset.sum (Finset.range n)
        (fun k => ⟪g k, yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪g n, yPert (n + 1) - yPert n⟫_ℝ) +
    Finset.sum (Finset.range n)
      (fun k =>
        ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ)
  have hsum :
      Finset.sum (Finset.range n)
          (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) =
        Finset.sum (Finset.range n)
          (fun k =>
            ⟪g k, yPert (k + 1) - yPert k⟫_ℝ +
              ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) := by
    apply Finset.sum_congr rfl
    intro k hk
    have hfield : g k + (B (yPert k) - g k) = B (yPert k) := by
      abel
    calc
      ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ =
          ⟪g k + (B (yPert k) - g k), yPert (k + 1) - yPert k⟫_ℝ := by
            rw [hfield]
      _ =
          ⟪g k, yPert (k + 1) - yPert k⟫_ℝ +
            ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ := by
            rw [inner_add_left]
  have hclose :
      B (yPert n) = g n := by
    have hn_not_lt : ¬ n < n := by omega
    have hyn : yPert n = x n := by
      simp [yPert, hn_not_lt]
    rw [hyn, hg n]
  rw [hsum, hclose, Finset.sum_add_distrib]
  ring

/-- Canonical reflected perturbation cycle used in Lan Lemma 5.8's
boundary-safe finite-cycle argument.

This is private proof scaffold, not a paper-facing primitive: it names the
same totalized finite cycle repeatedly built in the reflected-cycle proof so
helper statements cannot quantify over arbitrary noncanonical perturbation
polygons. -/
private noncomputable def reflectedPerturbedCycle
    {H : Type*} [Add H] [SMul ℝ H]
    (L τ : ℝ) (n : ℕ) (x r : ℕ → H) : ℕ → H := fun k =>
  if hk : k < n then
    x k + τ • ((1 / L) • r k)
  else if hk' : k = n then
    x n
  else
    x 0 + τ • ((1 / L) • r 0)

/-- Voucher step: split a range-`n+1` cyclic work inequality into the
range-`n` body plus the closing edge. -/
private theorem _voucher_step_3b_range_succ_nonpos
    {n : ℕ} (a : ℕ → ℝ)
    (hcycle : Finset.sum (Finset.range (n + 1)) a ≤ 0) :
    Finset.sum (Finset.range n) a + a n ≤ 0 := by
  rw [Finset.sum_range_succ] at hcycle
  simpa [add_comm, add_left_comm, add_assoc] using hcycle

/-- Voucher step: source support and smooth-upper support give the two split
cyclic work inequalities on the canonical reflected perturbation cycle. -/
private theorem _voucher_step_3a_cyclic_support_applications
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L τ : ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    {n : ℕ} (x r : ℕ → H)
    (hyPert_mem :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hyPert_cycle :
      reflectedPerturbedCycle L τ n x r (n + 1) =
        reflectedPerturbedCycle L τ n x r 0) :
    let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r;
    (Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0) ∧
    (Finset.sum (Finset.range n)
        (fun k =>
          ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0) := by
  classical
  let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
  change
    (Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0) ∧
    (Finset.sum (Finset.range n)
        (fun k =>
          ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0)
  have hy_mem : ∀ k, k ≤ n + 1 → yPert k ∈ U := by
    intro k hk
    simpa [yPert] using hyPert_mem k hk
  have hy_cycle : yPert (n + 1) = yPert 0 := by
    simpa [yPert] using hyPert_cycle
  have htilt :
      ∀ a ∈ U, ∀ b ∈ U,
        0 ≤
          ((L / 2) * ‖b‖ ^ 2 - Φ b) -
            ((L / 2) * ‖a‖ ^ 2 - Φ a) -
            ⟪L • a - B a, b - a⟫_ℝ :=
    open_quadratic_tilt_support_from_smooth_upper Φ B U L hupper
  constructor
  · have hcycle :=
      cyclic_monotone_sum_of_support_on_cycle Φ B U hsupport
        (n + 1) yPert hy_mem hy_cycle
    exact _voucher_step_3b_range_succ_nonpos
      (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) hcycle
  · have hcycle :=
      cyclic_monotone_sum_of_support_on_cycle
        (fun w : H => (L / 2) * ‖w‖ ^ 2 - Φ w)
        (fun w : H => L • w - B w) U htilt
        (n + 1) yPert hy_mem hy_cycle
    exact _voucher_step_3b_range_succ_nonpos
      (fun k =>
        ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) hcycle

/-- Voucher step: the reflected split identities used by the source-preserving
first-order assembly expose the concrete combined finite-sum inequality.

This is the typed algebraic replacement for the former `True` voucher.  It
does not assert the final first-order lower bound by itself: it records exactly
what the two source cyclic inequalities become after the moving/frozen
reflected-cycle splits.  The subsequent source bridge must still use the
Lipschitz freezing budget and positive perturbation scale to extract the
epsilon lower bound. -/
private theorem _voucher_step_3c_reflected_split_identities
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) {L τ : ℝ} (hL_pos : 0 < L)
    (B : H → H) (x g r : ℕ → H)
    (hg : ∀ k, g k = B (x k))
    (hcycle_B :
      let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
      Finset.sum (Finset.range n)
          (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0)
    (hcycle_tilt :
      let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
      Finset.sum (Finset.range n)
          (fun k =>
            ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0) :
    let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
    let baseB : ℝ :=
      Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ
    let predB : ℝ :=
      τ *
        ((1 / L) *
          (⟪g n - g 0, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
    let errorWork : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ)
    let baseTilt : ℝ :=
      Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ
    let predTilt : ℝ :=
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ)))
    let residualWork : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ)
    baseB + predB + baseTilt + predTilt + residualWork ≤ 0 := by
  classical
  let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
  change
    let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
    let baseB : ℝ :=
      Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ
    let predB : ℝ :=
      τ *
        ((1 / L) *
          (⟪g n - g 0, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
    let errorWork : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ)
    let baseTilt : ℝ :=
      Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ
    let predTilt : ℝ :=
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ)))
    let residualWork : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ)
    baseB + predB + baseTilt + predTilt + residualWork ≤ 0
  have hB_frozen :
      Finset.sum (Finset.range n)
          (fun k => ⟪g k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪g n, yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪g n - g 0, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ))) := by
    simpa [yPert, reflectedPerturbedCycle] using
      (early_reflected_frozen_field_split_pred (H := H)
        hn_pos L τ g x r)
  have hB_moving :
      Finset.sum (Finset.range n)
          (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k => ⟪g k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪g n, yPert (n + 1) - yPert n⟫_ℝ) +
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) := by
    simpa [yPert, reflectedPerturbedCycle] using
      (early_reflected_moving_B_frozen_error_split (H := H)
        hn_pos B x g r hg)
  have hB_pred_error_nonpos :
      ((Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪g n - g 0, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))) +
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
    have h :
        Finset.sum (Finset.range n)
            (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
          ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0 := by
      simpa [yPert] using hcycle_B
    rw [hB_moving, hB_frozen] at h
    simpa [yPert, add_assoc] using h
  have htilt_frozen :
      Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪L • x n - g n, yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ))) := by
    simpa [yPert, reflectedPerturbedCycle] using
      (early_reflected_frozen_field_split_pred (H := H)
        hn_pos L τ (fun k => L • x k - g k) x r)
  have htilt_moving :
      Finset.sum (Finset.range n)
          (fun k =>
            ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k =>
            ⟪L • x k - g k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪L • x n - g n, yPert (n + 1) - yPert n⟫_ℝ) +
      Finset.sum (Finset.range n)
        (fun k =>
          ⟪τ • r k - (B (yPert k) - g k),
            yPert (k + 1) - yPert k⟫_ℝ) := by
    simpa [yPert, reflectedPerturbedCycle] using
      (early_tilt_moving_frozen_residual_split (H := H)
        hn_pos hL_pos B x g r hg)
  have htilt_pred_residual_nonpos :
      ((Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ)))) +
      Finset.sum (Finset.range n)
        (fun k =>
          ⟪τ • r k - (B (yPert k) - g k),
            yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
    have h :
        Finset.sum (Finset.range n)
            (fun k =>
              ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
          ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0 := by
      simpa [yPert] using hcycle_tilt
    rw [htilt_moving, htilt_frozen] at h
    simpa [yPert, add_assoc] using h
  have htilt_pred_error_nonpos :
      ((Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ)))) +
      Finset.sum (Finset.range n)
        (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ) -
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
    have hres :
        Finset.sum (Finset.range n)
          (fun k =>
            ⟪τ • r k - (B (yPert k) - g k),
              yPert (k + 1) - yPert k⟫_ℝ) =
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ) -
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) := by
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      simp [inner_sub_left]
    have h := htilt_pred_residual_nonpos
    rw [hres] at h
    simpa [sub_eq_add_neg, add_assoc] using h
  let baseB : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
      ⟪g n, x 0 - x n⟫_ℝ
  let predB : ℝ :=
    τ *
      ((1 / L) *
        (⟪g n - g 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
  let errorWork : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ)
  let baseTilt : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
      ⟪L • x n - g n, x 0 - x n⟫_ℝ
  let predTilt : ℝ :=
    τ *
      ((1 / L) *
        (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                r (k + 1)⟫_ℝ)))
  let residualWork : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ)
  have hB_abbrev : (baseB + predB) + errorWork ≤ 0 := by
    simpa [baseB, predB, errorWork] using hB_pred_error_nonpos
  have htilt_abbrev :
      (baseTilt + predTilt) + residualWork - errorWork ≤ 0 := by
    simpa [baseTilt, predTilt, residualWork, errorWork] using
      htilt_pred_error_nonpos
  have hcombined : baseB + predB + baseTilt + predTilt + residualWork ≤ 0 := by
    linarith
  simpa [yPert, baseB, predB, errorWork, baseTilt, predTilt, residualWork]
    using hcombined

/-- Expose the two reflected-cycle split inequalities separately.

This is the source-preserving form needed before extracting the first
variation: `_voucher_step_3c_reflected_split_identities` combines these two
inequalities and cancels the freezing error, while the endpoint proof route
must retain the two signs separately. Search audit: checked the pre-searched
cycle/prox/probability candidates and the local combined split helper; none
exports these two intermediate inequalities, so this helper packages the
already-proved moving/frozen split algebra in the needed form. -/
private theorem before_endpoint_reflected_split_two_inequalities
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) {L τ : ℝ} (hL_pos : 0 < L)
    (B : H → H) (x g r : ℕ → H)
    (hg : ∀ k, g k = B (x k))
    (hcycle_B :
      let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
      Finset.sum (Finset.range n)
          (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0)
    (hcycle_tilt :
      let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
      Finset.sum (Finset.range n)
          (fun k =>
            ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0) :
    let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
    let baseB : ℝ :=
      Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ
    let predB : ℝ :=
      τ *
        ((1 / L) *
          (⟪g n - g 0, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
    let errorWork : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ)
    let baseTilt : ℝ :=
      Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ
    let predTilt : ℝ :=
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ)))
    let residualWork : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ)
    ((baseB + predB) + errorWork ≤ 0) ∧
      ((baseTilt + predTilt) + residualWork - errorWork ≤ 0) := by
  classical
  let yPert : ℕ → H := reflectedPerturbedCycle L τ n x r
  have hB_frozen :
      Finset.sum (Finset.range n)
          (fun k => ⟪g k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪g n, yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪g n - g 0, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ))) := by
    simpa [yPert, reflectedPerturbedCycle] using
      (early_reflected_frozen_field_split_pred (H := H)
        hn_pos L τ g x r)
  have hB_moving :
      Finset.sum (Finset.range n)
          (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k => ⟪g k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪g n, yPert (n + 1) - yPert n⟫_ℝ) +
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) := by
    simpa [yPert, reflectedPerturbedCycle] using
      (early_reflected_moving_B_frozen_error_split (H := H)
        hn_pos B x g r hg)
  have hB_pred_error_nonpos :
      ((Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪g n - g 0, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))) +
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
    have h :
        Finset.sum (Finset.range n)
            (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
          ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0 := by
      simpa [yPert] using hcycle_B
    rw [hB_moving, hB_frozen] at h
    simpa [yPert, add_assoc] using h
  have htilt_frozen :
      Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪L • x n - g n, yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ))) := by
    simpa [yPert, reflectedPerturbedCycle] using
      (early_reflected_frozen_field_split_pred (H := H)
        hn_pos L τ (fun k => L • x k - g k) x r)
  have htilt_moving :
      Finset.sum (Finset.range n)
          (fun k =>
            ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k =>
            ⟪L • x k - g k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪L • x n - g n, yPert (n + 1) - yPert n⟫_ℝ) +
      Finset.sum (Finset.range n)
        (fun k =>
          ⟪τ • r k - (B (yPert k) - g k),
            yPert (k + 1) - yPert k⟫_ℝ) := by
    simpa [yPert, reflectedPerturbedCycle] using
      (early_tilt_moving_frozen_residual_split (H := H)
        hn_pos hL_pos B x g r hg)
  have htilt_pred_residual_nonpos :
      ((Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ)))) +
      Finset.sum (Finset.range n)
        (fun k =>
          ⟪τ • r k - (B (yPert k) - g k),
            yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
    have h :
        Finset.sum (Finset.range n)
            (fun k =>
              ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
          ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0 := by
      simpa [yPert] using hcycle_tilt
    rw [htilt_moving, htilt_frozen] at h
    simpa [yPert, add_assoc] using h
  have htilt_pred_error_nonpos :
      ((Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ) +
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ)))) +
      Finset.sum (Finset.range n)
        (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ) -
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
    have hres :
        Finset.sum (Finset.range n)
          (fun k =>
            ⟪τ • r k - (B (yPert k) - g k),
              yPert (k + 1) - yPert k⟫_ℝ) =
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ) -
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) := by
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      simp [inner_sub_left]
    have h := htilt_pred_residual_nonpos
    rw [hres] at h
    simpa [sub_eq_add_neg, add_assoc] using h
  let baseB : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
      ⟪g n, x 0 - x n⟫_ℝ
  let predB : ℝ :=
    τ *
      ((1 / L) *
        (⟪g n - g 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
  let errorWork : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ)
  let baseTilt : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
      ⟪L • x n - g n, x 0 - x n⟫_ℝ
  let predTilt : ℝ :=
    τ *
      ((1 / L) *
        (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                r (k + 1)⟫_ℝ)))
  let residualWork : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ)
  have hB_abbrev : (baseB + predB) + errorWork ≤ 0 := by
    simpa [baseB, predB, errorWork] using hB_pred_error_nonpos
  have htilt_abbrev :
      (baseTilt + predTilt) + residualWork - errorWork ≤ 0 := by
    simpa [baseTilt, predTilt, residualWork, errorWork] using
      htilt_pred_error_nonpos
  exact ⟨hB_abbrev, htilt_abbrev⟩

/-- Average two signed error estimates without losing the common budget.

This is the scalar order step used when the positive and negative reflected
freezing errors are both controlled by the same Lipschitz budget. Search audit:
searched `two real inequalities average less equal same bound`; SOptLib hits were
unrelated complexity/Bregman estimates and Mathlib supplies only the primitive
linear-arithmetic facts, not this route-local averaging wrapper. -/
private theorem two_sign_error_average_le_lipschitz_budget
    {Epos Eneg R : ℝ} (hpos : Epos ≤ R) (hneg : Eneg ≤ R) :
    (Epos + Eneg) / 2 ≤ R := by
  nlinarith

/-- Absorb a nonnegative averaged freezing error into nonnegative reflected work.

This is the pure real-order closure for the two-sign reflected-cycle route:
once the finite reflected-work term is nonnegative, the averaged norm error
can only make the left side smaller. Search audit: checked
`scaled_error_absorbed_by_nonnegative_reflected_work`,
`two_sign_error_average_le_lipschitz_budget`, and SOptLib order/telescope
hits; existing helpers either carry the concrete finite norm sum or bound the
Lipschitz budget, while this local scalar average form is not packaged. -/
private theorem average_error_nonneg_absorption
    {τ Eavg S : ℝ} (hτ_nonneg : 0 ≤ τ)
    (hEavg_nonneg : 0 ≤ Eavg) (hS_nonneg : 0 ≤ S) :
    -(τ * Eavg) ≤ τ * S := by
  have hleft : -(τ * Eavg) ≤ 0 := by
    have hm : 0 ≤ τ * Eavg := mul_nonneg hτ_nonneg hEavg_nonneg
    exact neg_nonpos.mpr hm
  have hright : 0 ≤ τ * S := mul_nonneg hτ_nonneg hS_nonneg
  exact le_trans hleft hright

/-- Scale an unscaled first-variation lower bound by a nonnegative perturbation.

This is the scalar order normalization used in the two-sign reflected-cycle
route: once the finite component algebra proves `-Eavg ≤ S`, multiplying by
the nonnegative perturbation scale gives the exact scaled form consumed by the
outer epsilon argument. Search audit: checked `mul_le_mul_of_nonneg_left` and
SOptLib order/telescope hits; Mathlib's primitive scalar multiplication lemma
is the matching reusable API, while no SOptLib wrapper packages this route-local
normalization. -/
private theorem scale_nonnegative_perturbation_first_variation
    {τ Eavg S : ℝ} (hτ_nonneg : 0 ≤ τ) (hfirst : -Eavg ≤ S) :
    -(τ * Eavg) ≤ τ * S := by
  have hscaled := mul_le_mul_of_nonneg_left hfirst hτ_nonneg
  nlinarith

/-- Cancel a positive perturbation scale from the reflected Q-absorption form.

This is the pure ordered-field tail of Lan Lemma 5.8's scaled reflected-mesh
absorption. Search audit: checked Mathlib `mul_le_mul_iff_of_pos_left` and
the target-file `scale_nonnegative_perturbation_first_variation`; the latter
scales an already-unscaled first-variation inequality, while this helper
cancels the positive scale in the direction needed by the Q-form leaf. -/
private theorem positive_tau_cancel_scaled_q_absorption
    {τ Eavg S : ℝ} (hτ_pos : 0 < τ)
    (hscaled : -(τ * Eavg) ≤ τ * S) :
    -Eavg ≤ S := by
  have hscaled' : τ * (-Eavg) ≤ τ * S := by
    simpa only [mul_neg] using hscaled
  exact (mul_le_mul_iff_of_pos_left hτ_pos).mp hscaled'

/-- Positive-scale reflected absorption in scaled form is equivalent to the
unscaled Q-form tail used downstream. -/
private theorem q_form_absorption_of_scaled_q_absorption
    {τ Eavg S : ℝ} (hτ_pos : 0 < τ)
    (hscaled : -(τ * Eavg) ≤ τ * S) :
    0 ≤ S + Eavg := by
  have hfirst : -Eavg ≤ S :=
    positive_tau_cancel_scaled_q_absorption hτ_pos hscaled
  linarith

/-- Negating the reflected residual negates the predecessor first-variation term.

This is the small signed-normalization step needed before averaging the two
reflected cycles in Lan Lemma 5.8. Search audit: checked the local reflected
summation-by-parts helpers `early_reflected_if_last_inner_sum_eq_boundary_pred`
and `early_reflected_scaled_bracket_sum_rewrite`; those identify the predecessor
sum, while this helper packages only the `r ↦ -r` linearity needed for split
cancellation. -/
private theorem reflected_pred_neg_terms_normalize
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (L τ : ℝ) {n : ℕ} (F r : ℕ → H) :
    τ *
        ((1 / L) *
          (⟪F n - F 0, (fun k => -r k) 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪F k - F (k + 1), (fun j => -r j) (k + 1)⟫_ℝ))) =
      - (τ *
        ((1 / L) *
          (⟪F n - F 0, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪F k - F (k + 1), r (k + 1)⟫_ℝ)))) := by
  classical
  simp only [Pi.neg_apply, inner_neg_right]
  rw [Finset.sum_neg_distrib]
  ring

/-- The averaged two-sign freezing-error norm budget is nonnegative.

This is the norm-budget side of the cross-sign reflected-cycle algebra in Lan
Lemma 5.8. Search audit: checked `Finset.sum_nonneg`, `norm_nonneg`, and local
two-sign averaging helpers; Mathlib supplies the primitive nonnegativity facts
but no route-local wrapper for the exact averaged error expression. -/
private theorem reflected_two_sign_error_average_nonneg
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    {n : ℕ} {L τ : ℝ} (B : H → H) (x g r : ℕ → H) :
    0 ≤
      (Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
        Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖)) /
        2 := by
  have hpos :
      0 ≤ Finset.sum (Finset.range n)
        (fun k =>
          ‖(1 / L) •
            (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) := by
    exact Finset.sum_nonneg (by intro k hk; exact norm_nonneg _)
  have hneg :
      0 ≤ Finset.sum (Finset.range n)
        (fun k =>
          ‖(1 / L) •
            (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖) := by
    exact Finset.sum_nonneg (by intro k hk; exact norm_nonneg _)
  nlinarith

/-- Pointwise two-sign freezing-error work is bounded below by the scaled
error norms in the same normalization used by `Eavg`.

This is the atom for the T2 freezing-error route in Lan Lemma 5.8: after the
positive and negative reflected edge displays expose terms with
