      intro k
      rfl
    have hr : ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k) := by
      intro k hk
      rfl
    have hy_eq_range :
        ∀ k ∈ Finset.range n,
          yPert k = x k + perturbScale • ((1 / L) • r k) := by
      intro k hk
      have hklt : k < n := Finset.mem_range.mp hk
