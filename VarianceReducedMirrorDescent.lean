wrappers are declared downstream of the current mesh voucher. -/

private theorem early_zero_base_endpoint_energy_from_support_upper_lipschitz_before_mesh
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hBz : B z = 0)
    (u : H) (hu : u ∈ U) :
    ‖B u‖ ^ 2 ≤ 2 * L * (Φ u - Φ z) := by
