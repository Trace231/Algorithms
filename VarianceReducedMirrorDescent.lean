private theorem mesh_endpoint_algebra_from_reflected_work_before_endpoint
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (d : H) (L : ℝ) {n : ℕ} (hn_pos : 0 < n) (g : ℕ → H)
    (hg0 : g 0 = 0)
    (hreflected :
      0 ≤
        2 *
            Finset.sum (Finset.range n)
              (fun k => ⟪g k, (L / (n : ℝ)) • d - (g (k + 1) - g k)⟫_ℝ) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) :
    ‖g n‖ ^ 2 ≤
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
        Finset.sum (Finset.range n) (fun k => ‖g (k + 1) - g k‖ ^ 2) +
        L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
  classical
  let A : ℝ := Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)
  let Bsum : ℝ := Finset.sum (Finset.range n) (fun k => ⟪g k, g (k + 1) - g k⟫_ℝ)
  let S : ℝ := Finset.sum (Finset.range n) (fun k => ‖g (k + 1) - g k‖ ^ 2)
  let E : ℝ := L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)
  have htel_neg :
      Finset.sum (Finset.range n)
          (fun k => ‖g k‖ ^ 2 - ‖g (k + 1)‖ ^ 2) =
        ‖g 0‖ ^ 2 - ‖g n‖ ^ 2 := by
    simpa using (Finset.sum_range_sub' (fun k : ℕ => ‖g k‖ ^ 2) n)
  have htel :
      Finset.sum (Finset.range n)
          (fun k => ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2) =
        ‖g n‖ ^ 2 := by
    have hneg :
        Finset.sum (Finset.range n)
            (fun k => ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2) =
          -Finset.sum (Finset.range n)
            (fun k => ‖g k‖ ^ 2 - ‖g (k + 1)‖ ^ 2) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    rw [hneg, htel_neg, hg0]
    simp
  have hstep :
      ∀ k ∈ Finset.range n,
        ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2 =
          2 * ⟪g k, g (k + 1) - g k⟫_ℝ + ‖g (k + 1) - g k‖ ^ 2 := by
    intro k hk
    let δ : H := g (k + 1) - g k
    have hdecomp : g (k + 1) = g k + δ := by
      dsimp [δ]
      abel
    rw [hdecomp]
    have hsub : g k + δ - g k = δ := by
      abel
    rw [hsub]
    rw [← real_inner_self_eq_norm_sq (g k + δ)]
    rw [← real_inner_self_eq_norm_sq (g k)]
    rw [← real_inner_self_eq_norm_sq δ]
    simp only [inner_add_left, inner_add_right]
    rw [real_inner_comm δ (g k)]
    ring_nf
  have henergy :
      ‖g n‖ ^ 2 = 2 * Bsum + S := by
    rw [← htel]
    calc
      Finset.sum (Finset.range n)
          (fun k => ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2)
          = Finset.sum (Finset.range n)
              (fun k =>
                2 * ⟪g k, g (k + 1) - g k⟫_ℝ +
                  ‖g (k + 1) - g k‖ ^ 2) := by
            apply Finset.sum_congr rfl
            intro k hk
            exact hstep k hk
      _ = 2 * Bsum + S := by
            rw [Finset.sum_add_distrib]
            dsimp [Bsum, S]
            rw [← Finset.mul_sum]
  have hreflected' : 0 ≤ 2 * ((L / (n : ℝ)) * A - Bsum) + E := by
    simpa [A, Bsum, E, Finset.sum_sub_distrib, Finset.mul_sum, inner_sub_right,
      inner_smul_right] using hreflected
  have hB :
      2 * Bsum ≤ 2 * L * ((1 / (n : ℝ)) * A) + E := by
    have hscale : (L / (n : ℝ)) * A = L * ((1 / (n : ℝ)) * A) := by
      ring
    rw [hscale] at hreflected'
    nlinarith [hreflected']
  calc
    ‖g n‖ ^ 2 = 2 * Bsum + S := henergy
    _ ≤ (2 * L * ((1 / (n : ℝ)) * A) + E) + S := by
      simpa [add_comm, add_left_comm, add_assoc] using add_le_add_right hB S
    _ = 2 * L * ((1 / (n : ℝ)) * A) + S + E := by ring
    _ =
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          Finset.sum (Finset.range n) (fun k => ‖g (k + 1) - g k‖ ^ 2) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
        simp [A, S, E]

/-- Absorb a nonnegative reflected-work budget against the scaled freezing error.

This is the order-theoretic part actually needed in the reflected-cycle route:
the endpoint-energy bridge supplies nonnegativity of the reflected work, while
the Lipschitz estimate supplies the separate error budget. -/
private theorem scaled_error_absorbed_by_nonnegative_reflected_work
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) {n : ℕ} {L τ : ℝ}
    (hτ_nonneg : 0 ≤ τ) (d : H) (g r y : ℕ → H)
    (hwork_nonneg :
      0 ≤
        2 * Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) :
    -(τ *
        Finset.sum (Finset.range n)
          (fun k => ‖(1 / L) • (B (y k) - g k)‖)) ≤
      τ *
        (2 * Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) := by
  classical
  have herror_nonneg :
      0 ≤ Finset.sum (Finset.range n)
        (fun k => ‖(1 / L) • (B (y k) - g k)‖) := by
    exact Finset.sum_nonneg (by
      intro k hk
      exact norm_nonneg _)
  have hleft :
      -(τ *
          Finset.sum (Finset.range n)
            (fun k => ‖(1 / L) • (B (y k) - g k)‖)) ≤ 0 := by
    have hm :
        0 ≤ τ *
          Finset.sum (Finset.range n)
            (fun k => ‖(1 / L) • (B (y k) - g k)‖) :=
      mul_nonneg hτ_nonneg herror_nonneg
    linarith
  have hright :
      0 ≤ τ *
        (2 * Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) :=
    mul_nonneg hτ_nonneg hwork_nonneg
  exact le_trans hleft hright

