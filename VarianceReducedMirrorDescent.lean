              ⟪perturbScale • r k, yPert (k + 1) - yPert k⟫_ℝ) -
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
