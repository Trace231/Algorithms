    {n : ℕ} (hn_pos : 0 < n)
    (hmesh_step : ‖((1 / (n : ℝ)) • (u - v))‖ < ρ) :
    0 ≤
      2 *
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))),
                (L / (n : ℝ)) • (u - v) -
                  (C (AffineMap.lineMap v u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                    C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))))⟫_ℝ) +
        L ^ 2 * ‖u - v‖ ^ 2 / (n : ℝ) := by
  classical
  let d : H := u - v
  let x : ℕ → H := fun k => AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))
  let g : ℕ → H := fun k => C (x k)
  have hg0 : g 0 = 0 := by
    simp [g, x, hCv]
  have hforward :
      Ψ u - Ψ v ≤
        (1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k => ⟪g k, d⟫_ℝ) +
          L * ‖d‖ ^ 2 / (2 * (n : ℝ)) := by
    simpa [g, x, d] using
      uniform_forward_mesh_gap_upper_from_hasFDeriv_lipschitz
        Ψ C U L hL_pos hUconv hgradΨ hCLip v hv u hu hn_pos
  have hforward_zero :
      Ψ u ≤
        (1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k => ⟪g k, d⟫_ℝ) +
          L * ‖d‖ ^ 2 / (2 * (n : ℝ)) := by
    simpa [hΨv] using hforward
  have hendpoint0 :
      ‖C u‖ ^ 2 ≤ 2 * L * Ψ u :=
    _voucher_step_2a_zero_base_endpoint_energy_before_reflected_core
      Ψ C U L hL_pos hUopen hUconv hnonnegΨ hsupport hupper hgradΨ hCLip
      v hv hΨv hCv u hu
  have hendpoint :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    have hxn : x n = u := by
      have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
      have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
      simp [x, div_self hnR_ne]
    have hgn : g n = C u := by
      simp [g, hxn]
    have htwoL_nonneg : 0 ≤ 2 * L := by nlinarith
    have hscaled :
        2 * L * Ψ u ≤
          2 * L *
            ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ) +
              L * ‖d‖ ^ 2 / (2 * (n : ℝ))) :=
      mul_le_mul_of_nonneg_left hforward_zero htwoL_nonneg
    have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
    have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
    calc
      ‖g n‖ ^ 2 = ‖C u‖ ^ 2 := by rw [hgn]
      _ ≤ 2 * L * Ψ u := hendpoint0
      _ ≤
          2 * L *
            ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ) +
              L * ‖d‖ ^ 2 / (2 * (n : ℝ))) := hscaled
      _ =
          2 * L *
              ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
            L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
          field_simp [hnR_ne]
  have hwork :=
    reflected_work_nonneg_of_endpoint_energy_bound d L hn_pos g hg0 hendpoint
  simpa [d, x, g] using hwork

/-- Voucher step: the reflected finite-mesh work is nonnegative from the typed
shifted-potential data.

This is the only remaining analytic FILL leaf after the false cycle-only
scaffold was removed: support and smooth upper models are derived from
`ConvexOn` plus `HasFDerivAt`/Lipschitz data, then inserted into the finite
reflected-cycle perturbation argument. -/
private theorem _voucher_step_2a_reflected_work_nonneg_from_typed_mesh_data
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Ψ : H → ℝ) (C : H → H) (U : Set H) (L ρ : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hnonnegΨ : ∀ x ∈ U, 0 ≤ Ψ x)
    (hconvΨ : ConvexOn ℝ U Ψ)
    (hgradΨ : ∀ x ∈ U, HasFDerivAt Ψ (innerSL ℝ (C x)) x)
    (hCLip : ∀ x ∈ U, ∀ y ∈ U, ‖C x - C y‖ ≤ L * ‖x - y‖)
    (v : H) (hv : v ∈ U) (hΨv : Ψ v = 0) (hCv : C v = 0)
    (u : H) (hu : u ∈ U)
    (htube : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      Metric.ball (AffineMap.lineMap v u t) ρ ⊆ U)
    (hlocal_pair :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖(t - s) • (u - v)‖ < ρ →
          ‖C (AffineMap.lineMap v u t) - C (AffineMap.lineMap v u s)‖ ^ 2 ≤
            2 * L *
              (Ψ (AffineMap.lineMap v u t) - Ψ (AffineMap.lineMap v u s) -
                ⟪C (AffineMap.lineMap v u s), (t - s) • (u - v)⟫_ℝ))
    {n : ℕ} (hn_pos : 0 < n)
    (hmesh_step : ‖((1 / (n : ℝ)) • (u - v))‖ < ρ) :
    0 ≤
      2 *
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))),
                (L / (n : ℝ)) • (u - v) -
                  (C (AffineMap.lineMap v u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                    C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))))⟫_ℝ) +
        L ^ 2 * ‖u - v‖ ^ 2 / (n : ℝ) := by
  classical
  have hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ :=
    _voucher_step_2a_support_from_typed_convex_gradient_data
      Ψ C U hUconv hconvΨ hgradΨ
  have hupper : ∀ x ∈ U, ∀ y ∈ U,
      Ψ y ≤ Ψ x + ⟪C x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2 :=
    _voucher_step_2a_smooth_upper_from_typed_gradient_lipschitz
      Ψ C U L hUconv hgradΨ hCLip
  exact
    _voucher_step_2a_reflected_work_nonneg_from_support_upper_core
      Ψ C U L ρ hL_pos hUopen hUconv hnonnegΨ hsupport hupper
      hgradΨ hCLip v hv hΨv hCv u hu htube hlocal_pair hn_pos hmesh_step

/-- Voucher step: reflected-work nonnegativity implies the endpoint mesh
energy bound used by the typed partition proof. -/
private theorem _voucher_step_2a_reflected_endpoint_algebra_for_typed_mesh_data
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (C : H → H) (L : ℝ) (v u : H) (hCv : C v = 0)
    {n : ℕ} (hn_pos : 0 < n)
    (hreflected :
      0 ≤
        2 *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))),
                  (L / (n : ℝ)) • (u - v) -
                    (C (AffineMap.lineMap v u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                      C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))))⟫_ℝ) +
          L ^ 2 * ‖u - v‖ ^ 2 / (n : ℝ)) :
    ‖C u‖ ^ 2 ≤
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))), u - v⟫_ℝ)) +
        Finset.sum (Finset.range n)
          (fun k =>
            ‖C (AffineMap.lineMap v u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ)))‖ ^ 2) +
        L ^ 2 * ‖u - v‖ ^ 2 / (n : ℝ) := by
  classical
  let d : H := u - v
  let x : ℕ → H := fun k => AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))
  let g : ℕ → H := fun k => C (x k)
  have hg0 : g 0 = 0 := by
    simp [g, x, hCv]
  have halg :=
    mesh_endpoint_algebra_from_reflected_work_before_endpoint
      d L hn_pos g hg0 (by
        simpa [d, x, g] using hreflected)
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  simpa [d, x, g, div_self hnR_ne] using halg

/-- Voucher step: final arithmetic closing the partition epsilon estimate from
the endpoint mesh bound and the summed local-pair bound. -/
private theorem _voucher_step_2a_final_partition_epsilon_arithmetic
    {A B Φu L ε : ℝ}
    (hε_nonneg : 0 ≤ ε)
    (hendpoint : A ≤ B + ε / 2)
    (hmesh : B ≤ 2 * L * Φu) :
    A ≤ 2 * L * Φu + ε := by
  linarith

/-- Voucher step: scalar integration and finite-mesh endpoint closure for the
zero-base open-chart self-bound.

The hypotheses expose the exact typed data produced by compact segment
localization and local feasible inverse-step gaps; this is the remaining FILL
leaf, not a new source assumption. -/
private theorem _voucher_step_2a_partition_epsilon_bound_from_typed_mesh_data
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Ψ : H → ℝ) (C : H → H) (U : Set H) (L ε ρ : ℝ)
    (hL_pos : 0 < L) (hε_pos : 0 < ε) (hρ_pos : 0 < ρ)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hnonnegΨ : ∀ x ∈ U, 0 ≤ Ψ x)
    (hconvΨ : ConvexOn ℝ U Ψ)
    (hgradΨ : ∀ x ∈ U, HasFDerivAt Ψ (innerSL ℝ (C x)) x)
    (hCLip : ∀ x ∈ U, ∀ y ∈ U, ‖C x - C y‖ ≤ L * ‖x - y‖)
    (v : H) (hv : v ∈ U) (hΨv : Ψ v = 0) (hCv : C v = 0)
    (u : H) (hu : u ∈ U)
    (htube : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      Metric.ball (AffineMap.lineMap v u t) ρ ⊆ U)
    (hlocal_pair :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖(t - s) • (u - v)‖ < ρ →
          ‖C (AffineMap.lineMap v u t) - C (AffineMap.lineMap v u s)‖ ^ 2 ≤
            2 * L *
              (Ψ (AffineMap.lineMap v u t) - Ψ (AffineMap.lineMap v u s) -
                ⟪C (AffineMap.lineMap v u s), (t - s) • (u - v)⟫_ℝ)) :
    ‖C u‖ ^ 2 ≤ 2 * L * Ψ u + ε := by
  classical
  let line : ℝ → H := fun t => AffineMap.lineMap v u t
  let φ : ℝ → ℝ := fun t => Ψ (line t)
  let g : ℝ → H := fun t => C (line t)
  let d : H := u - v
  have hline0 : line 0 = v := by
    simp [line]
  have hline1 : line 1 = u := by
    simp [line]
  have hφ0 : φ 0 = 0 := by
    simp [φ, hline0, hΨv]
  have hφ1 : φ 1 = Ψ u := by
    simp [φ, hline1]
  have hseg_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1, line t ∈ U := by
    intro t ht
    exact hUconv.lineMap_mem hv hu ht
  have hlocal_pair_path :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖(t - s) • d‖ < ρ →
          ‖g t - g s‖ ^ 2 ≤
            2 * L * (φ t - φ s - ⟪g s, (t - s) • d⟫_ℝ) := by
    intro s hs t ht hmesh
    simpa [line, φ, g, d] using hlocal_pair s hs t ht hmesh
  have hgLip :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖g t - g s‖ ≤ L * ‖(t - s) • d‖ := by
    intro s hs t ht
    have hsub :
        line t - line s = (t - s) • d := by
      simpa [line, d] using lineMap_sub_eq_smul_endpoint_diff v u s t
    have hlip := hCLip (line t) (hseg_mem t ht) (line s) (hseg_mem s hs)
    simpa [g, hsub] using hlip
  have hderiv :
      ∀ t ∈ Set.Icc (0 : ℝ) 1,
        HasDerivWithinAt φ ⟪g t, d⟫_ℝ (Set.Icc (0 : ℝ) 1) t := by
    intro t ht
    simpa [φ, g, line, d] using
      open_segment_derivative_from_hasFDerivAt Ψ C U hUconv hgradΨ
        v hv u hu t ht
  obtain ⟨n, hn_pos, hmesh, henergyBudget, hworkBudget⟩ :=
    _voucher_step_2a_select_uniform_partition_for_typed_mesh_data
      d hL_pos hε_pos hρ_pos
  have hfwd :=
    _voucher_step_2a_local_pair_sum_for_typed_mesh_data
      φ g d L ρ hL_pos hlocal_pair_path hn_pos hmesh
  have _hriem :=
    _voucher_step_2a_scalar_riemann_for_typed_mesh_data
      φ g d L (ε / (4 * L)) hL_pos hn_pos hgLip hderiv hworkBudget
  have hreflected :
      0 ≤
        2 *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))),
                  (L / (n : ℝ)) • (u - v) -
                    (C (AffineMap.lineMap v u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                      C (AffineMap.lineMap v u ((k : ℝ) / (n : ℝ))))⟫_ℝ) +
          L ^ 2 * ‖u - v‖ ^ 2 / (n : ℝ) :=
    _voucher_step_2a_reflected_work_nonneg_from_typed_mesh_data
      Ψ C U L ρ hL_pos hUopen hUconv hnonnegΨ hconvΨ hgradΨ hCLip
      v hv hΨv hCv u hu htube hlocal_pair hn_pos (by simpa [d] using hmesh)
  have hendpoint_raw :=
    _voucher_step_2a_reflected_endpoint_algebra_for_typed_mesh_data
      C L v u hCv hn_pos hreflected
  let Bmesh : ℝ :=
    2 * L *
        ((1 / (n : ℝ)) *
          Finset.sum (Finset.range n)
            (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
      Finset.sum (Finset.range n)
        (fun k =>
          ‖g ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
              g ((k : ℝ) / (n : ℝ))‖ ^ 2)
  have hendpoint : ‖C u‖ ^ 2 ≤ Bmesh + ε / 2 := by
    calc
      ‖C u‖ ^ 2 ≤
          Bmesh + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
            simpa [Bmesh, g, line, d] using hendpoint_raw
      _ ≤ Bmesh + ε / 2 := by
            simpa [add_comm, add_left_comm, add_assoc] using
              add_le_add_left henergyBudget Bmesh
  have hmesh_bound : Bmesh ≤ 2 * L * Ψ u := by
    calc
      Bmesh ≤ 2 * L * (φ 1 - φ 0) := by
        simpa [Bmesh] using hfwd
      _ = 2 * L * Ψ u := by
        rw [hφ1, hφ0]
        ring
  exact
    _voucher_step_2a_final_partition_epsilon_arithmetic
      (le_of_lt hε_pos) hendpoint hmesh_bound

/-- Voucher step: remove the positive epsilon from the typed epsilon
self-bound. -/
private theorem _voucher_step_2a_epsilon_removal_self_bound
    {A B : ℝ} (hε : ∀ ε : ℝ, 0 < ε → A ≤ B + ε) :
    A ≤ B := by
  exact le_of_forall_pos_le_add hε

/-- Voucher step: zero-base open-convex smooth self-bound.

This is the remaining analytic leaf after the pairwise statement is shifted to
a nonnegative potential with zero value and zero selected gradient at the base.
It is deliberately upstream of the reflected aggregate cycle. -/
private theorem _voucher_step_2a_zero_base_self_bound_from_shifted_data
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Ψ : H → ℝ) (C : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hnonnegΨ : ∀ x ∈ U, 0 ≤ Ψ x)
    (hconvΨ : ConvexOn ℝ U Ψ)
    (hgradΨ : ∀ x ∈ U, HasFDerivAt Ψ (innerSL ℝ (C x)) x)
    (hCLip : ∀ x ∈ U, ∀ y ∈ U, ‖C x - C y‖ ≤ L * ‖x - y‖)
    (v : H) (hv : v ∈ U) (hΨv : Ψ v = 0) (hCv : C v = 0)
    (u : H) (hu : u ∈ U) :
    ‖C u‖ ^ 2 ≤ 2 * L * Ψ u := by
  classical
  refine _voucher_step_2a_epsilon_removal_self_bound ?_
  intro ε hε_pos
  obtain ⟨ρ, hρ_pos, htube⟩ :=
    _voucher_step_2a_compact_segment_localization U hUopen hUconv v hv u hu
  let line : ℝ → H := fun t => AffineMap.lineMap v u t
  let d : H := u - v
  have hseg_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1, line t ∈ U := by
    intro t ht
    exact hUconv.lineMap_mem hv hu ht
  have hlocal_pair :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖(t - s) • d‖ < ρ →
          ‖C (line t) - C (line s)‖ ^ 2 ≤
            2 * L *
              (Ψ (line t) - Ψ (line s) -
                ⟪C (line s), (t - s) • d⟫_ℝ) := by
    intro s hs t ht hmesh
    have hsub :
        line t - line s = (t - s) • d := by
      simpa [line, d] using lineMap_sub_eq_smul_endpoint_diff v u s t
    have hpair :=
      _voucher_step_2a_local_feasible_inverse_pair_gap
        Ψ C U L hL_pos hUconv hconvΨ hgradΨ hCLip
        (line s) (hseg_mem s hs) (line t) (hseg_mem t ht)
        (htube t ht) (by simpa [hsub] using hmesh)
    simpa [line, d, hsub] using hpair
  simpa [line, d] using
    _voucher_step_2a_partition_epsilon_bound_from_typed_mesh_data
      Ψ C U L ε ρ hL_pos hε_pos hρ_pos hUopen hUconv hnonnegΨ hconvΨ
      hgradΨ hCLip v hv hΨv hCv u hu htube hlocal_pair

/-- Voucher step: pairwise open-domain Baillon-Haddad from convexity,
gradient semantics, and Lipschitz selected gradients.

This is the non-circular analytic core for Lan Lemma 5.8. It must be proved
from the open convex chart data, not from the endpoint-energy/aggregate-cycle
chain below. -/
private theorem _voucher_step_2a_open_convex_pairwise_baillon_haddad_core
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hconvΦ : ConvexOn ℝ U Φ)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (u : H) (hu : u ∈ U) (v : H) (hv : v ∈ U) :
    ‖B u - B v‖ ^ 2 ≤
      2 * L * (Φ u - Φ v - ⟪B v, u - v⟫_ℝ) := by
  classical
  let Ψ : H → ℝ := fun y => Φ y - Φ v - ⟪B v, y - v⟫_ℝ
  let C : H → H := fun y => B y - B v
  have hΨv : Ψ v = 0 := by
    simp [Ψ]
  have hCv : C v = 0 := by
    simp [C]
  have hnonnegΨ : ∀ x ∈ U, 0 ≤ Ψ x := by
    simpa [Ψ] using
      _voucher_step_2a_shifted_potential_nonneg
        Φ B U hUconv hconvΦ hgrad v hv
  have hconvΨ : ConvexOn ℝ U Ψ := by
    simpa [Ψ] using
      _voucher_step_2a_shifted_potential_convex
        Φ B U hUconv hconvΦ hgrad v hv
  have hgradΨ : ∀ x ∈ U, HasFDerivAt Ψ (innerSL ℝ (C x)) x := by
    simpa [Ψ, C] using
      _voucher_step_2a_shifted_gradient_semantics
        Φ B U hgrad v
  have hCLip : ∀ x ∈ U, ∀ y ∈ U, ‖C x - C y‖ ≤ L * ‖x - y‖ := by
    simpa [C] using
      _voucher_step_2a_shifted_gradient_lipschitz
        B U L hBLip v
  have hself : ‖C u‖ ^ 2 ≤ 2 * L * Ψ u :=
    _voucher_step_2a_zero_base_self_bound_from_shifted_data
      Ψ C U L hL_pos hUopen hUconv hnonnegΨ hconvΨ hgradΨ hCLip
      v hv hΨv hCv u hu
  simpa [Ψ, C] using hself

/-- Voucher step: pairwise open-domain Baillon-Haddad from support, smooth
upper model, gradient semantics, and Lipschitz selected gradients. -/
private theorem _voucher_step_2_pairwise_open_baillon_haddad
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ U, ∀ v ∈ U,
