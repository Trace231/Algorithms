            φ ((k : ℝ) / (n : ℝ)) + err := by
    intro k hk
    simpa [err] using
      left_partition_step_work_le_phi_increment_add_error
        φ g d L hL_pos hn_pos hgLip hderiv (Finset.mem_range.mp hk)
  have hsum_raw := Finset.sum_le_sum hstep
  have hsum :
      (1 / (n : ℝ)) *
          Finset.sum (Finset.range n)
            (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ) ≤
        Finset.sum (Finset.range n)
          (fun k => φ (((k + 1 : ℕ) : ℝ) / (n : ℝ)) -
            φ ((k : ℝ) / (n : ℝ))) +
          Finset.sum (Finset.range n) (fun _ => err) := by
    calc
      (1 / (n : ℝ)) *
          Finset.sum (Finset.range n)
            (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)
          = Finset.sum (Finset.range n)
              (fun k => (1 / (n : ℝ)) *
                ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ) := by
            rw [Finset.mul_sum]
      _ ≤ Finset.sum (Finset.range n)
          (fun k => φ (((k + 1 : ℕ) : ℝ) / (n : ℝ)) -
            φ ((k : ℝ) / (n : ℝ)) + err) := hsum_raw
      _ = Finset.sum (Finset.range n)
          (fun k => φ (((k + 1 : ℕ) : ℝ) / (n : ℝ)) -
            φ ((k : ℝ) / (n : ℝ))) +
          Finset.sum (Finset.range n) (fun _ => err) := by
            rw [Finset.sum_add_distrib]
  have htel := uniform_partition_phi_increment_telescope φ hn_pos
  have herrsum :
      Finset.sum (Finset.range n) (fun _ => err) =
        L * ‖d‖ ^ 2 / (2 * (n : ℝ)) := by
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    dsimp [err]
    field_simp [hnR_ne]
  have htel_sums :
      Finset.sum (Finset.range n)
          (fun k => φ (((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
        Finset.sum (Finset.range n)
          (fun k => φ ((k : ℝ) / (n : ℝ))) =
