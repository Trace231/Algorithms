private theorem _voucher_step_3d_q_absorption_to_unscaled
    {Rsum Q Eavg : ℝ} (hfirst_Q : 0 ≤ 2 * Rsum + Q + Eavg) :
    -(2 * Rsum + Q) ≤ Eavg := by
  linarith

/-- Pair-norm control gives the Q-form scalar slack after the exact averaged
