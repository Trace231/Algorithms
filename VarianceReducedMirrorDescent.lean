    ‖B u‖ ^ 2
        ≤ 2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖g ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
                  g ((k : ℝ) / (n : ℝ))‖ ^ 2) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := hendpoint
    _ ≤ 2 * L * (φ 1 - φ 0) + ε / 2 := by
          linarith
    _ = 2 * L * Φ u + ε / 2 := by
          rw [hφ1, hφ0]
          ring
