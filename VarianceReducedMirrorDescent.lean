/-- A nonempty open feasible chart spans the whole ambient direction space.

This is the open-chart specialization needed to align the paper's ambient
gradient field with the constrained Baillon-Haddad carrier theorem. Search
audit: considered `SOptLib.vsub_mem_carrierAffineSpan_direction` and
`AffineSubspace.vsub_mem_direction`; they provide feasible-difference membership
but not the full-space conclusion, so this lemma adds the open-ball scaling
argument. -/
private theorem open_set_affineSpan_direction_eq_top
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    {U : Set H} {v : H}
    (hUopen : IsOpen U) (hv : v ∈ U) :
    (affineSpan ℝ U).direction = ⊤ := by
  classical
  refine Submodule.eq_top_iff'.2 ?_
  intro w
  by_cases hw : w = 0
  · simp [hw]
  · obtain ⟨ε, hε_pos, hε_ball⟩ := Metric.isOpen_iff.1 hUopen v hv
    let t : ℝ := ε / (2 * ‖w‖)
    have hw_norm_pos : 0 < ‖w‖ := norm_pos_iff.2 hw
    have ht_pos : 0 < t := by
      dsimp [t]
      positivity
    let y : H := v + t • w
    have hyU : y ∈ U := by
      apply hε_ball
      rw [Metric.mem_ball, dist_eq_norm]
      have hdist : ‖y - v‖ = ε / 2 := by
        dsimp [y, t]
        rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs]
        have ht_nonneg : 0 ≤ ε / (2 * ‖w‖) := le_of_lt ht_pos
        rw [abs_of_nonneg ht_nonneg]
        field_simp [ne_of_gt hw_norm_pos]
      rw [hdist]
      linarith
    have hvspan : v ∈ affineSpan ℝ U := subset_affineSpan ℝ U hv
    have hyspan : y ∈ affineSpan ℝ U := subset_affineSpan ℝ U hyU
    have hydir : y - v ∈ (affineSpan ℝ U).direction :=
      AffineSubspace.vsub_mem_direction hyspan hvspan
    have hscale :
        (t⁻¹) • (y - v) ∈ (affineSpan ℝ U).direction :=
      (affineSpan ℝ U).direction.smul_mem (t⁻¹) hydir
    have hrewrite : (t⁻¹) • (y - v) = w := by
      dsimp [y]
      rw [add_sub_cancel_left]
      calc
        (t⁻¹) • (t • w) = (t⁻¹ * t) • w := by
          rw [smul_smul]
        _ = (1 : ℝ) • w := by
          field_simp [ne_of_gt ht_pos]
        _ = w := by
          simp
    simpa [hrewrite] using hscale

/-- Early carrier-chart vsub transport through the ambient affine chart.

This is the affine algebra used by Lan Lemma 5.8's intrinsic-interior chart
transport. Search audit: checked SOptLib chart lemmas
`SOptLib.carrierChartToAmbient`, `AffineSubspace.vaddConst_contLinear_eq_subtypeL`,
and the downstream `carrier_chart_to_ambient_vsub`; no upstream reusable lemma
states exactly this two-point vsub form before the early bridge. -/
private theorem early_carrier_chart_to_ambient_vsub
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [FiniteDimensional ℝ H]
    (T : Set H) (anchor : {x : H // x ∈ T})
    (p q : (affineSpan ℝ T).direction) :
    ((q - p : (affineSpan ℝ T).direction) : H) =
      SOptLib.carrierChartToAmbient T anchor q -
        SOptLib.carrierChartToAmbient T anchor p := by
  classical
  let A : AffineSubspace ℝ H := affineSpan ℝ T
  haveI : Nonempty A := ⟨⟨anchor.1, subset_affineSpan ℝ T anchor.2⟩⟩
  haveI : IsClosed ((A.direction : Submodule ℝ H) : Set H) :=
    A.direction.closed_of_finiteDimensional
  haveI : IsUniformAddGroup A.direction := A.direction.toAddSubgroup.isUniformAddGroup
  haveI : CompleteSpace A.direction := FiniteDimensional.complete ℝ A.direction
  let Lchart : A.direction →ᴬ[ℝ] H := SOptLib.carrierChartToAmbient T anchor
  have hlin :
      Lchart.contLinear (q - p) = Lchart q - Lchart p := by
    simpa [vsub_eq_sub] using Lchart.contLinear_map_vsub q p
  have hcont : Lchart.contLinear = A.direction.subtypeL := by
    let a : A := ⟨anchor.1, subset_affineSpan ℝ T anchor.2⟩
    apply AffineSubspace.vaddConst_contLinear_eq_subtypeL a Lchart
    intro du
    change (((AffineIsometryEquiv.vaddConst ℝ a).toContinuousAffineEquiv.toContinuousAffineMap
        du : A) : H) = (du : H) + (a : H)
    simp
  calc
    ((q - p : A.direction) : H) = A.direction.subtypeL (q - p) := rfl
    _ = Lchart.contLinear (q - p) := by rw [hcont]
    _ = Lchart q - Lchart p := hlin

