/-- Source-named reflected splits induce the canonical signed-work interval.

This is the acyclic frontier replacing the earlier downstream dependency:
it consumes the actual positive/negative source split normal forms and rewrites
them to the canonical drift/oscillation interval.  The remaining proof is
finite Hilbert/Finset normalization of the named components, not a new source
assumption and not the refuted absorbed-cross scalar bridge. -/
private theorem source_named_splits_to_canonical_work_interval
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) (L : ℝ) {n : ℕ} (hn_pos : 0 < n) {τ : ℝ}
    (d : H) (x g r : ℕ → H)
    (hg : ∀ k, g k = B (x k))
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    (hclose : x 0 - x n = -d)
    (hg0 : g 0 = 0)
    (hpos_named :
      let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        τ *
          ((1 / L) *
            (⟪g n - g 0, r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
      let errorWork_pos : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yPos k) - g k, yPos (k + 1) - yPos k⟫_ℝ)
      let baseTilt : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n - g n, x 0 - x n⟫_ℝ
      let predTilt : ℝ :=
        τ *
          ((1 / L) *
            (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork_pos : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ)
      (baseB + predB) + errorWork_pos ≤ 0 ∧
        (baseTilt + predTilt) + residualWork_pos - errorWork_pos ≤ 0)
    (hneg_named :
      let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        τ *
          ((1 / L) *
            (⟪g n - g 0, r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
      let errorWork_neg : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yNeg k) - g k, yNeg (k + 1) - yNeg k⟫_ℝ)
      let baseTilt : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n - g n, x 0 - x n⟫_ℝ
      let predTilt : ℝ :=
        τ *
          ((1 / L) *
            (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork_neg : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ)
      (baseB - predB) + errorWork_neg ≤ 0 ∧
        (baseTilt - predTilt) + residualWork_neg - errorWork_neg ≤ 0) :
    let baseStep : ℝ :=
      Finset.sum (Finset.range n)
          (fun k => ⟪L • x k, (1 / (n : ℝ)) • d⟫_ℝ) +
        ⟪L • x n, -d⟫_ℝ
    let predSkewNF : ℝ :=
      τ * ((1 / L) *
        ((⟪g n - g 0, r 0⟫_ℝ -
          ⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ) +
          Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ -
                ⟪-r k, r (k + 1)⟫_ℝ)))
    let residualPosNF : ℝ :=
      τ * ((1 / (n : ℝ)) *
          Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ)) +
        τ ^ 2 * (1 / L) *
          (Finset.sum (Finset.range (n - 1))
              (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
            ‖r (n - 1)‖ ^ 2)
    let residualNegNF : ℝ :=
      -(τ * ((1 / (n : ℝ)) *
          Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ))) +
        τ ^ 2 * (1 / L) *
          (Finset.sum (Finset.range (n - 1))
              (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
            ‖r (n - 1)‖ ^ 2)
    let canonicalDriftError : ℝ :=
      Finset.sum (Finset.range (n - 1))
          (fun k =>
            ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
                (1 / (n : ℝ)) • d⟫_ℝ -
              ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
                (1 / (n : ℝ)) • d⟫_ℝ) +
        (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d⟫_ℝ -
          ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
              g (n - 1),
            (1 / (n : ℝ)) • d⟫_ℝ)
    let canonicalOscillationError : ℝ :=
      Finset.sum (Finset.range (n - 1))
          (fun k =>
            ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
                (1 / L) • (r (k + 1) - r k)⟫_ℝ +
              ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
                (1 / L) • (r (k + 1) - r k)⟫_ℝ) -
        (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
            (1 / L) • r (n - 1)⟫_ℝ +
          ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
              g (n - 1),
            (1 / L) • r (n - 1)⟫_ℝ)
    (baseStep - predSkewNF + residualPosNF ≤
        canonicalDriftError + τ * canonicalOscillationError) ∧
      (canonicalDriftError + τ * canonicalOscillationError ≤
        -(baseStep + predSkewNF + residualNegNF)) := by
  classical
  let baseStep : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪L • x k, (1 / (n : ℝ)) • d⟫_ℝ) +
      ⟪L • x n, -d⟫_ℝ
  let predSkewNF : ℝ :=
    τ * ((1 / L) *
      ((⟪g n - g 0, r 0⟫_ℝ -
        ⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ) +
        Finset.sum (Finset.range (n - 1))
          (fun k =>
            ⟪r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ -
              ⟪-r k, r (k + 1)⟫_ℝ)))
  let residualPosNF : ℝ :=
    τ * ((1 / (n : ℝ)) *
        Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ)) +
      τ ^ 2 * (1 / L) *
        (Finset.sum (Finset.range (n - 1))
            (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
          ‖r (n - 1)‖ ^ 2)
  let residualNegNF : ℝ :=
    -(τ * ((1 / (n : ℝ)) *
        Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ))) +
      τ ^ 2 * (1 / L) *
        (Finset.sum (Finset.range (n - 1))
            (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
          ‖r (n - 1)‖ ^ 2)
  let canonicalDriftError : ℝ :=
    Finset.sum (Finset.range (n - 1))
        (fun k =>
          ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
              (1 / (n : ℝ)) • d⟫_ℝ -
            ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
              (1 / (n : ℝ)) • d⟫_ℝ) +
      (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
          (1 / (n : ℝ)) • d⟫_ℝ -
        ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
            g (n - 1),
          (1 / (n : ℝ)) • d⟫_ℝ)
  let canonicalOscillationError : ℝ :=
    Finset.sum (Finset.range (n - 1))
        (fun k =>
          ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
              (1 / L) • (r (k + 1) - r k)⟫_ℝ +
            ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
              (1 / L) • (r (k + 1) - r k)⟫_ℝ) -
      (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
          (1 / L) • r (n - 1)⟫_ℝ +
        ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
            g (n - 1),
          (1 / L) • r (n - 1)⟫_ℝ)
  let canonicalErrorWork_pos : ℝ :=
    Finset.sum (Finset.range n)
      (fun k =>
        ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
          reflectedPerturbedCycle L τ n x r (k + 1) -
            reflectedPerturbedCycle L τ n x r k⟫_ℝ)
  let canonicalErrorWork_neg : ℝ :=
    Finset.sum (Finset.range n)
      (fun k =>
        ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
          reflectedPerturbedCycle L τ n x (fun j => -r j) (k + 1) -
            reflectedPerturbedCycle L τ n x (fun j => -r j) k⟫_ℝ)
  change
    (baseStep - predSkewNF + residualPosNF ≤
        canonicalDriftError + τ * canonicalOscillationError) ∧
      (canonicalDriftError + τ * canonicalOscillationError ≤
        -(baseStep + predSkewNF + residualNegNF))
  have hcanonical_signed_edge :
      canonicalDriftError + τ * canonicalOscillationError =
        canonicalErrorWork_pos - canonicalErrorWork_neg := by
    exact
      canonical_signed_defect_edge_reconstruction
        (H := H) (n := n) hn_pos L τ d B x g r hstep
        (Eavg :=
          (Finset.sum (Finset.range n)
              (fun k =>
                ‖(1 / L) •
                  (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
            Finset.sum (Finset.range n)
              (fun k =>
                ‖(1 / L) •
                  (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                    g k)‖)) /
            2)
        (hdriftError_def := rfl)
        (hoscillationError_def := rfl)
        (herrorWork_pos_def := rfl)
        (herrorWork_neg_def := rfl)
        rfl
  let baseB : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
      ⟪g n, x 0 - x n⟫_ℝ
  let predB : ℝ :=
    τ *
      ((1 / L) *
        (⟪g n - g 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
  let baseTilt : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
      ⟪L • x n - g n, x 0 - x n⟫_ℝ
  let predTilt : ℝ :=
    τ *
      ((1 / L) *
        (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                r (k + 1)⟫_ℝ)))
  let residualWork_pos : ℝ :=
    Finset.sum (Finset.range n)
      (fun k =>
        ⟪τ • r k,
          reflectedPerturbedCycle L τ n x r (k + 1) -
            reflectedPerturbedCycle L τ n x r k⟫_ℝ)
  let residualWork_neg : ℝ :=
    Finset.sum (Finset.range n)
      (fun k =>
        ⟪τ • (-r k),
          reflectedPerturbedCycle L τ n x (fun j => -r j) (k + 1) -
            reflectedPerturbedCycle L τ n x (fun j => -r j) k⟫_ℝ)
  have hposB : (baseB + predB) + canonicalErrorWork_pos ≤ 0 := by
    simpa [baseB, predB, canonicalErrorWork_pos] using hpos_named.1
  have hposT :
      (baseTilt + predTilt) + residualWork_pos - canonicalErrorWork_pos ≤ 0 := by
    simpa [baseTilt, predTilt, residualWork_pos, canonicalErrorWork_pos]
      using hpos_named.2
  have hnegB : (baseB - predB) + canonicalErrorWork_neg ≤ 0 := by
    simpa [baseB, predB, canonicalErrorWork_neg] using hneg_named.1
  have hnegT :
      (baseTilt - predTilt) + residualWork_neg - canonicalErrorWork_neg ≤ 0 := by
    simpa [baseTilt, predTilt, residualWork_neg, canonicalErrorWork_neg]
      using hneg_named.2
  have hcross :=
    _voucher_step_3d_named_split_cross_combination hposB hposT hnegB hnegT
  have hbase_tilt_linear :
      baseB + baseTilt =
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n, x 0 - x n⟫_ℝ := by
    calc
      baseB + baseTilt =
          (Finset.sum (Finset.range n)
              (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
            Finset.sum (Finset.range n)
              (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ)) +
          (⟪g n, x 0 - x n⟫_ℝ +
            ⟪L • x n - g n, x 0 - x n⟫_ℝ) := by
            dsimp [baseB, baseTilt]
            ring
      _ =
          Finset.sum (Finset.range n)
              (fun k =>
                ⟪g k, x (k + 1) - x k⟫_ℝ +
                  ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
            (⟪g n, x 0 - x n⟫_ℝ +
              ⟪L • x n - g n, x 0 - x n⟫_ℝ) := by
            rw [Finset.sum_add_distrib]
      _ =
          Finset.sum (Finset.range n)
              (fun k => ⟪L • x k, x (k + 1) - x k⟫_ℝ) +
            ⟪L • x n, x 0 - x n⟫_ℝ := by
            congr 1
            · apply Finset.sum_congr rfl
              intro k hk
              simp [inner_sub_left]
            · simp [inner_sub_left]
  have hbase_step_eq : baseB + baseTilt = baseStep := by
    rw [hbase_tilt_linear]
    dsimp [baseStep]
    congr 1
    · apply Finset.sum_congr rfl
      intro k hk
      rw [hstep k hk]
    · rw [hclose]
  let predG : ℝ :=
    ⟪g n - g 0, r 0⟫_ℝ +
      Finset.sum (Finset.range (n - 1))
        (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)
  let predLinear : ℝ :=
    ⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
      Finset.sum (Finset.range (n - 1))
        (fun k =>
          ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
            r (k + 1)⟫_ℝ)
  have hpred_skew_raw :
      predB - predTilt =
        τ * ((1 / L) * predG) - τ * ((1 / L) * predLinear) := by
    rfl
  have hpred_skew_def :
      predB - predTilt =
        τ * ((1 / L) * (predG - predLinear)) := by
    rw [hpred_skew_raw]
    rw [mul_sub, mul_sub]
  have hgdiff :
      ∀ k ∈ Finset.range n,
        g k - g (k + 1) = r k - (L / (n : ℝ)) • d := by
    intro k hk
    have hrk := hr k hk
    calc
      g k - g (k + 1) = -(g (k + 1) - g k) := by
        abel
      _ = r k - (L / (n : ℝ)) • d := by
        rw [hrk]
        abel
  have htilt_diff :
      ∀ k ∈ Finset.range n,
        (L • x k - g k) - (L • x (k + 1) - g (k + 1)) = -r k := by
    intro k hk
    have hstepk := hstep k hk
    have hrk := hr k hk
    have hLstep :
        L • (x (k + 1) - x k) = (L / (n : ℝ)) • d := by
      rw [hstepk]
      rw [smul_smul]
      congr 1
      ring
    calc
      (L • x k - g k) - (L • x (k + 1) - g (k + 1))
          = (g (k + 1) - g k) + (L • x k - L • x (k + 1)) := by
            abel
      _ = (g (k + 1) - g k) - L • (x (k + 1) - x k) := by
            rw [smul_sub]
            abel
      _ = (g (k + 1) - g k) - (L / (n : ℝ)) • d := by
            rw [hLstep]
      _ = -r k := by
            rw [hrk]
            abel
  have hpredG_nf :
      predG =
        ⟪g n - g 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ) := by
    dsimp [predG]
    congr 1
    apply Finset.sum_congr rfl
    intro k hk
    have hk_n : k ∈ Finset.range n := by
      have hklt : k < n - 1 := Finset.mem_range.mp hk
      exact Finset.mem_range.mpr (by omega)
    rw [hgdiff k hk_n]
  have hpredLinear_nf :
      predLinear =
        ⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪-r k, r (k + 1)⟫_ℝ) := by
    dsimp [predLinear]
    congr 1
    apply Finset.sum_congr rfl
    intro k hk
    have hk_n : k ∈ Finset.range n := by
      have hklt : k < n - 1 := Finset.mem_range.mp hk
      exact Finset.mem_range.mpr (by omega)
    rw [htilt_diff k hk_n]
  have hpred_diff_nf :
      predG - predLinear =
        (⟪g n - g 0, r 0⟫_ℝ -
          ⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ) +
          Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ -
                ⟪-r k, r (k + 1)⟫_ℝ) := by
    rw [hpredG_nf, hpredLinear_nf, Finset.sum_sub_distrib]
    ring
  have hpred_skew_eq : predB - predTilt = predSkewNF := by
    rw [hpred_skew_def, hpred_diff_nf]
  have hresidual_pos_eq : residualWork_pos = residualPosNF := by
    have hn_sub_succ : n - 1 + 1 = n := Nat.sub_add_cancel hn_pos
    have hsplit :
        residualWork_pos =
          Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪τ • r k,
                  reflectedPerturbedCycle L τ n x r (k + 1) -
                    reflectedPerturbedCycle L τ n x r k⟫_ℝ) +
            ⟪τ • r (n - 1),
              reflectedPerturbedCycle L τ n x r n -
                reflectedPerturbedCycle L τ n x r (n - 1)⟫_ℝ := by
      dsimp [residualWork_pos]
      conv_lhs => rw [← hn_sub_succ, Finset.sum_range_succ]
      simp [hn_sub_succ]
    have hbody :
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪τ • r k,
                reflectedPerturbedCycle L τ n x r (k + 1) -
                  reflectedPerturbedCycle L τ n x r k⟫_ℝ) =
          Finset.sum (Finset.range (n - 1))
            (fun k =>
              τ * ((1 / (n : ℝ)) * ⟪r k, d⟫_ℝ) +
                τ ^ 2 * (1 / L) * ⟪r k, r (k + 1) - r k⟫_ℝ) := by
      refine Finset.sum_congr rfl ?_
      intro k hk
      have hk_n : k ∈ Finset.range n := Finset.mem_range.mpr (by
        have hklt' : k < n - 1 := Finset.mem_range.mp hk
        omega)
      have hk0 : k < n := Finset.mem_range.mp hk_n
      have hk1 : k + 1 < n := by
        have hklt' : k < n - 1 := Finset.mem_range.mp hk
        omega
      have hedge :
          reflectedPerturbedCycle L τ n x r (k + 1) -
              reflectedPerturbedCycle L τ n x r k =
            (1 / (n : ℝ)) • d +
              τ • ((1 / L) • (r (k + 1) - r k)) := by
        have hy_k1 :
            reflectedPerturbedCycle L τ n x r (k + 1) =
              x (k + 1) + τ • ((1 / L) • r (k + 1)) := by
          simp [reflectedPerturbedCycle, hk1]
        have hy_k :
            reflectedPerturbedCycle L τ n x r k =
              x k + τ • ((1 / L) • r k) := by
          simp [reflectedPerturbedCycle, hk0]
        rw [hy_k1, hy_k, ← hstep k hk_n]
        module
      rw [hedge]
      simp [inner_add_right, inner_sub_right, inner_smul_left,
        inner_smul_right, real_inner_self_eq_norm_sq]
      ring
    have hlast :
        ⟪τ • r (n - 1),
          reflectedPerturbedCycle L τ n x r n -
            reflectedPerturbedCycle L τ n x r (n - 1)⟫_ℝ =
          τ * ((1 / (n : ℝ)) * ⟪r (n - 1), d⟫_ℝ) -
            τ ^ 2 * (1 / L) * ‖r (n - 1)‖ ^ 2 := by
      have hlast_mem : n - 1 ∈ Finset.range n := by
        exact Finset.mem_range.mpr (Nat.sub_lt hn_pos Nat.zero_lt_one)
      have hlast_lt : n - 1 < n := Finset.mem_range.mp hlast_mem
      have hedge :
          reflectedPerturbedCycle L τ n x r n -
              reflectedPerturbedCycle L τ n x r (n - 1) =
            (1 / (n : ℝ)) • d -
              τ • ((1 / L) • r (n - 1)) := by
        have hyn : reflectedPerturbedCycle L τ n x r n = x n := by
          simp [reflectedPerturbedCycle]
        have hlast_y :
            reflectedPerturbedCycle L τ n x r (n - 1) =
              x (n - 1) + τ • ((1 / L) • r (n - 1)) := by
          simp [reflectedPerturbedCycle, hlast_lt]
        rw [hyn, hlast_y, ← hstep (n - 1) hlast_mem, hn_sub_succ]
        module
      rw [hedge]
      simp [inner_sub_right, inner_smul_left, inner_smul_right,
        real_inner_self_eq_norm_sq]
      ring
    rw [hsplit, hbody, hlast]
    dsimp [residualPosNF]
    rw [Finset.sum_add_distrib]
    rw [← Finset.mul_sum, ← Finset.mul_sum]
    have hsum_extend :
        Finset.sum (Finset.range (n - 1))
            (fun k => ⟪r k, d⟫_ℝ) + ⟪r (n - 1), d⟫_ℝ =
          Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ) := by
      conv_rhs => rw [← hn_sub_succ, Finset.sum_range_succ]
    rw [← hsum_extend]
    rw [← Finset.mul_sum]
    ring
  have hresidual_pair :
      residualWork_pos + residualWork_neg =
        2 * τ ^ 2 * (1 / L) *
          (Finset.sum (Finset.range (n - 1))
              (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
            ‖r (n - 1)‖ ^ 2) := by
    simpa [residualWork_pos, residualWork_neg] using
      _voucher_step_3d_reflected_cycle_residual_pair_expansion
        (H := H) hn_pos L τ x r
  have hresidual_neg_eq : residualWork_neg = residualNegNF := by
    have hneg_from_pair :
        residualWork_neg =
          (residualWork_pos + residualWork_neg) - residualWork_pos := by
      ring
    rw [hneg_from_pair, hresidual_pair, hresidual_pos_eq]
    dsimp [residualPosNF, residualNegNF]
    ring
  constructor
  · have hpos := hcross.2
    have hrewrite :
        (baseB + baseTilt) - (predB - predTilt) + residualWork_pos +
            (canonicalErrorWork_neg - canonicalErrorWork_pos) =
          baseStep - predSkewNF + residualPosNF -
            (canonicalDriftError + τ * canonicalOscillationError) := by
      rw [hbase_step_eq, hpred_skew_eq, hresidual_pos_eq,
        hcanonical_signed_edge]
      ring
    have hcanon :
        baseStep - predSkewNF + residualPosNF -
            (canonicalDriftError + τ * canonicalOscillationError) ≤ 0 := by
      exact hrewrite ▸ hpos
    linarith only [hcanon]
  · have hneg := hcross.1
    have hrewrite :
        (baseB + baseTilt) + (predB - predTilt) + residualWork_neg +
            (canonicalErrorWork_pos - canonicalErrorWork_neg) =
          baseStep + predSkewNF + residualNegNF +
            (canonicalDriftError + τ * canonicalOscillationError) := by
      rw [hbase_step_eq, hpred_skew_eq, hresidual_neg_eq,
        hcanonical_signed_edge]
    have hcanon :
        baseStep + predSkewNF + residualNegNF +
            (canonicalDriftError + τ * canonicalOscillationError) ≤ 0 := by
      exact hrewrite ▸ hneg
    linarith only [hcanon]

/-
Retired legacy route.

The old canonical interval route tried to prove exact
Q-form absorption from the compressed canonical interval.  The scratch bridge
and skew-linear tests showed that this loses the signed split information needed
for the Q-level statement.  The active proof frontier is now
`source_named_splits_to_q_form_absorption_leaf`, which keeps the positive and
negative source split components available.

/-- Retired canonical source-work interval theorem.

This is the remaining finite reflected-mesh leaf.  It explicitly materializes
the actual averaged freezing-error normalization, the Lipschitz source budget,
the canonical two-sign work lower bound, and the correct signed mesh telescope.
The false absorbed-cross scaled inequality is not used. -/
private theorem retired_canonical_work_interval_to_q_form_absorption
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) {τ : ℝ}
    (hτ_pos : 0 < τ)
    (d : H) (x g r : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hyPert_mem_pos :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hyPert_mem_neg :
      ∀ k, k ≤ n + 1 →
        reflectedPerturbedCycle L τ n x (fun j => -r j) k ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    (hclose : x 0 - x n = -d)
    (hg0 : g 0 = 0)
    (hinterval :
      let baseStep : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k, (1 / (n : ℝ)) • d⟫_ℝ) +
          ⟪L • x n, -d⟫_ℝ
      let predSkewNF : ℝ :=
        τ * ((1 / L) *
          ((⟪g n - g 0, r 0⟫_ℝ -
            ⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ) +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ -
                  ⟪-r k, r (k + 1)⟫_ℝ)))
      let residualPosNF : ℝ :=
        τ * ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ)) +
          τ ^ 2 * (1 / L) *
            (Finset.sum (Finset.range (n - 1))
                (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
              ‖r (n - 1)‖ ^ 2)
      let residualNegNF : ℝ :=
        -(τ * ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ))) +
          τ ^ 2 * (1 / L) *
            (Finset.sum (Finset.range (n - 1))
                (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
              ‖r (n - 1)‖ ^ 2)
      let canonicalDriftError : ℝ :=
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
                  (1 / (n : ℝ)) • d⟫_ℝ -
                ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
                  (1 / (n : ℝ)) • d⟫_ℝ) +
          (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
              (1 / (n : ℝ)) • d⟫_ℝ -
            ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
                g (n - 1),
              (1 / (n : ℝ)) • d⟫_ℝ)
      let canonicalOscillationError : ℝ :=
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (reflectedPerturbedCycle L τ n x r k) - g k,
                  (1 / L) • (r (k + 1) - r k)⟫_ℝ +
                ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k,
                  (1 / L) • (r (k + 1) - r k)⟫_ℝ) -
          (⟪B (reflectedPerturbedCycle L τ n x r (n - 1)) - g (n - 1),
              (1 / L) • r (n - 1)⟫_ℝ +
            ⟪B (reflectedPerturbedCycle L τ n x (fun j => -r j) (n - 1)) -
                g (n - 1),
              (1 / L) • r (n - 1)⟫_ℝ)
      (baseStep - predSkewNF + residualPosNF ≤
          canonicalDriftError + τ * canonicalOscillationError) ∧
        (canonicalDriftError + τ * canonicalOscillationError ≤
          -(baseStep + predSkewNF + residualNegNF)))
    {Rsum Q Eavg : ℝ}
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n) (fun k => ‖g (k + 1) - g k‖ ^ 2))
    (hEavg_def :
      Eavg =
        (Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                  g k)‖)) /
          2) :
    0 ≤ 2 * Rsum + Q + Eavg := by
  classical
  have hτ_nonneg : 0 ≤ τ := le_of_lt hτ_pos
  have hcanonical_error_context :=
    canonical_reflected_error_context
      (H := H) hn_pos L τ d B x g r hstep hEavg_def
  have hcanonical_pos_edge := hcanonical_error_context.1
  have hcanonical_neg_edge := hcanonical_error_context.2.1
  have hEavg_nonneg := hcanonical_error_context.2.2
  have hcanonical_Eavg_budget_from_source :
