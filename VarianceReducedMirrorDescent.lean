`‖(1 / L) • error‖` quantities. Search audit: checked Mathlib
`abs_real_inner_le_norm`, `real_inner_le_norm`, and the local
`reflected_two_sign_error_average_nonneg`; the latter only proves
nonnegativity of the averaged norm budget, while this helper records the
pointwise signed lower bound needed before summing. -/
private theorem two_sign_scaled_error_inner_lower_bound
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {L : ℝ} (hL_pos : 0 < L) (ep en v : H) :
    -((‖(1 / L) • ep‖ + ‖(1 / L) • en‖) * ‖v‖) ≤
      ⟪ep, (1 / L) • v⟫_ℝ + ⟪en, (1 / L) • v⟫_ℝ := by
  have hL_ne : L ≠ 0 := ne_of_gt hL_pos
  have hscale_norm : ∀ w : H, ‖w‖ * ‖(1 / L) • v‖ = ‖(1 / L) • w‖ * ‖v‖ := by
    intro w
    rw [norm_smul, norm_smul]
    have hone_div_pos : 0 < 1 / L := one_div_pos.mpr hL_pos
    simp [Real.norm_eq_abs, abs_of_pos hone_div_pos, mul_comm, mul_left_comm,
      mul_assoc]
  have hep_lower :
      -(‖(1 / L) • ep‖ * ‖v‖) ≤ ⟪ep, (1 / L) • v⟫_ℝ := by
    have hcs := abs_real_inner_le_norm ep ((1 / L) • v)
    have hcs' : |⟪ep, (1 / L) • v⟫_ℝ| ≤ ‖(1 / L) • ep‖ * ‖v‖ := by
      rw [← hscale_norm ep]
      exact hcs
    exact (abs_le.mp hcs').1
  have hen_lower :
      -(‖(1 / L) • en‖ * ‖v‖) ≤ ⟪en, (1 / L) • v⟫_ℝ := by
    have hcs := abs_real_inner_le_norm en ((1 / L) • v)
    have hcs' : |⟪en, (1 / L) • v⟫_ℝ| ≤ ‖(1 / L) • en‖ * ‖v‖ := by
      rw [← hscale_norm en]
      exact hcs
    exact (abs_le.mp hcs').1
  nlinarith

/-- Finite-sum form of the two-sign scaled freezing-error lower bound.

This is the T1 range-sum bridge for Lan Lemma 5.8. Search audit: checked the
target-file `two_sign_scaled_error_inner_lower_bound`, Mathlib
`Finset.sum_le_sum`/`Finset.sum_neg_distrib`, and SOptLib telescope hits; the
SOptLib lemmas are probabilistic/telescoping wrappers, while this proof is the
direct finite sum of the local Cauchy--Schwarz atom. -/
private theorem sum_range_two_sign_scaled_error_inner_lower_bound
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {L : ℝ} (hL_pos : 0 < L) (m : ℕ) (ep en v : ℕ → H) :
    -(Finset.sum (Finset.range m)
        (fun k => (‖(1 / L) • ep k‖ + ‖(1 / L) • en k‖) * ‖v k‖)) ≤
      Finset.sum (Finset.range m)
        (fun k =>
          ⟪ep k, (1 / L) • v k⟫_ℝ + ⟪en k, (1 / L) • v k⟫_ℝ) := by
  have hsum :
      Finset.sum (Finset.range m)
      (fun k => -((‖(1 / L) • ep k‖ + ‖(1 / L) • en k‖) * ‖v k‖)) ≤
        Finset.sum (Finset.range m)
          (fun k =>
            ⟪ep k, (1 / L) • v k⟫_ℝ + ⟪en k, (1 / L) • v k⟫_ℝ) := by
    exact Finset.sum_le_sum
      (fun k hk => two_sign_scaled_error_inner_lower_bound hL_pos (ep k) (en k) (v k))
  simpa [Finset.sum_neg_distrib] using hsum

/-- Range plus closing-edge two-sign oscillation lower bound.

This is the exact finite Hilbert-space lower-bound shape used in Lan Lemma
5.8's freezing-error control. Search audit: checked the target-file
`sum_range_two_sign_scaled_error_inner_lower_bound` and
`two_sign_scaled_error_inner_lower_bound`; the first gives the summed range
part, and the second must be specialized to `v = -vLast` to get the reflected
closing-edge sign. -/
private theorem two_sign_scaled_error_oscillation_lower_bound
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {L : ℝ} (hL_pos : 0 < L) (m : ℕ) (ep en v : ℕ → H) (vLast : H) :
    -(Finset.sum (Finset.range m)
          (fun k => (‖(1 / L) • ep k‖ + ‖(1 / L) • en k‖) * ‖v k‖) +
        (‖(1 / L) • ep m‖ + ‖(1 / L) • en m‖) * ‖vLast‖) ≤
      Finset.sum (Finset.range m)
          (fun k =>
            ⟪ep k, (1 / L) • v k⟫_ℝ + ⟪en k, (1 / L) • v k⟫_ℝ) -
        (⟪ep m, (1 / L) • vLast⟫_ℝ + ⟪en m, (1 / L) • vLast⟫_ℝ) := by
  have hrange :=
    sum_range_two_sign_scaled_error_inner_lower_bound
      (H := H) (L := L) hL_pos m ep en v
  have hlast_raw :=
    two_sign_scaled_error_inner_lower_bound
      (H := H) (L := L) hL_pos (ep m) (en m) (-vLast)
  have hlast :
      -((‖(1 / L) • ep m‖ + ‖(1 / L) • en m‖) * ‖vLast‖) ≤
        -(⟪ep m, (1 / L) • vLast⟫_ℝ + ⟪en m, (1 / L) • vLast⟫_ℝ) := by
    simpa [norm_neg, smul_neg, inner_neg_right, add_comm] using hlast_raw
  nlinarith

/-- Any single positive/negative reflected error pair is controlled by twice
the actual averaged error `Eavg`.

This is the finite-sum normalization half of the T2 freezing-error route in
Lan Lemma 5.8. Search audit: checked `reflected_two_sign_error_average_nonneg`,
`_voucher_step_3d_error_average_normalization`, and Mathlib
`Finset.single_le_sum`; the first two expose the same `Eavg` expression but do
not provide the pointwise extraction from the finite average, while
`Finset.single_le_sum` is the exact reusable API for this route-local bound. -/
private theorem reflected_two_sign_point_error_norm_le_two_Eavg
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    {n : ℕ} {L τ : ℝ} (B : H → H) (x g r : ℕ → H)
    {Eavg : ℝ}
    (hEavg_def :
      Eavg =
        (Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                  g k)‖)) /
          2)
    {k : ℕ} (hk : k ∈ Finset.range n) :
    ‖(1 / L) • (B (reflectedPerturbedCycle L τ n x r k) - g k)‖ +
        ‖(1 / L) •
          (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖ ≤
      2 * Eavg := by
  classical
  let P : ℕ → ℝ := fun k =>
    ‖(1 / L) • (B (reflectedPerturbedCycle L τ n x r k) - g k)‖
  let N : ℕ → ℝ := fun k =>
    ‖(1 / L) •
      (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖
  have hP_nonneg : ∀ j ∈ Finset.range n, 0 ≤ P j := by
    intro j hj
    exact norm_nonneg _
  have hN_nonneg : ∀ j ∈ Finset.range n, 0 ≤ N j := by
    intro j hj
    exact norm_nonneg _
  have hP_le : P k ≤ Finset.sum (Finset.range n) P :=
    Finset.single_le_sum hP_nonneg hk
  have hN_le : N k ≤ Finset.sum (Finset.range n) N :=
    Finset.single_le_sum hN_nonneg hk
  have hE :
      2 * Eavg = Finset.sum (Finset.range n) P + Finset.sum (Finset.range n) N := by
    rw [hEavg_def]
    dsimp [P, N]
    ring
  dsimp [P, N] at hP_le hN_le ⊢
  linarith

/-- Normalize the positive reflected split into the component names used below.

This is the positive-sign companion to `reflected_neg_split_components_named`.
