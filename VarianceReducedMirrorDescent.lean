    nlinarith
  simpa [A, v] using hA

/-- Choose a positive uniform mesh scale whose segment displacement is below
the local radius.

This is the arithmetic core for the finite partition in Lan Lemma 5.8's
boundary-safe path proof. Reuse audit: searched `exists nat one_div lt
positive`, `Nat cast positive inverse tends zero`, and `norm smul one over nat
less`; Mathlib's `exists_nat_one_div_lt` supplies the Archimedean step, while
no SOptLib partition wrapper matches this standalone mesh selector. -/
private theorem exists_pos_nat_inv_smul_norm_lt
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    (d : H) {ρ : ℝ} (hρ_pos : 0 < ρ) :
    ∃ n : ℕ, 0 < n ∧ ‖((1 / (n : ℝ)) • d)‖ < ρ := by
  classical
  have hden_pos : 0 < ‖d‖ + 1 := by positivity
  have hε_pos : 0 < ρ / (‖d‖ + 1) := div_pos hρ_pos hden_pos
  obtain ⟨k, hk⟩ := exists_nat_one_div_lt hε_pos
  refine ⟨k + 1, Nat.succ_pos k, ?_⟩
  have hkpos_real : 0 < ((k + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.succ_pos k
  have hinv_nonneg : 0 ≤ (1 / (((k + 1 : ℕ) : ℝ))) := by positivity
  have hscale_le :
      (1 / (((k + 1 : ℕ) : ℝ))) * ‖d‖ ≤
        (1 / (((k + 1 : ℕ) : ℝ))) * (‖d‖ + 1) := by
    exact mul_le_mul_of_nonneg_left (by linarith [norm_nonneg d]) hinv_nonneg
  have hscale_lt :
      (1 / (((k + 1 : ℕ) : ℝ))) * (‖d‖ + 1) < ρ := by
    have hmul := mul_lt_mul_of_pos_right hk hden_pos
    have hmul' :
        (1 / (((k + 1 : ℕ) : ℝ))) * (‖d‖ + 1) <
          (ρ / (‖d‖ + 1)) * (‖d‖ + 1) := by
      simpa [Nat.cast_add, Nat.cast_one] using hmul
    have hcancel : (ρ / (‖d‖ + 1)) * (‖d‖ + 1) = ρ := by
      field_simp [ne_of_gt hden_pos]
    calc
      (1 / (((k + 1 : ℕ) : ℝ))) * (‖d‖ + 1)
          < (ρ / (‖d‖ + 1)) * (‖d‖ + 1) := hmul'
      _ = ρ := hcancel
  have hnorm_eq :
      ‖((1 / (((k + 1 : ℕ) : ℝ))) • d)‖ =
        (1 / (((k + 1 : ℕ) : ℝ))) * ‖d‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hinv_nonneg]
  calc
    ‖((1 / (((k + 1 : ℕ) : ℝ))) • d)‖ =
        (1 / (((k + 1 : ℕ) : ℝ))) * ‖d‖ := hnorm_eq
    _ ≤ (1 / (((k + 1 : ℕ) : ℝ))) * (‖d‖ + 1) := hscale_le
    _ < ρ := hscale_lt

/-- Adjacent nodes of a chosen positive uniform partition of `[0,1]` stay in
the interval and inherit the selected mesh bound.

This packages the finite-partition arithmetic needed for Lan Lemma 5.8's
boundary-safe local-to-global step. Reuse audit: searched `uniform partition
adjacent mesh Icc one_div nat`; the only relevant hit was the local mesh
selector `exists_pos_nat_inv_smul_norm_lt`, while SOptLib has no standalone
uniform-partition endpoint wrapper at this granularity. -/
private theorem uniform_partition_adjacent_mesh_lt
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    (d : H) {ρ : ℝ} {n : ℕ} (hn_pos : 0 < n)
    (hmesh_step : ‖((1 / (n : ℝ)) • d)‖ < ρ) :
    ∀ k : ℕ, k < n →
      ((k : ℝ) / (n : ℝ)) ∈ Set.Icc (0 : ℝ) 1 ∧
        (((k + 1 : ℕ) : ℝ) / (n : ℝ)) ∈ Set.Icc (0 : ℝ) 1 ∧
        (((k + 1 : ℕ) : ℝ) / (n : ℝ) - (k : ℝ) / (n : ℝ) =
          1 / (n : ℝ)) ∧
        ‖((((k + 1 : ℕ) : ℝ) / (n : ℝ) - (k : ℝ) / (n : ℝ)) • d)‖ < ρ := by
  intro k hk
  have hnR : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR
  have hk_le_n : (k : ℝ) ≤ (n : ℝ) := by
    exact_mod_cast (Nat.le_of_lt hk)
  have hk1_le_n : (((k + 1 : ℕ) : ℝ)) ≤ (n : ℝ) := by
    exact_mod_cast (Nat.succ_le_of_lt hk)
  have hk_node_mem : ((k : ℝ) / (n : ℝ)) ∈ Set.Icc (0 : ℝ) 1 := by
    constructor
    · positivity
    · have hdiv :
          (k : ℝ) / (n : ℝ) ≤ (n : ℝ) / (n : ℝ) :=
        div_le_div_of_nonneg_right hk_le_n (le_of_lt hnR)
      simpa [div_self hnR_ne] using hdiv
  have hk1_node_mem :
      (((k + 1 : ℕ) : ℝ) / (n : ℝ)) ∈ Set.Icc (0 : ℝ) 1 := by
    constructor
    · positivity
    · have hdiv :
          ((k + 1 : ℕ) : ℝ) / (n : ℝ) ≤ (n : ℝ) / (n : ℝ) :=
        div_le_div_of_nonneg_right hk1_le_n (le_of_lt hnR)
      simpa [div_self hnR_ne] using hdiv
  have hdiff :
      ((k + 1 : ℕ) : ℝ) / (n : ℝ) - (k : ℝ) / (n : ℝ) =
        1 / (n : ℝ) := by
    field_simp [hnR_ne]
    norm_num [Nat.cast_add, Nat.cast_one]
  refine ⟨hk_node_mem, hk1_node_mem, hdiff, ?_⟩
  rw [hdiff]
  simpa [one_div] using hmesh_step

/-- Select a uniform partition fine enough for the local mesh radius and the
two explicit endpoint/Riemann error budgets.

This is the arithmetic selector for Lan Lemma 5.8's finite-partition passage.
No SOptLib match: checked the pre-searched local selector
`exists_pos_nat_inv_smul_norm_lt`, searched `uniform partition mesh error
one_div nat` and `Archimedean inverse natural bound`, and found only the mesh
part, not the combined radius plus two real error estimates needed here. -/
private theorem choose_uniform_partition_for_mesh_and_error
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    (d : H) {L ρ ε : ℝ}
    (hL_pos : 0 < L) (hρ_pos : 0 < ρ) (hε_pos : 0 < ε) :
    ∃ n : ℕ, 0 < n ∧
      ‖((1 / (n : ℝ)) • d)‖ < ρ ∧
      L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) ≤ ε / 2 ∧
      L * ‖d‖ ^ 2 / (2 * (n : ℝ)) ≤ ε / (4 * L) := by
  let a : ℝ := (‖d‖ + 1) / ρ
  let b : ℝ := (2 * L ^ 2 * ‖d‖ ^ 2) / ε
  let n : ℕ := max 1 (Nat.ceil (max (max a b) b))
  have hdom := le_positive_ceil_threeway_max a b b
  have ha : a ≤ (n : ℝ) := by
    simpa [n] using hdom.1
  have hb : b ≤ (n : ℝ) := by
    simpa [n] using hdom.2.1
  have hn_pos : 0 < n := by
    dsimp [n]
    exact Nat.lt_of_lt_of_le Nat.zero_lt_one
      (Nat.le_max_left 1 (Nat.ceil (max (max a b) b)))
  have hnR_pos : 0 < (n : ℝ) := by
    exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have hmesh_budget : ‖d‖ < ρ * (n : ℝ) := by
    have ha_mul :
        ((‖d‖ + 1) / ρ) * ρ ≤ (n : ℝ) * ρ := by
      simpa [a] using mul_le_mul_of_nonneg_right ha (le_of_lt hρ_pos)
    calc
      ‖d‖ < ‖d‖ + 1 := by
        linarith [norm_nonneg d]
      _ = ((‖d‖ + 1) / ρ) * ρ := by
        field_simp [ne_of_gt hρ_pos]
      _ ≤ (n : ℝ) * ρ := ha_mul
      _ = ρ * (n : ℝ) := by ring
  have hmesh_div : ‖d‖ / (n : ℝ) < ρ := by
    calc
      ‖d‖ / (n : ℝ) < (ρ * (n : ℝ)) / (n : ℝ) :=
        div_lt_div_of_pos_right hmesh_budget hnR_pos
      _ = ρ := by
        field_simp [hnR_ne]
  have hbudget : 2 * L ^ 2 * ‖d‖ ^ 2 ≤ ε * (n : ℝ) := by
    have hb_mul :
        ((2 * L ^ 2 * ‖d‖ ^ 2) / ε) * ε ≤ (n : ℝ) * ε := by
      simpa [b] using mul_le_mul_of_nonneg_right hb (le_of_lt hε_pos)
    calc
      2 * L ^ 2 * ‖d‖ ^ 2 =
          ((2 * L ^ 2 * ‖d‖ ^ 2) / ε) * ε := by
        field_simp [ne_of_gt hε_pos]
      _ ≤ (n : ℝ) * ε := hb_mul
      _ = ε * (n : ℝ) := by ring
  have henergy : L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) ≤ ε / 2 := by
    rw [div_le_iff₀ hnR_pos]
    have hhalf := div_le_div_of_nonneg_right hbudget (by norm_num : (0 : ℝ) ≤ 2)
    calc
      L ^ 2 * ‖d‖ ^ 2 = (2 * (L ^ 2 * ‖d‖ ^ 2)) / 2 := by ring
      _ ≤ (ε * (n : ℝ)) / 2 := by
        simpa [mul_assoc] using hhalf
      _ = ε / 2 * (n : ℝ) := by ring
  have hwork : L * ‖d‖ ^ 2 / (2 * (n : ℝ)) ≤ ε / (4 * L) := by
    have hscale_nonneg : 0 ≤ 1 / (2 * L) := by positivity
    have hscaled := mul_le_mul_of_nonneg_right henergy hscale_nonneg
    calc
      L * ‖d‖ ^ 2 / (2 * (n : ℝ)) =
          (L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) * (1 / (2 * L)) := by
        field_simp [hnR_ne, ne_of_gt hL_pos]
      _ ≤ (ε / 2) * (1 / (2 * L)) := hscaled
      _ = ε / (4 * L) := by
        field_simp [ne_of_gt hL_pos]
        ring
  refine ⟨n, hn_pos, ?_, henergy, hwork⟩
  calc
    ‖((1 / (n : ℝ)) • d)‖ = ‖d‖ / (n : ℝ) := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (one_div_pos.mpr hnR_pos)]
      ring
    _ < ρ := hmesh_div

/-- Reflection of one increment across the center of the cocoercive cone.

This is the pointwise geometric algebra used in the finite partition bridge for
Lan Lemma 5.8. Reuse audit: checked `real_inner_self_eq_norm_sq`,
`inner_sub_left`, `inner_smul_left`, and searched `inner product norm square
subtraction smul expansion`; SOptLib/Mathlib provide the expansion primitives
but no packaged reflected-cone lemma. -/
private theorem finite_cone_reflection_step
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (c : ℝ) (d u : H)
    (hu : ‖u‖ ^ 2 ≤ c * ⟪u, d⟫_ℝ) :
    ‖c • d - u‖ ^ 2 ≤ c * ⟪c • d - u, d⟫_ℝ := by
  have hleft :
      ‖c • d - u‖ ^ 2 =
        c ^ 2 * ‖d‖ ^ 2 - 2 * c * ⟪u, d⟫_ℝ + ‖u‖ ^ 2 := by
    rw [← real_inner_self_eq_norm_sq (c • d - u)]
    simp only [sub_eq_add_neg, inner_add_left, inner_add_right, inner_neg_left,
      inner_neg_right, inner_smul_left, inner_smul_right]
    rw [real_inner_self_eq_norm_sq d, real_inner_self_eq_norm_sq u]
    simp [real_inner_comm]
    ring
  have hright :
      c * ⟪c • d - u, d⟫_ℝ =
        c ^ 2 * ‖d‖ ^ 2 - c * ⟪u, d⟫_ℝ := by
    simp only [sub_eq_add_neg, inner_add_left, inner_add_right, inner_neg_left,
      inner_neg_right, inner_smul_left, inner_smul_right]
    rw [real_inner_self_eq_norm_sq d]
    simp [real_inner_comm]
    ring
  rw [hleft, hright]
  linarith

/-- Scalar inner-products along the path inherit the vector Lipschitz bound.

This is the scalarization step in Lan Lemma 5.8's Riemann-work estimate.
Alignment audit: checked SOptLib's `le_value_add_of_hasDerivWithinAt_le_affine_on_Icc`
for the subsequent one-step calculus bridge and searched `absolute value inner
product norm Cauchy Schwarz real_inner`; Mathlib's `abs_real_inner_le_norm`
provides the exact Cauchy-Schwarz ingredient, while no SOptLib wrapper packages
this path-specific scalar derivative bound. -/
private theorem inner_path_derivative_lipschitz_on_Icc
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (g : ℝ → H) (d : H) (L : ℝ)
    (hgLip : ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
      ‖g t - g s‖ ≤ L * ‖(t - s) • d‖) :
    ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
      |⟪g t, d⟫_ℝ - ⟪g s, d⟫_ℝ| ≤
        L * ‖d‖ ^ 2 * |t - s| := by
  intro s hs t ht
  have hinner :
      ⟪g t, d⟫_ℝ - ⟪g s, d⟫_ℝ = ⟪g t - g s, d⟫_ℝ := by
    rw [inner_sub_left]
  have hcs :
      |⟪g t - g s, d⟫_ℝ| ≤ ‖g t - g s‖ * ‖d‖ :=
    abs_real_inner_le_norm (g t - g s) d
  have hlip := hgLip s hs t ht
  have hmul :
      ‖g t - g s‖ * ‖d‖ ≤
        (L * ‖(t - s) • d‖) * ‖d‖ :=
    mul_le_mul_of_nonneg_right hlip (norm_nonneg d)
  calc
    |⟪g t, d⟫_ℝ - ⟪g s, d⟫_ℝ|
        = |⟪g t - g s, d⟫_ℝ| := by rw [hinner]
    _ ≤ ‖g t - g s‖ * ‖d‖ := hcs
    _ ≤ (L * ‖(t - s) • d‖) * ‖d‖ := hmul
    _ = L * ‖d‖ ^ 2 * |t - s| := by
      rw [norm_smul, Real.norm_eq_abs]
      ring

/-- Uniform-partition increments of a scalar path telescope to the endpoint
difference.

This is the finite-sum part of Lan Lemma 5.8's Riemann-work estimate.
Alignment audit: searched `Finset sum range telescope sub consecutive function`;
SOptLib's `sum_Icc_sub_succ` is the closed-interval version, while Mathlib's
`Finset.sum_range_sub'` directly matches this zero-based range form. -/
private theorem uniform_partition_phi_increment_telescope
    (φ : ℝ → ℝ) {n : ℕ} (hn_pos : 0 < n) :
    Finset.sum (Finset.range n)
        (fun k => φ (((k + 1 : ℕ) : ℝ) / (n : ℝ)) -
          φ ((k : ℝ) / (n : ℝ))) =
      φ 1 - φ 0 := by
  have hnR_pos : 0 < (n : ℝ) := by
    exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have htel :
      Finset.sum (Finset.range n)
          (fun k => φ (((k + 1 : ℕ) : ℝ) / (n : ℝ)) -
            φ ((k : ℝ) / (n : ℝ))) =
        φ ((n : ℝ) / (n : ℝ)) - φ ((0 : ℕ) / (n : ℝ)) := by
    have htel0 :
        Finset.sum (Finset.range n)
            (fun k => φ ((k : ℝ) / (n : ℝ)) -
              φ (((k + 1 : ℕ) : ℝ) / (n : ℝ))) =
          φ ((0 : ℕ) / (n : ℝ)) - φ ((n : ℝ) / (n : ℝ)) := by
      simpa [Nat.cast_add, Nat.cast_one] using
        (Finset.sum_range_sub' (fun k : ℕ => φ ((k : ℝ) / (n : ℝ))) n)
    calc
      Finset.sum (Finset.range n)
          (fun k => φ (((k + 1 : ℕ) : ℝ) / (n : ℝ)) -
            φ ((k : ℝ) / (n : ℝ)))
          = - Finset.sum (Finset.range n)
              (fun k => φ ((k : ℝ) / (n : ℝ)) -
                φ (((k + 1 : ℕ) : ℝ) / (n : ℝ))) := by
            rw [← Finset.sum_neg_distrib]
            apply Finset.sum_congr rfl
            intro k hk
            ring
      _ = φ ((n : ℝ) / (n : ℝ)) - φ ((0 : ℕ) / (n : ℝ)) := by
            rw [htel0]
            ring
  simpa [div_self hnR_ne] using htel

/-- One left-endpoint work term on a uniform partition is bounded by the
corresponding scalar increment plus the quadratic Lipschitz error.

This is the true calculus atom in Lan Lemma 5.8's Riemann-work estimate.
Alignment audit: selected SOptLib's
`le_value_add_of_hasDerivWithinAt_le_affine_on_Icc` after checking its full
signature, and used the local scalar Lipschitz helper
`inner_path_derivative_lipschitz_on_Icc`; no SOptLib lemma packages this
boundary-safe affine rescaling of an arbitrary subinterval. -/
private theorem left_partition_step_work_le_phi_increment_add_error
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (φ : ℝ → ℝ) (g : ℝ → H) (d : H) (L : ℝ) {n : ℕ}
    (hL_pos : 0 < L) (hn_pos : 0 < n)
    (hgLip : ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
      ‖g t - g s‖ ≤ L * ‖(t - s) • d‖)
    (hderiv : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      HasDerivWithinAt φ ⟪g t, d⟫_ℝ (Set.Icc (0 : ℝ) 1) t)
    {k : ℕ} (hk : k < n) :
    (1 / (n : ℝ)) * ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ ≤
      φ (((k + 1 : ℕ) : ℝ) / (n : ℝ)) -
        φ ((k : ℝ) / (n : ℝ)) +
          L * ‖d‖ ^ 2 / (2 * (n : ℝ) ^ 2) := by
  classical
  let I : Set ℝ := Set.Icc (0 : ℝ) 1
  let a : ℝ := (k : ℝ) / (n : ℝ)
  let h : ℝ := 1 / (n : ℝ)
  have hnR_pos : 0 < (n : ℝ) := by
    exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have h_nonneg : 0 ≤ h := by
    dsimp [h]
    positivity
  have hmaps : Set.MapsTo (fun u : ℝ => a + h * u) I I := by
    intro u hu
    have hu0 : 0 ≤ u := by simpa [I] using hu.1
    have hu1 : u ≤ 1 := by simpa [I] using hu.2
    have hk_succ_le : (k : ℝ) + 1 ≤ (n : ℝ) := by
      exact_mod_cast (Nat.succ_le_of_lt hk)
    constructor
    · have ha_nonneg : 0 ≤ a := by
        dsimp [a]
        positivity
      have hhu_nonneg : 0 ≤ h * u := mul_nonneg h_nonneg hu0
      dsimp [I]
      nlinarith
    · have hku : (k : ℝ) + u ≤ (n : ℝ) := by
        nlinarith
      have hfrac : ((k : ℝ) + u) / (n : ℝ) ≤ 1 := by
        rw [div_le_iff₀ hnR_pos]
        simpa using hku
      have heq : a + h * u = ((k : ℝ) + u) / (n : ℝ) := by
        dsimp [a, h]
        field_simp [hnR_ne]
      dsimp [I]
      simpa [heq] using hfrac
  have ha_mem : a ∈ I := by
    have h0 : (0 : ℝ) ∈ I := by
      norm_num [I]
    have h := hmaps h0
    simpa [a, h] using h
  let F : ℝ → ℝ := fun u => -φ (a + h * u)
  let psi : ℝ → ℝ := fun u => -(h * ⟪g (a + h * u), d⟫_ℝ)
  have hFderiv : ∀ u ∈ I, HasDerivWithinAt F (psi u) I u := by
    intro u hu
    have hline_deriv : HasDerivWithinAt (fun v : ℝ => a + h * v) h I u := by
      have hmul : HasDerivWithinAt (fun v : ℝ => h * v) h I u := by
        simpa using ((hasDerivWithinAt_id (x := u) (s := I)).const_mul h)
      simpa using hmul.const_add a
    have hφ := hderiv (a + h * u) (hmaps hu)
    have hcomp := hφ.comp u hline_deriv hmaps
    have hneg := hcomp.neg
    convert hneg using 1 <;> simp [F, psi, Function.comp_def] <;> ring
  have hinnerLip := inner_path_derivative_lipschitz_on_Icc g d L hgLip
  have hbound : ∀ u ∈ I,
      psi u ≤ -(h * ⟪g a, d⟫_ℝ) + (L * ‖d‖ ^ 2 * h ^ 2) * u := by
    intro u hu
    have hu0 : 0 ≤ u := by simpa [I] using hu.1
    have hpt_mem : a + h * u ∈ I := hmaps hu
    have habs :=
      hinnerLip a ha_mem (a + h * u) hpt_mem
    have hdiff_le :
        ⟪g a, d⟫_ℝ - ⟪g (a + h * u), d⟫_ℝ ≤
          L * ‖d‖ ^ 2 * |(a + h * u) - a| := by
      calc
        ⟪g a, d⟫_ℝ - ⟪g (a + h * u), d⟫_ℝ =
            -(⟪g (a + h * u), d⟫_ℝ - ⟪g a, d⟫_ℝ) := by
              ring
        _ ≤ |⟪g (a + h * u), d⟫_ℝ - ⟪g a, d⟫_ℝ| := neg_le_abs _
        _ ≤ L * ‖d‖ ^ 2 * |(a + h * u) - a| := habs
    have hscaled := mul_le_mul_of_nonneg_left hdiff_le h_nonneg
    have habs_arg : |(a + h * u) - a| = h * u := by
      have hhu_nonneg : 0 ≤ h * u := mul_nonneg h_nonneg hu0
      have hsub : (a + h * u) - a = h * u := by ring
      rw [hsub, abs_of_nonneg hhu_nonneg]
    calc
      psi u = -(h * ⟪g (a + h * u), d⟫_ℝ) := by
        simp [psi]
      _ = -(h * ⟪g a, d⟫_ℝ) +
            h * (⟪g a, d⟫_ℝ - ⟪g (a + h * u), d⟫_ℝ) := by
            ring
      _ ≤ -(h * ⟪g a, d⟫_ℝ) +
            h * (L * ‖d‖ ^ 2 * |(a + h * u) - a|) := by
            simpa [add_comm, add_left_comm, add_assoc] using
              add_le_add_left hscaled (-(h * ⟪g a, d⟫_ℝ))
      _ = -(h * ⟪g a, d⟫_ℝ) + (L * ‖d‖ ^ 2 * h ^ 2) * u := by
