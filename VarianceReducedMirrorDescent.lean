/-- Early scalar telescope for the reflected last-edge bracket.

This is the declaration-order-safe copy of the reflected summation-by-parts
algebra used by the source-cycle proof. No SOptLib match: searched `Finset sum
if last cyclic shift summation by parts`; Mathlib has adjacent telescopes such
as `Finset.sum_range_sub'`, but not this route-specific reflected last-edge
form. -/
private theorem early_reflected_if_last_scalar_sum_eq_boundary_pred
    {n : ℕ} (hn_pos : 0 < n) (a b : ℕ → ℝ) (c : ℝ) :
    Finset.sum (Finset.range n)
        (fun k => if hlast : k + 1 = n then -a k else b k - a k) + c =
      c - a 0 + Finset.sum (Finset.range (n - 1)) (fun k => b k - a (k + 1)) := by
  classical
  rcases Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn_pos) with ⟨m, rfl⟩
  have hsplit :
      Finset.sum (Finset.range (m + 1))
          (fun k => if hlast : k + 1 = m + 1 then -a k else b k - a k) =
        Finset.sum (Finset.range m) (fun k => b k - a k) - a m := by
    rw [Finset.sum_range_succ]
    have hsum :
        Finset.sum (Finset.range m)
            (fun k => if hlast : k + 1 = m + 1 then -a k else b k - a k) =
          Finset.sum (Finset.range m) (fun k => b k - a k) := by
      apply Finset.sum_congr rfl
      intro k hk
      have hk_ne : k ≠ m := by
        have hklt : k < m := Finset.mem_range.mp hk
        omega
      simp [hk_ne]
    rw [hsum]
    simp
    ring
  have htel :
      Finset.sum (Finset.range m) (fun k => a k - a (k + 1)) = a 0 - a m := by
    simpa using (Finset.sum_range_sub' a m)
  rw [hsplit]
  have hsumdiff :
      Finset.sum (Finset.range m) (fun k => b k - a k) -
          Finset.sum (Finset.range m) (fun k => b k - a (k + 1)) =
        -(a 0 - a m) := by
    have hcalc :
        Finset.sum (Finset.range m) (fun k => b k - a k) -
            Finset.sum (Finset.range m) (fun k => b k - a (k + 1)) =
          -(Finset.sum (Finset.range m) (fun k => a k - a (k + 1))) := by
      have hright :
          Finset.sum (Finset.range m) (fun k => a k - a (k + 1)) =
            Finset.sum (Finset.range m) (fun k => a k) -
              Finset.sum (Finset.range m) (fun k => a (k + 1)) := by
        rw [Finset.sum_sub_distrib]
      rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib, hright]
      ring
    rw [hcalc, htel]
  have hnsub : m.succ - 1 = m := by omega
  rw [hnsub]
  nlinarith [hsumdiff]

/-- Early Hilbert summation-by-parts for the reflected last-edge bracket.

This is the finite-dimensional algebra piece needed by Lan Lemma 5.8's
perturbed reflected cycle. Search audit: considered downstream local
`reflected_if_last_inner_sum_eq_boundary_pred` and Mathlib telescopes; the
downstream helper has the right shape but is declared after the endpoint
scaffold, so this early copy exposes the same source-neutral identity. -/
private theorem early_reflected_if_last_inner_sum_eq_boundary_pred
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (g q : ℕ → H) :
    Finset.sum (Finset.range n)
        (fun k =>
          if hlast : k + 1 = n then
            -⟪g k, q k⟫_ℝ
          else
            ⟪g k, q (k + 1) - q k⟫_ℝ) +
      ⟪g n, q 0⟫_ℝ =
    ⟪g n - g 0, q 0⟫_ℝ +
      Finset.sum (Finset.range (n - 1))
        (fun k => ⟪g k - g (k + 1), q (k + 1)⟫_ℝ) := by
  classical
  let a : ℕ → ℝ := fun k => ⟪g k, q k⟫_ℝ
  let b : ℕ → ℝ := fun k => ⟪g k, q (k + 1)⟫_ℝ
  have hscalar :=
    early_reflected_if_last_scalar_sum_eq_boundary_pred hn_pos a b ⟪g n, q 0⟫_ℝ
  dsimp [a, b] at hscalar
  calc
    Finset.sum (Finset.range n)
        (fun k =>
          if hlast : k + 1 = n then
            -⟪g k, q k⟫_ℝ
          else
            ⟪g k, q (k + 1) - q k⟫_ℝ) +
      ⟪g n, q 0⟫_ℝ
        = Finset.sum (Finset.range n)
            (fun k =>
              if hlast : k + 1 = n then
                -⟪g k, q k⟫_ℝ
              else
                ⟪g k, q (k + 1)⟫_ℝ - ⟪g k, q k⟫_ℝ) +
            ⟪g n, q 0⟫_ℝ := by
          congr 1
          apply Finset.sum_congr rfl
          intro k hk
          by_cases hlast : k + 1 = n
          · simp [hlast]
          · simp [hlast, inner_sub_right]
    _ = ⟪g n, q 0⟫_ℝ - ⟪g 0, q 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪g k, q (k + 1)⟫_ℝ - ⟪g (k + 1), q (k + 1)⟫_ℝ) := hscalar
    _ = ⟪g n - g 0, q 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪g k - g (k + 1), q (k + 1)⟫_ℝ) := by
          simp [inner_sub_left]

/-- Early scaled reflected-bracket rewrite.

This is the inverse-`L` specialization consumed by the reflected-cycle split.
Search audit: checked downstream `reflected_scaled_bracket_sum_rewrite` and
the unscaled reflected bracket identity above; SOptLib/Mathlib do not package
this finite Hilbert bracket specialization. -/
private theorem early_reflected_scaled_bracket_sum_rewrite
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (L : ℝ) (g r : ℕ → H) :
    (Finset.sum (Finset.range n)
        (fun k =>
          if hlast : k + 1 = n then
            -⟪g k, (1 / L) • r k⟫_ℝ
          else
            ⟪g k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) +
      ⟪g n, (1 / L) • r 0⟫_ℝ) =
    (1 / L) *
      (⟪g n - g 0, r 0⟫_ℝ +
        Finset.sum (Finset.range (n - 1))
          (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)) := by
  classical
  have hbase :=
    early_reflected_if_last_inner_sum_eq_boundary_pred
      (H := H) hn_pos g (fun k => (1 / L) • r k)
  calc
    (Finset.sum (Finset.range n)
        (fun k =>
          if hlast : k + 1 = n then
            -⟪g k, (1 / L) • r k⟫_ℝ
          else
            ⟪g k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) +
      ⟪g n, (1 / L) • r 0⟫_ℝ)
        =
      ⟪g n - g 0, (1 / L) • r 0⟫_ℝ +
        Finset.sum (Finset.range (n - 1))
          (fun k => ⟪g k - g (k + 1), (1 / L) • r (k + 1)⟫_ℝ) := hbase
    _ =
      (1 / L) *
        (⟪g n - g 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)) := by
        simp only [inner_smul_right]
        rw [← Finset.mul_sum, ← mul_add]

/-- Early frozen-field split for the reflected perturbation cycle.

This is a declaration-order-safe copy of the downstream
`reflected_frozen_field_split_pred`, aligned with Lan Lemma 5.8's perturbed
