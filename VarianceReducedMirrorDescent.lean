    choose_uniform_partition_for_mesh_and_error d hL_pos hρ_pos hε_pos
  have hrev :=
    reverse_uniform_partition_work_sum_from_local_pair
      φ g d L ρ hL_pos hlocal_pair hn_pos hmesh
