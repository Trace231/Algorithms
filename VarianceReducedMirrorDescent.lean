/-- Endpoint Baillon--Haddad energy converted to the uniform source-mesh
endpoint bound used by the Q-form bridge.

This is declaration-order safe: the analytic open-convex endpoint theorem can
be supplied later as `hzero_endpoint`, while this lemma performs only the
forward-mesh and scalar endpoint normalization. -/
private theorem zero_base_endpoint_energy_to_source_mesh_endpoint_bound
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUconv : Convex ℝ U)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) (d : H) (x g : ℕ → H)
    (hx0_mem : x 0 ∈ U) (hxn_mem : x n ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hmesh :
      ∀ k, k ≤ n →
        x k = AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ)))
    (hclose : x 0 - x n = -d)
    (hzero_endpoint :
      ‖B (x n)‖ ^ 2 ≤ 2 * L * (Φ (x n) - Φ (x 0))) :
    ‖g n‖ ^ 2 ≤
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
        L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
  classical
  have hdx : x n - x 0 = d := by
    have h := congrArg Neg.neg hclose
    simpa [neg_sub] using h
  have hsum :
      Finset.sum (Finset.range n)
          (fun k =>
            ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
              d⟫_ℝ) =
        Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ) := by
    apply Finset.sum_congr rfl
    intro k hk
    have hk_le : k ≤ n := Nat.le_of_lt (Finset.mem_range.mp hk)
    have hxk := hmesh k hk_le
    calc
      ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
          d⟫_ℝ
          = ⟪B (x k), d⟫_ℝ := by rw [← hxk]
      _ = ⟪g k, d⟫_ℝ := by rw [← hg k]
  have hforward :
      Φ (x n) - Φ (x 0) ≤
        (1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                  x n - x 0⟫_ℝ) +
          L * ‖x n - x 0‖ ^ 2 / (2 * (n : ℝ)) :=
    uniform_forward_mesh_gap_upper_from_hasFDeriv_lipschitz
      Φ B U L hL_pos hUconv hgrad hBLip (x 0) hx0_mem (x n) hxn_mem hn_pos
  have htwoL_nonneg : 0 ≤ 2 * L := by nlinarith
  have hscaled :
      2 * L * (Φ (x n) - Φ (x 0)) ≤
        2 * L *
          ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                    x n - x 0⟫_ℝ) +
            L * ‖x n - x 0‖ ^ 2 / (2 * (n : ℝ))) :=
    mul_le_mul_of_nonneg_left hforward htwoL_nonneg
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have hendpoint :
      ‖B (x n)‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                    x n - x 0⟫_ℝ)) +
          L ^ 2 * ‖x n - x 0‖ ^ 2 / (n : ℝ) := by
    calc
      ‖B (x n)‖ ^ 2 ≤ 2 * L * (Φ (x n) - Φ (x 0)) := hzero_endpoint
      _ ≤
          2 * L *
            ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n)
                  (fun k =>
                    ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                      x n - x 0⟫_ℝ) +
              L * ‖x n - x 0‖ ^ 2 / (2 * (n : ℝ))) := hscaled
      _ =
          2 * L *
              ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n)
                  (fun k =>
                    ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                      x n - x 0⟫_ℝ)) +
            L ^ 2 * ‖x n - x 0‖ ^ 2 / (n : ℝ) := by
        field_simp [hnR_ne]
  have hgn : g n = B (x n) := hg n
  rw [← hgn] at hendpoint
  simpa [hsum, hdx] using hendpoint

/-- Source-preserving endpoint/cocoercivity bridge for the Q-form absorption.

This is the acyclic replacement interface for the old bare canonical interval:
the reflected source split data stay in scope, while the two genuinely
source-derived obligations are exposed explicitly:

* the endpoint mesh-energy bound, supplied by open-convex Baillon--Haddad;
* the signed double-`Q` gap cover, supplied by the reflected two-sign data.

The proof below is intentionally only the finite algebra tail. -/
private theorem source_endpoint_cocoercivity_bridge
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) {τ : ℝ}
    (hτ_pos : 0 < τ)
    (d : H) (x g r : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hyPert_mem_pos :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hyPert_mem_neg :
      ∀ k, k ≤ n + 1 →
        reflectedPerturbedCycle L τ n x (fun j => -r j) k ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    (hclose : x 0 - x n = -d)
    (hg0 : g 0 = 0)
    (hpos_named :
      let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        τ *
          ((1 / L) *
            (⟪g n - g 0, r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
      let errorWork_pos : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yPos k) - g k, yPos (k + 1) - yPos k⟫_ℝ)
      let baseTilt : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n - g n, x 0 - x n⟫_ℝ
      let predTilt : ℝ :=
        τ *
          ((1 / L) *
            (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork_pos : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ)
      (baseB + predB) + errorWork_pos ≤ 0 ∧
        (baseTilt + predTilt) + residualWork_pos - errorWork_pos ≤ 0)
    (hneg_named :
      let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        τ *
          ((1 / L) *
            (⟪g n - g 0, r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
      let errorWork_neg : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yNeg k) - g k, yNeg (k + 1) - yNeg k⟫_ℝ)
      let baseTilt : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n - g n, x 0 - x n⟫_ℝ
      let predTilt : ℝ :=
        τ *
          ((1 / L) *
            (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork_neg : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ)
      (baseB - predB) + errorWork_neg ≤ 0 ∧
        (baseTilt - predTilt) + residualWork_neg - errorWork_neg ≤ 0)
    {Rsum Q Eavg : ℝ}
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n) (fun k => ‖g (k + 1) - g k‖ ^ 2))
    (hEavg_def :
      Eavg =
        (Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                  g k)‖)) /
          2)
    (hendpoint_mesh :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ))
    (hgap_pair :
      Finset.sum (Finset.range n)
          (fun k =>
            2 * ⟪r k, (L / (n : ℝ)) • d⟫_ℝ - ‖r k‖ ^ 2 -
              ‖g (k + 1) - g k‖ ^ 2)
        ≤
          (1 / 2) *
            Finset.sum (Finset.range n)
              (fun k =>
                ‖(1 / L) •
                    (B (reflectedPerturbedCycle L τ n x r k) - g k)‖ +
                  ‖(1 / L) •
                    (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                      g k)‖)) :
    -(2 * Rsum + Q) ≤ Eavg := by
  classical
  have _ := hsupport
  have _ := hupper
  have _ := hBLip
  have _ := hτ_pos
  have _ := hx_mem_range
  have _ := hyPert_mem_pos
  have _ := hyPert_mem_neg
  have _ := hg
  have _ := hstep
  have _ := hclose
  have _ := hpos_named
  have _ := hneg_named
  let pairNorm : ℕ → ℝ := fun k =>
    ‖(1 / L) •
        (B (reflectedPerturbedCycle L τ n x r k) - g k)‖ +
      ‖(1 / L) •
        (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖
  have hpair_sum :
      Finset.sum (Finset.range n) pairNorm = 2 * Eavg := by
    rw [hEavg_def]
    dsimp [pairNorm]
    rw [Finset.sum_add_distrib]
    ring
  have hgap_pair' :
      Finset.sum (Finset.range n)
          (fun k =>
            2 * ⟪r k, (L / (n : ℝ)) • d⟫_ℝ - ‖r k‖ ^ 2 -
              ‖g (k + 1) - g k‖ ^ 2)
        ≤ (1 / 2) * Finset.sum (Finset.range n) pairNorm := by
    simpa [pairNorm] using hgap_pair
  have hqform : 0 ≤ 2 * Rsum + Q + Eavg :=
    endpoint_mesh_energy_and_pairnorm_gap_to_q_form_absorption
      hn_pos d hL_pos g r pairNorm hg0 hr
      hRsum_def hQ_def hendpoint_mesh hgap_pair' hpair_sum
  linarith

/-- Acyclic source endpoint bridge all the way to the Q-form.

This packages the two declaration-order-safe leaves needed by the corrected
Lemma 5.8 route: open-convex endpoint cocoercivity is supplied as the
zero-base endpoint estimate, and the signed two-reflection finite algebra is
supplied as the pair-norm gap cover.  The public algorithmic theorem does not
see these extra obligations; they are private proof plumbing. -/
private theorem source_zero_endpoint_and_gap_to_q_form_absorption
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUconv : Convex ℝ U)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) {τ : ℝ}
    (hτ_pos : 0 < τ)
    (d : H) (x g r : ℕ → H)
    (hx0_mem : x 0 ∈ U)
    (hxn_mem : x n ∈ U)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hyPert_mem_pos :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hyPert_mem_neg :
      ∀ k, k ≤ n + 1 →
        reflectedPerturbedCycle L τ n x (fun j => -r j) k ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    (hmesh :
      ∀ k, k ≤ n →
        x k = AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ)))
    (hclose : x 0 - x n = -d)
    (hg0 : g 0 = 0)
    (hpos_named :
      let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        τ *
