            L ^ 2 * ‖x n - x 0‖ ^ 2 / (n : ℝ) := by
          field_simp [hnR_ne]
  have hgn : g n = B (x n) := hg n
  rw [← hgn] at hendpoint
  simpa [hsum, hdx] using hendpoint

