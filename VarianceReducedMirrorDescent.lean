      z hz hΦz hBz u hu hn_pos
  have hendpoint :
      ‖B u‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖g ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
