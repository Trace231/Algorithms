private theorem signed_defect_edge_reconstruction_from_edges
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (L τ : ℝ) (d : H) (B : H → H) (g r yPos yNeg : ℕ → H)
    {driftError oscillationError errorWork_pos errorWork_neg : ℝ}
    (hdriftError_def :
      driftError =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k, (1 / (n : ℝ)) • d⟫_ℝ -
                ⟪B (yNeg k) - g k, (1 / (n : ℝ)) • d⟫_ℝ) +
          (⟪B (yPos (n - 1)) - g (n - 1), (1 / (n : ℝ)) • d⟫_ℝ -
            ⟪B (yNeg (n - 1)) - g (n - 1), (1 / (n : ℝ)) • d⟫_ℝ))
    (hoscillationError_def :
      oscillationError =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k, (1 / L) • (r (k + 1) - r k)⟫_ℝ +
                ⟪B (yNeg k) - g k, (1 / L) • (r (k + 1) - r k)⟫_ℝ) -
          (⟪B (yPos (n - 1)) - g (n - 1),
              (1 / L) • r (n - 1)⟫_ℝ +
            ⟪B (yNeg (n - 1)) - g (n - 1),
              (1 / L) • r (n - 1)⟫_ℝ))
    (herrorWork_pos_edge :
      errorWork_pos =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k,
                (1 / (n : ℝ)) • d +
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yPos (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d -
              τ • ((1 / L) • r (n - 1))⟫_ℝ)
    (herrorWork_neg_edge :
      errorWork_neg =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yNeg k) - g k,
                (1 / (n : ℝ)) • d -
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yNeg (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d +
              τ • ((1 / L) • r (n - 1))⟫_ℝ) :
    driftError + τ * oscillationError = errorWork_pos - errorWork_neg := by
  classical
  have hsum_pair :
      Finset.sum (Finset.range (n - 1))
          (fun k =>
            ⟪B (yPos k) - g k,
              (1 / (n : ℝ)) • d +
                τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ -
              ⟪B (yNeg k) - g k,
                (1 / (n : ℝ)) • d -
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) =
        Finset.sum (Finset.range (n - 1))
          (fun k =>
            (⟪B (yPos k) - g k, (1 / (n : ℝ)) • d⟫_ℝ -
              ⟪B (yNeg k) - g k, (1 / (n : ℝ)) • d⟫_ℝ) +
            τ *
              (⟪B (yPos k) - g k,
                (1 / L) • (r (k + 1) - r k)⟫_ℝ +
                ⟪B (yNeg k) - g k,
                  (1 / L) • (r (k + 1) - r k)⟫_ℝ)) := by
    apply Finset.sum_congr rfl
    intro k hk
    exact
      reflected_error_edge_pair_split_pos
        (B (yPos k) - g k) (B (yNeg k) - g k)
        ((1 / (n : ℝ)) • d)
        ((1 / L) • (r (k + 1) - r k)) τ
  have hlast_pair :
      ⟪B (yPos (n - 1)) - g (n - 1),
        (1 / (n : ℝ)) • d -
          τ • ((1 / L) • r (n - 1))⟫_ℝ -
        ⟪B (yNeg (n - 1)) - g (n - 1),
          (1 / (n : ℝ)) • d +
            τ • ((1 / L) • r (n - 1))⟫_ℝ =
      (⟪B (yPos (n - 1)) - g (n - 1),
          (1 / (n : ℝ)) • d⟫_ℝ -
        ⟪B (yNeg (n - 1)) - g (n - 1),
          (1 / (n : ℝ)) • d⟫_ℝ) -
        τ *
          (⟪B (yPos (n - 1)) - g (n - 1),
              (1 / L) • r (n - 1)⟫_ℝ +
            ⟪B (yNeg (n - 1)) - g (n - 1),
              (1 / L) • r (n - 1)⟫_ℝ) :=
    reflected_error_edge_pair_split_last
      (B (yPos (n - 1)) - g (n - 1))
      (B (yNeg (n - 1)) - g (n - 1))
      ((1 / (n : ℝ)) • d) ((1 / L) • r (n - 1)) τ
  have hwork_to_split :
      errorWork_pos - errorWork_neg =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k,
                (1 / (n : ℝ)) • d +
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ -
                ⟪B (yNeg k) - g k,
                  (1 / (n : ℝ)) • d -
                    τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          (⟪B (yPos (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d -
              τ • ((1 / L) • r (n - 1))⟫_ℝ -
            ⟪B (yNeg (n - 1)) - g (n - 1),
              (1 / (n : ℝ)) • d +
                τ • ((1 / L) • r (n - 1))⟫_ℝ) := by
    rw [herrorWork_pos_edge, herrorWork_neg_edge]
    rw [Finset.sum_sub_distrib]
    abel
  have hsplit_to_defect :
      Finset.sum (Finset.range (n - 1))
          (fun k =>
            ⟪B (yPos k) - g k,
              (1 / (n : ℝ)) • d +
                τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ -
              ⟪B (yNeg k) - g k,
                (1 / (n : ℝ)) • d -
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
        (⟪B (yPos (n - 1)) - g (n - 1),
          (1 / (n : ℝ)) • d -
            τ • ((1 / L) • r (n - 1))⟫_ℝ -
          ⟪B (yNeg (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d +
              τ • ((1 / L) • r (n - 1))⟫_ℝ) =
        driftError + τ * oscillationError := by
    rw [hsum_pair, hlast_pair]
    rw [Finset.sum_add_distrib, ← Finset.mul_sum]
    rw [hdriftError_def, hoscillationError_def]
    ring
  rw [hwork_to_split, hsplit_to_defect]

