    forward_local_pair_gap_sum_controls_mesh_energy_budget
      φ g d L ρ hL_pos hlocal_pair hn_pos hmesh
  have hendpointMesh :
      ‖B u‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖g ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
                  g ((k : ℝ) / (n : ℝ))‖ ^ 2) +
          ε / 2 := by
    simpa [g, line, d] using
      ambient_endpoint_energy_le_forward_mesh_work_add_budget
        Φ B U L ε hL_pos hUopen hUconv hnonneg hsupport hupper hgrad hBLip
        z hz hBz u hu hn_pos henergyBudget
  calc
    ‖B u‖ ^ 2
        ≤ 2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k =>
