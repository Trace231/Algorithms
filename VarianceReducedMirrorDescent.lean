    L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) - 2 * Q =
      Finset.sum (Finset.range n)
        (fun k =>
          2 * ⟪r k, (L / (n : ℝ)) • d⟫_ℝ - ‖r k‖ ^ 2) -
        Q := by
  have hgap :=
    mesh_gap_as_residual_cross_terms
      hn_pos hL_pos d g r hr hQ_def
