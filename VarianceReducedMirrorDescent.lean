                ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
            ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
          (Finset.sum (Finset.range n)
              (fun k =>
                ⟪L • x k - g k, yPert (k + 1) - yPert k⟫_ℝ) +
            ⟪L • x n - g n, yPert (n + 1) - yPert n⟫_ℝ) +
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪perturbScale • r k - (B (yPert k) - g k),
                yPert (k + 1) - yPert k⟫_ℝ) := by
        simpa [yPert] using
          (tilt_moving_frozen_residual_split (H := H)
            hn_pos hL_pos B x g r (by intro k; simp [g]))
      have htilt_frozen_residual_nonpos :
          (Finset.sum (Finset.range n)
              (fun k =>
                ⟪L • x k - g k, yPert (k + 1) - yPert k⟫_ℝ) +
            ⟪L • x n - g n, yPert (n + 1) - yPert n⟫_ℝ) +
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪perturbScale • r k - (B (yPert k) - g k),
                yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
        have h := hcycle_tilt_perturbed_split
        rwa [htilt_moving_frozen_residual_split] at h
      have htilt_pred_residual_nonpos :
          ((Finset.sum (Finset.range n)
              (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
            ⟪L • x n - g n, x 0 - x n⟫_ℝ) +
          perturbScale *
            (1 / L *
              (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
                Finset.sum (Finset.range (n - 1))
                  (fun k =>
                    ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                      r (k + 1)⟫_ℝ)))) +
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪perturbScale • r k - (B (yPert k) - g k),
                yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
        have h := htilt_frozen_residual_nonpos
        rw [htilt_frozen_perturbed_split_pred] at h
        simpa [add_assoc] using h
      have hB_moving_frozen_error_split :
          Finset.sum (Finset.range n)
              (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
            ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ =
          (Finset.sum (Finset.range n)
              (fun k => ⟪g k, yPert (k + 1) - yPert k⟫_ℝ) +
            ⟪g n, yPert (n + 1) - yPert n⟫_ℝ) +
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) := by
        simpa [yPert] using
          (reflected_moving_B_frozen_error_split (H := H)
            hn_pos B x g r (by intro k; simp [g]))
      have hB_pred_error_nonpos :
          ((Finset.sum (Finset.range n)
              (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
            ⟪g n, x 0 - x n⟫_ℝ) +
          perturbScale *
            (1 / L *
              (⟪g n - g 0, r 0⟫_ℝ +
                Finset.sum (Finset.range (n - 1))
                  (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))) +
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪B (yPert k) - g k, yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 := by
        have h := hcycle_B_perturbed_split
        rw [hB_moving_frozen_error_split, hB_frozen_perturbed_split_pred] at h
        simpa [add_assoc] using h
      have htilt_pred_error_nonpos' :
          ((Finset.sum (Finset.range n)
              (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
            ⟪L • x n - g n, x 0 - x n⟫_ℝ) +
          perturbScale *
            (1 / L *
              (⟪L • x n - g n - (L • x 0 - g 0), r 0⟫_ℝ +
                Finset.sum (Finset.range (n - 1))
