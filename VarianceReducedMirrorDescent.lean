        τ *
          ((1 / L) *
            (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • r k, yPert (k + 1) - yPert k⟫_ℝ)
      baseB + predB + errorWork ≤ 0 ∧
        baseTilt + predTilt + residualWork - errorWork ≤ 0) :
    let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
    let baseB : ℝ :=
      Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ
    let predB : ℝ :=
      τ *
        ((1 / L) *
          (⟪g n - g 0, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
    let errorWork_pos : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPos k) - g k, yPos (k + 1) - yPos k⟫_ℝ)
    let baseTilt : ℝ :=
      Finset.sum (Finset.range n)
          (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
        ⟪L • x n - g n, x 0 - x n⟫_ℝ
    let predTilt : ℝ :=
      τ *
        ((1 / L) *
          (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                  r (k + 1)⟫_ℝ)))
    let residualWork_pos : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ)
    (baseB + predB) + errorWork_pos ≤ 0 ∧
      (baseTilt + predTilt) + residualWork_pos - errorWork_pos ≤ 0 := by
  simpa [add_assoc] using hsplit_pos

