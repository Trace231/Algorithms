    let errorSum : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ‖(1 / L) • (B (yPert k) - g k)‖)
    let R : ℝ :=
      perturbScale *
        Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖)
    have hperturbScale_le_eps :
        perturbScale ≤
          ε / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1) := by
      exact min_le_right _ _
    have hperturb_linear_error_small :
        perturbScale * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) < ε := by
      let Rsum : ℝ := Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖)
      have hRsum_nonneg : 0 ≤ Rsum := by
        dsimp [Rsum]
        exact Finset.sum_nonneg (by
          intro j hj
          exact norm_nonneg ((1 / L) • r j))
      have hden_pos : 0 < Rsum + 1 := by linarith
      have hscaleR_le : perturbScale * Rsum ≤ (ε / (Rsum + 1)) * Rsum := by
        exact mul_le_mul_of_nonneg_right
          (by simpa [Rsum] using hperturbScale_le_eps) hRsum_nonneg
      have hquot_mul_lt : (ε / (Rsum + 1)) * Rsum < ε := by
        have hRsum_lt : Rsum < Rsum + 1 := by linarith
        calc
          (ε / (Rsum + 1)) * Rsum < (ε / (Rsum + 1)) * (Rsum + 1) :=
            mul_lt_mul_of_pos_left hRsum_lt (div_pos hε_pos hden_pos)
