private theorem reflected_frozen_field_split_pred
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (L τ : ℝ) (F x r : ℕ → H) :
    let yPert : ℕ → H := fun k =>
      if hk : k < n then
        x k + τ • ((1 / L) • r k)
      else if hk' : k = n then
        x n
      else
        x 0 + τ • ((1 / L) • r 0)
    Finset.sum (Finset.range n)
        (fun k => ⟪F k, yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪F n, yPert (n + 1) - yPert n⟫_ℝ =
    (Finset.sum (Finset.range n)
        (fun k => ⟪F k, x (k + 1) - x k⟫_ℝ) +
      ⟪F n, x 0 - x n⟫_ℝ) +
    τ *
      ((1 / L) *
        (⟪F n - F 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪F k - F (k + 1), r (k + 1)⟫_ℝ))) := by
  classical
  let yPert : ℕ → H := fun k =>
    if hk : k < n then
      x k + τ • ((1 / L) • r k)
    else if hk' : k = n then
      x n
    else
      x 0 + τ • ((1 / L) • r 0)
  change
    Finset.sum (Finset.range n)
        (fun k => ⟪F k, yPert (k + 1) - yPert k⟫_ℝ) +
      ⟪F n, yPert (n + 1) - yPert n⟫_ℝ =
    (Finset.sum (Finset.range n)
        (fun k => ⟪F k, x (k + 1) - x k⟫_ℝ) +
      ⟪F n, x 0 - x n⟫_ℝ) +
    τ *
      ((1 / L) *
        (⟪F n - F 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪F k - F (k + 1), r (k + 1)⟫_ℝ)))
  obtain ⟨hyPert_edge_lt, hyPert_edge_last, hyPert_closing_edge⟩ :=
    reflected_perturbed_cycle_edge_identities x r τ L hn_pos
  have hfrozen_split :
      Finset.sum (Finset.range n)
          (fun k => ⟪F k, yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪F n, yPert (n + 1) - yPert n⟫_ℝ =
      (Finset.sum (Finset.range n)
          (fun k => ⟪F k, x (k + 1) - x k⟫_ℝ) +
        ⟪F n, x 0 - x n⟫_ℝ) +
      (Finset.sum (Finset.range n)
          (fun k =>
            if hlast : k + 1 = n then
              ⟪F k, -τ • ((1 / L) • r k)⟫_ℝ
            else
              ⟪F k,
                τ •
                  ((1 / L) • r (k + 1) - (1 / L) • r k)⟫_ℝ) +
        ⟪F n, τ • ((1 / L) • r 0)⟫_ℝ) := by
    have hsum :
        Finset.sum (Finset.range n)
            (fun k => ⟪F k, yPert (k + 1) - yPert k⟫_ℝ) =
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪F k, x (k + 1) - x k⟫_ℝ +
                (if hlast : k + 1 = n then
                  ⟪F k, -τ • ((1 / L) • r k)⟫_ℝ
                else
                  ⟪F k,
                    τ •
                      ((1 / L) • r (k + 1) - (1 / L) • r k)⟫_ℝ)) := by
      apply Finset.sum_congr rfl
      intro k hk
      by_cases hlast : k + 1 = n
      · rw [hyPert_edge_last k hk hlast]
        simp [inner_sub_right, hlast]
        ring
      · have hlt : k + 1 < n := by
          have hklt : k < n := Finset.mem_range.mp hk
          omega
        rw [hyPert_edge_lt k hlt]
        simp [inner_add_right, hlast]
    have hclose :
        ⟪F n, yPert (n + 1) - yPert n⟫_ℝ =
          ⟪F n, x 0 - x n⟫_ℝ +
            ⟪F n, τ • ((1 / L) • r 0)⟫_ℝ := by
      rw [hyPert_closing_edge]
      simp [inner_add_right]
    rw [hsum, hclose, Finset.sum_add_distrib]
    ring
  have hscaled :
      Finset.sum (Finset.range n)
          (fun k =>
            if hlast : k + 1 = n then
              ⟪F k, -τ • ((1 / L) • r k)⟫_ℝ
            else
              ⟪F k,
                τ •
                  ((1 / L) • r (k + 1) - (1 / L) • r k)⟫_ℝ) +
        ⟪F n, τ • ((1 / L) • r 0)⟫_ℝ =
      τ *
        (Finset.sum (Finset.range n)
            (fun k =>
              if hlast : k + 1 = n then
                -⟪F k, (1 / L) • r k⟫_ℝ
              else
                ⟪F k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) +
          ⟪F n, (1 / L) • r 0⟫_ℝ) := by
    have hsum_scale :
        Finset.sum (Finset.range n)
            (fun k =>
              if hlast : k + 1 = n then
                ⟪F k, -τ • ((1 / L) • r k)⟫_ℝ
              else
                ⟪F k,
                  τ •
                    ((1 / L) • r (k + 1) - (1 / L) • r k)⟫_ℝ) =
          τ *
            Finset.sum (Finset.range n)
              (fun k =>
                if hlast : k + 1 = n then
                  -⟪F k, (1 / L) • r k⟫_ℝ
                else
                  ⟪F k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      by_cases hlast : k + 1 = n
      · simp [hlast, inner_smul_right]
      · simp [hlast, inner_smul_right]
    rw [hsum_scale, inner_smul_right]
    ring
  rw [hfrozen_split, hscaled,
    reflected_scaled_bracket_sum_rewrite (H := H) hn_pos L F r]

/-- Moving-to-frozen split for the perturbed quadratic-tilt cycle.

This is the local algebraic bridge in Lan Lemma 5.8's reflected perturbation
argument: on perturbed vertices before the endpoint,
`L • y_k - B y_k` is the frozen field `L • x_k - g_k` plus the injected
residual `τ • r_k` and minus the `B y_k - g_k` freezing error. Search audit:
searched `moving frozen residual split inner product finite sum field
perturbation`; the closest hit was the local
`reflected_frozen_field_split_pred`, which freezes an arbitrary field after the
edge expansion but does not compare the moving `B (y_k)` field with its frozen
