/-- Source-data version of the early reflected finite-mesh work nonnegativity.

This is the faithful replacement for the old arbitrary-cycle scaffold: the
nonnegative reflected work must be derived from Lan Lemma 5.8's actual source
data, not from two cycle inequalities over an unconstrained moving field. -/
private theorem early_reflected_work_nonnegative_from_source_data
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hnonneg : ∀ u ∈ U, 0 ≤ Φ u)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ U, ∀ v ∈ U,
      Φ v ≤ Φ u + ⟪B u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hΦz : Φ z = 0) (hBz : B z = 0)
    (u : H) (hu : u ∈ U)
    {n : ℕ} (hn_pos : 0 < n) :
    0 ≤
      2 *
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))),
                (L / (n : ℝ)) • (u - z) -
                  (B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                    B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))))⟫_ℝ) +
        L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
  classical
  let d : H := u - z
  let g : ℕ → H := fun k => B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))
  have hg0 : g 0 = 0 := by
    simp [g, hBz]
  have hendpoint0 :
      ‖B u‖ ^ 2 ≤ 2 * L * Φ u :=
    early_zero_base_endpoint_energy_from_source_data
      Φ B U L hL_pos hUopen hUconv hnonneg hsupport hupper hgrad hBLip
      z hz hΦz hBz u hu
  have hforward_gap :
      Φ u - Φ z ≤
        (1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
          L * ‖u - z‖ ^ 2 / (2 * (n : ℝ)) :=
    uniform_forward_mesh_gap_upper_from_hasFDeriv_lipschitz
      Φ B U L hL_pos hUconv hgrad hBLip z hz u hu hn_pos
  have hforward :
      Φ u ≤
        (1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
          L * ‖u - z‖ ^ 2 / (2 * (n : ℝ)) := by
    simpa [hΦz] using hforward_gap
  have hendpoint :
      ‖B u‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ)) +
          L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
    have htwoL_nonneg : 0 ≤ 2 * L := by nlinarith
    have hscaled :
        2 * L * Φ u ≤
          2 * L *
            ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n)
                  (fun k =>
                    ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
              L * ‖u - z‖ ^ 2 / (2 * (n : ℝ))) :=
      mul_le_mul_of_nonneg_left hforward htwoL_nonneg
    have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
    have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
    calc
      ‖B u‖ ^ 2 ≤ 2 * L * Φ u := hendpoint0
      _ ≤
          2 * L *
            ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n)
                  (fun k =>
                    ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
              L * ‖u - z‖ ^ 2 / (2 * (n : ℝ))) := hscaled
      _ =
          2 * L *
              ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n)
                  (fun k =>
                    ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ)) +
            L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
          field_simp [hnR_ne]
  have hendpoint_g :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
    have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
    have hgn : g n = B u := by
      simp [g, div_self hnR_ne]
    simpa [g, d, hgn] using hendpoint
  have hwork :=
    reflected_work_nonneg_of_endpoint_energy_bound d L hn_pos g hg0 hendpoint_g
  simpa [d, g] using hwork

/-- Voucher step: endpoint energy plus the forward mesh estimate gives the
fixed-mesh endpoint inequality needed by reflected-work algebra.

This is only ordered-field assembly; the analytic content is the zero-base
endpoint estimate and the forward mesh estimate supplied as hypotheses. -/
private theorem _voucher_step_2a_source_endpoint_energy_from_zero_base_and_forward
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) (L : ℝ) (hL_pos : 0 < L)
    (z u : H) (Φu : ℝ) {n : ℕ} (hn_pos : 0 < n)
    (hendpoint0 : ‖B u‖ ^ 2 ≤ 2 * L * Φu)
    (hforward :
      Φu ≤
        (1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
          L * ‖u - z‖ ^ 2 / (2 * (n : ℝ))) :
    ‖B u‖ ^ 2 ≤
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ)) +
        L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
  have htwoL_nonneg : 0 ≤ 2 * L := by nlinarith
  have hscaled :
      2 * L * Φu ≤
        2 * L *
          ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
            L * ‖u - z‖ ^ 2 / (2 * (n : ℝ))) :=
    mul_le_mul_of_nonneg_left hforward htwoL_nonneg
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  calc
    ‖B u‖ ^ 2 ≤ 2 * L * Φu := hendpoint0
    _ ≤
        2 * L *
          ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
            L * ‖u - z‖ ^ 2 / (2 * (n : ℝ))) := hscaled
    _ =
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ)) +
          L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
        field_simp [hnR_ne]

/-- Voucher step: fixed endpoint energy implies the reflected finite-mesh work.

This exposes the exact final assembly for `early_reflected_work_nonnegative_from_source_data`;
after the endpoint-energy inequality is available, the rest is the proved
Hilbert-space telescope `reflected_work_nonneg_of_endpoint_energy_bound`. -/
private theorem _voucher_step_2a_endpoint_energy_to_source_reflected_work
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) (L : ℝ) (z u : H) (hBz : B z = 0)
    {n : ℕ} (hn_pos : 0 < n)
    (hendpoint :
      ‖B u‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ)) +
          L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ)) :
    0 ≤
      2 *
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))),
                (L / (n : ℝ)) • (u - z) -
                  (B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                    B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))))⟫_ℝ) +
        L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
  classical
  let d : H := u - z
  let g : ℕ → H := fun k => B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))
  have hg0 : g 0 = 0 := by
    simp [g, hBz]
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have hgn : g n = B u := by
    simp [g, div_self hnR_ne]
  have hendpoint_g :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    simpa [g, d, hgn] using hendpoint
  have hwork :=
    reflected_work_nonneg_of_endpoint_energy_bound d L hn_pos g hg0 hendpoint_g
  simpa [d, g] using hwork

/-- Voucher step: support plus the smooth upper model gives the selected
Fréchet-gradient semantics on the open chart. -/
private theorem _voucher_step_1_endpoint_gradient_semantics
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hUopen : IsOpen U)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ U, ∀ v ∈ U,
      Φ v ≤ Φ u + ⟪B u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2) :
    ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x := by
  intro x hx
  exact
    support_upper_hasFDerivAt_of_mem_interior
      Φ B U L hsupport hupper x (by
        simpa [hUopen.interior_eq] using hx)

/-- Voucher step: the shifted supporting-plane potential is nonnegative. -/
private theorem _voucher_step_2a_shifted_potential_nonneg
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H)
    (hUconv : Convex ℝ U)
    (hconvΦ : ConvexOn ℝ U Φ)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (v : H) (hv : v ∈ U) :
    ∀ x ∈ U, 0 ≤ Φ x - Φ v - ⟪B v, x - v⟫_ℝ := by
  classical
  have hsupport : ∀ a ∈ U, ∀ b ∈ U,
      0 ≤ Φ b - Φ a - ⟪B a, b - a⟫_ℝ :=
    open_support_from_convexOn_hasFDerivAt Φ B U hUconv hconvΦ hgrad
  intro x hx
  simpa using hsupport v hv x hx

/-- Voucher step: subtracting a supporting plane preserves the support
inequality with shifted gradient field. -/
private theorem _voucher_step_2a_shifted_support
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H)
    (hUconv : Convex ℝ U)
    (hconvΦ : ConvexOn ℝ U Φ)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (v : H) (hv : v ∈ U) :
    ∀ x ∈ U, ∀ y ∈ U,
      0 ≤
        (Φ y - Φ v - ⟪B v, y - v⟫_ℝ) -
          (Φ x - Φ v - ⟪B v, x - v⟫_ℝ) -
            ⟪B x - B v, y - x⟫_ℝ := by
  classical
  have hsupport : ∀ a ∈ U, ∀ b ∈ U,
      0 ≤ Φ b - Φ a - ⟪B a, b - a⟫_ℝ :=
    open_support_from_convexOn_hasFDerivAt Φ B U hUconv hconvΦ hgrad
  intro x hx y hy
  have h := hsupport x hx y hy
  have hres :
      (Φ y - Φ v - ⟪B v, y - v⟫_ℝ) -
          (Φ x - Φ v - ⟪B v, x - v⟫_ℝ) -
            ⟪B x - B v, y - x⟫_ℝ =
        Φ y - Φ x - ⟪B x, y - x⟫_ℝ := by
    simp [inner_sub_left, inner_sub_right]
    ring
  simpa [hres] using h

/-- Voucher step: the shifted potential is convex on the same open chart. -/
private theorem _voucher_step_2a_shifted_potential_convex
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H)
    (hUconv : Convex ℝ U)
    (hconvΦ : ConvexOn ℝ U Φ)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (v : H) (hv : v ∈ U) :
    ConvexOn ℝ U (fun y => Φ y - Φ v - ⟪B v, y - v⟫_ℝ) := by
  classical
  have hsupportΨ :
      ∀ x ∈ U, ∀ y ∈ U,
        0 ≤
          (Φ y - Φ v - ⟪B v, y - v⟫_ℝ) -
            (Φ x - Φ v - ⟪B v, x - v⟫_ℝ) -
              ⟪B x - B v, y - x⟫_ℝ :=
    _voucher_step_2a_shifted_support Φ B U hUconv hconvΦ hgrad v hv
  exact
    convexOn_of_global_support_open
      (fun y => Φ y - Φ v - ⟪B v, y - v⟫_ℝ)
      (fun y => B y - B v) U hUconv hsupportΨ

/-- Voucher step: the shifted selected gradient is the Fréchet gradient of the
shifted potential. -/
private theorem _voucher_step_2a_shifted_gradient_semantics
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (v : H) :
    ∀ x ∈ U,
      HasFDerivAt
        (fun y => Φ y - Φ v - ⟪B v, y - v⟫_ℝ)
        (innerSL ℝ (B x - B v)) x := by
  classical
  intro x hx
  have hΦ : HasFDerivAt Φ (innerSL ℝ (B x)) x := hgrad x hx
  have hlin :
      HasFDerivAt (fun y : H => ⟪B v, y - v⟫_ℝ)
        (innerSL ℝ (B v)) x := by
    simpa using
      ((innerSL ℝ (B v)).hasFDerivAt.comp x
        ((hasFDerivAt_id x).sub_const v))
  have hshift :
      HasFDerivAt
        (fun y : H => Φ y - Φ v - ⟪B v, y - v⟫_ℝ)
        (innerSL ℝ (B x) - innerSL ℝ (B v)) x := by
    exact (hΦ.sub_const (Φ v)).sub hlin
  have hderiv :
      innerSL ℝ (B x) - innerSL ℝ (B v) = innerSL ℝ (B x - B v) := by
    ext d
    simp
  rw [hderiv] at hshift
  exact hshift

/-- Voucher step: Lipschitzness transports to the shifted gradient field. -/
private theorem _voucher_step_2a_shifted_gradient_lipschitz
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) (U : Set H) (L : ℝ)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (v : H) :
    ∀ x ∈ U, ∀ y ∈ U,
      ‖(B x - B v) - (B y - B v)‖ ≤ L * ‖x - y‖ := by
  intro x hx y hy
  have hdiff : (B x - B v) - (B y - B v) = B x - B y := by
    abel
  simpa [hdiff] using hBLip x hx y hy

/-- Voucher step: compact localization of the segment used by the zero-base
open-chart self-bound. -/
private theorem _voucher_step_2a_compact_segment_localization
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    (U : Set H)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (v : H) (hv : v ∈ U) (u : H) (hu : u ∈ U) :
    ∃ ρ : ℝ, 0 < ρ ∧
      ∀ t ∈ Set.Icc (0 : ℝ) 1,
        Metric.ball (AffineMap.lineMap v u t) ρ ⊆ U := by
  exact compact_segment_tube_inside_open_convex_domain U hUopen hUconv v hv u hu

/-- Voucher step: a short subsegment has the feasible inverse-step pair gap
needed for the partition argument. -/
private theorem _voucher_step_2a_local_feasible_inverse_pair_gap
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Ψ : H → ℝ) (C : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUconv : Convex ℝ U)
    (hconvΨ : ConvexOn ℝ U Ψ)
    (hgradΨ : ∀ x ∈ U, HasFDerivAt Ψ (innerSL ℝ (C x)) x)
    (hCLip : ∀ x ∈ U, ∀ y ∈ U, ‖C x - C y‖ ≤ L * ‖x - y‖)
    (x : H) (hx : x ∈ U) (y : H) (hy : y ∈ U)
    {ρ : ℝ}
    (hball : Metric.ball y ρ ⊆ U)
    (hmesh : ‖y - x‖ < ρ) :
    ‖C y - C x‖ ^ 2 ≤
      2 * L * (Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ) := by
  classical
  have hsupport : ∀ a ∈ U, ∀ b ∈ U,
      0 ≤ Ψ b - Ψ a - ⟪C a, b - a⟫_ℝ :=
    open_support_from_convexOn_hasFDerivAt Ψ C U hUconv hconvΨ hgradΨ
  have hupper : ∀ a ∈ U, ∀ b ∈ U,
      Ψ b ≤ Ψ a + ⟪C a, b - a⟫_ℝ + (L / 2) * ‖b - a‖ ^ 2 :=
    open_smooth_quadratic_upper_bound_from_hasFDerivAt_lipschitz
      Ψ C U L hUconv hgradΨ hCLip
  exact
    local_pair_gap_of_mesh_ball_subset
      Ψ C U L hL_pos hsupport hupper hCLip x hx y hy hball hmesh

/-- Voucher step: choose a uniform partition fine enough for the tube and the
two scalar error budgets used by the typed partition proof. -/
private theorem _voucher_step_2a_select_uniform_partition_for_typed_mesh_data
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    (d : H) {L ε ρ : ℝ}
    (hL_pos : 0 < L) (hε_pos : 0 < ε) (hρ_pos : 0 < ρ) :
    ∃ n : ℕ, 0 < n ∧
      ‖((1 / (n : ℝ)) • d)‖ < ρ ∧
      L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) ≤ ε / 2 ∧
      L * ‖d‖ ^ 2 / (2 * (n : ℝ)) ≤ ε / (4 * L) := by
  exact choose_uniform_partition_for_mesh_and_error d hL_pos hρ_pos hε_pos

/-- Voucher step: sum the local pair inequalities over a selected uniform
partition to control left work plus adjacent gradient increments. -/
private theorem _voucher_step_2a_local_pair_sum_for_typed_mesh_data
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (φ : ℝ → ℝ) (g : ℝ → H) (d : H) (L ρ : ℝ)
    (hL_pos : 0 < L)
    (hlocal_pair :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖(t - s) • d‖ < ρ →
          ‖g t - g s‖ ^ 2 ≤
            2 * L * (φ t - φ s - ⟪g s, (t - s) • d⟫_ℝ))
    {n : ℕ} (hn_pos : 0 < n)
    (hmesh_step : ‖((1 / (n : ℝ)) • d)‖ < ρ) :
    2 * L *
        ((1 / (n : ℝ)) *
          Finset.sum (Finset.range n)
            (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
      Finset.sum (Finset.range n)
        (fun k =>
          ‖g ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
              g ((k : ℝ) / (n : ℝ))‖ ^ 2) ≤
      2 * L * (φ 1 - φ 0) := by
  exact
    forward_local_pair_gap_sum_controls_mesh_energy_budget
      φ g d L ρ hL_pos hlocal_pair hn_pos hmesh_step

/-- Voucher step: scalar left-Riemann work control from Lipschitz derivative
data along the segment. -/
private theorem _voucher_step_2a_scalar_riemann_for_typed_mesh_data
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (φ : ℝ → ℝ) (g : ℝ → H) (d : H) (L η : ℝ) {n : ℕ}
    (hL_pos : 0 < L) (hn_pos : 0 < n)
    (hgLip : ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
      ‖g t - g s‖ ≤ L * ‖(t - s) • d‖)
    (hderiv : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      HasDerivWithinAt φ ⟪g t, d⟫_ℝ (Set.Icc (0 : ℝ) 1) t)
