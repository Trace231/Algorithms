private theorem ambient_endpoint_energy_le_forward_mesh_work_add_budget
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L ε : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hnonneg : ∀ u ∈ U, 0 ≤ Φ u)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ U, ∀ v ∈ U,
      Φ v ≤ Φ u + ⟪B u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hBz : B z = 0)
    (u : H) (hu : u ∈ U)
    {n : ℕ} (hn_pos : 0 < n)
    (henergyBudget : L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) ≤ ε / 2) :
    ‖B u‖ ^ 2 ≤
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ)) +
        Finset.sum (Finset.range n)
          (fun k =>
            ‖B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))‖ ^ 2) +
        ε / 2 := by
  classical
  let line : ℝ → H := fun t => AffineMap.lineMap z u t
  let φ : ℝ → ℝ := fun t => Φ (line t)
  let g : ℝ → H := fun t => B (line t)
  let d : H := u - z
  let W : ℝ :=
    (1 / (n : ℝ)) *
      Finset.sum (Finset.range n)
        (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)
  have hline0 : line 0 = z := by
    simp [line]
  have hline1 : line 1 = u := by
    simp [line]
  have hseg_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1, line t ∈ U := by
    intro t ht
    exact hUconv.lineMap_mem hz hu ht
  have hgLip :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖g t - g s‖ ≤ L * ‖(t - s) • d‖ := by
    intro s hs t ht
    have hsub :
        line t - line s = (t - s) • d := by
      simpa [line, d] using lineMap_sub_eq_smul_endpoint_diff z u s t
    have hlip := hBLip (line t) (hseg_mem t ht) (line s) (hseg_mem s hs)
    simpa [g, hsub] using hlip
  have hderiv :
      ∀ t ∈ Set.Icc (0 : ℝ) 1,
        HasDerivWithinAt φ ⟪g t, d⟫_ℝ (Set.Icc (0 : ℝ) 1) t := by
    intro t ht
    simpa [φ, g, line, d] using
      open_segment_derivative_from_hasFDerivAt Φ B U hUconv hgrad
        z hz u hu t ht
  have hendpoint_gap :
      ‖B u‖ ^ 2 ≤ 2 * L * (φ 1 - φ 0) := by
    have hmain :=
      open_zero_base_endpoint_energy_le_twice_L_gap
        Φ B U L hL_pos hUopen hUconv hsupport hupper hgrad hBLip
        z hz hBz u hu
    simpa [φ, hline0, hline1] using hmain
  have hriem :
      φ 1 - φ 0 ≤ W + L * ‖d‖ ^ 2 / (2 * (n : ℝ)) := by
    simpa [W] using
      scalar_value_increment_le_left_work_add_lipschitz_error
        φ g d L hL_pos hn_pos hgLip hderiv
  have htwoL_nonneg : 0 ≤ 2 * L := by nlinarith
  have hscaled :
      2 * L * (φ 1 - φ 0) ≤
        2 * L * (W + L * ‖d‖ ^ 2 / (2 * (n : ℝ))) :=
    mul_le_mul_of_nonneg_left hriem htwoL_nonneg
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have hscaled_norm :
      2 * L * (W + L * ‖d‖ ^ 2 / (2 * (n : ℝ))) =
        2 * L * W + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    field_simp [hnR_ne]
  have hmain_no_mesh :
      ‖B u‖ ^ 2 ≤ 2 * L * W + ε / 2 := by
    calc
      ‖B u‖ ^ 2 ≤ 2 * L * (φ 1 - φ 0) := hendpoint_gap
      _ ≤ 2 * L * (W + L * ‖d‖ ^ 2 / (2 * (n : ℝ))) := hscaled
      _ = 2 * L * W + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := hscaled_norm
      _ ≤ 2 * L * W + ε / 2 := by
        simpa [d] using add_le_add_left henergyBudget (2 * L * W)
  have hsum_nonneg :
      0 ≤
        Finset.sum (Finset.range n)
          (fun k =>
            ‖B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))‖ ^ 2) := by
    exact Finset.sum_nonneg (by intro k hk; exact sq_nonneg _)
  calc
    ‖B u‖ ^ 2
        ≤ 2 * L * W + ε / 2 := hmain_no_mesh
    _ ≤ 2 * L * W +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                  B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))‖ ^ 2) +
          ε / 2 := by
          linarith
    _ =
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                  B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))‖ ^ 2) +
          ε / 2 := by
          simp [W, g, line, d]

