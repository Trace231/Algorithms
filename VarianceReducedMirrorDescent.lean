private theorem early_source_cycle_scaled_first_order_bound_legacy_cycle_only_refutable :
    let n : ℕ := 2
    let L : ℝ := 1
    let τ : ℝ := 1 / 10
    let d : ℝ := 1
    let x : ℕ → ℝ := fun k => if k = 0 then 0 else if k = 1 then 1 / 2 else 1
    let g : ℕ → ℝ := fun k => if k = 0 then 0 else if k = 1 then -5 else -24 / 5
    let r : ℕ → ℝ := fun k => if k = 0 then 11 / 2 else 3 / 10
    0 < n ∧ 0 < L ∧ 0 ≤ τ ∧
      (∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) * d - (g (k + 1) - g k)) ∧
      (∀ k ∈ Finset.range n,
        x (k + 1) - x k = (1 / (n : ℝ)) * d) ∧
      x 0 - x n = -d ∧ g 0 = 0 ∧
      (-19 / 100 : ℝ) ≤ 0 ∧ (-219 / 10000 : ℝ) ≤ 0 ∧
      ¬ (-(τ * 0) ≤ τ * (-5 / 2)) := by
  norm_num
  constructor
  · intro k hk
    interval_cases k <;> norm_num
  · intro k hk
    interval_cases k <;> norm_num

/-- Voucher step: the fixed mesh generated by equal increments is the uniform
line-map mesh between its endpoints. -/
private theorem _voucher_step_3g_mesh_vertices_eq_uniform_segment
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (d : H) (x : ℕ → H)
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    (hclose : x 0 - x n = -d) :
    ∀ k, k ≤ n →
      x k = AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ)) := by
  classical
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have hdx : x n - x 0 = d := by
    have h := congrArg Neg.neg hclose
    simpa [neg_sub] using h
  have hprefix :
      ∀ k, k ≤ n → x k = x 0 + ((k : ℝ) / (n : ℝ)) • d := by
    intro k
    induction k with
    | zero =>
        intro hk
        simp
    | succ k ih =>
        intro hksucc
        have hklt : k < n := Nat.lt_of_succ_le hksucc
        have hk_mem : k ∈ Finset.range n := Finset.mem_range.mpr hklt
        have hk_le : k ≤ n := Nat.le_of_lt hklt
        have hstepk := hstep k hk_mem
        have hxsucc : x (k + 1) = x k + (1 / (n : ℝ)) • d := by
          simpa [add_comm] using (sub_eq_iff_eq_add.mp hstepk)
        rw [hxsucc, ih hk_le]
        have hcoef :
            ((k : ℝ) / (n : ℝ)) • d + (1 / (n : ℝ)) • d =
              (((k + 1 : ℕ) : ℝ) / (n : ℝ)) • d := by
          rw [← add_smul]
          congr 1
          have hcast : (((k + 1 : ℕ) : ℝ) = (k : ℝ) + 1) := by
            norm_num
          rw [hcast]
          field_simp [hnR_ne]
        rw [add_assoc]
        rw [hcoef]
  intro k hk
  rw [hprefix k hk]
  rw [AffineMap.lineMap_apply_module']
  rw [hdx]
  abel

