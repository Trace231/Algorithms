namespace VarianceReducedMirrorDescent

/-- Current-namespace copy of the scalar convex endpoint slope bridge above.

Reuse audit: same as `VarianceReducedMirrorDescentSetup.convexOn_Icc_hasDerivWithinAt_left_le_slope`;
this copy is needed because that helper is private to the setup namespace. -/
private theorem convexOn_Icc_hasDerivWithinAt_left_le_slope
    {φ : ℝ → ℝ} {D : ℝ}
    (hconv : ConvexOn ℝ (Set.Icc (0 : ℝ) 1) φ)
    (hderiv : HasDerivWithinAt φ D (Set.Icc (0 : ℝ) 1) 0) :
    D ≤ slope φ 0 1 := by
  exact hconv.le_slope_of_hasDerivWithinAt
    (x := (0 : ℝ)) (y := (1 : ℝ))
    (by norm_num) (by norm_num) (by norm_num) hderiv

/-- Global descent lemma from a Lipschitz Mathlib gradient.

This is the unrestricted-space analogue of
`Convex.carrier_smooth_quadratic_upper_bound`, aligned with Lan Lemma 5.8's
smoothness step.  Considered `Convex.carrier_smooth_quadratic_upper_bound`,
`le_value_add_of_hasDerivWithinAt_le_affine_on_Icc`, and
`Convex.norm_image_sub_le_of_norm_fderiv_le`; the first requires `ContDiffOn`,
the second is the scalar integration bridge used to prove this specialization,
and the third only gives a uniform Lipschitz estimate, not the sharp quadratic
`L / 2` descent term. -/
private theorem smooth_quadratic_upper_bound_of_global_gradient_lipschitz
    (f : E → ℝ) (L : ℝ)
    (hdiff : Differentiable ℝ f)
    (hsmooth : ∀ x y,
      SOptLib.dualNorm (gradient f x - gradient f y) ≤ L * ‖x - y‖)
    (x y : E) :
    f y ≤ f x + ⟪gradient f x, y - x⟫_ℝ +
      (L / 2) * ‖y - x‖ ^ 2 := by
  classical
  let d : E := y - x
  let I : Set ℝ := Set.Icc (0 : ℝ) 1
  let line : ℝ → E := fun t => x + t • d
  let Fseg : ℝ → ℝ := fun t => f (line t)
  let A : ℝ := ⟪gradient f x, d⟫_ℝ
  let B : ℝ := L * ‖d‖ ^ 2
  have hderiv : ∀ (t : ℝ) (ht : t ∈ I),
      HasDerivWithinAt Fseg ⟪gradient f (line t), d⟫_ℝ I t := by
    intro t ht
    have hline_deriv : HasDerivWithinAt line d I t := by
      simpa [line] using ((hasDerivWithinAt_id t I).smul_const d).const_add x
    have hfderiv :
        HasFDerivAt f (InnerProductSpace.toDual ℝ E (gradient f (line t))) (line t) :=
      (hdiff (line t)).hasGradientAt.hasFDerivAt
    have hcomp := hfderiv.comp_hasDerivWithinAt t hline_deriv
    simpa [Fseg, Function.comp_def, InnerProductSpace.toDual_apply_apply] using hcomp
  have hbound : ∀ (t : ℝ) (ht : t ∈ I),
      ⟪gradient f (line t), d⟫_ℝ ≤ A + B * t := by
    intro t ht
    have ht0 : 0 ≤ t := ht.1
    have hline_sub : line t - x = t • d := by
      simp [line]
    have hline_norm : ‖line t - x‖ = t * ‖d‖ := by
      rw [hline_sub, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht0]
    have hs : ‖gradient f (line t) - gradient f x‖ ≤ L * ‖line t - x‖ := by
      simpa [SOptLib.dualNorm_eq_norm] using hsmooth (line t) x
    have hcs :
        ⟪gradient f (line t) - gradient f x, d⟫_ℝ ≤
          ‖gradient f (line t) - gradient f x‖ * ‖d‖ := by
      exact real_inner_le_norm (gradient f (line t) - gradient f x) d
    have hmul :
        ‖gradient f (line t) - gradient f x‖ * ‖d‖ ≤
          (L * ‖line t - x‖) * ‖d‖ := by
      exact mul_le_mul_of_nonneg_right hs (norm_nonneg d)
    have hgrad_decomp :
        gradient f (line t) = gradient f x + (gradient f (line t) - gradient f x) := by
      simp
    calc
      ⟪gradient f (line t), d⟫_ℝ
          = A + ⟪gradient f (line t) - gradient f x, d⟫_ℝ := by
              rw [hgrad_decomp, inner_add_left]
              dsimp [A]
              congr 1
              rw [hgrad_decomp]
              simp
      _ ≤ A + ‖gradient f (line t) - gradient f x‖ * ‖d‖ := by
              linarith
      _ ≤ A + (L * ‖line t - x‖) * ‖d‖ := by
              linarith
      _ ≤ A + B * t := by
              rw [hline_norm]
              dsimp [B]
              ring_nf
              exact le_rfl
  have hmain := le_value_add_of_hasDerivWithinAt_le_affine_on_Icc
    Fseg (fun t => ⟪gradient f (line t), d⟫_ℝ) A B hderiv hbound
  have hmain' :
      f y ≤ f x + ⟪gradient f x, y - x⟫_ℝ + L * ‖y - x‖ ^ 2 / 2 := by
    simpa [Fseg, line, d, A, B] using hmain
  convert hmain' using 1
  ring

/-- Lan Lemma 5.8 smoothness step after shifting by the supporting hyperplane
at `z` and evaluating at `x - L⁻¹ • (∇f x - ∇f z)`.

This packages the second proof step of `book/FOML/VarianceReducedMirrorDescent.json`
Lemma 5.8.  The reusable SOptLib descent candidate is
`Convex.carrier_smooth_quadratic_upper_bound`; it gives the quadratic upper
model but not this shifted inverse-gradient specialization, so this helper
performs the paper-specific algebra. -/
private theorem smooth_upper_bound_at_inverse_gradient_step
    (f : E → ℝ) (L : ℝ)
    (hL_pos : 0 < L)
    (hdiff : Differentiable ℝ f)
    (hsmooth : ∀ x y,
      SOptLib.dualNorm (gradient f x - gradient f y) ≤ L * ‖x - y‖)
    (x z : E) :
    let g : E := gradient f x - gradient f z
    let y : E := x - L⁻¹ • g
    f y - f z - ⟪gradient f z, y - z⟫_ℝ ≤
      f x - f z - ⟪gradient f z, x - z⟫_ℝ -
        (1 / (2 * L : ℝ)) * SOptLib.dualNorm g ^ 2 := by
  classical
  let g : E := gradient f x - gradient f z
  let y : E := x - L⁻¹ • g
  have hquad := smooth_quadratic_upper_bound_of_global_gradient_lipschitz
    f L hdiff hsmooth x y
  have hL_ne : L ≠ 0 := ne_of_gt hL_pos
  have hdual : SOptLib.dualNorm g ^ 2 = ‖g‖ ^ 2 :=
    SOptLib.dualNorm_sq_eq_norm_sq g
  have hyx : y - x = -L⁻¹ • g := by
    simp [y, sub_eq_add_neg]
  have hnorm : ‖y - x‖ ^ 2 = (L⁻¹) ^ 2 * ‖g‖ ^ 2 := by
    rw [hyx, norm_smul]
    have habs : ‖(-L⁻¹ : ℝ)‖ = L⁻¹ := by
      rw [Real.norm_eq_abs, abs_of_nonpos]
      · ring
      · exact neg_nonpos.mpr (inv_nonneg.mpr (le_of_lt hL_pos))
    rw [habs]
    ring
  have hinner :
      ⟪gradient f x, y - x⟫_ℝ - ⟪gradient f z, y - z⟫_ℝ +
          ⟪gradient f z, x - z⟫_ℝ =
        -L⁻¹ * ‖g‖ ^ 2 := by
    rw [hyx]
    have hyz : y - z = (x - z) + (-L⁻¹ • g) := by
      simp [y, sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
    rw [hyz, inner_add_right]
    rw [inner_smul_right, inner_smul_right]
    have hgx : gradient f x = g + gradient f z := by
      simp [g, sub_eq_add_neg, add_comm, add_left_comm]
    rw [hgx, inner_add_left]
    have hg_inner : ⟪g, g⟫_ℝ = ‖g‖ ^ 2 := by
      simpa using (real_inner_self_eq_norm_sq g)
    rw [hg_inner]
    ring
  have hcoef :
      -L⁻¹ * ‖g‖ ^ 2 + (L / 2) * ((L⁻¹) ^ 2 * ‖g‖ ^ 2) =
        -(1 / (2 * L : ℝ)) * ‖g‖ ^ 2 := by
    field_simp [hL_ne]
    ring
  have hcalc :
      f x + ⟪gradient f x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2 - f z -
          ⟪gradient f z, y - z⟫_ℝ ≤
        f x - f z - ⟪gradient f z, x - z⟫_ℝ -
          (1 / (2 * L : ℝ)) * SOptLib.dualNorm g ^ 2 := by
    rw [hdual, hnorm]
    linarith
  have hle :
      f y - f z - ⟪gradient f z, y - z⟫_ℝ ≤
        f x + ⟪gradient f x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2 - f z -
          ⟪gradient f z, y - z⟫_ℝ := by
    linarith
  exact le_trans hle hcalc

/-- Global smooth-convex co-coercivity bridge used to realize Lan Lemma 5.8.

This aligns with Lan Lemma 5.8 proof steps 1-2: for a smooth convex component
with globally Lipschitz gradient, the shifted function
`φ(x) = f(x) - f(z) - ⟪∇f(z), x - z⟫` gives the standard
`1 / (2L)` gradient-gap lower bound.  Considered
`Convex.carrier_smooth_quadratic_upper_bound` and
`lipschitz_gradient_quadratic_bound'`; they provide the descent-model side of
the argument but not the packaged co-coercivity inequality in Lan's stated
form. -/
theorem global_smooth_convex_gap_inequality
    (f : E → ℝ) (L : ℝ)
    (hL_pos : 0 < L)
    (hconv : ConvexOn ℝ Set.univ f)
    (hdiff : Differentiable ℝ f)
    (hsmooth : ∀ x y,
      SOptLib.dualNorm (gradient f x - gradient f y) ≤ L * ‖x - y‖)
    (x z : E) :
    (1 / (2 * L : ℝ)) *
        SOptLib.dualNorm (gradient f x - gradient f z) ^ 2 ≤
      f x - f z - ⟪gradient f z, x - z⟫_ℝ := by
  classical
  let g : E := gradient f x - gradient f z
  let y : E := x - L⁻¹ • g
  have hnonneg : 0 ≤ f y - f z - ⟪gradient f z, y - z⟫_ℝ := by
    have hgrad : HasGradientAt f (gradient f z) z := (hdiff z).hasGradientAt
    have h : 0 ≤ bregmanDivergence f z y :=
      bregmanDivergence_nonneg_of_convexOn (X := Set.univ) (v := f)
        (x := z) (z := y) hconv (by simp) (by simp) hgrad
    simpa [bregmanDivergence] using h
  have hstep :
      f y - f z - ⟪gradient f z, y - z⟫_ℝ ≤
        f x - f z - ⟪gradient f z, x - z⟫_ℝ -
          (1 / (2 * L : ℝ)) * SOptLib.dualNorm g ^ 2 := by
    simpa [g, y] using
      smooth_upper_bound_at_inverse_gradient_step f L hL_pos hdiff hsmooth x z
  have hmain :
      (1 / (2 * L : ℝ)) * SOptLib.dualNorm g ^ 2 ≤
        f x - f z - ⟪gradient f z, x - z⟫_ℝ := by
    linarith
  simpa [g] using hmain

/-- Boundary-safe carrier supporting-hyperplane inequality for a convex
differentiable-on ambient representative.

This is the current-namespace copy of the setup-side
`bregman_core_nonneg_of_convexOn_differentiableOn`, which is private to
`VarianceReducedMirrorDescentSetup` and cannot be specialized here.  Considered
`bregmanDivergence_nonneg_of_convexOn` and
`bregman_core_nonneg_of_convexOn_differentiableOn`; the SOptLib theorem is an
ambient-gradient form, while the existing local theorem is namespace-private,
so this helper records the needed `gradientWithin` support form. -/
private theorem carrier_linearized_gap_nonneg_of_convexOn_differentiableOn
    {X : Set E} {v : E → ℝ} {x z : E}
    (hv : ConvexOn ℝ X v)
    (hdiff : DifferentiableOn ℝ v X)
    (hx : x ∈ X) (hz : z ∈ X) :
    0 ≤ v z - v x - ⟪gradientWithin v X x, z - x⟫_ℝ := by
  let line : ℝ → E := fun t => AffineMap.lineMap x z t
  have hline_mem : Set.Icc (0 : ℝ) 1 ⊆ line ⁻¹' X := by
    intro t ht
    have ht0 : 0 ≤ t := ht.1
    have ht1 : t ≤ 1 := ht.2
    have h1t : 0 ≤ 1 - t := sub_nonneg.mpr ht1
    have hsum : 1 - t + t = 1 := by ring
    have hmem : (1 - t) • x + t • z ∈ X := hv.1 hx hz h1t ht0 hsum
    simpa [line, AffineMap.lineMap_apply_module] using hmem
  have hg_conv : ConvexOn ℝ (Set.Icc (0 : ℝ) 1) (fun t => v (line t)) := by
    simpa [line] using
      (hv.comp_affineMap (AffineMap.lineMap x z)).subset hline_mem (convex_Icc 0 1)
  have hmaps : Set.MapsTo line (Set.Icc (0 : ℝ) 1) X := by
    intro t ht
    exact hline_mem ht
  have hline_deriv :
      HasDerivWithinAt line (z - x) (Set.Icc (0 : ℝ) 1) 0 := by
    simpa [line] using
      (AffineMap.hasDerivWithinAt_lineMap (a := x) (b := z)
        (s := Set.Icc (0 : ℝ) 1) (x := (0 : ℝ)))
  have hvdiff : DifferentiableWithinAt ℝ v X x := hdiff x hx
  have hg_deriv :
      HasDerivWithinAt (fun t => v (line t))
        ((fderivWithin ℝ v X x) (z - x)) (Set.Icc (0 : ℝ) 1) 0 :=
    hvdiff.hasFDerivWithinAt.comp_hasDerivWithinAt_of_eq 0 hline_deriv hmaps (by simp [line])
  have hslope :
      (fderivWithin ℝ v X x) (z - x) ≤
        slope (fun t => v (line t)) 0 1 := by
    exact convexOn_Icc_hasDerivWithinAt_left_le_slope hg_conv hg_deriv
  have hgrad_apply :
      (fderivWithin ℝ v X x) (z - x) =
        ⟪gradientWithin v X x, z - x⟫_ℝ := by
    rw [gradientWithin, InnerProductSpace.toDual_symm_apply]
  have hslope_expanded :
      ⟪gradientWithin v X x, z - x⟫_ℝ ≤ v z - v x := by
    rw [hgrad_apply] at hslope
    simpa [slope_def_field, line] using hslope
  linarith

/-- Pair the canonical carrier gradient with a feasible displacement as the
ambient within-derivative of the representative.

This is the local chart bridge needed for Lan Lemma 5.8 on a carrier.  Considered
`SOptLib.carrierGradientFrom_inner_eq_gradientWithin_intrinsicInterior` and
`SOptLib.carrierChart_fderivWithin_eq_intrinsicInterior_fderivWithin_on_feasible_direction`;
those are intrinsic-interior/`ContDiffOn` bridges, while this proof unit needs
the boundary `DifferentiableOn` form for the carrier chart selected by
`SOptLib.carrierGradient`. -/
private theorem carrierGradient_inner_eq_fderivWithin_on_feasible_direction
    {X : Set E} (F : E → ℝ) (f : {x : E // x ∈ X} → ℝ)
    (hX : Convex ℝ X)
    (hdiff : DifferentiableOn ℝ F X)
    (hf : ∀ y : {x : E // x ∈ X}, f y = F y.1)
    (x z : {x : E // x ∈ X}) :
    ⟪SOptLib.carrierGradient X f x, z.1 - x.1⟫_ℝ =
      (fderivWithin ℝ F X x.1) (z.1 - x.1) := by
  classical
  let A : AffineSubspace ℝ E := affineSpan ℝ X
  haveI : Nonempty A := ⟨⟨x.1, subset_affineSpan ℝ X x.2⟩⟩
  haveI : IsClosed ((A.direction : Submodule ℝ E) : Set E) :=
    A.direction.closed_of_finiteDimensional
  haveI : IsUniformAddGroup A.direction := A.direction.toAddSubgroup.isUniformAddGroup
  let instComplete : CompleteSpace A.direction := FiniteDimensional.complete ℝ A.direction
  letI : CompleteSpace A.direction := instComplete
  let T : Set A.direction := SOptLib.carrierChartSet X x
  let cf : A.direction → ℝ := SOptLib.carrierChartFunction X f x
  let u : A.direction := SOptLib.carrierChartPoint X x x
  let du : A.direction :=
    ⟨z.1 - x.1,
      AffineSubspace.vsub_mem_direction
        (subset_affineSpan ℝ X z.2) (subset_affineSpan ℝ X x.2)⟩
  let Lchart : A.direction →ᴬ[ℝ] E := SOptLib.carrierChartToAmbient X x
  have hdu_sub : (A.direction.subtypeL) du = z.1 - x.1 := rfl
  have hu : u ∈ T := by
    simpa [A, T, u] using SOptLib.carrierChartPoint_mem X x x
  have huniq : UniqueDiffWithinAt ℝ T u := by
    exact (SOptLib.carrierChartSet_uniqueDiffOn X x hX) u hu
  have hLu : Lchart u = x.1 := by
    simpa [A, Lchart, u] using SOptLib.carrierChartToAmbient_chartPoint X x x
  have hFdiff : DifferentiableWithinAt ℝ F X (Lchart u) := by
    rw [hLu]
    exact hdiff x.1 x.2
  have hLhas : HasFDerivWithinAt (fun y : A.direction => Lchart y) Lchart.contLinear T u := by
    rw [Lchart.decomp]
    exact Lchart.contLinear.hasFDerivWithinAt.add_const (Lchart 0)
  have hLdiff : DifferentiableWithinAt ℝ (fun y : A.direction => Lchart y) T u :=
    hLhas.differentiableWithinAt
  have hmap : Set.MapsTo (fun y : A.direction => Lchart y) T X := by
    intro y hy
    simpa [A, T, Lchart, SOptLib.carrierChartSet] using hy
  have hcongr : Set.EqOn cf (fun y : A.direction => F (Lchart y)) T := by
    intro y hy
    have hyX : Lchart y ∈ X := hmap hy
    calc
      cf y = SOptLib.totalizeOn X f (Lchart y) := rfl
      _ = f ⟨Lchart y, hyX⟩ := by
          exact SOptLib.totalizeOn_of_mem X f hyX
      _ = F (Lchart y) := by
          rw [hf]
  have hleft_congr :
      fderivWithin ℝ cf T u =
        fderivWithin ℝ (fun y : A.direction => F (Lchart y)) T u := by
    exact fderivWithin_congr' hcongr hu
  have hcomp :
      fderivWithin ℝ (fun y : A.direction => F (Lchart y)) T u =
        (fderivWithin ℝ F X (Lchart u)).comp
          (fderivWithin ℝ (fun y : A.direction => Lchart y) T u) := by
    exact fderivWithin_comp' (x := u) hFdiff hLdiff hmap huniq
  have hLder :
      fderivWithin ℝ (fun y : A.direction => Lchart y) T u = Lchart.contLinear := by
    exact hLhas.fderivWithin huniq
  have hLlin : Lchart.contLinear du = Lchart du - Lchart 0 := by
    simpa [vsub_eq_sub] using Lchart.contLinear_map_vsub du 0
  have hLdu_apply : Lchart du = (du : E) + x.1 := by
    let a : A := ⟨x.1, subset_affineSpan ℝ X x.2⟩
    change (((AffineIsometryEquiv.vaddConst ℝ a).toContinuousAffineEquiv.toContinuousAffineMap
        du : A) : E) = (du : E) + x.1
    simp [a]
  have hLzero : Lchart 0 = x.1 := by
    let a : A := ⟨x.1, subset_affineSpan ℝ X x.2⟩
    change (((AffineIsometryEquiv.vaddConst ℝ a).toContinuousAffineEquiv.toContinuousAffineMap
        (0 : A.direction) : A) : E) = x.1
    simp [a]
  have hLdu : Lchart.contLinear du = z.1 - x.1 := by
    rw [hLlin, hLdu_apply, hLzero]
    simp [du]
  have hchart :
      (fderivWithin ℝ cf T u) du =
        (fderivWithin ℝ F X x.1) (z.1 - x.1) := by
    calc
      (fderivWithin ℝ cf T u) du
          = (fderivWithin ℝ (fun y : A.direction => F (Lchart y)) T u) du := by
              rw [hleft_congr]
      _ = ((fderivWithin ℝ F X (Lchart u)).comp
            (fderivWithin ℝ (fun y : A.direction => Lchart y) T u)) du := by
              rw [hcomp]
      _ = (fderivWithin ℝ F X x.1) (z.1 - x.1) := by
              rw [hLder]
              simp [ContinuousLinearMap.comp_apply, hLdu, hLu]
  have hcompInst : CompleteSpace A.direction := instComplete
  calc
    ⟪SOptLib.carrierGradient X f x, z.1 - x.1⟫_ℝ
        = (fderivWithin ℝ cf T u) du := by
          unfold SOptLib.carrierGradient SOptLib.carrierGradientFrom
          rw [← hdu_sub]
          change
            ⟪((@gradientWithin ℝ A.direction _ _ _ hcompInst cf T u : A.direction) : E),
              (du : E)⟫_ℝ =
              (fderivWithin ℝ cf T u) du
          rw [← A.direction.coe_inner
            (@gradientWithin ℝ A.direction _ _ _ hcompInst cf T u) du]
          simp [gradientWithin]
          rfl
    _ = (fderivWithin ℝ F X x.1) (z.1 - x.1) := hchart

/-- Supporting-hyperplane gap using the canonical carrier gradient.

This aligns with Lan Lemma 5.8 proof step 1 after translating the paper
gradient notation to `SOptLib.carrierGradient`.  Considered
`carrier_linearized_gap_nonneg_of_convexOn_differentiableOn`, which gives the
same support inequality for `gradientWithin`; the pairing bridge above is the
missing carrier-gradient specialization. -/
private theorem carrier_linearized_gap_nonneg_with_carrierGradient
    {X : Set E} (F : E → ℝ) (f : {x : E // x ∈ X} → ℝ)
    (hX : Convex ℝ X)
    (hconv : ConvexOn ℝ X F)
    (hdiff : DifferentiableOn ℝ F X)
    (hf : ∀ y : {x : E // x ∈ X}, f y = F y.1)
    (x z : {x : E // x ∈ X}) :
    0 ≤ f z - f x - ⟪SOptLib.carrierGradient X f x, z.1 - x.1⟫_ℝ := by
  have hsupport :=
    carrier_linearized_gap_nonneg_of_convexOn_differentiableOn
      (X := X) (v := F) (x := x.1) (z := z.1) hconv hdiff x.2 z.2
  have hpair :
      ⟪SOptLib.carrierGradient X f x, z.1 - x.1⟫_ℝ =
        ⟪gradientWithin F X x.1, z.1 - x.1⟫_ℝ := by
    calc
      ⟪SOptLib.carrierGradient X f x, z.1 - x.1⟫_ℝ
          = (fderivWithin ℝ F X x.1) (z.1 - x.1) := by
              exact carrierGradient_inner_eq_fderivWithin_on_feasible_direction
                F f hX hdiff hf x z
      _ = ⟪gradientWithin F X x.1, z.1 - x.1⟫_ℝ := by
              rw [gradientWithin, InnerProductSpace.toDual_symm_apply]
  rw [hf x, hf z, hpair]
  exact hsupport

/-- Pair the canonical carrier gradient with any affine-span direction as the
ambient within-derivative of the representative.

This is the affine-direction variant needed by Lan Lemma 5.8's segment FTC
argument.  Considered
`SOptLib.carrierChart_fderivWithin_eq_intrinsicInterior_fderivWithin_on_feasible_direction`
and the local `carrierGradient_inner_eq_fderivWithin_on_feasible_direction`;
both are stated for feasible point differences, while the derivative of a
feasible segment is an arbitrary direction in `(affineSpan ℝ X).direction`. -/
private theorem carrierGradient_inner_eq_fderivWithin_on_affine_direction
    {X : Set E} (F : E → ℝ) (f : {x : E // x ∈ X} → ℝ)
    (hX : Convex ℝ X)
    (hdiff : DifferentiableOn ℝ F X)
    (hf : ∀ y : {x : E // x ∈ X}, f y = F y.1)
    (x : {x : E // x ∈ X}) (du : (affineSpan ℝ X).direction) :
    ⟪SOptLib.carrierGradient X f x, (du : E)⟫_ℝ =
      (fderivWithin ℝ F X x.1) (du : E) := by
  classical
  let A : AffineSubspace ℝ E := affineSpan ℝ X
  haveI : Nonempty A := ⟨⟨x.1, subset_affineSpan ℝ X x.2⟩⟩
  haveI : IsClosed ((A.direction : Submodule ℝ E) : Set E) :=
    A.direction.closed_of_finiteDimensional
  haveI : IsUniformAddGroup A.direction := A.direction.toAddSubgroup.isUniformAddGroup
  let instComplete : CompleteSpace A.direction := FiniteDimensional.complete ℝ A.direction
  letI : CompleteSpace A.direction := instComplete
  let T : Set A.direction := SOptLib.carrierChartSet X x
  let cf : A.direction → ℝ := SOptLib.carrierChartFunction X f x
  let u : A.direction := SOptLib.carrierChartPoint X x x
  let Lchart : A.direction →ᴬ[ℝ] E := SOptLib.carrierChartToAmbient X x
  have hu : u ∈ T := by
    simpa [A, T, u] using SOptLib.carrierChartPoint_mem X x x
  have huniq : UniqueDiffWithinAt ℝ T u := by
    exact (SOptLib.carrierChartSet_uniqueDiffOn X x hX) u hu
  have hLu : Lchart u = x.1 := by
    simpa [A, Lchart, u] using SOptLib.carrierChartToAmbient_chartPoint X x x
  have hFdiff : DifferentiableWithinAt ℝ F X (Lchart u) := by
    rw [hLu]
    exact hdiff x.1 x.2
  have hLhas : HasFDerivWithinAt (fun y : A.direction => Lchart y) Lchart.contLinear T u := by
    rw [Lchart.decomp]
    exact Lchart.contLinear.hasFDerivWithinAt.add_const (Lchart 0)
  have hLdiff : DifferentiableWithinAt ℝ (fun y : A.direction => Lchart y) T u :=
    hLhas.differentiableWithinAt
  have hmap : Set.MapsTo (fun y : A.direction => Lchart y) T X := by
    intro y hy
    simpa [A, T, Lchart, SOptLib.carrierChartSet] using hy
  have hcongr : Set.EqOn cf (fun y : A.direction => F (Lchart y)) T := by
    intro y hy
    have hyX : Lchart y ∈ X := hmap hy
    calc
      cf y = SOptLib.totalizeOn X f (Lchart y) := rfl
      _ = f ⟨Lchart y, hyX⟩ := by
          exact SOptLib.totalizeOn_of_mem X f hyX
      _ = F (Lchart y) := by
          rw [hf]
  have hleft_congr :
      fderivWithin ℝ cf T u =
        fderivWithin ℝ (fun y : A.direction => F (Lchart y)) T u := by
    exact fderivWithin_congr' hcongr hu
  have hcomp :
      fderivWithin ℝ (fun y : A.direction => F (Lchart y)) T u =
        (fderivWithin ℝ F X (Lchart u)).comp
          (fderivWithin ℝ (fun y : A.direction => Lchart y) T u) := by
    exact fderivWithin_comp' (x := u) hFdiff hLdiff hmap huniq
  have hLder :
      fderivWithin ℝ (fun y : A.direction => Lchart y) T u = Lchart.contLinear := by
    exact hLhas.fderivWithin huniq
  have hLlin : Lchart.contLinear du = Lchart du - Lchart 0 := by
    simpa [vsub_eq_sub] using Lchart.contLinear_map_vsub du 0
  have hLdu_apply : Lchart du = (du : E) + x.1 := by
    let a : A := ⟨x.1, subset_affineSpan ℝ X x.2⟩
    change (((AffineIsometryEquiv.vaddConst ℝ a).toContinuousAffineEquiv.toContinuousAffineMap
        du : A) : E) = (du : E) + x.1
    simp [a]
  have hLzero : Lchart 0 = x.1 := by
    let a : A := ⟨x.1, subset_affineSpan ℝ X x.2⟩
    change (((AffineIsometryEquiv.vaddConst ℝ a).toContinuousAffineEquiv.toContinuousAffineMap
        (0 : A.direction) : A) : E) = x.1
    simp [a]
  have hLdu : Lchart.contLinear du = (du : E) := by
    rw [hLlin, hLdu_apply, hLzero]
    simp
  have hchart :
      (fderivWithin ℝ cf T u) du =
        (fderivWithin ℝ F X x.1) (du : E) := by
    calc
      (fderivWithin ℝ cf T u) du
          = (fderivWithin ℝ (fun y : A.direction => F (Lchart y)) T u) du := by
              rw [hleft_congr]
      _ = ((fderivWithin ℝ F X (Lchart u)).comp
            (fderivWithin ℝ (fun y : A.direction => Lchart y) T u)) du := by
              rw [hcomp]
      _ = (fderivWithin ℝ F X x.1) (du : E) := by
              rw [hLder]
              simp [ContinuousLinearMap.comp_apply, hLdu, hLu]
  have hcompInst : CompleteSpace A.direction := instComplete
  calc
    ⟪SOptLib.carrierGradient X f x, (du : E)⟫_ℝ
        = (fderivWithin ℝ cf T u) du := by
          unfold SOptLib.carrierGradient SOptLib.carrierGradientFrom
          change
            ⟪((@gradientWithin ℝ A.direction _ _ _ hcompInst cf T u : A.direction) : E),
              (du : E)⟫_ℝ =
              (fderivWithin ℝ cf T u) du
          rw [← A.direction.coe_inner
            (@gradientWithin ℝ A.direction _ _ _ hcompInst cf T u) du]
          simp [gradientWithin]
          rfl
    _ = (fderivWithin ℝ F X x.1) (du : E) := hchart

/-- Carrier smooth quadratic upper bound from the exact hypotheses available in
Lan Lemma 5.8.

This aligns with Lan Lemma 5.8's smoothness step on the feasible carrier.
Considered `Convex.carrier_smooth_quadratic_upper_bound`; it has the same
mathematical conclusion but requires `ContDiffOn`, while the VRMD setup supplies
`DifferentiableOn` plus an explicit Lipschitz bound for
`SOptLib.carrierGradient`, so this local bridge repeats the scalar segment FTC
argument under those hypotheses. -/
private theorem carrierGradient_smooth_upper_bound_from_diff_lipschitz
    {X : Set E} (F : E → ℝ) (f : {x : E // x ∈ X} → ℝ) (L : ℝ)
    (hX : Convex ℝ X)
    (hdiff : DifferentiableOn ℝ F X)
    (hf : ∀ y : {x : E // x ∈ X}, f y = F y.1)
    (hsmooth : ∀ x y : {x : E // x ∈ X},
      SOptLib.dualNorm
          (SOptLib.carrierGradient X f x - SOptLib.carrierGradient X f y) ≤
        L * ‖x.1 - y.1‖)
    (x y : {x : E // x ∈ X}) :
    f y ≤ f x + ⟪SOptLib.carrierGradient X f x, y.1 - x.1⟫_ℝ +
      (L / 2) * ‖y.1 - x.1‖ ^ 2 := by
  classical
  let grad : {x : E // x ∈ X} → E := fun x => SOptLib.carrierGradient X f x
  let d : E := y.1 - x.1
  let s : Set ℝ := Set.Icc (0 : ℝ) 1
  let line : ℝ → E := fun t => AffineMap.lineMap x.1 y.1 t
  let Fseg : ℝ → ℝ := fun t => F (line t)
  have hF0 : Fseg 0 = f x := by
    simpa [Fseg, line] using (hf x).symm
  have hF1 : Fseg 1 = f y := by
    simpa [Fseg, line] using (hf y).symm
  have hline_mem : ∀ t ∈ s, line t ∈ X := by
    intro t ht
    exact hX.lineMap_mem x.2 y.2 ht
  have hmaps : Set.MapsTo line s X := by
    intro t ht
    exact hline_mem t ht
  have hderiv : ∀ (t : ℝ) (ht : t ∈ s),
      HasDerivWithinAt Fseg
        ⟪grad ⟨line t, hX.lineMap_mem x.2 y.2 ht⟩, d⟫_ℝ s t := by
    intro t ht
    have hline_deriv : HasDerivWithinAt line d s t := by
      simpa [line, d] using
        (AffineMap.hasDerivWithinAt_lineMap (a := x.1) (b := y.1)
          (s := s) (x := t))
    have hfdiff : DifferentiableWithinAt ℝ F X (line t) :=
      hdiff (line t) (hline_mem t ht)
    have hfseg : HasDerivWithinAt Fseg
        ((fderivWithin ℝ F X (line t)) d) s t := by
      simpa [Fseg, Function.comp_def] using
        hfdiff.hasFDerivWithinAt.comp_hasDerivWithinAt_of_eq t hline_deriv hmaps
          (by simp [line])
    have hgrad_apply :
        (fderivWithin ℝ F X (line t)) d =
          ⟪grad ⟨line t, hX.lineMap_mem x.2 y.2 ht⟩, d⟫_ℝ := by
      symm
      have hd_mem : d ∈ (affineSpan ℝ X).direction := by
        exact AffineSubspace.vsub_mem_direction
          (subset_affineSpan ℝ X y.2) (subset_affineSpan ℝ X x.2)
      let du : (affineSpan ℝ X).direction := ⟨d, hd_mem⟩
      simpa [du] using
        carrierGradient_inner_eq_fderivWithin_on_affine_direction
          F f hX hdiff hf ⟨line t, hX.lineMap_mem x.2 y.2 ht⟩ du
    simpa [hgrad_apply] using hfseg
  have hbound : ∀ (t : ℝ) (ht : t ∈ s),
      ⟪grad ⟨line t, hX.lineMap_mem x.2 y.2 ht⟩, d⟫_ℝ ≤
        ⟪grad x, d⟫_ℝ + L * t * ‖d‖ ^ 2 := by
    intro t ht
    let zt : {x : E // x ∈ X} := ⟨line t, hX.lineMap_mem x.2 y.2 ht⟩
    have ht_nonneg : 0 ≤ t := ht.1
    have hseg_sub : zt.1 - x.1 = t • d := by
      simp [zt, line, d, AffineMap.lineMap_apply_module']
    have hnorm_line : ‖zt.1 - x.1‖ = t * ‖d‖ := by
      rw [hseg_sub, norm_smul, Real.norm_of_nonneg ht_nonneg]
    have hlip : ‖grad zt - grad x‖ ≤ L * (t * ‖d‖) := by
      calc
        ‖grad zt - grad x‖
            = SOptLib.dualNorm (grad zt - grad x) := by
                rw [SOptLib.dualNorm_eq_norm]
        _ ≤ L * ‖zt.1 - x.1‖ := hsmooth zt x
        _ = L * (t * ‖d‖) := by rw [hnorm_line]
    have hinner_diff :
        ⟪grad zt, d⟫_ℝ - ⟪grad x, d⟫_ℝ =
          ⟪grad zt - grad x, d⟫_ℝ := by
      rw [inner_sub_left]
    have hcs :
        ⟪grad zt - grad x, d⟫_ℝ ≤ ‖grad zt - grad x‖ * ‖d‖ := by
      calc
        ⟪grad zt - grad x, d⟫_ℝ
            ≤ |⟪grad zt - grad x, d⟫_ℝ| := le_abs_self _
        _ ≤ ‖grad zt - grad x‖ * ‖d‖ :=
          abs_real_inner_le_norm (grad zt - grad x) d
    have hmul :
        ‖grad zt - grad x‖ * ‖d‖ ≤ L * t * ‖d‖ ^ 2 := by
      have hmul' :
          ‖grad zt - grad x‖ * ‖d‖ ≤
            (L * (t * ‖d‖)) * ‖d‖ :=
        mul_le_mul_of_nonneg_right hlip (norm_nonneg d)
      calc
        ‖grad zt - grad x‖ * ‖d‖
            ≤ (L * (t * ‖d‖)) * ‖d‖ := hmul'
        _ = L * t * ‖d‖ ^ 2 := by ring
    have hdiff_le :
        ⟪grad zt, d⟫_ℝ - ⟪grad x, d⟫_ℝ ≤
          L * t * ‖d‖ ^ 2 := by
      calc
        ⟪grad zt, d⟫_ℝ - ⟪grad x, d⟫_ℝ
            = ⟪grad zt - grad x, d⟫_ℝ := hinner_diff
        _ ≤ ‖grad zt - grad x‖ * ‖d‖ := hcs
        _ ≤ L * t * ‖d‖ ^ 2 := hmul
    linarith
  let phi : ℝ → ℝ := fun t =>
    if ht : t ∈ s then
      ⟪grad ⟨line t, hX.lineMap_mem x.2 y.2 ht⟩, d⟫_ℝ
    else 0
  have hderiv_phi : ∀ (t : ℝ) (ht : t ∈ s),
      HasDerivWithinAt Fseg (phi t) s t := by
    intro t ht
    rw [show phi t =
        ⟪grad ⟨line t, hX.lineMap_mem x.2 y.2 ht⟩, d⟫_ℝ by
      dsimp [phi]
      rw [dif_pos ht]]
    exact hderiv t ht
  have hbound_phi : ∀ (t : ℝ) (ht : t ∈ s),
      phi t ≤ ⟪grad x, d⟫_ℝ + (L * ‖d‖ ^ 2) * t := by
    intro t ht
    have hb := hbound t ht
    rw [show phi t =
        ⟪grad ⟨line t, hX.lineMap_mem x.2 y.2 ht⟩, d⟫_ℝ by
      dsimp [phi]
      rw [dif_pos ht]]
    simpa [mul_assoc, mul_comm, mul_left_comm] using hb
  have hscalar :
      Fseg 1 ≤ Fseg 0 + ⟪grad x, d⟫_ℝ + (L * ‖d‖ ^ 2) / 2 := by
    exact le_value_add_of_hasDerivWithinAt_le_affine_on_Icc Fseg phi
      ⟪grad x, d⟫_ℝ (L * ‖d‖ ^ 2) hderiv_phi hbound_phi
  rw [hF0, hF1] at hscalar
  change f y ≤ f x + ⟪grad x, y.1 - x.1⟫_ℝ +
    (L / 2) * ‖y.1 - x.1‖ ^ 2
  rw [show d = y.1 - x.1 by rfl] at hscalar
  calc
    f y ≤ f x + ⟪grad x, y.1 - x.1⟫_ℝ +
        (L * ‖y.1 - x.1‖ ^ 2) / 2 := hscalar
    _ = f x + ⟪grad x, y.1 - x.1⟫_ℝ +
        (L / 2) * ‖y.1 - x.1‖ ^ 2 := by ring

/-- Shift the carrier support inequality by the supporting hyperplane at `z`.

This aligns with the first algebraic step in Lan Lemma 5.8 after fixing the
base point `z`.  Considered `carrier_linearized_gap_nonneg_with_carrierGradient`
and `global_smooth_convex_gap_inequality`; the former proves this support
hypothesis from representative convexity, while this helper only packages the
already-available abstract support assumption, and the latter is the unrestricted
global co-coercivity theorem rather than this local shifted form. -/
private theorem carrier_shifted_gap_nonneg
    {X : Set E} (f : {x : E // x ∈ X} → ℝ)
    (hsupport :
      ∀ x z : {x : E // x ∈ X},
        0 ≤ f z - f x - ⟪SOptLib.carrierGradient X f x, z.1 - x.1⟫_ℝ)
    (z y : {x : E // x ∈ X}) :
    0 ≤ f y - f z -
      ⟪SOptLib.carrierGradient X f z, y.1 - z.1⟫_ℝ := by
  simpa using hsupport z y

/-- Shift the carrier smooth upper model by the supporting hyperplane at `z`.

This is the algebraic smooth-model step in Lan Lemma 5.8.  Considered
`smooth_upper_bound_at_inverse_gradient_step` and
`carrierGradient_smooth_upper_bound_from_diff_lipschitz`; the first also
specializes to an inverse-gradient point outside the carrier, while the second
provides the unshifted carrier upper model that this helper rewrites. -/
private theorem carrier_shifted_smooth_upper
    {X : Set E} (f : {x : E // x ∈ X} → ℝ) (L : ℝ)
    (hupper : ∀ x y : {x : E // x ∈ X},
      f y ≤ f x + ⟪SOptLib.carrierGradient X f x, y.1 - x.1⟫_ℝ +
        (L / 2) * ‖y.1 - x.1‖ ^ 2)
    (x z y : {x : E // x ∈ X}) :
    f y - f z -
        ⟪SOptLib.carrierGradient X f z, y.1 - z.1⟫_ℝ ≤
      (f x - f z -
          ⟪SOptLib.carrierGradient X f z, x.1 - z.1⟫_ℝ) +
        ⟪SOptLib.carrierGradient X f x -
            SOptLib.carrierGradient X f z, y.1 - x.1⟫_ℝ +
        (L / 2) * ‖y.1 - x.1‖ ^ 2 := by
  classical
  let gx := SOptLib.carrierGradient X f x
  let gz := SOptLib.carrierGradient X f z
  let dxy := y.1 - x.1
  let dxz := x.1 - z.1
  have hyz : y.1 - z.1 = dxy + dxz := by
    simp [dxy, dxz, sub_eq_add_neg]
  have hinner :
      ⟪gx, dxy⟫_ℝ - ⟪gz, y.1 - z.1⟫_ℝ =
        -⟪gz, dxz⟫_ℝ + ⟪gx - gz, dxy⟫_ℝ := by
    rw [hyz, inner_add_right, inner_sub_left]
    ring
  have hu := hupper x y
  calc
    f y - f z - ⟪gz, y.1 - z.1⟫_ℝ
        ≤ f x + ⟪gx, dxy⟫_ℝ + (L / 2) * ‖dxy‖ ^ 2 -
            f z - ⟪gz, y.1 - z.1⟫_ℝ := by
          dsimp [gx, dxy]
          linarith
    _ = (f x - f z - ⟪gz, dxz⟫_ℝ) +
          ⟪gx - gz, dxy⟫_ℝ + (L / 2) * ‖dxy‖ ^ 2 := by
          calc
            f x + ⟪gx, dxy⟫_ℝ + L / 2 * ‖dxy‖ ^ 2 - f z -
                ⟪gz, y.1 - z.1⟫_ℝ
                = f x - f z +
                    (⟪gx, dxy⟫_ℝ - ⟪gz, y.1 - z.1⟫_ℝ) +
                    (L / 2) * ‖dxy‖ ^ 2 := by ring
            _ = (f x - f z - ⟪gz, dxz⟫_ℝ) +
                  ⟪gx - gz, dxy⟫_ℝ + (L / 2) * ‖dxy‖ ^ 2 := by
                rw [hinner]
                ring

/-- Shifted Baillon-Haddad algebra when Lan's inverse-gradient point is feasible.

This is exactly the algebraic second step in Lan Lemma 5.8: evaluate the shifted
smooth upper model at `x - L⁻¹(∇f x - ∇f z)` and combine it with shifted
nonnegativity.  Considered `smooth_upper_bound_at_inverse_gradient_step` and
`global_smooth_convex_gap_inequality`; those package the same calculation on
`Set.univ`, while this helper isolates the carrier-feasibility premise that is
missing from the current shifted core. -/
private theorem carrier_shifted_baillon_haddad_core_of_inverse_step
    {X : Set E} (f : {x : E // x ∈ X} → ℝ) (L : ℝ)
    (hL_pos : 0 < L)
    (x z y : {x : E // x ∈ X})
    (hphi_nonneg :
      ∀ y : {x : E // x ∈ X},
        0 ≤ f y - f z -
          ⟪SOptLib.carrierGradient X f z, y.1 - z.1⟫_ℝ)
    (hphi_upper :
      ∀ y : {x : E // x ∈ X},
        f y - f z -
            ⟪SOptLib.carrierGradient X f z, y.1 - z.1⟫_ℝ ≤
          (f x - f z -
              ⟪SOptLib.carrierGradient X f z, x.1 - z.1⟫_ℝ) +
            ⟪SOptLib.carrierGradient X f x -
                SOptLib.carrierGradient X f z, y.1 - x.1⟫_ℝ +
            (L / 2) * ‖y.1 - x.1‖ ^ 2)
    (hy_step :
      y.1 - x.1 =
        -L⁻¹ • (SOptLib.carrierGradient X f x -
          SOptLib.carrierGradient X f z)) :
    (1 / (2 * L : ℝ)) *
        SOptLib.dualNorm
          (SOptLib.carrierGradient X f x - SOptLib.carrierGradient X f z) ^ 2 ≤
      f x - f z - ⟪SOptLib.carrierGradient X f z, x.1 - z.1⟫_ℝ := by
  classical
  let g : E := SOptLib.carrierGradient X f x - SOptLib.carrierGradient X f z
  let gap : ℝ := f x - f z -
    ⟪SOptLib.carrierGradient X f z, x.1 - z.1⟫_ℝ
  have hL_ne : L ≠ 0 := ne_of_gt hL_pos
  have hnorm_step : ‖y.1 - x.1‖ ^ 2 = (L⁻¹) ^ 2 * ‖g‖ ^ 2 := by
    rw [hy_step]
    simp only [norm_smul, norm_neg]
    have hL_inv_nonneg : 0 ≤ L⁻¹ := inv_nonneg.mpr (le_of_lt hL_pos)
    rw [Real.norm_eq_abs, abs_of_nonneg hL_inv_nonneg]
    ring
  have hinner_step : ⟪g, y.1 - x.1⟫_ℝ = -L⁻¹ * ‖g‖ ^ 2 := by
    rw [hy_step, inner_smul_right]
    have hg_inner : ⟪g, g⟫_ℝ = ‖g‖ ^ 2 := by
      simpa using real_inner_self_eq_norm_sq g
    rw [hg_inner]
  have hupper_y := hphi_upper y
  have hnonneg_y := hphi_nonneg y
  have hnonneg_upper :
      0 ≤ gap + ⟪g, y.1 - x.1⟫_ℝ + (L / 2) * ‖y.1 - x.1‖ ^ 2 := by
    dsimp [gap, g] at hupper_y ⊢
    linarith
  have hcoef :
      -L⁻¹ * ‖g‖ ^ 2 + (L / 2) * ((L⁻¹) ^ 2 * ‖g‖ ^ 2) =
        -(1 / (2 * L : ℝ)) * ‖g‖ ^ 2 := by
    field_simp [hL_ne]
    ring
  have hmain_norm : (1 / (2 * L : ℝ)) * ‖g‖ ^ 2 ≤ gap := by
    rw [hinner_step, hnorm_step] at hnonneg_upper
    nlinarith [hcoef]
  dsimp [gap, g] at hmain_norm ⊢
  simpa [SOptLib.dualNorm_eq_norm] using hmain_norm

/-- The canonical carrier gradient lives in the direction of the carrier affine span.

This is a model-transport fact for the chart proof of Lan Lemma 5.8.  Considered
`SOptLib.vsub_mem_carrierAffineSpan_direction`, which covers feasible point
differences but not the selected gradient vector; unfolding
`SOptLib.carrierGradientFrom` gives the chart gradient included through the
direction-submodule map, which is exactly the needed range statement. -/
private theorem carrierGradient_mem_affineSpan_direction
    {X : Set E} (f : {x : E // x ∈ X} → ℝ) (x : {x : E // x ∈ X}) :
    SOptLib.carrierGradient X f x ∈ (affineSpan ℝ X).direction := by
  classical
  unfold SOptLib.carrierGradient SOptLib.carrierGradientFrom
  simp

/-- The feasible carrier chart is uniquely differentiable.

This is the chart-regularity bridge needed for the carrier-safe form of Lan
Lemma 5.8.  It aligns the paper's feasible chart with the reusable SOptLib
primitive `SOptLib.carrierChartSet_uniqueDiffOn`; the pre-searched prox and
probability candidates do not address chart differentiability. -/
private theorem carrier_chart_uniqueDiffOn_bridge
    {X : Set E} (anchor : {x : E // x ∈ X}) (hX : Convex ℝ X) :
    UniqueDiffOn ℝ (SOptLib.carrierChartSet X anchor) := by
  exact SOptLib.carrierChartSet_uniqueDiffOn X anchor hX

/-- Support inequalities in both directions give monotonicity of the chart
gradient field along feasible chords.

This is the algebraic support step in Lan Lemma 5.8.  Considered the
pre-searched prox/probability candidates
`mirrorStep_minimizes_of_update`, `literalMirrorStep_of_update_of_interior`,
`mirrorDescent_three_point_of_update`, `iIndepFun.indep_past_iSup_current`, and
`IdentDistrib.integral_comp_eq_of_measurable`; they concern algorithmic
transport or probability, not this pointwise convex-support algebra. -/
private theorem chart_support_monotone_of_support
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (ψ : H → ℝ) (A : H → H) (T : Set H)
    (hpsi_support : ∀ u ∈ T, ∀ v ∈ T,
      0 ≤ ψ v - ψ u - ⟪A u, v - u⟫_ℝ)
    (u : H) (hu : u ∈ T) (v : H) (hv : v ∈ T) :
    0 ≤ ⟪A u - A v, u - v⟫_ℝ := by
  have huv := hpsi_support u hu v hv
  have hvu := hpsi_support v hv u hu
  have hsum :
      0 ≤
        (ψ v - ψ u - ⟪A u, v - u⟫_ℝ) +
          (ψ u - ψ v - ⟪A v, u - v⟫_ℝ) :=
    add_nonneg huv hvu
  have hrewrite :
      (ψ v - ψ u - ⟪A u, v - u⟫_ℝ) +
          (ψ u - ψ v - ⟪A v, u - v⟫_ℝ) =
        ⟪A u - A v, u - v⟫_ℝ := by
    have hvu_sub : v - u = -(u - v) := by
      abel
    rw [hvu_sub, inner_neg_right, inner_sub_left]
    ring
  rwa [hrewrite] at hsum

/-- Subtracting the support plane at `z` preserves within-gradient semantics.

This is the local shift used in Lan Lemma 5.8, step 1:
`φ(y) = ψ(y) - ψ(z) - ⟪A z, y-z⟫` has gradient `A u - A z` at `u`.
Considered `hasGradientWithinAt_iff_hasFDerivWithinAt` and
`HasGradientWithinAt.fderivWithin_apply`; the former is the direct API for this
linear-shift proof, while the latter only identifies an already-existing
within derivative after unique-differentiability is available. -/
private theorem chart_shifted_gradient_semantics
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (ψ : H → ℝ) (A : H → H) (T : Set H)
    (hgrad : ∀ u ∈ T, HasGradientWithinAt ψ (A u) T u)
    (z : H) (u : H) (hu : u ∈ T) :
    HasGradientWithinAt
      (fun y : H => ψ y - ψ z - ⟪A z, y - z⟫_ℝ) (A u - A z) T u := by
  have hψ : HasFDerivWithinAt ψ (innerSL ℝ (A u)) T u := by
    simpa using (hgrad u hu).hasFDerivWithinAt
  have hlin :
      HasFDerivWithinAt (fun y : H => ⟪A z, y - z⟫_ℝ)
        (innerSL ℝ (A z)) T u := by
    simpa using
      ((innerSL ℝ (A z)).hasFDerivAt.comp_hasFDerivWithinAt u
        ((hasFDerivWithinAt_id u T).sub_const z))
  have hshift :
      HasFDerivWithinAt
        (fun y : H => ψ y - ψ z - ⟪A z, y - z⟫_ℝ)
        (innerSL ℝ (A u) - innerSL ℝ (A z)) T u := by
    exact (hψ.sub_const (ψ z)).sub hlin
  have hderiv :
      innerSL ℝ (A u) - innerSL ℝ (A z) = innerSL ℝ (A u - A z) := by
    ext d
    simp
  rw [hasGradientWithinAt_iff_hasFDerivWithinAt]
  rw [hderiv] at hshift
  exact hshift

/-- The chart restriction to the feasible segment has the expected scalar derivative.

This is the segment chain-rule step in Lan Lemma 5.8.  Considered
`Convex.carrier_smooth_quadratic_upper_bound`, which contains an analogous
segment derivative proof for carrier subtypes, and
`HasGradientWithinAt.hasFDerivWithinAt`, which is the local API used here; no
existing lemma states this abstract chart version for an arbitrary `φ`, `G`,
and feasible set `T`. -/
private theorem chart_segment_derivative_from_gradient_semantics
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (φ : H → ℝ) (G : H → H) (T : Set H)
    (hTconv : Convex ℝ T)
    (hgrad : ∀ u ∈ T, HasGradientWithinAt φ (G u) T u)
    (z : H) (hz : z ∈ T) (x : H) (hx : x ∈ T) :
    ∀ t ∈ Set.Icc (0 : ℝ) 1,
      HasDerivWithinAt
        (fun τ : ℝ => φ (AffineMap.lineMap z x τ))
        ⟪G (AffineMap.lineMap z x t), x - z⟫_ℝ
        (Set.Icc (0 : ℝ) 1) t := by
  intro t ht
  let s : Set ℝ := Set.Icc (0 : ℝ) 1
  let line : ℝ → H := fun τ => AffineMap.lineMap z x τ
  have hline_mem : ∀ τ ∈ s, line τ ∈ T := by
    intro τ hτ
    exact hTconv.lineMap_mem hz hx hτ
  have hmaps : Set.MapsTo line s T := by
    intro τ hτ
    exact hline_mem τ hτ
  have hline_deriv : HasDerivWithinAt line (x - z) s t := by
    simpa [line, s] using
      (AffineMap.hasDerivWithinAt_lineMap (a := z) (b := x)
        (s := s) (x := t))
  have hφ :
      HasFDerivWithinAt φ (innerSL ℝ (G (line t))) T (line t) := by
    simpa using (hgrad (line t) (hline_mem t ht)).hasFDerivWithinAt
  have hcomp :
      HasDerivWithinAt (fun τ : ℝ => φ (line τ))
        ((innerSL ℝ (G (line t))) (x - z)) s t := by
    simpa [line] using
      hφ.comp_hasDerivWithinAt_of_eq t hline_deriv hmaps (by simp [line])
  simpa [line, s] using hcomp

/-- Constrained smooth quadratic upper model from within-gradient semantics.

This is the abstract Mathlib-style endpoint behind the carrier-specific smooth
upper model used in Lan Lemma 5.8: restrict to the feasible segment, identify
the scalar derivative by `HasGradientWithinAt`, control its increase by the
Lipschitz gradient assumption, and integrate the affine derivative bound on
`[0,1]`. -/
private theorem constrained_smooth_quadratic_upper_bound_from_gradientSemantics
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (ψ : H → ℝ) (G : H → H) (T : Set H) (L : ℝ)
    (hTconv : Convex ℝ T)
    (hgrad : ∀ u ∈ T, HasGradientWithinAt ψ (G u) T u)
    (hGLip : ∀ u ∈ T, ∀ v ∈ T, ‖G u - G v‖ ≤ L * ‖u - v‖)
    (u : H) (hu : u ∈ T) (v : H) (hv : v ∈ T) :
    ψ v ≤ ψ u + ⟪G u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2 := by
  classical
  let d : H := v - u
  let s : Set ℝ := Set.Icc (0 : ℝ) 1
  let line : ℝ → H := fun t => AffineMap.lineMap u v t
  let Fseg : ℝ → ℝ := fun t => ψ (line t)
  have hF0 : Fseg 0 = ψ u := by
    simp [Fseg, line]
  have hF1 : Fseg 1 = ψ v := by
    simp [Fseg, line]
  have hline_mem : ∀ t ∈ s, line t ∈ T := by
    intro t ht
    exact hTconv.lineMap_mem hu hv ht
  have hderiv : ∀ (t : ℝ) (ht : t ∈ s),
      HasDerivWithinAt Fseg
        ⟪G (line t), d⟫_ℝ s t := by
    intro t ht
    simpa [Fseg, line, d, s] using
      chart_segment_derivative_from_gradient_semantics ψ G T hTconv hgrad
        u hu v hv t ht
  have hbound : ∀ (t : ℝ) (ht : t ∈ s),
      ⟪G (line t), d⟫_ℝ ≤ ⟪G u, d⟫_ℝ + (L * ‖d‖ ^ 2) * t := by
    intro t ht
    have ht_nonneg : 0 ≤ t := ht.1
    have hseg_sub : line t - u = t • d := by
      simp [line, d, AffineMap.lineMap_apply_module']
    have hnorm_line : ‖line t - u‖ = t * ‖d‖ := by
      rw [hseg_sub, norm_smul, Real.norm_of_nonneg ht_nonneg]
    have hlip : ‖G (line t) - G u‖ ≤ L * (t * ‖d‖) := by
      calc
        ‖G (line t) - G u‖ ≤ L * ‖line t - u‖ :=
          hGLip (line t) (hline_mem t ht) u hu
        _ = L * (t * ‖d‖) := by rw [hnorm_line]
    have hcs :
        ⟪G (line t) - G u, d⟫_ℝ ≤ ‖G (line t) - G u‖ * ‖d‖ :=
      real_inner_le_norm (G (line t) - G u) d
    have hmul :
        ‖G (line t) - G u‖ * ‖d‖ ≤ L * t * ‖d‖ ^ 2 := by
      have hmul' :
          ‖G (line t) - G u‖ * ‖d‖ ≤
            (L * (t * ‖d‖)) * ‖d‖ :=
        mul_le_mul_of_nonneg_right hlip (norm_nonneg d)
      calc
        ‖G (line t) - G u‖ * ‖d‖
            ≤ (L * (t * ‖d‖)) * ‖d‖ := hmul'
        _ = L * t * ‖d‖ ^ 2 := by ring
    calc
      ⟪G (line t), d⟫_ℝ
          = ⟪G u, d⟫_ℝ + ⟪G (line t) - G u, d⟫_ℝ := by
              rw [← inner_add_left]
              congr 1
              simp
      _ ≤ ⟪G u, d⟫_ℝ + ‖G (line t) - G u‖ * ‖d‖ := by
              linarith
      _ ≤ ⟪G u, d⟫_ℝ + L * t * ‖d‖ ^ 2 := by
              linarith
      _ = ⟪G u, d⟫_ℝ + (L * ‖d‖ ^ 2) * t := by ring
  have hscalar :
      Fseg 1 ≤ Fseg 0 + ⟪G u, d⟫_ℝ + (L * ‖d‖ ^ 2) / 2 := by
    exact le_value_add_of_hasDerivWithinAt_le_affine_on_Icc
      Fseg (fun t => ⟪G (line t), d⟫_ℝ) ⟪G u, d⟫_ℝ
      (L * ‖d‖ ^ 2) hderiv hbound
  rw [hF0, hF1] at hscalar
  calc
    ψ v ≤ ψ u + ⟪G u, v - u⟫_ℝ + (L * ‖v - u‖ ^ 2) / 2 := by
      simpa [d] using hscalar
    _ = ψ u + ⟪G u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2 := by ring

/-- Support plus a quadratic upper model identify the selected carrier gradient
as the within-gradient of the totalized carrier objective.

This is the differentiability-realization step in the chart-safe route for Lan
Lemma 5.8.  Search audit: considered
`hasFDerivWithinAt_of_contDiffOn_gradientWithin_comp`,
`Convex.carrier_smooth_quadratic_upper_bound`,
`carrierGradient_inner_eq_fderivWithin_on_feasible_direction`, and
`carrierChart_fderivWithin_eq_intrinsicInterior_fderivWithin_on_feasible_direction`;
they either require a `ContDiffOn`/ambient representative hypothesis, give only
the smooth upper model, or identify an already-existing derivative rather than
constructing one from support plus the quadratic remainder bound. -/
private theorem carrier_support_upper_hasGradientWithinAt
    {X : Set E} (f : {x : E // x ∈ X} → ℝ) (L : ℝ)
    (hsupport :
      ∀ x z : {x : E // x ∈ X},
        0 ≤ f z - f x - ⟪SOptLib.carrierGradient X f x, z.1 - x.1⟫_ℝ)
    (hupper :
      ∀ x y : {x : E // x ∈ X},
        f y ≤ f x + ⟪SOptLib.carrierGradient X f x, y.1 - x.1⟫_ℝ +
          (L / 2) * ‖y.1 - x.1‖ ^ 2) :
    ∀ x : {x : E // x ∈ X},
      HasGradientWithinAt (SOptLib.totalizeOn X f)
        (SOptLib.carrierGradient X f x) X x.1 := by
  intro x
  rw [hasGradientWithinAt_iff_hasFDerivWithinAt]
  have hbig :
      (fun y : E =>
        SOptLib.totalizeOn X f y - SOptLib.totalizeOn X f x.1 -
          (innerSL ℝ (SOptLib.carrierGradient X f x)) (y - x.1))
        =O[𝓝[X] x.1] (fun y : E => ‖y - x.1‖ ^ 2) := by
    refine Asymptotics.IsBigO.of_bound ‖L / 2‖ ?_
    filter_upwards [self_mem_nhdsWithin] with y hy
    let r : ℝ :=
      f ⟨y, hy⟩ - f x - ⟪SOptLib.carrierGradient X f x, y - x.1⟫_ℝ
    have hres_nonneg : 0 ≤ r := by
      simpa [r] using hsupport x ⟨y, hy⟩
    have hres_upper : r ≤ (L / 2) * ‖y - x.1‖ ^ 2 := by
      have h := hupper x ⟨y, hy⟩
      calc
        r ≤ (f x + ⟪SOptLib.carrierGradient X f x, y - x.1⟫_ℝ +
              (L / 2) * ‖y - x.1‖ ^ 2) - f x -
              ⟪SOptLib.carrierGradient X f x, y - x.1⟫_ℝ := by
          simpa [r] using
            (sub_le_sub_right
              (sub_le_sub_right h (f x))
              ⟪SOptLib.carrierGradient X f x, y - x.1⟫_ℝ)
        _ = (L / 2) * ‖y - x.1‖ ^ 2 := by ring
    have hres_eq :
        SOptLib.totalizeOn X f y - SOptLib.totalizeOn X f x.1 -
            (innerSL ℝ (SOptLib.carrierGradient X f x)) (y - x.1) = r := by
      simp [r, SOptLib.totalizeOn_of_mem X f hy,
        SOptLib.totalizeOn_of_mem X f x.2, innerSL]
    have hnorm_res : ‖r‖ ≤ ‖L / 2‖ * ‖y - x.1‖ ^ 2 := by
      rw [Real.norm_eq_abs, abs_of_nonneg hres_nonneg]
      exact hres_upper.trans
        (mul_le_mul_of_nonneg_right (le_abs_self (L / 2)) (sq_nonneg ‖y - x.1‖))
    simpa [← hres_eq, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg ‖y - x.1‖)]
      using hnorm_res
  have hsub_tendsto :
      Filter.Tendsto (fun y : E => y - x.1) (𝓝[X] x.1) (𝓝 (0 : E)) := by
    have hcont :
        ContinuousWithinAt (fun y : E => y - x.1) X x.1 :=
      ((continuous_id.sub (continuous_const : Continuous fun _ : E => x.1)).continuousWithinAt
        (x := x.1) (s := X))
    simpa using hcont.tendsto
  have hquad :
      (fun y : E => ‖y - x.1‖ ^ 2) =o[𝓝[X] x.1] (fun y : E => y - x.1) := by
    simpa using
      ((Asymptotics.isLittleO_norm_pow_id (E' := E) (n := 2)
        (by norm_num : 1 < 2)).comp_tendsto hsub_tendsto)
  exact HasFDerivWithinAt.of_isLittleO (hbig.trans_isLittleO hquad)

/-- Support plus a quadratic upper model identify an abstract selected gradient
as the within-gradient on a feasible carrier.

This is the paper-neutral version of `carrier_support_upper_hasGradientWithinAt`
used by the Lan Lemma 5.8 zero-base reduction. Search audit: considered
`carrier_support_upper_hasGradientWithinAt`, `support_upper_hasFDerivAt_of_mem_interior`,
and `Convex.carrier_smooth_quadratic_upper_bound`; the first is tied to
`SOptLib.carrierGradient` on a subtype, the second only handles ordinary
interior points, and the third gives a smooth upper model rather than deriving
the within-gradient from support and upper residual bounds. -/
private theorem generic_support_upper_hasGradientWithinAt
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Φ : H → ℝ) (B : H → H) (T : Set H) (L : ℝ)
    (hsupport : ∀ u ∈ T, ∀ v ∈ T,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ T, ∀ v ∈ T,
      Φ v ≤ Φ u + ⟪B u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2) :
    ∀ x ∈ T, HasGradientWithinAt Φ (B x) T x := by
  intro x hx
  rw [hasGradientWithinAt_iff_hasFDerivWithinAt]
  have hbig :
      (fun y : H =>
