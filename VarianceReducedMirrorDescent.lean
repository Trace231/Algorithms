            simp [g, hxn]
          have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
          have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
          calc
            ‖g n‖ ^ 2 = ‖B u‖ ^ 2 := hgn
            _ ≤ 2 * L * (Φ u - Φ z) := hBH
            _ ≤
                2 * L *
                  ((1 / (n : ℝ)) *
                      Finset.sum (Finset.range n)
                        (fun k => ⟪g k, d⟫_ℝ) +
                    L * ‖d‖ ^ 2 / (2 * (n : ℝ))) := hscaled
            _ =
                2 * L *
                    ((1 / (n : ℝ)) *
                      Finset.sum (Finset.range n)
                        (fun k => ⟪g k, d⟫_ℝ)) +
                  L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
                field_simp [hnR_ne]
        have hS_nonneg : 0 ≤ S := by
          have hmesh :=
            reflected_work_nonneg_of_endpoint_energy_bound
              d L hn_pos g hg0 hendpoint_energy
          simpa [S, r] using hmesh
        have herror_nonneg : 0 ≤ errorSum := by
          dsimp [errorSum]
          exact Finset.sum_nonneg (by
            intro k hk
            exact norm_nonneg _)
        have hleft : -(perturbScale * errorSum) ≤ 0 := by
          have hm : 0 ≤ perturbScale * errorSum :=
            mul_nonneg hperturbScale_nonneg herror_nonneg
          linarith
        have hright : 0 ≤ perturbScale * S :=
          mul_nonneg hperturbScale_nonneg hS_nonneg
        exact le_trans hleft hright
      exact
        scaled_error_budget_to_R
          hperturbScale_nonneg herror_le_R hfirst
    have hcancel : -ε ≤ S :=
      positive_perturb_scale_cancel_with_epsilon_loss
        hperturbScale_pos hperturb_linear_error_small hscaled_reflected_cycle
    simpa [S] using hcancel
  simpa [x, g, r, d] using hperturbed_cycle_limit

/-- Aggregate reflected finite-mesh work lower bound along one segment.

This replaces the false pairwise reflected cross-work scaffold.  Lan Lemma 5.8
needs only the aggregate reflected-work inequality consumed by the endpoint
mesh algebra; the source proof does not assert nonnegative cross-work for every
pair of uniform mesh increments. Search audit: checked
`cyclic_monotone_sum_of_support_on_cycle`,
`open_quadratic_tilt_support_from_smooth_upper`, and
`mesh_endpoint_algebra_from_reflected_work`, and searched `aggregate reflected
mesh work source cycle cyclic monotone support quadratic tilt`; available
helpers telescope feasible support cycles or consume the aggregate bound, but do
not yet package the reflected-cycle perturbation/limit bridge. -/
private theorem aggregate_reflected_mesh_work_from_source_cycle
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ U, ∀ v ∈ U,
      Φ v ≤ Φ u + ⟪B u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hBz : B z = 0)
    (u : H) (hu : u ∈ U)
    {n : ℕ} (hn_pos : 0 < n) :
    0 ≤
      2 *
          Finset.sum (Finset.range n)
            (fun k =>
              ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))),
                (L / (n : ℝ)) • (u - z) -
                  (B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                    B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))))⟫_ℝ) +
        L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
  exact
    nonnegative_of_forall_neg_epsilon_le
      (aggregate_reflected_mesh_work_epsilon_from_source_cycle
        Φ B U L hL_pos hUopen hUconv hsupport hupper hBLip
        z hz hBz u hu hn_pos)

/-- Reflected finite-mesh cyclic work lower bound along one segment.

This is the isolated analytic core of Lan Lemma 5.8's open-domain reflected
