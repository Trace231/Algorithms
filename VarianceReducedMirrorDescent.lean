              Finset.sum (Finset.range n)
                (fun k => ‖B (yPert k) - g k‖) := hsum_scale
          _ ≤ (1 / L) *
              (L * (perturbScale *
                Finset.sum (Finset.range n)
                  (fun k => ‖(1 / L) • r k‖))) := by
                exact mul_le_mul_of_nonneg_left
                  hB_yPert_close_sum hscale_nonneg
          _ = perturbScale *
              Finset.sum (Finset.range n)
                (fun k => ‖(1 / L) • r k‖) := by
                field_simp [ne_of_gt hL_pos]
      have hB_yPert_close_scaled_sum_le_R :
          Finset.sum (Finset.range n)
              (fun k => ‖(1 / L) • (B (yPert k) - g k)‖) ≤ R := by
        simpa [R] using hB_yPert_close_scaled_sum_le
      have hB_frozen_perturbed_split_pred :
          Finset.sum (Finset.range n)
              (fun k => ⟪g k, yPert (k + 1) - yPert k⟫_ℝ) +
            ⟪g n, yPert (n + 1) - yPert n⟫_ℝ =
          (Finset.sum (Finset.range n)
              (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
            ⟪g n, x 0 - x n⟫_ℝ) +
          perturbScale *
            ((1 / L) *
              (⟪g n - g 0, r 0⟫_ℝ +
                Finset.sum (Finset.range (n - 1))
                  (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ))) := by
        rw [hB_frozen_perturbed_split_scaled,
          reflected_scaled_bracket_sum_rewrite (H := H) hn_pos L g r]
      have htilt_frozen_perturbed_split_pred :
          Finset.sum (Finset.range n)
