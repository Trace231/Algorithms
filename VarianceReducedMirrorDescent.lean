    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) (d : H) (x g : ℕ → H)
    (hx0_mem : x 0 ∈ U) (hxn_mem : x n ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hg0 : g 0 = 0)
    (hmesh :
      ∀ k, k ≤ n →
        x k = AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ)))
