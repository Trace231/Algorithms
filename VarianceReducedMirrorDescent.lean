    ∫ i, SOptLib.dualNorm (setup.delta xTilde.1 x.1 i) ^ 2
        ∂Measure.map (setup.sampledIndexAt s t) setup.P ≤
      4 * setup.LQ *
        ((setup.PsiOn x - setup.PsiOn xStar) +
          (setup.PsiOn xTilde - setup.PsiOn xStar)) := by
  calc
    ∫ i, SOptLib.dualNorm (setup.delta xTilde.1 x.1 i) ^ 2
        ∂Measure.map (setup.sampledIndexAt s t) setup.P
