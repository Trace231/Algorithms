                  g k)‖)) /
          2)
    (hzero_endpoint :
      ‖B (x n)‖ ^ 2 ≤ 2 * L * (Φ (x n) - Φ (x 0)))
    (hgap_pair :
      Finset.sum (Finset.range n)
          (fun k =>
            2 * ⟪r k, (L / (n : ℝ)) • d⟫_ℝ - ‖r k‖ ^ 2 -
              ‖g (k + 1) - g k‖ ^ 2)
        ≤
          (1 / 2) *
            Finset.sum (Finset.range n)
              (fun k =>
                ‖(1 / L) •
                    (B (reflectedPerturbedCycle L τ n x r k) - g k)‖ +
                  ‖(1 / L) •
                    (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                      g k)‖)) :
    0 ≤ 2 * Rsum + Q + Eavg := by
  classical
  have hendpoint_mesh :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) :=
    zero_base_endpoint_energy_to_source_mesh_endpoint_bound
      Φ B U L hL_pos hUconv hgrad hBLip hn_pos d x g
      hx0_mem hxn_mem hg hmesh hclose hzero_endpoint
  have hslack :
      -(2 * Rsum + Q) ≤ Eavg :=
    source_endpoint_cocoercivity_bridge
      Φ B U L hL_pos hsupport hupper hBLip hn_pos hτ_pos
      d x g r hx_mem_range hyPert_mem_pos hyPert_mem_neg
      hg hr hstep hclose hg0 hpos_named hneg_named
      hRsum_def hQ_def hEavg_def hendpoint_mesh hgap_pair
  linarith

