              φ ((k : ℝ) / (n : ℝ))) =
          Finset.sum (Finset.range n)
              (fun k => φ (((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
            Finset.sum (Finset.range n)
              (fun k => φ ((k : ℝ) / (n : ℝ))) := by
      rw [Finset.sum_sub_distrib]
    rw [← hsum_sub]
