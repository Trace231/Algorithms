  let C : H → H := fun x => B x - B z
  have hΨz : Ψ z = 0 := by
    simp [Ψ]
  have hCz : C z = 0 := by
    simp [C]
  have hnonnegΨ : ∀ x ∈ U, 0 ≤ Ψ x := by
    intro x hx
    simpa [Ψ, hBz] using hsupport z hz x hx
  have hsupportΨ : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ := by
    intro x hx y hy
    have h := hsupport x hx y hy
    have hres :
        Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ =
          Φ y - Φ x - ⟪B x, y - x⟫_ℝ := by
      simp [Ψ, C, inner_sub_left, inner_sub_right]
      ring
    simpa [hres] using h
  have hupperΨ : ∀ x ∈ U, ∀ y ∈ U,
      Ψ y ≤ Ψ x + ⟪C x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2 := by
    intro x hx y hy
    have h := hupper x hx y hy
    have hres :
        Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ =
          Φ y - Φ x - ⟪B x, y - x⟫_ℝ := by
      simp [Ψ, C, inner_sub_left, inner_sub_right]
      ring
    have hgap :
        Φ y - Φ x - ⟪B x, y - x⟫_ℝ ≤
          (L / 2) * ‖y - x‖ ^ 2 := by
      linarith
    have hgapΨ :
        Ψ y - Ψ x - ⟪C x, y - x⟫_ℝ ≤
          (L / 2) * ‖y - x‖ ^ 2 := by
      simpa [hres] using hgap
    linarith
  have hgradΨ : ∀ x ∈ U, HasFDerivAt Ψ (innerSL ℝ (C x)) x := by
    intro x hx
    exact
      support_upper_hasFDerivAt_of_mem_interior
        Ψ C U L hsupportΨ hupperΨ x (by
          simpa [hUopen.interior_eq] using hx)
  have hCLip : ∀ x ∈ U, ∀ y ∈ U, ‖C x - C y‖ ≤ L * ‖x - y‖ := by
    intro x hx y hy
    have hdiff : C x - C y = B x - B y := by
      dsimp [C]
      abel
    simpa [hdiff] using hBLip x hx y hy
  have hself : ‖C u‖ ^ 2 ≤ 2 * L * Ψ u :=
    early_open_zero_base_endpoint_from_support_upper_gradient_before_mesh
      Ψ C U L hL_pos hUopen hUconv hnonnegΨ hsupportΨ hupperΨ hgradΨ hCLip
      z hz hΨz hCz u hu
  simpa [Ψ, C, hBz] using hself

/-- Voucher step: source support, smooth upper model, and Lipschitz selected
