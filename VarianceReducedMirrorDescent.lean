  have hconvΨ : ConvexOn ℝ U Ψ :=
    convexOn_of_global_support_open Ψ C U hUconv hsupportΨ
  have hgradΨ : ∀ x ∈ U, HasFDerivAt Ψ (innerSL ℝ (C x)) x := by
    intro x hx
    have hΦ : HasFDerivAt Φ (innerSL ℝ (B x)) x := hgrad x hx
