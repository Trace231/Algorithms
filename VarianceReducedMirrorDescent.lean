private theorem _voucher_step_3_source_reflected_cycle_first_order_bridge
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) {ε τ : ℝ}
    (hε_pos : 0 < ε) (hτ_pos : 0 < τ) (hτ_nonneg : 0 ≤ τ)
    (d : H) (x g r : ℕ → H)
    (hyPert_mem :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hyPert_cycle :
      reflectedPerturbedCycle L τ n x r (n + 1) =
        reflectedPerturbedCycle L τ n x r 0)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hy_mem_range :
      ∀ k ∈ Finset.range n, reflectedPerturbedCycle L τ n x r k ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    (hclose : x 0 - x n = -d)
    (hg0 : g 0 = 0)
    (herror_le_R :
      Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) • (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) ≤
        τ * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖))
    (hlinear_error_small :
      τ * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) < ε) :
    -ε ≤
      2 * Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) +
        L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
  classical
  have hcycles :=
    _voucher_step_3a_cyclic_support_applications
      Φ B U L τ hupper hsupport x r hyPert_mem hyPert_cycle
  have hsplit :=
    _voucher_step_3c_reflected_split_identities
      (H := H) hn_pos (hL_pos := hL_pos) B x g r hg
      hcycles.1 hcycles.2
  let S : ℝ :=
    2 * Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) +
      L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)
  let errorSum : ℝ :=
    Finset.sum (Finset.range n)
      (fun k =>
        ‖(1 / L) • (B (reflectedPerturbedCycle L τ n x r k) - g k)‖)
  let R : ℝ :=
    τ * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖)
  have hfirst : -(τ * errorSum) ≤ τ * S := by
    simpa [S, errorSum] using
      _voucher_step_3d_first_order_from_source_split
        Φ B U L hL_pos hUopen hUconv hsupport hupper hBLip
        hn_pos hτ_nonneg d x g r hyPert_mem hx_mem_range hy_mem_range
