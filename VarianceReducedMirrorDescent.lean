/-- Epsilon form of the early aggregate reflected finite-mesh work bound.

This stages Lan Lemma 5.8's reflected-cycle argument before the endpoint
theorem: the open convex tube, positive perturbation scale, feasible perturbed
cycle, and the two cyclic support inequalities are constructed explicitly.
Search audit: checked pre-searched candidates
`cyclic_monotone_sum_of_support_on_cycle`,
`open_quadratic_tilt_support_from_smooth_upper`,
`scaled_lipschitz_error_sum_bound_for_reflected_cycle`, and the downstream
`aggregate_reflected_mesh_work_epsilon_from_source_cycle`; the first two are
used here, while the downstream theorem is declaration-order unavailable and
the Lipschitz/error helper only applies after the finite first-order split. -/

private theorem early_aggregate_reflected_mesh_work_epsilon_from_source_cycle
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hBz : B z = 0)
    (u : H) (hu : u ∈ U)
    {n : ℕ} (hn_pos : 0 < n) :
    ∀ ε : ℝ, 0 < ε →
      -ε ≤
        2 *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))),
                  (L / (n : ℝ)) • (u - z) -
                    (B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                      B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))))⟫_ℝ) +
          L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
  classical
  intro ε hε_pos
  let d : H := u - z
  let x : ℕ → H := fun k => AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))
  let g : ℕ → H := fun k => B (x k)
  let r : ℕ → H := fun k => (L / (n : ℝ)) • d - (g (k + 1) - g k)
  have htilt :
      ∀ a ∈ U, ∀ b ∈ U,
        0 ≤
          ((L / 2) * ‖b‖ ^ 2 - Φ b) -
            ((L / 2) * ‖a‖ ^ 2 - Φ a) -
            ⟪L • a - B a, b - a⟫_ℝ :=
    open_quadratic_tilt_support_from_smooth_upper Φ B U L hupper
  have hseg_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      AffineMap.lineMap z u t ∈ U := by
    intro t ht
    exact hUconv.lineMap_mem hz hu ht
  obtain ⟨ρ, hρ_pos, htube⟩ :=
    compact_segment_tube_inside_open_convex_domain U hUopen hUconv z hz u hu
  have hx_mem : ∀ k, k ≤ n → x k ∈ U := by
    intro k hk
    have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
    have h0 : 0 ≤ (k : ℝ) / (n : ℝ) := by positivity
    have h1 : (k : ℝ) / (n : ℝ) ≤ 1 := by
      rw [div_le_iff₀ hnR_pos]
      have hkR : (k : ℝ) ≤ (n : ℝ) := by exact_mod_cast hk
      nlinarith
    exact hseg_mem ((k : ℝ) / (n : ℝ)) ⟨h0, h1⟩
  have hscaled_vertex_mem :
      ∀ τ : ℝ, ∀ k ∈ Finset.range n,
        ‖τ • ((1 / L) • r k)‖ < ρ →
          x k + τ • ((1 / L) • r k) ∈ U := by
    intro τ k hk hscaled
    have hklt : k < n := Finset.mem_range.mp hk
    simpa [x, r, g, d] using
      scaled_reflected_uniform_mesh_point_mem_of_tube
        B U L ρ τ z u hseg_mem htube hn_pos k hklt hscaled
  let perturbScale : ℝ :=
    min
      (min 1 (ρ / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1)))
      (ε / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1))
  have hperturbScale_pos : 0 < perturbScale := by
    have hsum_nonneg :
        0 ≤ Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) := by
      exact Finset.sum_nonneg (by intro k hk; exact norm_nonneg _)
    have hden_pos :
        0 < Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1 := by
      linarith
    have hquot_pos :
        0 < ρ / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1) :=
      div_pos hρ_pos hden_pos
    have hεquot_pos :
        0 < ε / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1) :=
      div_pos hε_pos hden_pos
    exact lt_min (lt_min (by norm_num) hquot_pos) hεquot_pos
  have hperturbScale_nonneg : 0 ≤ perturbScale := le_of_lt hperturbScale_pos
  have hperturbScale_le_tube :
      perturbScale ≤
        ρ / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1) := by
    exact le_trans (min_le_left _ _) (min_le_right _ _)
  have hperturbScale_le_eps :
      perturbScale ≤
        ε / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1) := by
    exact min_le_right _ _
  have hperturb_scaled_small :
      ∀ k ∈ Finset.range n,
        ‖perturbScale • ((1 / L) • r k)‖ < ρ := by
    intro k hk
    let R : ℝ := Finset.sum (Finset.range n) (fun j => ‖(1 / L) • r j‖)
    have hR_nonneg : 0 ≤ R := by
      dsimp [R]
      exact Finset.sum_nonneg (by
        intro j hj
        exact norm_nonneg ((1 / L) • r j))
    have hterm_le : ‖(1 / L) • r k‖ ≤ R := by
      dsimp [R]
      exact
        Finset.single_le_sum
          (s := Finset.range n) (f := fun j : ℕ => ‖(1 / L) • r j‖)
          (by
            intro j hj
            exact norm_nonneg ((1 / L) • r j)) hk
    have hden_pos : 0 < R + 1 := by linarith
    have hscaleR_le : perturbScale * R ≤ (ρ / (R + 1)) * R := by
      exact mul_le_mul_of_nonneg_right (by simpa [R] using hperturbScale_le_tube) hR_nonneg
    have hquot_mul_lt : (ρ / (R + 1)) * R < ρ := by
      have hR_lt : R < R + 1 := by linarith
      calc
        (ρ / (R + 1)) * R < (ρ / (R + 1)) * (R + 1) :=
          mul_lt_mul_of_pos_left hR_lt (div_pos hρ_pos hden_pos)
        _ = ρ := by field_simp [ne_of_gt hden_pos]
    calc
      ‖perturbScale • ((1 / L) • r k)‖ =
          perturbScale * ‖(1 / L) • r k‖ := by
            rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hperturbScale_nonneg]
      _ ≤ perturbScale * R :=
          mul_le_mul_of_nonneg_left hterm_le hperturbScale_nonneg
      _ ≤ (ρ / (R + 1)) * R := hscaleR_le
      _ < ρ := hquot_mul_lt
  have hperturb_linear_error_small :
      perturbScale * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) < ε := by
    let R : ℝ := Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖)
    have hR_nonneg : 0 ≤ R := by
      dsimp [R]
      exact Finset.sum_nonneg (by
        intro j hj
        exact norm_nonneg ((1 / L) • r j))
    have hden_pos : 0 < R + 1 := by linarith
    have hscaleR_le : perturbScale * R ≤ (ε / (R + 1)) * R := by
      exact mul_le_mul_of_nonneg_right (by simpa [R] using hperturbScale_le_eps) hR_nonneg
    have hquot_mul_lt : (ε / (R + 1)) * R < ε := by
      have hR_lt : R < R + 1 := by linarith
      calc
        (ε / (R + 1)) * R < (ε / (R + 1)) * (R + 1) :=
          mul_lt_mul_of_pos_left hR_lt (div_pos hε_pos hden_pos)
        _ = ε := by field_simp [ne_of_gt hden_pos]
    exact lt_of_le_of_lt hscaleR_le hquot_mul_lt
  have hperturbed_vertex_mem :
      ∀ k ∈ Finset.range n,
        x k + perturbScale • ((1 / L) • r k) ∈ U := by
    intro k hk
    exact hscaled_vertex_mem perturbScale k hk (hperturb_scaled_small k hk)
  let yPert : ℕ → H := fun k =>
    if hk : k < n then
      x k + perturbScale • ((1 / L) • r k)
    else if hk' : k = n then
      x n
    else
      x 0 + perturbScale • ((1 / L) • r 0)
  have hyPert_mem : ∀ k, k ≤ n + 1 → yPert k ∈ U := by
    intro k hk
    by_cases hkn : k < n
    · have hkrange : k ∈ Finset.range n := Finset.mem_range.mpr hkn
      simpa [yPert, hkn] using hperturbed_vertex_mem k hkrange
    · by_cases hk_eq_n : k = n
      · have hnle : n ≤ n := le_rfl
        simpa [yPert, hkn, hk_eq_n] using hx_mem n hnle
      · have hk_eq_succ : k = n + 1 := by omega
        have h0range : 0 ∈ Finset.range n := Finset.mem_range.mpr hn_pos
        simpa [yPert, hk_eq_succ, hkn, hk_eq_n] using hperturbed_vertex_mem 0 h0range
  have hyPert_cycle : yPert (n + 1) = yPert 0 := by
    have hn1_not_lt : ¬ n + 1 < n := by omega
    have hn1_ne_n : n + 1 ≠ n := by omega
    have h0lt : 0 < n := hn_pos
    simp [yPert, hn1_not_lt, hn1_ne_n, h0lt]
  have hcycle_B_perturbed :
      Finset.sum (Finset.range (n + 1))
          (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 :=
    cyclic_monotone_sum_of_support_on_cycle Φ B U hsupport
      (n + 1) yPert hyPert_mem hyPert_cycle
  have hcycle_tilt_perturbed :
      Finset.sum (Finset.range (n + 1))
