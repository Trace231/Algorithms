          hfirst_unscaled hpairNorm_sum_visible
    have hqform : 0 ≤ 2 * Rsum + Q + Eavg :=
      pairnorm_sum_close_qform hpair_q hpairNorm_sum_visible
    have hendpoint' :
        ‖g n‖ ^ 2 ≤
          2 * L *
              ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
            2 * Q + Eavg := by
      rw [hmesh_visible] at hqform
