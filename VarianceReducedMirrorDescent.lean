private theorem residual_nf_pair_sum_nonpos_of_defs
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) {L τ residualPosNF residualNegNF : ℝ}
    (hL_pos : 0 < L) (d : H) (r : ℕ → H)
    (hresidualPosNF_def :
      residualPosNF =
        τ * ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ)) +
          τ ^ 2 * (1 / L) *
            (Finset.sum (Finset.range (n - 1))
                (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
              ‖r (n - 1)‖ ^ 2))
    (hresidualNegNF_def :
      residualNegNF =
        -(τ * ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ))) +
          τ ^ 2 * (1 / L) *
            (Finset.sum (Finset.range (n - 1))
                (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
              ‖r (n - 1)‖ ^ 2)) :
    residualPosNF + residualNegNF ≤ 0 := by
  classical
  have hchain :
      Finset.sum (Finset.range (n - 1))
          (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
        ‖r (n - 1)‖ ^ 2 ≤ 0 :=
    residual_chain_inner_sub_last_norm_nonpos hn_pos r
  have hsum_nf :
      residualPosNF + residualNegNF =
        2 * τ ^ 2 * (1 / L) *
          (Finset.sum (Finset.range (n - 1))
              (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
            ‖r (n - 1)‖ ^ 2) := by
    rw [hresidualPosNF_def, hresidualNegNF_def]
    ring
  rw [hsum_nf]
  have hcoef_nonneg : 0 ≤ 2 * τ ^ 2 * (1 / L) := by
    exact mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg τ))
      (le_of_lt (one_div_pos.mpr hL_pos))
  exact mul_nonpos_of_nonneg_of_nonpos hcoef_nonneg hchain

/-- Reconstruct the signed freezing defect from the two reflected edge displays.

This is the local T2 algebra in Lan Lemma 5.8's reflected mesh route.  Search
audit: considered `canonical_reflected_error_context`, the pointwise helpers
`reflected_error_edge_pair_split_pos`/`reflected_error_edge_pair_split_last`,
