        rw [hyPert_closing_edge]
        simp [inner_add_right]
      rw [hsum, hclose, Finset.sum_add_distrib]
      ring
    have hB_frozen_perturbed_split_scaled :
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, yPert (k + 1) - yPert k⟫_ℝ) +
          ⟪g n, yPert (n + 1) - yPert n⟫_ℝ =
        (Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ) +
        perturbScale *
          (Finset.sum (Finset.range n)
              (fun k =>
                if hlast : k + 1 = n then
                  -⟪g k, (1 / L) • r k⟫_ℝ
                else
                  ⟪g k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) +
            ⟪g n, (1 / L) • r 0⟫_ℝ) := by
      rw [hB_frozen_perturbed_split]
      congr 1
      have hsum_scale :
          Finset.sum (Finset.range n)
              (fun k =>
                if hlast : k + 1 = n then
                  ⟪g k, -perturbScale • ((1 / L) • r k)⟫_ℝ
                else
                  ⟪g k,
                    perturbScale •
                      ((1 / L) • r (k + 1) - (1 / L) • r k)⟫_ℝ) =
            perturbScale *
              Finset.sum (Finset.range n)
                (fun k =>
                  if hlast : k + 1 = n then
                    -⟪g k, (1 / L) • r k⟫_ℝ
                  else
                    ⟪g k, (1 / L) • r (k + 1) - (1 / L) • r k⟫_ℝ) := by
