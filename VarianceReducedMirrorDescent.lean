    uniform_forward_mesh_gap_upper_from_hasFDeriv_lipschitz
      Φ B U L hL_pos hUconv hgrad hBLip z hz u hu hn_pos

/-- Endpoint-energy budget used to make the reflected work nonnegative.

This packages the source-derived endpoint part of Lan Lemma 5.8 for the earlier
reflected-cycle bridge: support plus the smooth upper model gives the zero-base
Baillon-Haddad endpoint bound, and the forward uniform mesh estimate converts it
to the finite mesh budget consumed by `reflected_work_nonneg_of_endpoint_energy_bound`. -/
private theorem caller_endpoint_energy_from_support_upper_lipschitz
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ U, ∀ v ∈ U,
      Φ v ≤ Φ u + ⟪B u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hBz : B z = 0)
    (u : H) (hu : u ∈ U)
    {n : ℕ} (hn_pos : 0 < n) :
    ‖B u‖ ^ 2 ≤
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ)) +
        L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
  classical
  have hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x :=
    _voucher_step_1_endpoint_gradient_semantics
      Φ B U L hUopen hsupport hupper
  have hBH :
      ‖B u‖ ^ 2 ≤ 2 * L * (Φ u - Φ z) :=
    _voucher_step_2_zero_base_endpoint_energy
      Φ B U L hL_pos hUopen hUconv hsupport hupper hgrad hBLip
      z hz hBz u hu
  have hforward :
      Φ u - Φ z ≤
        (1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
          L * ‖u - z‖ ^ 2 / (2 * (n : ℝ)) :=
    _voucher_step_3_forward_mesh_gap
      Φ B U L hL_pos hUconv hgrad hBLip z hz u hu hn_pos
  have htwoL_nonneg : 0 ≤ 2 * L := by nlinarith
  have hscaled :
      2 * L * (Φ u - Φ z) ≤
        2 * L *
          ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
            L * ‖u - z‖ ^ 2 / (2 * (n : ℝ))) :=
    mul_le_mul_of_nonneg_left hforward htwoL_nonneg
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  calc
    ‖B u‖ ^ 2 ≤ 2 * L * (Φ u - Φ z) := hBH
    _ ≤
        2 * L *
          ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ) +
            L * ‖u - z‖ ^ 2 / (2 * (n : ℝ))) := hscaled
    _ =
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))), u - z⟫_ℝ)) +
          L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
        field_simp [hnR_ne]

/-- Downstream terminal for the early uniform-mesh endpoint-energy voucher.

This is the exact theorem needed by `_voucher_step_3h_endpoint_energy_from_source_uniform_mesh`.
It is declared after `caller_endpoint_energy_from_support_upper_lipschitz`
only because that endpoint wrapper is declaration-order later than the early
reflected-cycle bridge. -/
private theorem _voucher_step_3h_endpoint_energy_from_source_uniform_mesh_terminal
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) (d : H) (x g : ℕ → H)
    (hx0_mem : x 0 ∈ U) (hxn_mem : x n ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hg0 : g 0 = 0)
    (hmesh :
      ∀ k, k ≤ n →
        x k = AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ)))
    (hclose : x 0 - x n = -d) :
    ‖g n‖ ^ 2 ≤
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
        L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
  classical
  have hdx : x n - x 0 = d := by
    have h := congrArg Neg.neg hclose
    simpa [neg_sub] using h
  have hBz : B (x 0) = 0 := by
    have h := hg0
    rw [hg 0] at h
    exact h
  have hsum :
      Finset.sum (Finset.range n)
          (fun k =>
            ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
              d⟫_ℝ) =
        Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ) := by
    apply Finset.sum_congr rfl
    intro k hk
    have hk_le : k ≤ n := Nat.le_of_lt (Finset.mem_range.mp hk)
    have hxk := hmesh k hk_le
    calc
      ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
          d⟫_ℝ
          = ⟪B (x k), d⟫_ℝ := by rw [← hxk]
      _ = ⟪g k, d⟫_ℝ := by rw [← hg k]
  have hendpoint :=
    caller_endpoint_energy_from_support_upper_lipschitz
      Φ B U L hL_pos hUopen hUconv hsupport hupper hBLip
      (x 0) hx0_mem hBz (x n) hxn_mem hn_pos
  have hgn : g n = B (x n) := hg n
  rw [← hgn] at hendpoint
  simpa [hsum, hdx] using hendpoint

/-- Aggregate reflected finite-mesh work from the non-circular source cycle.

This is the declaration-order bridge needed before the endpoint-energy theorem
for Lan Lemma 5.8. It deliberately omits the unused nonnegativity, gradient,
and base-value hypotheses. Search audit: checked the later local candidates
`aggregate_reflected_mesh_work_from_source_cycle`,
`cyclic_reflected_work_limit_on_segment`, and
`reflected_mesh_work_nonnegative_from_source_cyclic_monotonicity`; all are
declared downstream of the current endpoint. SOptLib candidates from the
pre-search (`mirrorDescent_three_point_of_update`, filtration/independence
bridges) are algorithmic or probabilistic and do not state this deterministic
reflected finite-cycle work inequality. -/
private theorem aggregate_reflected_mesh_work_epsilon_before_endpoint
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ U, ∀ v ∈ U,
      Φ v ≤ Φ u + ⟪B u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hBz : B z = 0)
    (u : H) (hu : u ∈ U)
    {n : ℕ} (hn_pos : 0 < n) :
    ∀ ε : ℝ, 0 < ε →
      -ε ≤
        2 *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))),
                  (L / (n : ℝ)) • (u - z) -
                    (B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                      B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))))⟫_ℝ) +
          L ^ 2 * ‖u - z‖ ^ 2 / (n : ℝ) := by
  classical
  intro ε hε_pos
  let d : H := u - z
  let x : ℕ → H := fun k => AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))
  let g : ℕ → H := fun k => B (x k)
  let r : ℕ → H := fun k => (L / (n : ℝ)) • d - (g (k + 1) - g k)
  have htilt :
      ∀ a ∈ U, ∀ b ∈ U,
        0 ≤
          ((L / 2) * ‖b‖ ^ 2 - Φ b) -
            ((L / 2) * ‖a‖ ^ 2 - Φ a) -
            ⟪L • a - B a, b - a⟫_ℝ :=
    open_quadratic_tilt_support_from_smooth_upper Φ B U L hupper
  have hseg_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      AffineMap.lineMap z u t ∈ U := by
    intro t ht
    exact hUconv.lineMap_mem hz hu ht
  obtain ⟨ρ, hρ_pos, htube⟩ :=
    compact_segment_tube_inside_open_convex_domain U hUopen hUconv z hz u hu
  have hx_mem : ∀ k, k ≤ n → x k ∈ U := by
    intro k hk
    have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
    have h0 : 0 ≤ (k : ℝ) / (n : ℝ) := by positivity
    have h1 : (k : ℝ) / (n : ℝ) ≤ 1 := by
      rw [div_le_iff₀ hnR_pos]
      have hkR : (k : ℝ) ≤ (n : ℝ) := by exact_mod_cast hk
      nlinarith
    exact hseg_mem ((k : ℝ) / (n : ℝ)) ⟨h0, h1⟩
  have hscaled_vertex_mem :
      ∀ τ : ℝ, ∀ k ∈ Finset.range n,
        ‖τ • ((1 / L) • r k)‖ < ρ →
          x k + τ • ((1 / L) • r k) ∈ U := by
    intro τ k hk hscaled
    have hklt : k < n := Finset.mem_range.mp hk
    simpa [x, r, g, d] using
      scaled_reflected_uniform_mesh_point_mem_of_tube
        B U L ρ τ z u hseg_mem htube hn_pos k hklt hscaled
  let perturbScale : ℝ :=
    min
      (min 1 (ρ / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1)))
      (ε / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1))
  have hperturbScale_pos : 0 < perturbScale := by
    have hsum_nonneg :
        0 ≤ Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) := by
      exact Finset.sum_nonneg (by intro k hk; exact norm_nonneg _)
    have hden_pos :
        0 < Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1 := by
      linarith
    have hquot_pos :
        0 < ρ / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1) :=
      div_pos hρ_pos hden_pos
    have hεquot_pos :
        0 < ε / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1) :=
      div_pos hε_pos hden_pos
    exact lt_min (lt_min (by norm_num) hquot_pos) hεquot_pos
  have hperturbScale_nonneg : 0 ≤ perturbScale := le_of_lt hperturbScale_pos
  have hperturbScale_le_tube :
      perturbScale ≤
        ρ / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1) := by
    exact le_trans (min_le_left _ _) (min_le_right _ _)
  have hperturbScale_le_eps :
      perturbScale ≤
        ε / (Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) + 1) := by
    exact min_le_right _ _
  have hperturb_scaled_small :
      ∀ k ∈ Finset.range n,
        ‖perturbScale • ((1 / L) • r k)‖ < ρ := by
    intro k hk
    let R : ℝ := Finset.sum (Finset.range n) (fun j => ‖(1 / L) • r j‖)
    have hR_nonneg : 0 ≤ R := by
      dsimp [R]
      exact Finset.sum_nonneg (by
        intro j hj
        exact norm_nonneg ((1 / L) • r j))
    have hterm_le : ‖(1 / L) • r k‖ ≤ R := by
      dsimp [R]
      exact
        Finset.single_le_sum
          (s := Finset.range n) (f := fun j : ℕ => ‖(1 / L) • r j‖)
          (by
            intro j hj
            exact norm_nonneg ((1 / L) • r j)) hk
    have hden_pos : 0 < R + 1 := by linarith
    have hscaleR_le : perturbScale * R ≤ (ρ / (R + 1)) * R := by
      exact mul_le_mul_of_nonneg_right (by simpa [R] using hperturbScale_le_tube) hR_nonneg
    have hquot_mul_lt : (ρ / (R + 1)) * R < ρ := by
      have hR_lt : R < R + 1 := by linarith
      calc
        (ρ / (R + 1)) * R < (ρ / (R + 1)) * (R + 1) :=
          mul_lt_mul_of_pos_left hR_lt (div_pos hρ_pos hden_pos)
        _ = ρ := by field_simp [ne_of_gt hden_pos]
    calc
      ‖perturbScale • ((1 / L) • r k)‖ =
          perturbScale * ‖(1 / L) • r k‖ := by
            rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hperturbScale_nonneg]
      _ ≤ perturbScale * R :=
          mul_le_mul_of_nonneg_left hterm_le hperturbScale_nonneg
      _ ≤ (ρ / (R + 1)) * R := hscaleR_le
      _ < ρ := hquot_mul_lt
  have hperturb_linear_error_small :
      perturbScale * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) < ε := by
    let R : ℝ := Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖)
    have hR_nonneg : 0 ≤ R := by
      dsimp [R]
      exact Finset.sum_nonneg (by
        intro j hj
        exact norm_nonneg ((1 / L) • r j))
    have hden_pos : 0 < R + 1 := by linarith
    have hscaleR_le : perturbScale * R ≤ (ε / (R + 1)) * R := by
      exact mul_le_mul_of_nonneg_right (by simpa [R] using hperturbScale_le_eps) hR_nonneg
    have hquot_mul_lt : (ε / (R + 1)) * R < ε := by
      have hR_lt : R < R + 1 := by linarith
      calc
        (ε / (R + 1)) * R < (ε / (R + 1)) * (R + 1) :=
          mul_lt_mul_of_pos_left hR_lt (div_pos hε_pos hden_pos)
        _ = ε := by field_simp [ne_of_gt hden_pos]
    exact lt_of_le_of_lt hscaleR_le hquot_mul_lt
  have hperturbed_vertex_mem :
      ∀ k ∈ Finset.range n,
        x k + perturbScale • ((1 / L) • r k) ∈ U := by
    intro k hk
    exact hscaled_vertex_mem perturbScale k hk (hperturb_scaled_small k hk)
  let yPert : ℕ → H := fun k =>
    if hk : k < n then
      x k + perturbScale • ((1 / L) • r k)
    else if hk' : k = n then
      x n
    else
      x 0 + perturbScale • ((1 / L) • r 0)
  have hyPert_mem : ∀ k, k ≤ n + 1 → yPert k ∈ U := by
    intro k hk
    by_cases hkn : k < n
    · have hkrange : k ∈ Finset.range n := Finset.mem_range.mpr hkn
      simpa [yPert, hkn] using hperturbed_vertex_mem k hkrange
    · by_cases hk_eq_n : k = n
      · have hnle : n ≤ n := le_rfl
        simpa [yPert, hkn, hk_eq_n] using hx_mem n hnle
      · have hk_eq_succ : k = n + 1 := by omega
        have h0range : 0 ∈ Finset.range n := Finset.mem_range.mpr hn_pos
        simpa [yPert, hk_eq_succ, hkn, hk_eq_n] using hperturbed_vertex_mem 0 h0range
  have hyPert_cycle : yPert (n + 1) = yPert 0 := by
    have hn1_not_lt : ¬ n + 1 < n := by omega
    have hn1_ne_n : n + 1 ≠ n := by omega
    have h0lt : 0 < n := hn_pos
    simp [yPert, hn1_not_lt, hn1_ne_n, h0lt]
  have hcycle_B_perturbed :
      Finset.sum (Finset.range (n + 1))
          (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 :=
    cyclic_monotone_sum_of_support_on_cycle Φ B U hsupport
      (n + 1) yPert hyPert_mem hyPert_cycle
  have hcycle_tilt_perturbed :
      Finset.sum (Finset.range (n + 1))
          (fun k =>
            ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) ≤ 0 :=
    cyclic_monotone_sum_of_support_on_cycle
      (fun w : H => (L / 2) * ‖w‖ ^ 2 - Φ w)
      (fun w : H => L • w - B w) U htilt
      (n + 1) yPert hyPert_mem hyPert_cycle
  have hcycle_B_perturbed_split :
      Finset.sum (Finset.range n)
          (fun k => ⟪B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0 := by
    rw [Finset.sum_range_succ] at hcycle_B_perturbed
    simpa [add_comm, add_left_comm, add_assoc] using hcycle_B_perturbed
  have hcycle_tilt_perturbed_split :
      Finset.sum (Finset.range n)
          (fun k =>
            ⟪L • yPert k - B (yPert k), yPert (k + 1) - yPert k⟫_ℝ) +
        ⟪L • yPert n - B (yPert n), yPert (n + 1) - yPert n⟫_ℝ ≤ 0 := by
    rw [Finset.sum_range_succ] at hcycle_tilt_perturbed
    simpa [add_comm, add_left_comm, add_assoc] using hcycle_tilt_perturbed
  have hcycle_to_bound :
