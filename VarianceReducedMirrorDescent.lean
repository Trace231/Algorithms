private theorem _voucher_step_3d_source_named_reflected_work_nonnegative
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) {τ : ℝ}
    (hτ_nonneg : 0 ≤ τ)
    (d : H) (x g r : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hyPert_mem_pos :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hyPert_cycle_pos :
      reflectedPerturbedCycle L τ n x r (n + 1) =
        reflectedPerturbedCycle L τ n x r 0)
    (hyPert_mem_neg :
      ∀ k, k ≤ n + 1 →
        reflectedPerturbedCycle L τ n x (fun j => -r j) k ∈ U)
    (hyPert_cycle_neg :
      reflectedPerturbedCycle L τ n x (fun j => -r j) (n + 1) =
        reflectedPerturbedCycle L τ n x (fun j => -r j) 0)
    (hg : ∀ k, g k = B (x k))
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    (hclose : x 0 - x n = -d)
    (hg0 : g 0 = 0)
    (hpos_named :
      let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        τ *
          ((1 / L) *
            (⟪g n - g 0, r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
      let errorWork_pos : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yPos k) - g k, yPos (k + 1) - yPos k⟫_ℝ)
      let baseTilt : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n - g n, x 0 - x n⟫_ℝ
      let predTilt : ℝ :=
        τ *
          ((1 / L) *
            (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork_pos : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ)
      (baseB + predB) + errorWork_pos ≤ 0 ∧
        (baseTilt + predTilt) + residualWork_pos - errorWork_pos ≤ 0)
    (hneg_named :
      let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
      let baseB : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
          ⟪g n, x 0 - x n⟫_ℝ
      let predB : ℝ :=
        τ *
          ((1 / L) *
            (⟪g n - g 0, r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
      let errorWork_neg : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪B (yNeg k) - g k, yNeg (k + 1) - yNeg k⟫_ℝ)
      let baseTilt : ℝ :=
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
          ⟪L • x n - g n, x 0 - x n⟫_ℝ
      let predTilt : ℝ :=
        τ *
          ((1 / L) *
            (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
              Finset.sum (Finset.range (n - 1))
                (fun k =>
                  ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                    r (k + 1)⟫_ℝ)))
      let residualWork_neg : ℝ :=
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ)
      (baseB - predB) + errorWork_neg ≤ 0 ∧
        (baseTilt - predTilt) + residualWork_neg - errorWork_neg ≤ 0) :
    -(τ *
        ((Finset.sum (Finset.range n)
              (fun k =>
                ‖(1 / L) •
                  (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
            Finset.sum (Finset.range n)
              (fun k =>
                ‖(1 / L) •
                  (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖)) /
          2)) ≤
      τ *
        (2 * Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)) := by
  classical
  have hx_succ_mem :
      ∀ k ∈ Finset.range n, x (k + 1) ∈ U := by
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    by_cases hksucc : k + 1 < n
    · exact hx_mem_range (k + 1) (Finset.mem_range.mpr hksucc)
    · have hkeq : k + 1 = n := by omega
      have hy := hyPert_mem_pos n (by omega)
      have hyn : reflectedPerturbedCycle L τ n x r n = x n := by
        simp [reflectedPerturbedCycle]
      simpa [hkeq, hyn] using hy
  have hsource_monotone :
      ∀ k ∈ Finset.range n,
        0 ≤ ⟪g (k + 1) - g k, x (k + 1) - x k⟫_ℝ := by
    intro k hk
    have hxk : x k ∈ U := hx_mem_range k hk
    have hxk1 : x (k + 1) ∈ U := hx_succ_mem k hk
    have hs_forward := hsupport (x k) hxk (x (k + 1)) hxk1
    have hs_backward := hsupport (x (k + 1)) hxk1 (x k) hxk
    have hsum := add_nonneg hs_forward hs_backward
    have hrewrite :
        (Φ (x (k + 1)) - Φ (x k) -
              ⟪B (x k), x (k + 1) - x k⟫_ℝ) +
            (Φ (x k) - Φ (x (k + 1)) -
              ⟪B (x (k + 1)), x k - x (k + 1)⟫_ℝ) =
          ⟪B (x (k + 1)) - B (x k), x (k + 1) - x k⟫_ℝ := by
      have hback : x k - x (k + 1) = -(x (k + 1) - x k) := by
        abel
      rw [hback, inner_neg_right]
      simp [inner_sub_left]
      ring
    have hmonoB :
        0 ≤ ⟪B (x (k + 1)) - B (x k), x (k + 1) - x k⟫_ℝ := by
      simpa [hrewrite] using hsum
    simpa [hg (k + 1), hg k] using hmonoB
  let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
  let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
  let baseB : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
      ⟪g n, x 0 - x n⟫_ℝ
  let predB : ℝ :=
    τ *
      ((1 / L) *
        (⟪g n - g 0, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪g k - g (k + 1), r (k + 1)⟫_ℝ)))
  let errorWork_pos : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪B (yPos k) - g k, yPos (k + 1) - yPos k⟫_ℝ)
  let errorWork_neg : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪B (yNeg k) - g k, yNeg (k + 1) - yNeg k⟫_ℝ)
  let baseTilt : ℝ :=
    Finset.sum (Finset.range n)
        (fun k => ⟪L • x k - g k, x (k + 1) - x k⟫_ℝ) +
      ⟪L • x n - g n, x 0 - x n⟫_ℝ
  let predTilt : ℝ :=
    τ *
      ((1 / L) *
        (⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪(L • x k - g k) - (L • x (k + 1) - g (k + 1)),
                r (k + 1)⟫_ℝ)))
  let residualWork_pos : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ)
  let residualWork_neg : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ)
  have hposB : (baseB + predB) + errorWork_pos ≤ 0 := by
    simpa [yPos, baseB, predB, errorWork_pos] using hpos_named.1
  have hposT :
      (baseTilt + predTilt) + residualWork_pos - errorWork_pos ≤ 0 := by
    simpa [yPos, baseTilt, predTilt, residualWork_pos, errorWork_pos] using
      hpos_named.2
  have hnegB : (baseB - predB) + errorWork_neg ≤ 0 := by
    simpa [yNeg, baseB, predB, errorWork_neg] using hneg_named.1
  have hnegT :
      (baseTilt - predTilt) + residualWork_neg - errorWork_neg ≤ 0 := by
    simpa [yNeg, baseTilt, predTilt, residualWork_neg, errorWork_neg] using
      hneg_named.2
  have hcross :
      ((baseB + baseTilt) + (predB - predTilt) + residualWork_neg +
          (errorWork_pos - errorWork_neg) ≤ 0) ∧
        ((baseB + baseTilt) - (predB - predTilt) + residualWork_pos +
          (errorWork_neg - errorWork_pos) ≤ 0) :=
    _voucher_step_3d_named_split_cross_combination hposB hposT hnegB hnegT
  have hB_signed_cancel :
      2 * baseB + errorWork_pos + errorWork_neg ≤ 0 := by
    linarith [hposB, hnegB]
  have htilt_signed_cancel :
      2 * baseTilt + residualWork_pos + residualWork_neg -
          (errorWork_pos + errorWork_neg) ≤ 0 := by
    linarith [hposT, hnegT]
  have hcross_cancel :
      2 * (baseB + baseTilt) + residualWork_pos + residualWork_neg ≤ 0 :=
    _voucher_step_3d_crossed_signed_errors_cancel hcross.1 hcross.2
  have hy_eq_range_pos :
      ∀ k ∈ Finset.range n, yPos k = x k + τ • ((1 / L) • r k) := by
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    simp [yPos, reflectedPerturbedCycle, hklt]
  have hy_eq_range_neg :
      ∀ k ∈ Finset.range n, yNeg k = x k + τ • ((1 / L) • (-r k)) := by
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    simp [yNeg, reflectedPerturbedCycle, hklt]
  have hy_mem_range_pos : ∀ k ∈ Finset.range n, yPos k ∈ U := by
    intro k hk
    exact hyPert_mem_pos k (by
      have hklt : k < n := Finset.mem_range.mp hk
      omega)
  have hy_mem_range_neg : ∀ k ∈ Finset.range n, yNeg k ∈ U := by
    intro k hk
    exact hyPert_mem_neg k (by
      have hklt : k < n := Finset.mem_range.mp hk
      omega)
  have herror_pos :
      Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) ≤
        τ * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) := by
    exact
      scaled_lipschitz_error_sum_bound_for_reflected_cycle
        B U L τ hL_pos hτ_nonneg x g r yPos hg
        hy_eq_range_pos hx_mem_range hy_mem_range_pos hBLip
  have herror_neg :
      Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖) ≤
        τ * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) := by
    exact
      scaled_lipschitz_error_sum_bound_for_neg_reflected_cycle
        B U L τ hL_pos hτ_nonneg x g r yNeg hg
        hy_eq_range_neg hx_mem_range hy_mem_range_neg hBLip
  let Eavg : ℝ :=
    (Finset.sum (Finset.range n)
        (fun k =>
          ‖(1 / L) •
            (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
      Finset.sum (Finset.range n)
        (fun k =>
          ‖(1 / L) •
            (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖)) /
      2
  let S : ℝ :=
    2 * Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) +
      L ^ 2 * ‖d‖ ^ 2 / (n : ℝ)
  have hEavg_nonneg : 0 ≤ Eavg := by
    simpa [Eavg] using
      reflected_two_sign_error_average_nonneg
        (B := B) (x := x) (g := g) (r := r) (n := n) (L := L) (τ := τ)
  have hEavg_le_budget :
      Eavg ≤
        τ * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) := by
    simpa [Eavg] using
      _voucher_step_3d_two_sided_error_average_bound herror_pos herror_neg
  have hresidual_pair :
      residualWork_pos + residualWork_neg =
        2 * τ ^ 2 * (1 / L) *
          (Finset.sum (Finset.range (n - 1))
              (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
            ‖r (n - 1)‖ ^ 2) := by
    simpa [yPos, yNeg, residualWork_pos, residualWork_neg] using
      _voucher_step_3d_reflected_cycle_residual_pair_expansion
        (H := H) hn_pos L τ x r
  have hfinite_cancellation : -(τ * Eavg) ≤ τ * S := by
