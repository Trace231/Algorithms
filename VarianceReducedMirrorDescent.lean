    (hderiv : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      HasDerivWithinAt φ ⟪g t, d⟫_ℝ (Set.Icc (0 : ℝ) 1) t) :
    φ 1 - φ 0 ≤
      (1 / (n : ℝ)) *
        Finset.sum (Finset.range n)
          (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ) +
        L * ‖d‖ ^ 2 / (2 * (n : ℝ)) := by
  classical
  let gneg : ℝ → H := fun t => -g t
  have hgLip_neg :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖gneg t - gneg s‖ ≤ L * ‖(t - s) • d‖ := by
    intro s hs t ht
    have h := hgLip s hs t ht
    have hnorm : ‖gneg t - gneg s‖ = ‖g t - g s‖ := by
      have hdiff : gneg t - gneg s = -(g t - g s) := by
        simp [gneg]
        abel
      rw [hdiff, norm_neg]
    simpa [hnorm] using h
  have hderiv_neg :
      ∀ t ∈ Set.Icc (0 : ℝ) 1,
        HasDerivWithinAt (fun x => -φ x) ⟪gneg t, d⟫_ℝ
          (Set.Icc (0 : ℝ) 1) t := by
    intro t ht
    have h := (hderiv t ht).neg
    simpa [gneg] using h
  have herr :
      L * ‖d‖ ^ 2 / (2 * (n : ℝ)) ≤
        L * ‖d‖ ^ 2 / (2 * (n : ℝ)) := le_rfl
  have hwork :=
    scalar_work_riemann_error_of_lipschitz_derivative
      (fun x => -φ x) gneg d L hL_pos hn_pos hgLip_neg hderiv_neg herr
  have hsum_neg :
      Finset.sum (Finset.range n)
          (fun k => ⟪gneg ((k : ℝ) / (n : ℝ)), d⟫_ℝ) =
        -Finset.sum (Finset.range n)
          (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ) := by
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro k hk
    simp [gneg]
  have hwork' :
      -((1 / (n : ℝ)) *
        Finset.sum (Finset.range n)
          (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) ≤
        -φ 1 + φ 0 + L * ‖d‖ ^ 2 / (2 * (n : ℝ)) := by
    simpa [hsum_neg] using hwork
  linarith

/-- Cyclic monotonicity obtained by summing supporting hyperplanes around a
finite cycle.

This is the source-derived cyclic-gradient structure needed in Lan Lemma 5.8's
open-domain Baillon-Haddad endpoint: summing support gaps around a closed cycle
telescopes the potential values and leaves a nonpositive cyclic work sum.
Search audit: checked the pre-searched downstream Baillon-Haddad wrappers and
searched `cyclic monotone support telescope finite cycle`; no SOptLib/Mathlib
lemma packages the derivative restriction with the projected gradient. -/
private theorem cyclic_monotone_sum_of_support_on_cycle
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (n : ℕ) (x : ℕ → H)
    (hx_mem : ∀ k, k ≤ n → x k ∈ U)
    (hcycle : x n = x 0) :
    Finset.sum (Finset.range n)
        (fun k => ⟪B (x k), x (k + 1) - x k⟫_ℝ) ≤ 0 := by
  classical
  have hstep :
      ∀ k ∈ Finset.range n,
        ⟪B (x k), x (k + 1) - x k⟫_ℝ ≤
          Φ (x (k + 1)) - Φ (x k) := by
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    have hxk : x k ∈ U := hx_mem k (Nat.le_of_lt hklt)
    have hxk1 : x (k + 1) ∈ U := hx_mem (k + 1) (Nat.succ_le_of_lt hklt)
    have h := hsupport (x k) hxk (x (k + 1)) hxk1
    linarith
  have hsum := Finset.sum_le_sum hstep
  have htel_neg :
      Finset.sum (Finset.range n)
          (fun k => Φ (x k) - Φ (x (k + 1))) =
        Φ (x 0) - Φ (x n) := by
    simpa [Nat.cast_add, Nat.cast_one] using
      (Finset.sum_range_sub' (fun k : ℕ => Φ (x k)) n)
  have htel :
      Finset.sum (Finset.range n)
          (fun k => Φ (x (k + 1)) - Φ (x k)) = 0 := by
    have hneg :
        Finset.sum (Finset.range n)
            (fun k => Φ (x (k + 1)) - Φ (x k)) =
          -Finset.sum (Finset.range n)
            (fun k => Φ (x k) - Φ (x (k + 1))) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    rw [hneg, htel_neg, hcycle]
    ring
  calc
    Finset.sum (Finset.range n)
        (fun k => ⟪B (x k), x (k + 1) - x k⟫_ℝ)
        ≤ Finset.sum (Finset.range n)
            (fun k => Φ (x (k + 1)) - Φ (x k)) := hsum
    _ = 0 := htel

/-- Closed-cycle work of the linear Hilbert field is exactly the negative
half squared-edge energy.

This is the pure geometric part of the reflected-cycle proof for Lan Lemma
5.8: the quadratic-tilt cycle contains the linear field `x ↦ L • x`, whose
work around any closed finite cycle is nonpositive with this exact squared-edge
formula. No SOptLib match: searched `closed cycle linear inner sum norm square`,
`Finset sum inner consecutive norm squared cycle`, and `inner norm telescoping
Hilbert cycle`; hits covered support-cycle monotonicity and stochastic
finite-sum norm identities, not this deterministic Hilbert cycle identity. -/
private theorem linear_field_cycle_work_eq_neg_half_sq
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (L : ℝ) (n : ℕ) (x : ℕ → H) (hcycle : x n = x 0) :
    Finset.sum (Finset.range n)
        (fun k => ⟪L • x k, x (k + 1) - x k⟫_ℝ) =
      -(L / 2) *
        Finset.sum (Finset.range n)
          (fun k => ‖x (k + 1) - x k‖ ^ 2) := by
  classical
  have hpoint :
      ∀ k ∈ Finset.range n,
        ⟪x k, x (k + 1) - x k⟫_ℝ =
          (‖x (k + 1)‖ ^ 2 - ‖x k‖ ^ 2 -
            ‖x (k + 1) - x k‖ ^ 2) / 2 := by
    intro k hk
    let δ : H := x (k + 1) - x k
    have hdecomp : x (k + 1) = x k + δ := by
      dsimp [δ]
      abel
    rw [hdecomp]
    have hsub : x k + δ - x k = δ := by
      abel
    rw [hsub]
    rw [← real_inner_self_eq_norm_sq (x k + δ)]
    rw [← real_inner_self_eq_norm_sq (x k)]
    rw [← real_inner_self_eq_norm_sq δ]
    simp only [inner_add_left, inner_add_right]
    rw [real_inner_comm δ (x k)]
    ring
  have htel_neg :
      Finset.sum (Finset.range n)
          (fun k => ‖x k‖ ^ 2 - ‖x (k + 1)‖ ^ 2) =
        ‖x 0‖ ^ 2 - ‖x n‖ ^ 2 := by
    simpa using (Finset.sum_range_sub' (fun k : ℕ => ‖x k‖ ^ 2) n)
  have htel :
      Finset.sum (Finset.range n)
          (fun k => ‖x (k + 1)‖ ^ 2 - ‖x k‖ ^ 2) = 0 := by
    have hneg :
        Finset.sum (Finset.range n)
            (fun k => ‖x (k + 1)‖ ^ 2 - ‖x k‖ ^ 2) =
          -Finset.sum (Finset.range n)
            (fun k => ‖x k‖ ^ 2 - ‖x (k + 1)‖ ^ 2) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    rw [hneg, htel_neg, hcycle]
    ring
  calc
    Finset.sum (Finset.range n)
        (fun k => ⟪L • x k, x (k + 1) - x k⟫_ℝ)
        =
      L * Finset.sum (Finset.range n)
        (fun k => ⟪x k, x (k + 1) - x k⟫_ℝ) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro k hk
        simp [inner_smul_left]
    _ =
      L * Finset.sum (Finset.range n)
        (fun k =>
          (‖x (k + 1)‖ ^ 2 - ‖x k‖ ^ 2 -
            ‖x (k + 1) - x k‖ ^ 2) / 2) := by
        congr 1
        apply Finset.sum_congr rfl
        intro k hk
        exact hpoint k hk
    _ =
      L * ((Finset.sum (Finset.range n)
          (fun k => ‖x (k + 1)‖ ^ 2 - ‖x k‖ ^ 2) -
        Finset.sum (Finset.range n)
          (fun k => ‖x (k + 1) - x k‖ ^ 2)) / 2) := by
        congr 1
        rw [← Finset.sum_sub_distrib, ← Finset.sum_div]
    _ =
      -(L / 2) *
        Finset.sum (Finset.range n)
          (fun k => ‖x (k + 1) - x k‖ ^ 2) := by
        rw [htel]
        ring

/-- Real-order closure for reflected mesh work from arbitrarily small
perturbation losses.

The analytic cyclic construction naturally gives `-ε ≤ S` for every positive
`ε`, because the reflected cycle vertices are obtained by an open-domain
perturbation and then sent back to the uniform mesh.  This helper isolates the
pure order-theoretic epsilon removal from that mathematical perturbation
argument. -/
private theorem nonnegative_of_forall_neg_epsilon_le
    {S : ℝ} (hε : ∀ ε : ℝ, 0 < ε → -ε ≤ S) :
    0 ≤ S := by
  by_contra hS
  have hSlt : S < 0 := lt_of_not_ge hS
  let ε : ℝ := -S / 2
  have hεpos : 0 < ε := by
    dsimp [ε]
    linarith
  have hbound := hε ε hεpos
  dsimp [ε] at hbound
  linarith

/-- Edge identities for the small reflected perturbation cycle.

This is the algebraic expansion requested by the reflected-cycle route in Lan
Lemma 5.8: the open-domain perturbation cycle has ordinary mesh edges, one
last mesh edge, and one closing edge, each with an explicit first-order
perturbation in the reflected residuals. -/
private theorem reflected_perturbed_cycle_edge_identities
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    (x r : ℕ → H) (τ L : ℝ) {n : ℕ} (hn_pos : 0 < n) :
    let yPert : ℕ → H := fun k =>
      if hk : k < n then
        x k + τ • ((1 / L) • r k)
      else if hk' : k = n then
        x n
      else
        x 0 + τ • ((1 / L) • r 0)
    (∀ k : ℕ, k + 1 < n →
        yPert (k + 1) - yPert k =
          (x (k + 1) - x k) +
            τ • ((1 / L) • r (k + 1) - (1 / L) • r k)) ∧
      (∀ k ∈ Finset.range n, k + 1 = n →
        yPert (k + 1) - yPert k =
          (x (k + 1) - x k) -
            τ • ((1 / L) • r k)) ∧
      yPert (n + 1) - yPert n =
        (x 0 - x n) + τ • ((1 / L) • r 0) := by
  classical
  dsimp
  refine ⟨?_, ?_, ?_⟩
  · intro k hk
    have hk0 : k < n := by omega
    have hk1 : k + 1 < n := hk
    simp [hk0, hk1]
    module
  · intro k hk hk_last
    have hklt : k < n := Finset.mem_range.mp hk
    have hk1_not_lt : ¬ k + 1 < n := by omega
    have hk1_eq : k + 1 = n := hk_last
    simp [hklt, hk1_not_lt, hk1_eq]
    module
  · have hn1_not_lt : ¬ n + 1 < n := by omega
    have hn1_ne_n : n + 1 ≠ n := by omega
    have hn_not_lt : ¬ n < n := by omega
    have h0lt : 0 < n := hn_pos
    simp [hn1_not_lt, hn1_ne_n, hn_not_lt, h0lt]
    module

/-- Feasibility of the reflected inverse-gradient point on a sufficiently fine
uniform mesh.

This is the open-tube object that the source-faithful reflected-cycle proof
must use: for an adjacent mesh edge `x_k -> x_{k+1}`, Lipschitzness gives
`‖L⁻¹(B x_{k+1} - B x_k)‖ ≤ ‖x_{k+1} - x_k‖`, so the reflected point
`x_{k+1} - L⁻¹(B x_{k+1} - B x_k)` stays inside the tube around the segment. -/
private theorem reflected_uniform_mesh_inverse_point_mem_of_tube
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) (U : Set H) (L ρ : ℝ)
    (hL_pos : 0 < L)
    (z u : H)
    (hseg_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      AffineMap.lineMap z u t ∈ U)
    (htube : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      Metric.ball (AffineMap.lineMap z u t) ρ ⊆ U)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n)
    (hmesh : ‖((1 / (n : ℝ)) • (u - z))‖ < ρ)
    (k : ℕ) (hk : k < n) :
    AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
        (1 / L) •
          (B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
            B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))) ∈ U := by
  classical
  let tk : ℝ := (k : ℝ) / (n : ℝ)
  let tk1 : ℝ := ((k + 1 : ℕ) : ℝ) / (n : ℝ)
  let xk : H := AffineMap.lineMap z u tk
  let xk1 : H := AffineMap.lineMap z u tk1
  obtain ⟨htk, htk1, hstep, hstep_mesh⟩ :=
    uniform_partition_adjacent_mesh_lt (u - z) hn_pos hmesh k hk
  have hxk : xk ∈ U := by
    exact hseg_mem tk htk
  have hxk1 : xk1 ∈ U := by
    exact hseg_mem tk1 htk1
  have hsub : xk1 - xk = (tk1 - tk) • (u - z) := by
    simpa [xk, xk1, tk, tk1] using lineMap_sub_eq_smul_endpoint_diff z u tk tk1
  have hstep_norm : ‖xk1 - xk‖ < ρ := by
    simpa [hsub, tk, tk1] using hstep_mesh
  have hBstep : ‖B xk1 - B xk‖ ≤ L * ‖xk1 - xk‖ :=
    hBLip xk1 hxk1 xk hxk
  have hscale_nonneg : 0 ≤ 1 / L := by positivity
  have hscaled :
      ‖(1 / L) • (B xk1 - B xk)‖ < ρ := by
    calc
      ‖(1 / L) • (B xk1 - B xk)‖ =
          (1 / L) * ‖B xk1 - B xk‖ := by
            rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hscale_nonneg]
      _ ≤ (1 / L) * (L * ‖xk1 - xk‖) :=
            mul_le_mul_of_nonneg_left hBstep hscale_nonneg
      _ = ‖xk1 - xk‖ := by
            field_simp [ne_of_gt hL_pos]
      _ < ρ := hstep_norm
  have hball :
      xk1 - (1 / L) • (B xk1 - B xk) ∈ Metric.ball xk1 ρ := by
    rw [Metric.mem_ball, dist_comm, dist_eq_norm]
    have hdiff :
        xk1 - (xk1 - (1 / L) • (B xk1 - B xk)) =
          (1 / L) • (B xk1 - B xk) := by
      abel
    simpa [hdiff] using hscaled
  change xk1 - (1 / L) • (B xk1 - B xk) ∈ U
  exact (htube tk1 htk1) hball

/-- Scaled reflected mesh perturbations remain feasible when their scaled
displacement fits in the open tube around the segment.

This is the local feasibility piece needed by the reflected cyclic
perturbation proof: the full inverse-gradient reflected point may be outside an
open chart for a coarse mesh, but sufficiently small scalar perturbations from a
segment vertex stay inside the tube supplied by openness. -/
private theorem scaled_reflected_uniform_mesh_point_mem_of_tube
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) (U : Set H) (L ρ τ : ℝ)
    (z u : H)
    (hseg_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      AffineMap.lineMap z u t ∈ U)
    (htube : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      Metric.ball (AffineMap.lineMap z u t) ρ ⊆ U)
    {n : ℕ} (hn_pos : 0 < n)
    (k : ℕ) (hk : k < n)
    (hscaled :
      ‖τ •
        ((1 / L) •
          ((L / (n : ℝ)) • (u - z) -
            (B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
              B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))))))‖ < ρ) :
    AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)) +
        τ •
          ((1 / L) •
            ((L / (n : ℝ)) • (u - z) -
              (B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
                B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))))) ∈ U := by
  classical
  let tk : ℝ := (k : ℝ) / (n : ℝ)
  let xk : H := AffineMap.lineMap z u tk
  let step : H :=
    τ •
      ((1 / L) •
        ((L / (n : ℝ)) • (u - z) -
          (B (AffineMap.lineMap z u ((((k + 1 : ℕ) : ℝ) / (n : ℝ)))) -
            B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ))))))
  have hmesh_small : ‖((1 / (n : ℝ)) • (u - z))‖ < (‖u - z‖ + 1) := by
    have hnorm_nonneg : 0 ≤ ‖u - z‖ := norm_nonneg _
    have hone_pos : (0 : ℝ) < 1 := by norm_num
    have hsum_pos : 0 < ‖u - z‖ + 1 := by linarith
    have hscale_nonneg : 0 ≤ (1 / (n : ℝ)) := by positivity
    have hscale_le_one : (1 / (n : ℝ)) ≤ 1 := by
      have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
      have hnR_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_pos
      rw [div_le_iff₀ hnR_pos]
      simpa using hnR_one
    calc
      ‖((1 / (n : ℝ)) • (u - z))‖ =
          (1 / (n : ℝ)) * ‖u - z‖ := by
            rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hscale_nonneg]
      _ ≤ 1 * ‖u - z‖ :=
            mul_le_mul_of_nonneg_right hscale_le_one hnorm_nonneg
      _ < ‖u - z‖ + 1 := by linarith
  obtain ⟨htk, _htk1, _hstep, _hmesh⟩ :=
    uniform_partition_adjacent_mesh_lt (u - z) hn_pos hmesh_small k hk
  have hball : xk + step ∈ Metric.ball xk ρ := by
    rw [Metric.mem_ball, dist_eq_norm]
    have hdiff : xk + step - xk = step := by abel
    simpa [xk, step, tk, hdiff] using hscaled
  change xk + step ∈ U
  exact (htube tk htk) hball

/-- Cancel a positive perturbation scale after absorbing a strict epsilon loss.

This is the pure order-theoretic last step of the reflected-cycle perturbation
argument for Lan Lemma 5.8: once cyclic monotonicity gives a scaled lower bound
with an error budget strictly below `ε`, positivity of the perturbation scale
removes the scale and converts the budget into `-ε ≤ S`. No SOptLib match:
searched `positive multiply cancel epsilon loss` and `mul_le_mul_left positive
order cancel`; hits were generic multiplication cancellation (`mul_le_mul_left`)
or unrelated epsilon-removal wrappers, not this exact scaled-error bridge. -/
private theorem positive_perturb_scale_cancel_with_epsilon_loss
    {τ ε S R : ℝ} (hτ_pos : 0 < τ) (hR_lt : R < ε)
    (hscaled : -(τ * R) ≤ τ * S) :
    -ε ≤ S := by
  have hτ_ne : τ ≠ 0 := ne_of_gt hτ_pos
  have hdiv : -(τ * R) / τ ≤ (τ * S) / τ :=
    div_le_div_of_nonneg_right hscaled (le_of_lt hτ_pos)
  have hbudget : -R ≤ S := by
    have hleft : -(τ * R) / τ = -R := by field_simp [hτ_ne]
    have hright : (τ * S) / τ = S := by field_simp [hτ_ne]
    simpa [hleft, hright] using hdiv
  have hstrict : -ε < -R := neg_lt_neg hR_lt
  exact le_trans (le_of_lt hstrict) hbudget

/-- Monotone transfer from a smaller error budget to the reflected-cycle `R`.

This is the pure real-order bridge used in Lan Lemma 5.8's perturbation
