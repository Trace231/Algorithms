    -- below cancels the positive perturbation scale and absorbs the strict
    -- epsilon budget.
    have hscaled_reflected_cycle : -(perturbScale * R) ≤ perturbScale * S := by
      have hB_yPert_close_scaled_sum_le :
          Finset.sum (Finset.range n)
              (fun k => ‖(1 / L) • (B (yPert k) - g k)‖) ≤
            perturbScale *
              Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) := by
        have hscale_nonneg : 0 ≤ 1 / L := by positivity
        have hsum_scale :
            Finset.sum (Finset.range n)
                (fun k => ‖(1 / L) • (B (yPert k) - g k)‖) =
              (1 / L) *
                Finset.sum (Finset.range n)
                  (fun k => ‖B (yPert k) - g k‖) := by
          calc
            Finset.sum (Finset.range n)
                (fun k => ‖(1 / L) • (B (yPert k) - g k)‖)
