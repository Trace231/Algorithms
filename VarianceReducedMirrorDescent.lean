split or consume the freezing error but do not prove this Lipschitz sum bound. -/
private theorem scaled_lipschitz_error_sum_bound_for_reflected_cycle
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) (U : Set H) (L τ : ℝ)
    (hL_pos : 0 < L) (hτ_nonneg : 0 ≤ τ)
    {n : ℕ} (x g r y : ℕ → H)
    (hg : ∀ k, g k = B (x k))
    (hy_eq : ∀ k ∈ Finset.range n, y k = x k + τ • ((1 / L) • r k))
    (hx_mem : ∀ k ∈ Finset.range n, x k ∈ U)
    (hy_mem : ∀ k ∈ Finset.range n, y k ∈ U)
    (hBLip : ∀ a ∈ U, ∀ b ∈ U, ‖B a - B b‖ ≤ L * ‖a - b‖) :
