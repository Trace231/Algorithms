  have htwoL_nonneg : 0 ≤ 2 * L := by nlinarith
  have hscaled :
      2 * L * (Φ (x n) - Φ (x 0)) ≤
        2 * L *
          ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                    x n - x 0⟫_ℝ) +
            L * ‖x n - x 0‖ ^ 2 / (2 * (n : ℝ))) :=
    mul_le_mul_of_nonneg_left hforward htwoL_nonneg
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have hendpoint :
      ‖B (x n)‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k =>
                  ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                    x n - x 0⟫_ℝ)) +
          L ^ 2 * ‖x n - x 0‖ ^ 2 / (n : ℝ) := by
    calc
      ‖B (x n)‖ ^ 2 ≤ 2 * L * (Φ (x n) - Φ (x 0)) := hBH
      _ ≤
          2 * L *
            ((1 / (n : ℝ)) *
                Finset.sum (Finset.range n)
                  (fun k =>
                    ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
                      x n - x 0⟫_ℝ) +
              L * ‖x n - x 0‖ ^ 2 / (2 * (n : ℝ))) := hscaled
