      setup.P[fun ω =>
        setup.VOn
          ⟨setup.paperInnerIterAt s t ω, setup.paperInnerIterAt_mem s t ω⟩ xStar +
          setup.η * ⟪setup.deltaProcessAt s t ω,
            xStar.1 - setup.paperInnerIterAt s t ω⟫_ℝ +
          setup.η ^ 2 * SOptLib.dualNorm (setup.deltaProcessAt s t ω) ^ 2 |
