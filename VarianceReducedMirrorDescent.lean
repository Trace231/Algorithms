/-- Definitional form of the two-sign error average with the active
perturbation scale.  This is the typed normalization point used by the voucher
so the actual scale remains visible in the consuming theorem. -/
private theorem _voucher_step_3d_error_average_normalization
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) (L τ : ℝ) (n : ℕ) (x g r : ℕ → H) :
    let Eavg : ℝ :=
      (Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
        Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖)) /
        2
    Eavg =
      (Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
        Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) - g k)‖)) /
        2 := by
  rfl

/-- Expand the positive and negative reflected residual works into the explicit
finite residual-pair expression.  This is the typed replacement for the former
informal "expand both reflected cycles" voucher step. -/
private theorem _voucher_step_3d_reflected_cycle_residual_pair_expansion
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (L τ : ℝ) (x r : ℕ → H) :
    let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
    let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
    let residualWork_pos : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ)
    let residualWork_neg : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ)
    residualWork_pos + residualWork_neg =
      2 * τ ^ 2 * (1 / L) *
        (Finset.sum (Finset.range (n - 1))
            (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
          ‖r (n - 1)‖ ^ 2) := by
  classical
  let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
  let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
  have hn_sub_succ : n - 1 + 1 = n := Nat.sub_add_cancel hn_pos
  have hpos_split :
      Finset.sum (Finset.range n)
          (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ) =
        Finset.sum (Finset.range (n - 1))
            (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ) +
          ⟪τ • r (n - 1), yPos n - yPos (n - 1)⟫_ℝ := by
    conv_lhs => rw [← hn_sub_succ, Finset.sum_range_succ]
    simp [hn_sub_succ]
  have hneg_split :
      Finset.sum (Finset.range n)
          (fun k => ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ) =
        Finset.sum (Finset.range (n - 1))
            (fun k => ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ) +
          ⟪τ • (-r (n - 1)), yNeg n - yNeg (n - 1)⟫_ℝ := by
    conv_lhs => rw [← hn_sub_succ, Finset.sum_range_succ]
    simp [hn_sub_succ]
  have hbody_sum :
      Finset.sum (Finset.range (n - 1))
          (fun k =>
            ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ +
              ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ) =
        Finset.sum (Finset.range (n - 1))
          (fun k => 2 * τ ^ 2 * (1 / L) * ⟪r k, r (k + 1) - r k⟫_ℝ) := by
    refine Finset.sum_congr rfl ?_
    intro k hk
    have hklt' : k < n - 1 := Finset.mem_range.mp hk
    have hklt : k + 1 < n := by omega
    have hk0 : k < n := by omega
    have hk1 : k + 1 < n := hklt
    simp [yPos, yNeg, reflectedPerturbedCycle, hk0, hk1, sub_eq_add_neg,
      add_comm, add_left_comm, add_assoc, inner_add_right, inner_neg_right,
      inner_smul_left, inner_smul_right]
    ring
  have hlast :
      ⟪τ • r (n - 1), yPos n - yPos (n - 1)⟫_ℝ +
          ⟪τ • (-r (n - 1)), yNeg n - yNeg (n - 1)⟫_ℝ =
        -(2 * τ ^ 2 * (1 / L) * ‖r (n - 1)‖ ^ 2) := by
    have hn_last_lt : n - 1 < n := Nat.sub_one_lt (Nat.ne_of_gt hn_pos)
    have hn_not_lt : ¬ n < n := by omega
    have hn_eq : n = n := rfl
    simp [yPos, yNeg, reflectedPerturbedCycle, hn_last_lt, hn_not_lt, hn_eq,
      sub_eq_add_neg, add_comm, add_left_comm, add_assoc, inner_add_right,
      inner_neg_right, inner_smul_left, inner_smul_right, real_inner_self_eq_norm_sq]
    ring
  calc
    (Finset.sum (Finset.range n)
          (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ) +
        Finset.sum (Finset.range n)
          (fun k => ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ))
        =
      (Finset.sum (Finset.range (n - 1))
            (fun k => ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ) +
          Finset.sum (Finset.range (n - 1))
            (fun k => ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ)) +
        (⟪τ • r (n - 1), yPos n - yPos (n - 1)⟫_ℝ +
          ⟪τ • (-r (n - 1)), yNeg n - yNeg (n - 1)⟫_ℝ) := by
          rw [hpos_split, hneg_split]
          ring
    _ =
      Finset.sum (Finset.range (n - 1))
          (fun k =>
            ⟪τ • r k, yPos (k + 1) - yPos k⟫_ℝ +
              ⟪τ • (-r k), yNeg (k + 1) - yNeg k⟫_ℝ) +
        (⟪τ • r (n - 1), yPos n - yPos (n - 1)⟫_ℝ +
          ⟪τ • (-r (n - 1)), yNeg n - yNeg (n - 1)⟫_ℝ) := by
          rw [Finset.sum_add_distrib]
    _ =
      Finset.sum (Finset.range (n - 1))
          (fun k => 2 * τ ^ 2 * (1 / L) * ⟪r k, r (k + 1) - r k⟫_ℝ) -
        2 * τ ^ 2 * (1 / L) * ‖r (n - 1)‖ ^ 2 := by
          rw [hbody_sum, hlast]
          ring
    _ =
      2 * τ ^ 2 * (1 / L) *
        (Finset.sum (Finset.range (n - 1))
            (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
          ‖r (n - 1)‖ ^ 2) := by
          rw [← Finset.mul_sum]
          ring

/-- The residual chain term left by the two reflected signs is nonpositive.

This is the finite Hilbert telescope behind the residual-pair normalization in
Lan Lemma 5.8: the adjacent residual work minus the final residual energy is
the negative of endpoint and jump-square energies. Search audit: checked local
residual-pair helpers and Mathlib's `Finset.sum_range_sub'`; no existing
SOptLib/target helper packages this exact `range (n - 1)` residual-chain
nonpositivity. -/
private theorem residual_chain_inner_sub_last_norm_nonpos
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (r : ℕ → H) :
    Finset.sum (Finset.range (n - 1))
        (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
      ‖r (n - 1)‖ ^ 2 ≤ 0 := by
  classical
  let m : ℕ := n - 1
  let q : ℕ → ℝ := fun k => ‖r k‖ ^ 2
  let D : ℝ :=
    Finset.sum (Finset.range m)
      (fun k => ‖r (k + 1) - r k‖ ^ 2)
  have hpoint :
      ∀ k ∈ Finset.range m,
        2 * ⟪r k, r (k + 1) - r k⟫_ℝ =
          q (k + 1) - q k - ‖r (k + 1) - r k‖ ^ 2 := by
    intro k hk
    let δ : H := r (k + 1) - r k
    have hdecomp : r (k + 1) = r k + δ := by
      dsimp [δ]
      abel
    dsimp [q, δ]
    rw [hdecomp]
    have hsub : r k + (r (k + 1) - r k) - r k = r (k + 1) - r k := by
      abel
    rw [hsub]
    rw [← real_inner_self_eq_norm_sq (r k + (r (k + 1) - r k))]
    rw [← real_inner_self_eq_norm_sq (r k)]
    rw [← real_inner_self_eq_norm_sq (r (k + 1) - r k)]
    simp only [inner_add_left, inner_add_right]
    rw [real_inner_comm (r (k + 1) - r k) (r k)]
    ring
  have hsum_point :
      2 * Finset.sum (Finset.range m)
          (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) =
        Finset.sum (Finset.range m) (fun k => q (k + 1) - q k) - D := by
    calc
      2 * Finset.sum (Finset.range m)
          (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ)
          =
        Finset.sum (Finset.range m)
          (fun k => 2 * ⟪r k, r (k + 1) - r k⟫_ℝ) := by
            rw [Finset.mul_sum]
      _ =
        Finset.sum (Finset.range m)
          (fun k => q (k + 1) - q k - ‖r (k + 1) - r k‖ ^ 2) := by
            apply Finset.sum_congr rfl
            intro k hk
            exact hpoint k hk
      _ =
        Finset.sum (Finset.range m) (fun k => q (k + 1) - q k) - D := by
            dsimp [D]
            rw [← Finset.sum_sub_distrib]
  have htel :
      Finset.sum (Finset.range m) (fun k => q (k + 1) - q k) =
        q m - q 0 := by
    have hneg :
        Finset.sum (Finset.range m) (fun k => q (k + 1) - q k) =
          -Finset.sum (Finset.range m) (fun k => q k - q (k + 1)) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    rw [hneg]
    simpa using congrArg Neg.neg (Finset.sum_range_sub' q m)
  have htwice :
      2 *
          (Finset.sum (Finset.range (n - 1))
              (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
            ‖r (n - 1)‖ ^ 2) =
        -(‖r 0‖ ^ 2 + ‖r (n - 1)‖ ^ 2 + D) := by
    dsimp [m, q] at hsum_point htel
    calc
      2 *
          (Finset.sum (Finset.range (n - 1))
              (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
            ‖r (n - 1)‖ ^ 2)
          =
        2 * Finset.sum (Finset.range (n - 1))
            (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
          2 * ‖r (n - 1)‖ ^ 2 := by
            ring
      _ =
        (Finset.sum (Finset.range (n - 1))
            (fun k => ‖r (k + 1)‖ ^ 2 - ‖r k‖ ^ 2) - D) -
          2 * ‖r (n - 1)‖ ^ 2 := by
            rw [hsum_point]
      _ = -(‖r 0‖ ^ 2 + ‖r (n - 1)‖ ^ 2 + D) := by
            rw [htel]
            ring
  have hD_nonneg : 0 ≤ D := by
    dsimp [D]
    exact Finset.sum_nonneg (by
      intro k hk
      exact sq_nonneg _)
  have hsum_nonneg : 0 ≤ ‖r 0‖ ^ 2 + ‖r (n - 1)‖ ^ 2 + D :=
    add_nonneg (add_nonneg (sq_nonneg _) (sq_nonneg _)) hD_nonneg
  have hright_nonpos : -(‖r 0‖ ^ 2 + ‖r (n - 1)‖ ^ 2 + D) ≤ 0 := by
    exact neg_nonpos.mpr hsum_nonneg
  have hmul_nonpos :
      2 *
          (Finset.sum (Finset.range (n - 1))
              (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
            ‖r (n - 1)‖ ^ 2) ≤ 0 := by
    simpa [htwice] using hright_nonpos
  have hdiv :=
    div_nonpos_of_nonpos_of_nonneg hmul_nonpos (by norm_num : 0 ≤ (2 : ℝ))
  have htwo_ne : (2 : ℝ) ≠ 0 := by norm_num
  simpa [htwo_ne] using hdiv

/-- Exact telescoping form of the residual chain left by the two reflected
signs. -/
private theorem residual_chain_inner_sub_last_norm_exact
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (_hn_pos : 0 < n) (r : ℕ → H) :
    2 *
        (Finset.sum (Finset.range (n - 1))
            (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
          ‖r (n - 1)‖ ^ 2) =
      -(‖r 0‖ ^ 2 + ‖r (n - 1)‖ ^ 2 +
        Finset.sum (Finset.range (n - 1))
          (fun k => ‖r (k + 1) - r k‖ ^ 2)) := by
  classical
  let m : ℕ := n - 1
  let q : ℕ → ℝ := fun k => ‖r k‖ ^ 2
  let D : ℝ :=
    Finset.sum (Finset.range m)
      (fun k => ‖r (k + 1) - r k‖ ^ 2)
  have hpoint :
      ∀ k ∈ Finset.range m,
        2 * ⟪r k, r (k + 1) - r k⟫_ℝ =
          q (k + 1) - q k - ‖r (k + 1) - r k‖ ^ 2 := by
    intro k hk
    let δ : H := r (k + 1) - r k
    have hdecomp : r (k + 1) = r k + δ := by
      dsimp [δ]
      abel
    dsimp [q, δ]
    rw [hdecomp]
    have hsub : r k + (r (k + 1) - r k) - r k = r (k + 1) - r k := by
      abel
    rw [hsub]
    rw [← real_inner_self_eq_norm_sq (r k + (r (k + 1) - r k))]
    rw [← real_inner_self_eq_norm_sq (r k)]
    rw [← real_inner_self_eq_norm_sq (r (k + 1) - r k)]
    simp only [inner_add_left, inner_add_right]
    rw [real_inner_comm (r (k + 1) - r k) (r k)]
    ring
  have hsum_point :
      2 * Finset.sum (Finset.range m)
          (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) =
        Finset.sum (Finset.range m) (fun k => q (k + 1) - q k) - D := by
    calc
      2 * Finset.sum (Finset.range m)
          (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ)
          =
        Finset.sum (Finset.range m)
          (fun k => 2 * ⟪r k, r (k + 1) - r k⟫_ℝ) := by
            rw [Finset.mul_sum]
      _ =
        Finset.sum (Finset.range m)
          (fun k => q (k + 1) - q k - ‖r (k + 1) - r k‖ ^ 2) := by
            apply Finset.sum_congr rfl
            intro k hk
            exact hpoint k hk
      _ =
        Finset.sum (Finset.range m) (fun k => q (k + 1) - q k) - D := by
            dsimp [D]
            rw [← Finset.sum_sub_distrib]
  have htel :
      Finset.sum (Finset.range m) (fun k => q (k + 1) - q k) =
        q m - q 0 := by
    have hneg :
        Finset.sum (Finset.range m) (fun k => q (k + 1) - q k) =
          -Finset.sum (Finset.range m) (fun k => q k - q (k + 1)) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    rw [hneg]
    simpa using congrArg Neg.neg (Finset.sum_range_sub' q m)
  dsimp [m, q] at hsum_point htel
  calc
    2 *
        (Finset.sum (Finset.range (n - 1))
            (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
          ‖r (n - 1)‖ ^ 2)
        =
      2 * Finset.sum (Finset.range (n - 1))
          (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
        2 * ‖r (n - 1)‖ ^ 2 := by
          ring
    _ =
      (Finset.sum (Finset.range (n - 1))
          (fun k => ‖r (k + 1)‖ ^ 2 - ‖r k‖ ^ 2) - D) -
        2 * ‖r (n - 1)‖ ^ 2 := by
          rw [hsum_point]
    _ = -(‖r 0‖ ^ 2 + ‖r (n - 1)‖ ^ 2 + D) := by
          rw [htel]
          ring

/-- Scalar wrapper for using the exact residual-chain identity in normalized
tails. -/
private theorem residual_chain_normalized_tail_exact
    {τ L C S : ℝ} (hchain : 2 * C = -S) :
    τ ^ 2 * (1 / L) * C =
      -(τ ^ 2 * (1 / (2 * L)) * S) := by
  have hC : C = -(1 / 2 : ℝ) * S := by
    nlinarith
  rw [hC]
  ring

/-- Final real ordered-ring conversion used by the mesh rewrite leaf.

After the reflected-cycle expansion and the `hr`/`hstep`/`hclose`/`hg0`
substitutions, the finite Hilbert algebra leaves the nonnegative scalar
`τ * S + τ * Eavg`.  This lemma is deliberately tiny and proved now, so the
remaining mesh voucher ends at a typed order leaf rather than at prose. -/
private theorem _voucher_step_3d_final_ordered_ring_from_nonnegative_sum
    {τ Eavg S : ℝ} (h : 0 ≤ τ * S + τ * Eavg) :
    -(τ * Eavg) ≤ τ * S := by
  linarith

/-- Pure ordered-ring closure from a nonnegative mesh energy dominated by the
first-variation work plus averaged freezing error.

This is only the scalar tail of Lan Lemma 5.8's reflected-mesh route. Search
audit: checked the local endpoint/first-variation helpers
`endpoint_energy_bound_of_residual_first_variation` and
`residual_first_variation_of_endpoint_energy_bound`; those package Hilbert
mesh algebra, while this lemma is the final real-order normalization after the
source-derived bound `Q ≤ S + Eavg` is available. -/
private theorem scaled_first_variation_nonneg_from_Q_bound
    {τ Q S Eavg : ℝ} (hτ_nonneg : 0 ≤ τ)
    (hQ_nonneg : 0 ≤ Q) (hfirst : Q ≤ S + Eavg) :
    0 ≤ τ * S + τ * Eavg := by
  have hwork_error_nonneg : 0 ≤ S + Eavg := le_trans hQ_nonneg hfirst
  have hscaled : 0 ≤ τ * (S + Eavg) :=
    mul_nonneg hτ_nonneg hwork_error_nonneg
  simpa [mul_add] using hscaled

/-- Scalar slack form of the unscaled first-variation absorption.

This is the pure ordered-ring tail of Lan Lemma 5.8's mesh-energy step:
once the source/reflected two-sign argument has proved
`0 ≤ 2 * Rsum + Q + Eavg`, the slackened residual first-variation hypothesis
needed by `endpoint_energy_bound_of_residual_first_variation_with_slack` is
immediate. Search audit: checked the local endpoint/first-variation helpers
`endpoint_energy_bound_of_residual_first_variation_with_slack` and
`residual_first_variation_of_endpoint_energy_bound_with_slack`; those package
Hilbert telescope algebra, while this helper is only the scalar normalization
from the paper's first-variation absorption to the endpoint slack form. -/
private theorem endpoint_slack_from_first_variation_absorption
    {Rsum Q meshEnergy Eavg : ℝ}
    (hfirst_Q : 0 ≤ 2 * Rsum + Q + Eavg) :
    Q ≤ 2 * Rsum + meshEnergy + (2 * Q + Eavg - meshEnergy) := by
  linarith

/-- Cross-combination of the positive and negative named split inequalities.

This is the scalar bookkeeping step requested by the Phase 2b audit: it keeps
the four named split inequalities visible instead of hiding them behind an
untyped prose cancellation. -/
private theorem _voucher_step_3d_named_split_cross_combination
    {baseB predB errorWork_pos errorWork_neg baseTilt predTilt
      residualWork_pos residualWork_neg : ℝ}
    (hposB : (baseB + predB) + errorWork_pos ≤ 0)
    (hposT : (baseTilt + predTilt) + residualWork_pos - errorWork_pos ≤ 0)
    (hnegB : (baseB - predB) + errorWork_neg ≤ 0)
    (hnegT : (baseTilt - predTilt) + residualWork_neg - errorWork_neg ≤ 0) :
    ((baseB + baseTilt) + (predB - predTilt) + residualWork_neg +
        (errorWork_pos - errorWork_neg) ≤ 0) ∧
      ((baseB + baseTilt) - (predB - predTilt) + residualWork_pos +
        (errorWork_neg - errorWork_pos) ≤ 0) := by
  constructor <;> linarith

/-- Averaging the two crossed inequalities cancels the signed error terms.

The proof of the remaining source bridge still has to identify the surviving
`base/pred/residual` expression with the mesh scalar, but the signed-error
cancellation itself is now a typed real-order lemma. -/
private theorem _voucher_step_3d_crossed_signed_errors_cancel
    {main skew residualWork_pos residualWork_neg errorWork_pos errorWork_neg : ℝ}
    (hcross_neg :
      main + skew + residualWork_neg + (errorWork_pos - errorWork_neg) ≤ 0)
    (hcross_pos :
      main - skew + residualWork_pos + (errorWork_neg - errorWork_pos) ≤ 0) :
    2 * main + residualWork_pos + residualWork_neg ≤ 0 := by
  linarith

/-- Pointwise split of a positive interior reflected edge into drift and signed
oscillation contributions.

This is the atom needed to turn `heDiff_edge_split` into a signed freezing-error
absorption: each edge separates into the common mesh direction and the odd
reflected perturbation. Search audit: checked target-file reflected split
helpers and SOptLib/Mathlib inner-product algebra hits; none packages this
specific two-sign edge normalization. -/
private theorem reflected_error_edge_pair_split_pos
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (ep en a b : H) (τ : ℝ) :
    ⟪ep, a + τ • b⟫_ℝ - ⟪en, a - τ • b⟫_ℝ =
      (⟪ep, a⟫_ℝ - ⟪en, a⟫_ℝ) +
        τ * (⟪ep, b⟫_ℝ + ⟪en, b⟫_ℝ) := by
  simp [inner_add_right, inner_sub_right, inner_smul_right]
  ring

/-- Pointwise split of the closing reflected edge into drift and signed
oscillation contributions.

This is the last-edge companion to `reflected_error_edge_pair_split_pos`; the
opposite sign records the reflected cycle's closing edge. Search audit: same as
the interior-edge split above. -/
private theorem reflected_error_edge_pair_split_last
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (ep en a b : H) (τ : ℝ) :
    ⟪ep, a - τ • b⟫_ℝ - ⟪en, a + τ • b⟫_ℝ =
      (⟪ep, a⟫_ℝ - ⟪en, a⟫_ℝ) -
        τ * (⟪ep, b⟫_ℝ + ⟪en, b⟫_ℝ) := by
  simp [inner_add_right, inner_sub_right, inner_smul_right]
  ring

/-- Temporary compatibility boundary for the retired reflected Q-form route.

The public Lemma 5.8 route below is being cut over to the open-convex
Baillon-Haddad terminal. This private declaration keeps the old local
compatibility block type-checkable while that block is removed in smaller
pieces. It must not be used by the final `lemma_5_8` path. -/
axiom source_preserving_reflected_first_variation_bridge
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    {n : ℕ} (hn_pos : 0 < n) {τ : ℝ}
    (hτ_nonneg : 0 ≤ τ)
    (hτ_pos : 0 < τ)
    (d : H) (x g r yPos yNeg : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hyPert_mem_pos :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hyPert_mem_neg :
      ∀ k, k ≤ n + 1 →
        reflectedPerturbedCycle L τ n x (fun j => -r j) k ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    (hclose : x 0 - x n = -d)
    (hg0 : g 0 = 0)
    {baseStep predSkewNF residualPosNF residualNegNF driftError
      oscillationError eDiff Rsum Q Eavg errorWork_pos errorWork_neg : ℝ}
    (hbaseStep_def :
      baseStep =
        Finset.sum (Finset.range n)
            (fun k => ⟪L • x k, (1 / (n : ℝ)) • d⟫_ℝ) +
          ⟪L • x n, -d⟫_ℝ)
    (hpredSkewNF_def :
      predSkewNF =
        τ * ((1 / L) *
          ((⟪g n - g 0, r 0⟫_ℝ -
            ⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ) +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ -
                  ⟪-r k, r (k + 1)⟫_ℝ))))
    (hresidualPosNF_def :
      residualPosNF =
        τ * ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ)) +
          τ ^ 2 * (1 / L) *
            (Finset.sum (Finset.range (n - 1))
                (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
              ‖r (n - 1)‖ ^ 2))
    (hresidualNegNF_def :
      residualNegNF =
        -(τ * ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ))) +
          τ ^ 2 * (1 / L) *
            (Finset.sum (Finset.range (n - 1))
                (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
              ‖r (n - 1)‖ ^ 2))
    (hdriftError_def :
      driftError =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k, (1 / (n : ℝ)) • d⟫_ℝ -
                ⟪B (yNeg k) - g k, (1 / (n : ℝ)) • d⟫_ℝ) +
          (⟪B (yPos (n - 1)) - g (n - 1), (1 / (n : ℝ)) • d⟫_ℝ -
            ⟪B (yNeg (n - 1)) - g (n - 1), (1 / (n : ℝ)) • d⟫_ℝ))
    (hoscillationError_def :
      oscillationError =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k, (1 / L) • (r (k + 1) - r k)⟫_ℝ +
                ⟪B (yNeg k) - g k, (1 / L) • (r (k + 1) - r k)⟫_ℝ) -
          (⟪B (yPos (n - 1)) - g (n - 1),
              (1 / L) • r (n - 1)⟫_ℝ +
            ⟪B (yNeg (n - 1)) - g (n - 1),
              (1 / L) • r (n - 1)⟫_ℝ))
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n) (fun k => ‖g (k + 1) - g k‖ ^ 2))
    (hEavg_def :
      Eavg =
        (Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                  g k)‖)) /
          2)
    (hcross_neg_split :
      baseStep + predSkewNF + residualNegNF +
          (driftError + τ * oscillationError) ≤ 0)
    (hcross_pos_split :
      baseStep - predSkewNF + residualPosNF -
          (driftError + τ * oscillationError) ≤ 0)
    (hresidual_sum_nonpos : residualPosNF + residualNegNF ≤ 0)
    (heDiff_drift_oscillation_sum_split :
      eDiff = driftError + τ * oscillationError)
    (herrorWork_pos_edge :
      errorWork_pos =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k,
                (1 / (n : ℝ)) • d +
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yPos (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d -
              τ • ((1 / L) • r (n - 1))⟫_ℝ)
    (herrorWork_neg_edge :
      errorWork_neg =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yNeg k) - g k,
                (1 / (n : ℝ)) • d -
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yNeg (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d +
              τ • ((1 / L) • r (n - 1))⟫_ℝ)
    (hEavg_budget_from_source :
      Eavg ≤
        τ * Finset.sum (Finset.range n)
          (fun k => ‖(1 / L) • r k‖)) :
    -(2 * Rsum + Q) ≤ Eavg

/-- Canonical reflected-cycle context for the exact two-sign error terms.

This is the T1 linkage for Lan Lemma 5.8's reflected mesh route: the same
canonical positive/negative vertices occur in the signed edge work and in the
averaged freezing-error norm. Search audit: checked the local candidates
`reflected_two_sign_error_average_nonneg`,
`_voucher_step_3d_reflected_cycle_residual_pair_expansion`, and downstream
`source_preserving_reflected_first_variation_bridge`; they provide pieces or
later wrappers, but no upstream helper packages the canonical edge expansions
and the `hEavg_def` normalization together. -/
private theorem canonical_reflected_error_context
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (L τ : ℝ) (d : H)
    (B : H → H) (x g r : ℕ → H)
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d)
    {Eavg : ℝ}
    (hEavg_def :
      Eavg =
        (Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖(1 / L) •
                (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                  g k)‖)) /
          2) :
    let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
    let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
    let errorWork_pos : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yPos k) - g k, yPos (k + 1) - yPos k⟫_ℝ)
    let errorWork_neg : ℝ :=
      Finset.sum (Finset.range n)
        (fun k => ⟪B (yNeg k) - g k, yNeg (k + 1) - yNeg k⟫_ℝ)
    errorWork_pos =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k,
                (1 / (n : ℝ)) • d +
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yPos (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d -
              τ • ((1 / L) • r (n - 1))⟫_ℝ ∧
      errorWork_neg =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yNeg k) - g k,
                (1 / (n : ℝ)) • d -
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yNeg (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d +
              τ • ((1 / L) • r (n - 1))⟫_ℝ ∧
      0 ≤ Eavg := by
  classical
  let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
  let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
  let errorWork_pos : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪B (yPos k) - g k, yPos (k + 1) - yPos k⟫_ℝ)
  let errorWork_neg : ℝ :=
    Finset.sum (Finset.range n)
      (fun k => ⟪B (yNeg k) - g k, yNeg (k + 1) - yNeg k⟫_ℝ)
  change
    errorWork_pos =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k,
                (1 / (n : ℝ)) • d +
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yPos (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d -
              τ • ((1 / L) • r (n - 1))⟫_ℝ ∧
      errorWork_neg =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yNeg k) - g k,
                (1 / (n : ℝ)) • d -
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yNeg (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d +
              τ • ((1 / L) • r (n - 1))⟫_ℝ ∧
      0 ≤ Eavg
  have hy_eq_range_pos :
      ∀ k ∈ Finset.range n, yPos k = x k + τ • ((1 / L) • r k) := by
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    simp [yPos, reflectedPerturbedCycle, hklt]
  have hy_eq_range_neg :
      ∀ k ∈ Finset.range n, yNeg k = x k + τ • ((1 / L) • (-r k)) := by
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    simp [yNeg, reflectedPerturbedCycle, hklt]
  have hpos_edge :
      errorWork_pos =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yPos k) - g k,
                (1 / (n : ℝ)) • d +
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yPos (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d -
              τ • ((1 / L) • r (n - 1))⟫_ℝ := by
    have hn_sub_succ : n - 1 + 1 = n := Nat.sub_add_cancel hn_pos
    have hpos_edges :
        ∀ k ∈ Finset.range (n - 1),
          yPos (k + 1) - yPos k =
            (1 / (n : ℝ)) • d +
              τ • ((1 / L) • (r (k + 1) - r k)) := by
      intro k hk
      have hk_n : k ∈ Finset.range n := by
        have hklt : k < n - 1 := Finset.mem_range.mp hk
        exact Finset.mem_range.mpr (by omega)
      have hk1 : k + 1 < n := by
        have hklt : k < n - 1 := Finset.mem_range.mp hk
        omega
      have hk1_mem : k + 1 ∈ Finset.range n := Finset.mem_range.mpr hk1
      rw [hy_eq_range_pos (k + 1) hk1_mem, hy_eq_range_pos k hk_n,
        ← hstep k hk_n]
      module
    have hpos_last :
        yPos n - yPos (n - 1) =
          (1 / (n : ℝ)) • d -
            τ • ((1 / L) • r (n - 1)) := by
      have hlast_mem : n - 1 ∈ Finset.range n := by
        exact Finset.mem_range.mpr (Nat.sub_lt hn_pos Nat.zero_lt_one)
      have hyn : yPos n = x n := by
        simp [yPos, reflectedPerturbedCycle]
      rw [hyn, hy_eq_range_pos (n - 1) hlast_mem,
        ← hstep (n - 1) hlast_mem, hn_sub_succ]
      module
    calc
      errorWork_pos =
          Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪B (yPos k) - g k, yPos (k + 1) - yPos k⟫_ℝ) +
            ⟪B (yPos (n - 1)) - g (n - 1),
              yPos n - yPos (n - 1)⟫_ℝ := by
            dsimp [errorWork_pos]
            conv_lhs => rw [← hn_sub_succ, Finset.sum_range_succ]
            simp [hn_sub_succ]
      _ =
          Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪B (yPos k) - g k,
                  (1 / (n : ℝ)) • d +
                    τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
            ⟪B (yPos (n - 1)) - g (n - 1),
              (1 / (n : ℝ)) • d -
                τ • ((1 / L) • r (n - 1))⟫_ℝ := by
            congr 1
            · apply Finset.sum_congr rfl
              intro k hk
              rw [hpos_edges k hk]
            · rw [hpos_last]
  have hneg_edge :
      errorWork_neg =
        Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪B (yNeg k) - g k,
                (1 / (n : ℝ)) • d -
                  τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
          ⟪B (yNeg (n - 1)) - g (n - 1),
            (1 / (n : ℝ)) • d +
              τ • ((1 / L) • r (n - 1))⟫_ℝ := by
    have hn_sub_succ : n - 1 + 1 = n := Nat.sub_add_cancel hn_pos
    have hneg_edges :
        ∀ k ∈ Finset.range (n - 1),
          yNeg (k + 1) - yNeg k =
            (1 / (n : ℝ)) • d -
              τ • ((1 / L) • (r (k + 1) - r k)) := by
      intro k hk
      have hk_n : k ∈ Finset.range n := by
        have hklt : k < n - 1 := Finset.mem_range.mp hk
        exact Finset.mem_range.mpr (by omega)
      have hk1 : k + 1 < n := by
        have hklt : k < n - 1 := Finset.mem_range.mp hk
        omega
      have hk1_mem : k + 1 ∈ Finset.range n := Finset.mem_range.mpr hk1
      rw [hy_eq_range_neg (k + 1) hk1_mem, hy_eq_range_neg k hk_n,
        ← hstep k hk_n]
      module
    have hneg_last :
        yNeg n - yNeg (n - 1) =
          (1 / (n : ℝ)) • d +
            τ • ((1 / L) • r (n - 1)) := by
      have hlast_mem : n - 1 ∈ Finset.range n := by
        exact Finset.mem_range.mpr (Nat.sub_lt hn_pos Nat.zero_lt_one)
      have hyn : yNeg n = x n := by
        simp [yNeg, reflectedPerturbedCycle]
      rw [hyn, hy_eq_range_neg (n - 1) hlast_mem,
        ← hstep (n - 1) hlast_mem, hn_sub_succ]
      module
    calc
      errorWork_neg =
          Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪B (yNeg k) - g k, yNeg (k + 1) - yNeg k⟫_ℝ) +
            ⟪B (yNeg (n - 1)) - g (n - 1),
              yNeg n - yNeg (n - 1)⟫_ℝ := by
            dsimp [errorWork_neg]
            conv_lhs => rw [← hn_sub_succ, Finset.sum_range_succ]
            simp [hn_sub_succ]
      _ =
          Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪B (yNeg k) - g k,
                  (1 / (n : ℝ)) • d -
                    τ • ((1 / L) • (r (k + 1) - r k))⟫_ℝ) +
            ⟪B (yNeg (n - 1)) - g (n - 1),
              (1 / (n : ℝ)) • d +
                τ • ((1 / L) • r (n - 1))⟫_ℝ := by
            congr 1
            · apply Finset.sum_congr rfl
              intro k hk
              rw [hneg_edges k hk]
            · rw [hneg_last]
  have hEavg_nonneg : 0 ≤ Eavg := by
    rw [hEavg_def]
    exact reflected_two_sign_error_average_nonneg
      (B := B) (x := x) (g := g) (r := r) (n := n) (L := L) (τ := τ)
  exact ⟨hpos_edge, hneg_edge, hEavg_nonneg⟩

/-- Two one-sided freezing-error estimates bound their arithmetic average. -/
private theorem _voucher_step_3d_two_sided_error_average_bound
    {Epos Eneg R : ℝ} (hpos : Epos ≤ R) (hneg : Eneg ≤ R) :
    (Epos + Eneg) / 2 ≤ R := by
  linarith

/-- Canonical reflected-cycle Lipschitz control for the actual averaged error.

This is the source-facing `Eavg` budget used in Lan Lemma 5.8's reflected
route: both error sums are evaluated at
`reflectedPerturbedCycle L τ n x r` and
`reflectedPerturbedCycle L τ n x (fun j => -r j)`.  Search audit: considered
the pre-searched `scaled_lipschitz_error_sum_bound_for_reflected_cycle`,
`scaled_lipschitz_error_sum_bound_for_neg_reflected_cycle`,
`two_sign_error_average_le_lipschitz_budget`, and the local
`_voucher_step_3d_two_sided_error_average_bound`; the first two prove the
one-sided canonical bounds, while this helper packages exactly their averaged
`hEavg_def`-shaped consequence. -/
private theorem canonical_reflected_error_average_le_lipschitz_budget
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : H → H) (U : Set H) (L τ : ℝ)
    (hL_pos : 0 < L) (hτ_nonneg : 0 ≤ τ)
    {n : ℕ} (x g r : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hyPert_mem_pos :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hyPert_mem_neg :
      ∀ k, k ≤ n + 1 →
        reflectedPerturbedCycle L τ n x (fun j => -r j) k ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖) :
    (Finset.sum (Finset.range n)
        (fun k =>
          ‖(1 / L) •
            (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) +
      Finset.sum (Finset.range n)
        (fun k =>
          ‖(1 / L) •
            (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
              g k)‖)) /
      2 ≤
      τ * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) := by
  classical
  let yPos : ℕ → H := reflectedPerturbedCycle L τ n x r
  let yNeg : ℕ → H := reflectedPerturbedCycle L τ n x (fun j => -r j)
  have hy_eq_range_pos :
      ∀ k ∈ Finset.range n, yPos k = x k + τ • ((1 / L) • r k) := by
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    simp [yPos, reflectedPerturbedCycle, hklt]
  have hy_eq_range_neg :
      ∀ k ∈ Finset.range n, yNeg k = x k + τ • ((1 / L) • (-r k)) := by
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    simp [yNeg, reflectedPerturbedCycle, hklt]
  have hy_mem_range_pos : ∀ k ∈ Finset.range n, yPos k ∈ U := by
    intro k hk
    exact hyPert_mem_pos k (by
      have hklt : k < n := Finset.mem_range.mp hk
      omega)
  have hy_mem_range_neg : ∀ k ∈ Finset.range n, yNeg k ∈ U := by
    intro k hk
    exact hyPert_mem_neg k (by
      have hklt : k < n := Finset.mem_range.mp hk
      omega)
  have herror_pos :
      Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x r k) - g k)‖) ≤
        τ * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) := by
    exact
      scaled_lipschitz_error_sum_bound_for_reflected_cycle
        B U L τ hL_pos hτ_nonneg x g r yPos hg
        hy_eq_range_pos hx_mem_range hy_mem_range_pos hBLip
  have herror_neg :
      Finset.sum (Finset.range n)
          (fun k =>
            ‖(1 / L) •
              (B (reflectedPerturbedCycle L τ n x (fun j => -r j) k) -
                g k)‖) ≤
        τ * Finset.sum (Finset.range n) (fun k => ‖(1 / L) • r k‖) := by
    exact
      scaled_lipschitz_error_sum_bound_for_neg_reflected_cycle
        B U L τ hL_pos hτ_nonneg x g r yNeg hg
        hy_eq_range_neg hx_mem_range hy_mem_range_neg hBLip
  exact _voucher_step_3d_two_sided_error_average_bound herror_pos herror_neg

/-- Correct finite Hilbert telescope for the residual/Q normal forms.

This is the route-local mesh identity behind the Q-absorption leaf.  Search
audit: checked the local endpoint/first-variation helpers
`endpoint_energy_bound_of_residual_first_variation`,
`residual_first_variation_of_endpoint_energy_bound`,
`residual_chain_inner_sub_last_norm_nonpos`, and Mathlib
`Finset.sum_range_sub'`/`real_inner_self_eq_norm_sq`.  The endpoint helpers
contain this calculation internally but do not expose the exact `Rsum`/`Q`
normal form needed here; the plus-`Q` variant sometimes suggested for this
leaf is false already for a one-step affine mesh, so this helper records the
proved signed form. -/
private theorem mesh_rsum_sub_q_endpoint_identity
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (d : H) (L : ℝ) {n : ℕ} (g r : ℕ → H)
    (hg0 : g 0 = 0)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    {Rsum Q : ℝ}
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n)
        (fun k => ‖g (k + 1) - g k‖ ^ 2)) :
    2 * Rsum - Q =
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) -
        ‖g n‖ ^ 2 := by
  classical
  let A : ℝ := Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)
  let Bsum : ℝ :=
    Finset.sum (Finset.range n) (fun k => ⟪g k, g (k + 1) - g k⟫_ℝ)
  have htel_neg :
      Finset.sum (Finset.range n)
          (fun k => ‖g k‖ ^ 2 - ‖g (k + 1)‖ ^ 2) =
        ‖g 0‖ ^ 2 - ‖g n‖ ^ 2 := by
    simpa using (Finset.sum_range_sub' (fun k : ℕ => ‖g k‖ ^ 2) n)
  have htel :
      Finset.sum (Finset.range n)
          (fun k => ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2) =
        ‖g n‖ ^ 2 := by
    have hneg :
        Finset.sum (Finset.range n)
            (fun k => ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2) =
          -Finset.sum (Finset.range n)
            (fun k => ‖g k‖ ^ 2 - ‖g (k + 1)‖ ^ 2) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    rw [hneg, htel_neg, hg0]
    simp
  have hstep :
      ∀ k ∈ Finset.range n,
        ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2 =
          2 * ⟪g k, g (k + 1) - g k⟫_ℝ +
            ‖g (k + 1) - g k‖ ^ 2 := by
    intro k hk
    let δ : H := g (k + 1) - g k
    have hdecomp : g (k + 1) = g k + δ := by
      dsimp [δ]
      abel
    rw [hdecomp]
    have hsub : g k + δ - g k = δ := by
      abel
    rw [hsub]
    rw [← real_inner_self_eq_norm_sq (g k + δ)]
    rw [← real_inner_self_eq_norm_sq (g k)]
    rw [← real_inner_self_eq_norm_sq δ]
    simp only [inner_add_left, inner_add_right]
    rw [real_inner_comm δ (g k)]
    ring_nf
  have henergy :
      ‖g n‖ ^ 2 =
        2 * Bsum +
          Finset.sum (Finset.range n)
            (fun k => ‖g (k + 1) - g k‖ ^ 2) := by
    rw [← htel]
    calc
      Finset.sum (Finset.range n)
          (fun k => ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2)
          =
        Finset.sum (Finset.range n)
          (fun k =>
            2 * ⟪g k, g (k + 1) - g k⟫_ℝ +
              ‖g (k + 1) - g k‖ ^ 2) := by
            apply Finset.sum_congr rfl
            intro k hk
            exact hstep k hk
      _ =
        2 * Bsum +
          Finset.sum (Finset.range n)
            (fun k => ‖g (k + 1) - g k‖ ^ 2) := by
            rw [Finset.sum_add_distrib]
            dsimp [Bsum]
            rw [← Finset.mul_sum]
  have hRsum :
      Rsum = (L / (n : ℝ)) * A - Bsum := by
    rw [hRsum_def]
    dsimp [A, Bsum]
    calc
      Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ)
          =
        Finset.sum (Finset.range n)
          (fun k => ⟪g k, (L / (n : ℝ)) • d - (g (k + 1) - g k)⟫_ℝ) := by
            apply Finset.sum_congr rfl
            intro k hk
            rw [hr k hk]
      _ = (L / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ) -
          Finset.sum (Finset.range n)
            (fun k => ⟪g k, g (k + 1) - g k⟫_ℝ) := by
            simp [Finset.sum_sub_distrib, Finset.mul_sum, inner_sub_right,
              inner_smul_right]
  have hscale : (L / (n : ℝ)) * A = L * ((1 / (n : ℝ)) * A) := by
    ring
  rw [hRsum, hQ_def, hscale]
  rw [henergy]
  ring

/-- Plus-`Q` endpoint form of the residual/Rsum mesh identity.

This is the exact normal form exposed in Lan Lemma 5.8's reflected Q-form
absorption leaf. Search audit: considered the pre-searched
`mesh_rsum_sub_q_endpoint_identity`, endpoint first-variation helpers, and
Mathlib finite telescope lemmas; the signed `sub_q` identity is the matching
upstream primitive, while the endpoint helpers package later implications
rather than this displayed `2 * Rsum + Q` scalar. -/
private theorem mesh_rsum_plus_q_endpoint_identity
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (d : H) (L : ℝ) {n : ℕ} (g r : ℕ → H)
    (hg0 : g 0 = 0)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    {Rsum Q : ℝ}
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n)
        (fun k => ‖g (k + 1) - g k‖ ^ 2)) :
    2 * Rsum + Q =
      2 * L *
          ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) -
        ‖g n‖ ^ 2 + 2 * Q := by
  have hsub :
      2 * Rsum - Q =
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) -
          ‖g n‖ ^ 2 :=
    mesh_rsum_sub_q_endpoint_identity
      (H := H) d L g r hg0 hr hRsum_def hQ_def
  calc
    2 * Rsum + Q = (2 * Rsum - Q) + 2 * Q := by ring
    _ =
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) -
          ‖g n‖ ^ 2 + 2 * Q := by
        rw [hsub]

/-- Endpoint-energy form of the source bridge implies the unscaled Q/R slack.

This is the finite Hilbert-space tail for the source-preserving
Baillon-Haddad route.  Once the open-domain/carrier cocoercivity argument gives
the endpoint estimate with the actual `2 * Q + Eavg` slack, the desired
Q-absorption is pure telescope and residual algebra.  This deliberately does
not use the refuted `hinterval`-only route. -/
private theorem endpoint_energy_bound_to_q_slack
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (d : H) (L : ℝ) {n : ℕ} (g r : ℕ → H)
    (hg0 : g 0 = 0)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    {Rsum Q Eavg : ℝ}
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n)
        (fun k => ‖g (k + 1) - g k‖ ^ 2))
    (hendpoint :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          2 * Q + Eavg) :
    -(2 * Rsum + Q) ≤ Eavg := by
  classical
  let A : ℝ := Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)
  let Bsum : ℝ :=
    Finset.sum (Finset.range n) (fun k => ⟪g k, g (k + 1) - g k⟫_ℝ)
  have htel_neg :
      Finset.sum (Finset.range n)
          (fun k => ‖g k‖ ^ 2 - ‖g (k + 1)‖ ^ 2) =
        ‖g 0‖ ^ 2 - ‖g n‖ ^ 2 := by
    simpa using (Finset.sum_range_sub' (fun k : ℕ => ‖g k‖ ^ 2) n)
  have htel :
      Finset.sum (Finset.range n)
          (fun k => ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2) =
        ‖g n‖ ^ 2 := by
    have hneg :
        Finset.sum (Finset.range n)
            (fun k => ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2) =
          -Finset.sum (Finset.range n)
            (fun k => ‖g k‖ ^ 2 - ‖g (k + 1)‖ ^ 2) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    rw [hneg, htel_neg, hg0]
    simp
  have hstep_sq :
      ∀ k ∈ Finset.range n,
        ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2 =
          2 * ⟪g k, g (k + 1) - g k⟫_ℝ +
            ‖g (k + 1) - g k‖ ^ 2 := by
    intro k hk
    let δ : H := g (k + 1) - g k
    have hdecomp : g (k + 1) = g k + δ := by
      dsimp [δ]
      abel
    rw [hdecomp]
    have hsub : g k + δ - g k = δ := by
      abel
    rw [hsub]
    rw [← real_inner_self_eq_norm_sq (g k + δ)]
    rw [← real_inner_self_eq_norm_sq (g k)]
    rw [← real_inner_self_eq_norm_sq δ]
    simp only [inner_add_left, inner_add_right]
    rw [real_inner_comm δ (g k)]
    ring_nf
  have henergy :
      ‖g n‖ ^ 2 = 2 * Bsum + Q := by
    rw [← htel, hQ_def]
    calc
      Finset.sum (Finset.range n)
          (fun k => ‖g (k + 1)‖ ^ 2 - ‖g k‖ ^ 2)
          =
        Finset.sum (Finset.range n)
          (fun k =>
            2 * ⟪g k, g (k + 1) - g k⟫_ℝ +
              ‖g (k + 1) - g k‖ ^ 2) := by
            apply Finset.sum_congr rfl
            intro k hk
            exact hstep_sq k hk
      _ =
        2 * Bsum +
          Finset.sum (Finset.range n)
            (fun k => ‖g (k + 1) - g k‖ ^ 2) := by
            rw [Finset.sum_add_distrib]
            dsimp [Bsum]
            rw [← Finset.mul_sum]
  have hRsum :
      Rsum = (L / (n : ℝ)) * A - Bsum := by
    rw [hRsum_def]
    dsimp [A, Bsum]
    calc
      Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ)
          =
        Finset.sum (Finset.range n)
          (fun k => ⟪g k, (L / (n : ℝ)) • d - (g (k + 1) - g k)⟫_ℝ) := by
            apply Finset.sum_congr rfl
            intro k hk
            rw [hr k hk]
      _ = (L / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ) -
          Finset.sum (Finset.range n)
            (fun k => ⟪g k, g (k + 1) - g k⟫_ℝ) := by
            simp [Finset.sum_sub_distrib, Finset.mul_sum, inner_sub_right,
              inner_smul_right]
  have hscale : (L / (n : ℝ)) * A = L * ((1 / (n : ℝ)) * A) := by
    ring
  have hendpoint' :
      2 * Bsum + Q ≤
        2 * L * ((1 / (n : ℝ)) * A) + 2 * Q + Eavg := by
    simpa [A, henergy] using hendpoint
  rw [hRsum, hscale]
  nlinarith

/-- Endpoint-energy source bridge in the exact downstream Q-form.

This is just the ordered-ring tail on `endpoint_energy_bound_to_q_slack`.
Keeping it as a named leaf lets the source-preserving route call the endpoint
bridge directly, instead of re-entering the refuted `hinterval`-only
absorption. -/
private theorem endpoint_energy_bound_to_q_form_absorption
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (d : H) (L : ℝ) {n : ℕ} (g r : ℕ → H)
    (hg0 : g 0 = 0)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    {Rsum Q Eavg : ℝ}
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n)
        (fun k => ‖g (k + 1) - g k‖ ^ 2))
    (hendpoint :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          2 * Q + Eavg) :
    0 ≤ 2 * Rsum + Q + Eavg := by
  have hslack :
      -(2 * Rsum + Q) ≤ Eavg :=
    endpoint_energy_bound_to_q_slack
      (H := H) d L g r hg0 hr hRsum_def hQ_def hendpoint
  linarith

/-- Aggregate reflected work plus a mesh-gap absorption gives the Q/R slack.

This is the reusable finite tail for the endpoint route: source data may prove
aggregate reflected work and a separate mesh-gap absorption; this lemma performs
only the Hilbert telescope and ordered-ring normalization. -/
private theorem aggregate_reflected_work_and_mesh_gap_to_q_slack
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (d : H) (L : ℝ) (g r : ℕ → H)
    (hg0 : g 0 = 0)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    {Rsum Q Eavg : ℝ}
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n)
        (fun k => ‖g (k + 1) - g k‖ ^ 2))
    (hreflected :
      0 ≤ 2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ))
    (hmesh_gap_absorbed :
      L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) ≤ Q + Eavg) :
    -(2 * Rsum + Q) ≤ Eavg := by
  classical
  have hsum_r :
      Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) =
        Finset.sum (Finset.range n)
          (fun k =>
            ⟪g k, (L / (n : ℝ)) • d - (g (k + 1) - g k)⟫_ℝ) := by
    apply Finset.sum_congr rfl
    intro k hk
    rw [hr k hk]
  have hreflected_r :
      0 ≤
        2 * Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    simpa [hRsum_def] using hreflected
  have hreflected_formula :
      0 ≤
        2 *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪g k, (L / (n : ℝ)) • d - (g (k + 1) - g k)⟫_ℝ) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    simpa [hsum_r] using hreflected_r
  have hendpoint_base :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k => ‖g (k + 1) - g k‖ ^ 2) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) :=
    finite_aggregate_reflected_work_endpoint_energy_bound
      d L hn_pos g hg0 hreflected_formula
  have hendpoint_base' :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          Q + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    simpa [hQ_def] using hendpoint_base
  have hendpoint :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          2 * Q + Eavg := by
    nlinarith only [hendpoint_base', hmesh_gap_absorbed]
  exact
    endpoint_energy_bound_to_q_slack
      d L g r hg0 hr hRsum_def hQ_def hendpoint

/-- Q-form version of the aggregate reflected-work endpoint route. -/
private theorem aggregate_reflected_work_and_mesh_gap_to_q_form_absorption
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) (d : H) (L : ℝ) (g r : ℕ → H)
    (hg0 : g 0 = 0)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    {Rsum Q Eavg : ℝ}
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n)
        (fun k => ‖g (k + 1) - g k‖ ^ 2))
    (hreflected :
      0 ≤ 2 * Rsum + L ^ 2 * ‖d‖ ^ 2 / (n : ℝ))
    (hmesh_gap_absorbed :
      L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) ≤ Q + Eavg) :
    0 ≤ 2 * Rsum + Q + Eavg := by
  have hslack :
      -(2 * Rsum + Q) ≤ Eavg :=
    aggregate_reflected_work_and_mesh_gap_to_q_slack
      hn_pos d L g r hg0 hr hRsum_def hQ_def
      hreflected hmesh_gap_absorbed
  linarith

/-- Source support telescoped around the closed mesh makes the `B` base work
nonpositive.

This is a source-level finite telescope used by the reflected split route. It
keeps the support inequalities available as a named fact instead of compressing
them into the lossy `hinterval` abstraction. -/
private theorem source_base_work_nonpos
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    {n : ℕ} (hn_pos : 0 < n) (x g : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hx_succ_mem : ∀ k ∈ Finset.range n, x (k + 1) ∈ U)
    (hg : ∀ k, g k = B (x k)) :
    Finset.sum (Finset.range n)
        (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
      ⟪g n, x 0 - x n⟫_ℝ ≤ 0 := by
  classical
  have hsupport_range :
      ∀ k ∈ Finset.range n,
        0 ≤ Φ (x (k + 1)) - Φ (x k) -
          ⟪g k, x (k + 1) - x k⟫_ℝ := by
    intro k hk
    have h := hsupport (x k) (hx_mem_range k hk)
      (x (k + 1)) (hx_succ_mem k hk)
    simpa [hg k] using h
  have hsum_range :
      0 ≤ Finset.sum (Finset.range n)
        (fun k =>
          Φ (x (k + 1)) - Φ (x k) -
            ⟪g k, x (k + 1) - x k⟫_ℝ) :=
    Finset.sum_nonneg hsupport_range
  have hzero_mem : 0 ∈ Finset.range n := Finset.mem_range.mpr hn_pos
  have hlast_mem : n - 1 ∈ Finset.range n :=
    Finset.mem_range.mpr (Nat.sub_lt hn_pos Nat.zero_lt_one)
  have hxn_mem : x n ∈ U := by
    simpa [Nat.sub_add_cancel hn_pos] using hx_succ_mem (n - 1) hlast_mem
  have hx0_mem : x 0 ∈ U := hx_mem_range 0 hzero_mem
  have hlast :
      0 ≤ Φ (x 0) - Φ (x n) - ⟪g n, x 0 - x n⟫_ℝ := by
    have h := hsupport (x n) hxn_mem (x 0) hx0_mem
    simpa [hg n] using h
  have htotal :
      0 ≤
        Finset.sum (Finset.range n)
            (fun k =>
              Φ (x (k + 1)) - Φ (x k) -
                ⟪g k, x (k + 1) - x k⟫_ℝ) +
          (Φ (x 0) - Φ (x n) - ⟪g n, x 0 - x n⟫_ℝ) :=
    add_nonneg hsum_range hlast
  have htel :
      Finset.sum (Finset.range n) (fun k => Φ (x (k + 1)) - Φ (x k)) =
        Φ (x n) - Φ (x 0) := by
    have hneg :
        Finset.sum (Finset.range n) (fun k => Φ (x (k + 1)) - Φ (x k)) =
          -Finset.sum (Finset.range n) (fun k => Φ (x k) - Φ (x (k + 1))) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    rw [hneg]
    simpa using congrArg Neg.neg (Finset.sum_range_sub' (fun k : ℕ => Φ (x k)) n)
  have hrewrite :
      Finset.sum (Finset.range n)
            (fun k =>
              Φ (x (k + 1)) - Φ (x k) -
                ⟪g k, x (k + 1) - x k⟫_ℝ) +
          (Φ (x 0) - Φ (x n) - ⟪g n, x 0 - x n⟫_ℝ)
        =
      - (Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ) := by
    rw [Finset.sum_sub_distrib, htel]
    ring
  have hnonneg_neg :
      0 ≤
        - (Finset.sum (Finset.range n)
          (fun k => ⟪g k, x (k + 1) - x k⟫_ℝ) +
        ⟪g n, x 0 - x n⟫_ℝ) := by
    rw [hrewrite] at htotal
    exact htotal
  exact neg_nonneg.mp hnonneg_neg

/-- Summing the source residual definition telescopes to the endpoint gradient. -/
private theorem source_residual_sum_eq_endpoint
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (L : ℝ) {n : ℕ} (hn_pos : 0 < n) (d : H) (g r : ℕ → H)
    (hg0 : g 0 = 0)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k)) :
    Finset.sum (Finset.range n) r = L • d - g n := by
  classical
  have hnR_ne : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn_pos)
  have hconst :
      Finset.sum (Finset.range n) (fun _ : ℕ => (L / (n : ℝ)) • d) =
        L • d := by
    rw [Finset.sum_const]
    rw [Finset.card_range]
    rw [← Nat.cast_smul_eq_nsmul ℝ]
    rw [smul_smul]
    field_simp [hnR_ne]
  have htel :
      Finset.sum (Finset.range n) (fun k => g (k + 1) - g k) = g n - g 0 := by
    have hneg :
        Finset.sum (Finset.range n) (fun k => g (k + 1) - g k) =
          -Finset.sum (Finset.range n) (fun k => g k - g (k + 1)) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      abel
    rw [hneg]
    simpa using congrArg Neg.neg (Finset.sum_range_sub' g n)
  calc
    Finset.sum (Finset.range n) r =
        Finset.sum (Finset.range n)
          (fun k => (L / (n : ℝ)) • d - (g (k + 1) - g k)) := by
          apply Finset.sum_congr rfl
          intro k hk
          rw [hr k hk]
    _ =
        Finset.sum (Finset.range n) (fun _ : ℕ => (L / (n : ℝ)) • d) -
          Finset.sum (Finset.range n) (fun k => g (k + 1) - g k) := by
          rw [Finset.sum_sub_distrib]
    _ = L • d - g n := by
          rw [hconst, htel, hg0]
          abel

/-- The predecessor-skew boundary term can be rewritten using only the endpoint
step and the summed source residual. -/
private theorem pred_skew_boundary_source_residual_nf
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (L : ℝ) {n : ℕ} (d : H) (x g r : ℕ → H)
    (hclose : x 0 - x n = -d)
    (hg0 : g 0 = 0)
    (hrsum : Finset.sum (Finset.range n) r = L • d - g n) :
    ⟪g n - g 0, r 0⟫_ℝ -
        ⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ =
      ⟪L • d - (2 : ℝ) • Finset.sum (Finset.range n) r, r 0⟫_ℝ := by
  have hxn_sub : x n - x 0 = d := by
    have hneg := congrArg Neg.neg hclose
    simpa using hneg
  have hleft :
      g n - g 0 -
          ((L • x n - g n) - (L • x 0 - g 0)) =
        (2 : ℝ) • g n - L • d := by
    have hLx : L • x n - L • x 0 = L • d := by
      rw [← smul_sub, hxn_sub]
    rw [hg0]
    calc
      g n - 0 - (L • x n - g n - (L • x 0 - 0)) =
          (2 : ℝ) • g n - (L • x n - L • x 0) := by
          module
      _ = (2 : ℝ) • g n - L • d := by
          rw [hLx]
  have hright :
      L • d - (2 : ℝ) • Finset.sum (Finset.range n) r =
        (2 : ℝ) • g n - L • d := by
    rw [hrsum]
    module
  calc
    ⟪g n - g 0, r 0⟫_ℝ -
        ⟪(L • x n - g n) - (L • x 0 - g 0), r 0⟫_ℝ
        = ⟪g n - g 0 -
            ((L • x n - g n) - (L • x 0 - g 0)), r 0⟫_ℝ := by
            simp [inner_sub_left]
    _ = ⟪L • d - (2 : ℝ) • Finset.sum (Finset.range n) r, r 0⟫_ℝ := by
            rw [hleft, hright]

/-- Interior predecessor-skew terms collapse to a single residual inner product. -/
private theorem pred_skew_interior_residual_nf
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (L : ℝ) (d : H) (r : ℕ → H) :
    Finset.sum (Finset.range (n - 1))
        (fun k =>
          ⟪r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ -
            ⟪-r k, r (k + 1)⟫_ℝ) =
      Finset.sum (Finset.range (n - 1))
        (fun k =>
          ⟪(2 : ℝ) • r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ) := by
  apply Finset.sum_congr rfl
  intro k hk
  simp [inner_sub_left, inner_neg_left, inner_smul_left]
  ring_nf

/-- Full predecessor-skew normal form after the source residual endpoint
telescope and interior residual collapse. -/
private theorem pred_skew_source_residual_nf
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (L τ : ℝ) (d : H) (r : ℕ → H) {predSkewNF : ℝ}
    (hpredSkewNF_def :
      predSkewNF =
        τ * ((1 / L) *
          (⟪L • d - (2 : ℝ) • Finset.sum (Finset.range n) r, r 0⟫_ℝ +
            Finset.sum (Finset.range (n - 1))
              (fun k =>
                ⟪r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ -
                  ⟪-r k, r (k + 1)⟫_ℝ)))) :
    predSkewNF =
      τ * ((1 / L) *
        (⟪L • d - (2 : ℝ) • Finset.sum (Finset.range n) r, r 0⟫_ℝ +
          Finset.sum (Finset.range (n - 1))
            (fun k =>
              ⟪(2 : ℝ) • r k - (L / (n : ℝ)) • d, r (k + 1)⟫_ℝ))) := by
  rw [hpredSkewNF_def]
  rw [pred_skew_interior_residual_nf L d r]

/-- The residual linear term can be expressed in the same `(L/n)d`
normalization as the source mesh inequality. -/
private theorem residual_linear_source_mesh_nf
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} {L : ℝ} (hL_pos : 0 < L) (d : H) (r : ℕ → H) :
    (1 / (n : ℝ)) *
        Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ) =
      (1 / L) *
        Finset.sum (Finset.range n)
          (fun k => ⟪r k, (L / (n : ℝ)) • d⟫_ℝ) := by
  have hL_ne : L ≠ 0 := ne_of_gt hL_pos
  calc
    (1 / (n : ℝ)) *
        Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ)
        =
      Finset.sum (Finset.range n)
        (fun k => (1 / (n : ℝ)) * ⟪r k, d⟫_ℝ) := by
        rw [Finset.mul_sum]
    _ =
      Finset.sum (Finset.range n)
        (fun k => (1 / L) * ⟪r k, (L / (n : ℝ)) • d⟫_ℝ) := by
        apply Finset.sum_congr rfl
        intro k hk
        rw [inner_smul_right]
        field_simp [hL_ne]
    _ =
      (1 / L) *
        Finset.sum (Finset.range n)
          (fun k => ⟪r k, (L / (n : ℝ)) • d⟫_ℝ) := by
        rw [Finset.mul_sum]

/-- Negative residual normal form in source-mesh normalization. -/
private theorem residual_neg_source_mesh_nf
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} {L τ residualNegNF : ℝ} (hL_pos : 0 < L)
    (d : H) (r : ℕ → H)
    (hresidualNegNF_def :
      residualNegNF =
        -(τ * ((1 / (n : ℝ)) *
            Finset.sum (Finset.range n) (fun k => ⟪r k, d⟫_ℝ))) +
          τ ^ 2 * (1 / L) *
            (Finset.sum (Finset.range (n - 1))
                (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
              ‖r (n - 1)‖ ^ 2)) :
    residualNegNF =
      -(τ * ((1 / L) *
          Finset.sum (Finset.range n)
            (fun k => ⟪r k, (L / (n : ℝ)) • d⟫_ℝ))) +
        τ ^ 2 * (1 / L) *
          (Finset.sum (Finset.range (n - 1))
              (fun k => ⟪r k, r (k + 1) - r k⟫_ℝ) -
            ‖r (n - 1)‖ ^ 2) := by
  rw [hresidualNegNF_def]
  rw [residual_linear_source_mesh_nf hL_pos d r]

/-- Scalar combination of the source residual normal forms for the predecessor
skew term and the negative residual term. -/
private theorem pred_skew_plus_residual_neg_source_nf
    {τ L predSkewNF residualNegNF P M C : ℝ}
    (hpredSkew_nf : predSkewNF = τ * ((1 / L) * P))
    (hresidualNeg_nf :
      residualNegNF =
        -(τ * ((1 / L) * M)) + τ ^ 2 * (1 / L) * C) :
    predSkewNF + residualNegNF =
      τ * ((1 / L) * (P - M)) + τ ^ 2 * (1 / L) * C := by
  rw [hpredSkew_nf, hresidualNeg_nf]
  ring

/-- If the residual chain is nonpositive, the source-tail normal form is
bounded above by its linear part. -/
private theorem pred_skew_plus_residual_neg_linear_upper
    {τ L tail P M C : ℝ} (hL_pos : 0 < L)
    (hC_nonpos : C ≤ 0)
    (htail :
      tail = τ * ((1 / L) * (P - M)) + τ ^ 2 * (1 / L) * C) :
    tail ≤ τ * ((1 / L) * (P - M)) := by
  rw [htail]
  have hcoef_nonneg : 0 ≤ τ ^ 2 * (1 / L) :=
    mul_nonneg (sq_nonneg τ) (le_of_lt (one_div_pos.mpr hL_pos))
  have hterm_nonpos : τ ^ 2 * (1 / L) * C ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos hcoef_nonneg hC_nonpos
  linarith

/-- The endpoint `x (k+1)` of every uniform mesh edge is source-feasible. -/
private theorem source_mesh_successor_mem
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {U : Set H} {L τ : ℝ} {n : ℕ} (x r : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hyPert_mem_pos :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U) :
    ∀ k ∈ Finset.range n, x (k + 1) ∈ U := by
  intro k hk
  have hklt : k < n := Finset.mem_range.mp hk
  by_cases hksucc : k + 1 < n
  · exact hx_mem_range (k + 1) (Finset.mem_range.mpr hksucc)
  · have hkeq : k + 1 = n := by omega
    have hy := hyPert_mem_pos n (by omega)
    have hyn : reflectedPerturbedCycle L τ n x r n = x n := by
      simp [reflectedPerturbedCycle]
    simpa [hkeq, hyn] using hy

/-- Source support inequalities imply monotonicity of adjacent gradient
increments along the mesh. -/
private theorem source_gradient_increment_monotone
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    {n : ℕ} (x g : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hx_succ_mem : ∀ k ∈ Finset.range n, x (k + 1) ∈ U)
    (hg : ∀ k, g k = B (x k)) :
    ∀ k ∈ Finset.range n,
      0 ≤ ⟪g (k + 1) - g k, x (k + 1) - x k⟫_ℝ := by
  intro k hk
  have hxk : x k ∈ U := hx_mem_range k hk
  have hxk1 : x (k + 1) ∈ U := hx_succ_mem k hk
  have hs_forward := hsupport (x k) hxk (x (k + 1)) hxk1
  have hs_backward := hsupport (x (k + 1)) hxk1 (x k) hxk
  have hsum := add_nonneg hs_forward hs_backward
  have hrewrite :
      (Φ (x (k + 1)) - Φ (x k) -
            ⟪B (x k), x (k + 1) - x k⟫_ℝ) +
          (Φ (x k) - Φ (x (k + 1)) -
            ⟪B (x (k + 1)), x k - x (k + 1)⟫_ℝ) =
        ⟪B (x (k + 1)) - B (x k),
          x (k + 1) - x k⟫_ℝ := by
    have hback : x k - x (k + 1) = -(x (k + 1) - x k) := by
      abel
    rw [hback, inner_neg_right]
    simp [inner_sub_left]
    ring
  have hmonoB :
      0 ≤ ⟪B (x (k + 1)) - B (x k),
        x (k + 1) - x k⟫_ℝ := by
    simpa [hrewrite] using hsum
  simpa [hg (k + 1), hg k] using hmonoB

/-- The smooth upper bound plus source support makes the tilted field
`x ↦ L • x - B x` monotone along every feasible mesh edge. -/
private theorem source_tilt_increment_monotone
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (_hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    {n : ℕ} (x g : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hx_succ_mem : ∀ k ∈ Finset.range n, x (k + 1) ∈ U)
    (hg : ∀ k, g k = B (x k)) :
    ∀ k ∈ Finset.range n,
      0 ≤
        ⟪(L • x (k + 1) - g (k + 1)) - (L • x k - g k),
          x (k + 1) - x k⟫_ℝ := by
  intro k hk
  let s : H := x (k + 1) - x k
  have hxk : x k ∈ U := hx_mem_range k hk
  have hxk1 : x (k + 1) ∈ U := hx_succ_mem k hk
  have hup_forward := hupper (x k) hxk (x (k + 1)) hxk1
  have hup_backward := hupper (x (k + 1)) hxk1 (x k) hxk
  have hgap_upper :
      Φ (x (k + 1)) - Φ (x k) -
        ⟪B (x k), s⟫_ℝ ≤ (L / 2) * ‖s‖ ^ 2 := by
    dsimp [s] at hup_forward ⊢
    linarith
  have hback_upper :
      Φ (x k) - Φ (x (k + 1)) +
        ⟪B (x (k + 1)), s⟫_ℝ ≤
          (L / 2) * ‖s‖ ^ 2 := by
    have hxback : x k - x (k + 1) = -s := by
      dsimp [s]
      abel
    have hnorm_back : ‖x k - x (k + 1)‖ ^ 2 = ‖s‖ ^ 2 := by
      rw [hxback, norm_neg]
    have hinner_back :
        ⟪B (x (k + 1)), x k - x (k + 1)⟫_ℝ =
          -⟪B (x (k + 1)), s⟫_ℝ := by
      rw [hxback, inner_neg_right]
    rw [hinner_back, hnorm_back] at hup_backward
    linarith
  have hmono_upper :
      ⟪B (x (k + 1)) - B (x k), s⟫_ℝ ≤
        (L / 2) * ‖s‖ ^ 2 + (L / 2) * ‖s‖ ^ 2 := by
    have hsum' := add_le_add hback_upper hgap_upper
    have hrewrite' :
        (Φ (x k) - Φ (x (k + 1)) +
            ⟪B (x (k + 1)), s⟫_ℝ) +
          (Φ (x (k + 1)) - Φ (x k) - ⟪B (x k), s⟫_ℝ) =
            ⟪B (x (k + 1)) - B (x k), s⟫_ℝ := by
      simp [inner_sub_left]
      ring
    rw [hrewrite'] at hsum'
    exact hsum'
  have htilt :
      0 ≤ L * ‖s‖ ^ 2 - ⟪B (x (k + 1)) - B (x k), s⟫_ℝ := by
    have htwo : (L / 2) * ‖s‖ ^ 2 + (L / 2) * ‖s‖ ^ 2 =
        L * ‖s‖ ^ 2 := by ring
    linarith
  have hrewrite_tilt :
      ⟪(L • x (k + 1) - B (x (k + 1))) - (L • x k - B (x k)), s⟫_ℝ =
        L * ‖s‖ ^ 2 - ⟪B (x (k + 1)) - B (x k), s⟫_ℝ := by
    have hvec :
        (L • x (k + 1) - B (x (k + 1))) - (L • x k - B (x k)) =
          L • s - (B (x (k + 1)) - B (x k)) := by
      dsimp [s]
      module
    have hself : ⟪L • s, s⟫_ℝ = L * ‖s‖ ^ 2 := by
      rw [inner_smul_left, real_inner_self_eq_norm_sq]
      simp
    rw [hvec, inner_sub_left, hself]
  simpa [hg (k + 1), hg k, s, hrewrite_tilt] using htilt

/-- Source monotonicity along the mesh gives the residual mesh normal form. -/
private theorem source_residual_mesh_normal_form
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    {n : ℕ} (hn_pos : 0 < n) {τ : ℝ}
    (d : H) (x g r : ℕ → H)
    (hx_mem_range : ∀ k ∈ Finset.range n, x k ∈ U)
    (hyPert_mem_pos :
      ∀ k, k ≤ n + 1 → reflectedPerturbedCycle L τ n x r k ∈ U)
    (hg : ∀ k, g k = B (x k))
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    (hstep :
      ∀ k ∈ Finset.range n, x (k + 1) - x k = (1 / (n : ℝ)) • d) :
    0 ≤
      L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) -
        Finset.sum (Finset.range n)
          (fun k => ⟪r k, (L / (n : ℝ)) • d⟫_ℝ) := by
  classical
  have hx_succ_mem :
      ∀ k ∈ Finset.range n, x (k + 1) ∈ U :=
    source_mesh_successor_mem (L := L) (τ := τ) x r hx_mem_range hyPert_mem_pos
  have hsource_monotone :
      ∀ k ∈ Finset.range n,
        0 ≤ ⟪g (k + 1) - g k, x (k + 1) - x k⟫_ℝ :=
    source_gradient_increment_monotone
      Φ B U hsupport x g hx_mem_range hx_succ_mem hg
  have hsource_mesh_work_nonneg :
      0 ≤ Finset.sum (Finset.range n)
        (fun k => ⟪g (k + 1) - g k, (L / (n : ℝ)) • d⟫_ℝ) := by
    refine Finset.sum_nonneg ?_
    intro k hk
    have hmono_step :
        0 ≤ ⟪g (k + 1) - g k, (1 / (n : ℝ)) • d⟫_ℝ := by
      simpa [hstep k hk] using hsource_monotone k hk
    have hscale :
        ⟪g (k + 1) - g k, (L / (n : ℝ)) • d⟫_ℝ =
          L * ⟪g (k + 1) - g k, (1 / (n : ℝ)) • d⟫_ℝ := by
      simp [inner_smul_right]
      ring
    rw [hscale]
    exact mul_nonneg (le_of_lt hL_pos) hmono_step
  have hsource_residual_mesh_nonneg :
      0 ≤ Finset.sum (Finset.range n)
        (fun k =>
          ⟪(L / (n : ℝ)) • d - r k, (L / (n : ℝ)) • d⟫_ℝ) := by
    refine hsource_mesh_work_nonneg.trans_eq ?_
    apply Finset.sum_congr rfl
    intro k hk
    have hrk := hr k hk
    have hdelta :
      g (k + 1) - g k = (L / (n : ℝ)) • d - r k := by
      rw [hrk]
      abel
    rw [hdelta]
  let a : H := (L / (n : ℝ)) • d
  have hsum_expand :
      Finset.sum (Finset.range n)
          (fun k => ⟪a - r k, a⟫_ℝ) =
        Finset.sum (Finset.range n) (fun _ : ℕ => ⟪a, a⟫_ℝ) -
          Finset.sum (Finset.range n) (fun k => ⟪r k, a⟫_ℝ) := by
    simp [Finset.sum_sub_distrib, inner_sub_left]
  have hconst :
      Finset.sum (Finset.range n) (fun _ : ℕ => ⟪a, a⟫_ℝ) =
        L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    have hnR_ne : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn_pos)
    have hnorm_a :
        ‖a‖ = (L / (n : ℝ)) * ‖d‖ := by
      have hscale_nonneg : 0 ≤ L / (n : ℝ) := by positivity
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hscale_nonneg]
    calc
      Finset.sum (Finset.range n) (fun _ : ℕ => ⟪a, a⟫_ℝ)
          = (n : ℝ) * ‖a‖ ^ 2 := by
            simp
      _ = (n : ℝ) * ((L / (n : ℝ)) * ‖d‖) ^ 2 := by
            rw [hnorm_a]
      _ = L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
            field_simp [hnR_ne]
  have hsrc :
      0 ≤ Finset.sum (Finset.range n) (fun k => ⟪a - r k, a⟫_ℝ) := by
    simpa [a] using hsource_residual_mesh_nonneg
  rw [hsum_expand, hconst] at hsrc
  simpa [a] using hsrc

/-- Direct endpoint-energy use only needs the source mesh budget to be covered
by `2 * Q + Eavg`. -/
private theorem double_q_gap_absorbed_iff_error_covers_gap
    {meshEnergy Q Eavg : ℝ} :
    (meshEnergy ≤ 2 * Q + Eavg) ↔ meshEnergy - 2 * Q ≤ Eavg := by
  constructor <;> intro h <;> linarith

/-- Exact residual normal form for the unused uniform-mesh energy. -/
private theorem mesh_gap_as_residual_cross_terms
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) {L : ℝ} (hL_pos : 0 < L)
    (d : H) (g r : ℕ → H)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    {Q : ℝ}
    (hQ_def :
      Q = Finset.sum (Finset.range n)
        (fun k => ‖g (k + 1) - g k‖ ^ 2)) :
    L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) - Q =
      Finset.sum (Finset.range n)
        (fun k =>
          2 * ⟪r k, (L / (n : ℝ)) • d⟫_ℝ - ‖r k‖ ^ 2) := by
  classical
  let a : H := (L / (n : ℝ)) • d
  have hnR_ne : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn_pos)
  have hmesh_const :
      Finset.sum (Finset.range n) (fun _ : ℕ => ‖a‖ ^ 2) =
        L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    have hnorm_a :
        ‖a‖ = (L / (n : ℝ)) * ‖d‖ := by
      have hscale_nonneg : 0 ≤ L / (n : ℝ) := by positivity
      dsimp [a]
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hscale_nonneg]
    calc
      Finset.sum (Finset.range n) (fun _ : ℕ => ‖a‖ ^ 2)
          = (n : ℝ) * ‖a‖ ^ 2 := by
            simp
      _ = (n : ℝ) * ((L / (n : ℝ)) * ‖d‖) ^ 2 := by
            rw [hnorm_a]
      _ = L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
            field_simp [hnR_ne]
  have hpoint :
      ∀ k ∈ Finset.range n,
        ‖a‖ ^ 2 - ‖g (k + 1) - g k‖ ^ 2 =
          2 * ⟪r k, a⟫_ℝ - ‖r k‖ ^ 2 := by
    intro k hk
    have hdelta : g (k + 1) - g k = a - r k := by
      rw [hr k hk]
      dsimp [a]
      abel
    rw [hdelta]
    rw [norm_sub_sq_real]
    rw [real_inner_comm a (r k)]
    ring
  calc
    L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) - Q
        =
      Finset.sum (Finset.range n) (fun _ : ℕ => ‖a‖ ^ 2) -
        Finset.sum (Finset.range n)
          (fun k => ‖g (k + 1) - g k‖ ^ 2) := by
          rw [hmesh_const, ← hQ_def]
    _ =
      Finset.sum (Finset.range n)
        (fun k => ‖a‖ ^ 2 - ‖g (k + 1) - g k‖ ^ 2) := by
        rw [Finset.sum_sub_distrib]
    _ =
      Finset.sum (Finset.range n)
        (fun k => 2 * ⟪r k, a⟫_ℝ - ‖r k‖ ^ 2) := by
        apply Finset.sum_congr rfl
        intro k hk
        exact hpoint k hk
    _ =
      Finset.sum (Finset.range n)
        (fun k =>
          2 * ⟪r k, (L / (n : ℝ)) • d⟫_ℝ - ‖r k‖ ^ 2) := by
        rfl

/-- A residual-cross cover is exactly the mesh-gap absorption needed by the
aggregate reflected-work route. -/
private theorem residual_cross_cover_to_mesh_gap_absorbed
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (hn_pos : 0 < n) {L : ℝ} (hL_pos : 0 < L)
    (d : H) (g r : ℕ → H)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    {Q Eavg : ℝ}
    (hQ_def :
      Q = Finset.sum (Finset.range n)
        (fun k => ‖g (k + 1) - g k‖ ^ 2))
    (hcover :
      Finset.sum (Finset.range n)
          (fun k => 2 * ⟪r k, (L / (n : ℝ)) • d⟫_ℝ - ‖r k‖ ^ 2)
