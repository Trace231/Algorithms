    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
