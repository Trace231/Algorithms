      (x 0) hx0_mem hBz (x n) hxn_mem
  have hforward :
      Φ (x n) - Φ (x 0) ≤
        (1 / (n : ℝ)) *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪B (AffineMap.lineMap (x 0) (x n) ((k : ℝ) / (n : ℝ))),
