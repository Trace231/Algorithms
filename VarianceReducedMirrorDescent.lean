    (hsupport : ∀ u ∈ U, ∀ v ∈ U,
      0 ≤ Φ v - Φ u - ⟪B u, v - u⟫_ℝ)
    (hupper : ∀ u ∈ U, ∀ v ∈ U,
      Φ v ≤ Φ u + ⟪B u, v - u⟫_ℝ + (L / 2) * ‖v - u‖ ^ 2)
    (hgrad : ∀ u ∈ U, HasFDerivAt Φ (innerSL ℝ (B u)) u)
