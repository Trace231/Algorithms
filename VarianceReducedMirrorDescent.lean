wrappers are declared downstream of the current mesh voucher, while imported
hits only provide support/smooth-upper ingredients or require a globally
feasible inverse-gradient step. -/
private theorem early_open_zero_base_endpoint_from_support_upper_gradient_before_mesh
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [FiniteDimensional ℝ H]
    (Φ : H → ℝ) (B : H → H) (U : Set H) (L : ℝ)
    (hL_pos : 0 < L)
    (hUopen : IsOpen U)
    (hUconv : Convex ℝ U)
    (hnonneg : ∀ u ∈ U, 0 ≤ Φ u)
    (hsupport : ∀ x ∈ U, ∀ y ∈ U,
      0 ≤ Φ y - Φ x - ⟪B x, y - x⟫_ℝ)
    (hupper : ∀ x ∈ U, ∀ y ∈ U,
      Φ y ≤ Φ x + ⟪B x, y - x⟫_ℝ + (L / 2) * ‖y - x‖ ^ 2)
    (hgrad : ∀ x ∈ U, HasFDerivAt Φ (innerSL ℝ (B x)) x)
    (hBLip : ∀ x ∈ U, ∀ y ∈ U, ‖B x - B y‖ ≤ L * ‖x - y‖)
    (z : H) (hz : z ∈ U) (hΦz : Φ z = 0) (hBz : B z = 0)
    (u : H) (hu : u ∈ U) :
    ‖B u‖ ^ 2 ≤ 2 * L * Φ u := by
  classical
  refine le_of_forall_pos_le_add ?_
  intro ε hε_pos
  let line : ℝ → H := fun t => AffineMap.lineMap z u t
  let φ : ℝ → ℝ := fun t => Φ (line t)
  let g : ℝ → H := fun t => B (line t)
  let d : H := u - z
  have hline0 : line 0 = z := by
    simp [line]
  have hline1 : line 1 = u := by
    simp [line]
  have hφ0 : φ 0 = 0 := by
    simp [φ, hline0, hΦz]
  have hφ1 : φ 1 = Φ u := by
    simp [φ, hline1]
  obtain ⟨ρ, hρ_pos, htube⟩ :=
    compact_segment_tube_inside_open_convex_domain U hUopen hUconv z hz u hu
  have hseg_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1, line t ∈ U := by
    intro t ht
    exact hUconv.lineMap_mem hz hu ht
  have hlocal_pair :
      ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖(t - s) • d‖ < ρ →
          ‖g t - g s‖ ^ 2 ≤
            2 * L * (φ t - φ s - ⟪g s, (t - s) • d⟫_ℝ) := by
    intro s hs t ht hmesh
    have hsub :
        line t - line s = (t - s) • d := by
      simpa [line, d] using lineMap_sub_eq_smul_endpoint_diff z u s t
    have hpair :=
      local_pair_gap_of_mesh_ball_subset Φ B U L hL_pos hsupport hupper hBLip
        (line s) (hseg_mem s hs) (line t) (hseg_mem t ht)
        (htube t ht) (by simpa [hsub] using hmesh)
    simpa [φ, g, hsub] using hpair
  obtain ⟨n, hn_pos, hmesh, henergyBudget, _hworkBudget⟩ :=
    choose_uniform_partition_for_mesh_and_error d hL_pos hρ_pos hε_pos
  have hfwd :=
    forward_local_pair_gap_sum_controls_mesh_energy_budget
      φ g d L ρ hL_pos hlocal_pair hn_pos hmesh
  let gn : ℕ → H := fun k => B (AffineMap.lineMap z u ((k : ℝ) / (n : ℝ)))
  have hg0 : gn 0 = 0 := by
    simp [gn, hBz]
  have hreflected :
      0 ≤
        2 *
            Finset.sum (Finset.range n)
              (fun k =>
                ⟪gn k, (L / (n : ℝ)) • d - (gn (k + 1) - gn k)⟫_ℝ) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    simpa [gn, d] using
      before_mesh_aggregate_reflected_mesh_work_from_source_cycle
        Φ B U L hL_pos hUopen hUconv hsupport hupper hBLip
        z hz hBz u hu hn_pos
  have hendpoint_raw :=
    mesh_endpoint_algebra_from_reflected_work_before_endpoint
      d L hn_pos gn hg0 hreflected
  have hnR_pos : 0 < (n : ℝ) := by
    exact_mod_cast hn_pos
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have hendpoint :
      ‖B u‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖g ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
                  g ((k : ℝ) / (n : ℝ))‖ ^ 2) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := by
    simpa [gn, g, line, d, div_self hnR_ne] using hendpoint_raw
  calc
    ‖B u‖ ^ 2
        ≤ 2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n)
                (fun k => ⟪g ((k : ℝ) / (n : ℝ)), d⟫_ℝ)) +
          Finset.sum (Finset.range n)
            (fun k =>
              ‖g ((((k + 1 : ℕ) : ℝ) / (n : ℝ))) -
                  g ((k : ℝ) / (n : ℝ))‖ ^ 2) +
          L ^ 2 * ‖d‖ ^ 2 / (n : ℝ) := hendpoint
    _ ≤ 2 * L * (φ 1 - φ 0) + ε / 2 := by
          linarith
    _ = 2 * L * Φ u + ε / 2 := by
          rw [hφ1, hφ0]
          ring
    _ ≤ 2 * L * Φ u + ε := by
          linarith

