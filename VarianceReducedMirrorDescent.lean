/-- Named-split Q-form absorption leaf.

This is the replacement proof interface for the lossy canonical interval route:
callers keep the positive and negative source split components in scope all the
way to the Q-form absorption. -/
private theorem source_endpoint_with_error_to_q_form_absorption_leaf
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {n : ℕ} (d : H) (L : ℝ) (g r : ℕ → H)
    (hg0 : g 0 = 0)
    (hr :
      ∀ k ∈ Finset.range n,
        r k = (L / (n : ℝ)) • d - (g (k + 1) - g k))
    {Rsum Q Eavg : ℝ}
    (hRsum_def :
      Rsum = Finset.sum (Finset.range n) (fun k => ⟪g k, r k⟫_ℝ))
    (hQ_def :
      Q = Finset.sum (Finset.range n) (fun k => ‖g (k + 1) - g k‖ ^ 2))
    (hsource_endpoint_energy :
      ‖g n‖ ^ 2 ≤
        2 * L *
            ((1 / (n : ℝ)) *
              Finset.sum (Finset.range n) (fun k => ⟪g k, d⟫_ℝ)) +
          2 * Q + Eavg) :
    0 ≤ 2 * Rsum + Q + Eavg := by
  exact
    endpoint_energy_bound_to_q_form_absorption
      (H := H) d L g r hg0 hr hRsum_def hQ_def hsource_endpoint_energy

